{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/translate-voice.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/test.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}
