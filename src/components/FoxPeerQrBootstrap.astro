<script is:inline>
(() => {
  // Preload PeerJS for QR/invitation sessions. The main FOX communicator
  // owns the actual Peer connection; this component only loads the library.
  if (window.Peer) return;

  const urls = [
    'https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js',
    'https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js'
  ];

  const load = (index = 0) => {
    if (window.Peer) return;
    if (index >= urls.length) {
      window.dispatchEvent(new CustomEvent('fox-peer-load-error'));
      return;
    }
    const script = document.createElement('script');
    script.src = urls[index];
    script.async = false;
    script.onload = () => {
      if (!window.Peer) load(index + 1);
    };
    script.onerror = () => load(index + 1);
    document.head.appendChild(script);
  };

  load();
})();
</script>
