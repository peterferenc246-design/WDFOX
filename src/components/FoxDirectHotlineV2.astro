---
interface Props { locale: string }
const { locale } = Astro.props;
---
<section class="fox-direct" data-fox-direct>
  <div class="direct-card">
    <div class="direct-head"><div><p class="eyebrow">FOX DIRECT</p><h2 data-title></h2><p data-subtitle></p></div><span class="device-badge" data-device></span></div>
    <div class="direct-status" data-status>⏳</div>
    <div class="direct-langs"><label>HOVORÍM<select data-source></select></label><button data-swap>⇄</button><label>PRELOŽIŤ DO<select data-target></select></label></div>
    <div class="direct-actions"><button class="call" data-call>📞 <span data-call-label></span></button><button class="secondary hidden" data-activate>🖥️ <span data-activate-label></span></button><button class="secondary hidden" data-hangup>⛔ <span data-hangup-label></span></button></div>
    <div class="direct-text"><article><header data-source-label></header><p data-transcript></p></article><article><header data-target-label></header><p data-translation></p></article></div>
    <p class="direct-note" data-note></p>
  </div>
</section>
<style>
.fox-direct{padding:18px 0}.direct-card{border:1px solid #f1d5c0;border-radius:22px;background:#fffaf6;padding:22px;box-shadow:0 12px 32px rgba(20,24,35,.06)}.direct-head{display:flex;justify-content:space-between;gap:16px}.eyebrow{margin:0 0 4px;color:#f36a0a;font-size:11px;font-weight:900;letter-spacing:.12em}.direct-head h2{margin:0;color:#172033;font-size:24px}.direct-head p{color:#667085}.device-badge{align-self:flex-start;border-radius:999px;background:#fff;border:1px solid #eee;padding:9px 12px;font-size:11px;font-weight:900}.direct-status{margin-top:16px;border-radius:12px;background:#f7f7f7;padding:12px;color:#667085;font-size:13px}.direct-langs{display:grid;grid-template-columns:1fr 48px 1fr;gap:8px;align-items:end;margin-top:14px}.direct-langs label{display:grid;gap:6px;font-size:10px;font-weight:900;color:#667085}.direct-langs select{border:1px solid #ddd;border-radius:12px;padding:11px;background:#fff;font-weight:700}.direct-langs button{height:44px;border:1px solid #eee;border-radius:12px;background:#fff;color:#f36a0a;font-size:22px}.direct-actions{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}.call,.secondary{border:0;border-radius:999px;padding:13px 18px;font-weight:900;cursor:pointer}.call{background:#18a957;color:#fff}.secondary{background:#eef0f3;color:#172033}.hidden{display:none!important}.direct-text{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.direct-text article{min-height:90px;background:#fff;border:1px solid #eee;border-radius:14px;padding:12px}.direct-text header{font-size:10px;font-weight:900;color:#f36a0a}.direct-text p{margin:12px 0 0;color:#172033;line-height:1.45}.direct-note{font-size:11px;color:#667085}@media(max-width:650px){.direct-head{display:block}.device-badge{display:inline-block;margin-top:10px}.direct-actions,.direct-text{display:grid;grid-template-columns:1fr}.call,.secondary{width:100%}.direct-langs{grid-template-columns:1fr 40px 1fr}}
</style>
<script define:vars={{ locale }}>
const root=document.querySelector('[data-fox-direct]');
if(root){
 const $=s=>root.querySelector(s),status=$('[data-status]'),callBtn=$('[data-call]'),callLabel=$('[data-call-label]'),activate=$('[data-activate]'),activateLabel=$('[data-activate-label]'),hangup=$('[data-hangup]'),hangupLabel=$('[data-hangup-label]'),device=$('[data-device]'),title=$('[data-title]'),subtitle=$('[data-subtitle]'),note=$('[data-note]'),source=$('[data-source]'),target=$('[data-target]'),sourceLabel=$('[data-source-label]'),targetLabel=$('[data-target-label]'),transcript=$('[data-transcript]'),translation=$('[data-translation]');
 const languages=[['bg','🇧🇬 Български'],['hr','🇭🇷 Hrvatski'],['cs','🇨🇿 Čeština'],['da','🇩🇰 Dansk'],['nl','🇳🇱 Nederlands'],['en','🇬🇧 English'],['et','🇪🇪 Eesti'],['fi','🇫🇮 Suomi'],['fr','🇫🇷 Français'],['de','🇩🇪 Deutsch'],['el','🇬🇷 Ελληνικά'],['hu','🇭🇺 Magyar'],['ga','🇮🇪 Gaeilge'],['it','🇮🇹 Italiano'],['lv','🇱🇻 Latviešu'],['lt','🇱🇹 Lietuvių'],['mt','🇲🇹 Malti'],['pl','🇵🇱 Polski'],['pt','🇵🇹 Português'],['ro','🇷🇴 Română'],['sk','🇸🇰 Slovenčina'],['sl','🇸🇮 Slovenščina'],['es','🇪🇸 Español'],['sv','🇸🇪 Svenska']]; const labels=Object.fromEntries(languages); languages.forEach(([c,n])=>{source.add(new Option(n,c));target.add(new Option(n,c))}); source.value=languages.some(x=>x[0]===locale)?locale:'en';target.value=source.value==='sk'?'en':'sk';
 const map={bg:'bg-BG',hr:'hr-HR',cs:'cs-CZ',da:'da-DK',nl:'nl-NL',en:'en-US',et:'et-EE',fi:'fi-FI',fr:'fr-FR',de:'de-DE',el:'el-GR',hu:'hu-HU',ga:'ga-IE',it:'it-IT',lv:'lv-LV',lt:'lt-LT',mt:'mt-MT',pl:'pl-PL',pt:'pt-PT',ro:'ro-RO',sk:'sk-SK',sl:'sl-SI',es:'es-ES',sv:'sv-SE'}; const speechLocale=c=>map[c]||c;
 const ui={sk:{title:'FOX PRIAMA LINKA',sub:'Priame volanie medzi mobilom a FOX PC bez QR párovania.',pc:'🖥️ FOX PC – PRIJÍMAČ',mobile:'📱 MOBIL – VOLAJÚCI',ready:'FOX PC je online a pripravený prijímať hovory.',offline:'FOX PC prijímač nie je aktivovaný.',call:'ZAVOLAŤ NA FOX PC',calling:'VOLÁM NA FOX PC…',incoming:'🔔 PRICHÁDZAJÚCI HOVOR',accept:'PRIJATIE HOVORU',end:'UKONČIŤ HOVOR',activate:'AKTIVOVAŤ TENTO PC AKO FOX PRIJÍMAČ',note:'PC a mobil sa rozlišujú podľa zariadenia a WebRTC spojenia. Rovnaká Wi‑Fi neprekáža.'},de:{title:'FOX DIREKTLEITUNG',sub:'Direkter Anruf zwischen Mobilgerät und FOX-PC ohne QR-Kopplung.',pc:'🖥️ FOX PC – EMPFÄNGER',mobile:'📱 MOBIL – ANRUFER',ready:'FOX PC ist online und bereit für Anrufe.',offline:'FOX-PC-Empfänger ist nicht aktiviert.',call:'FOX-PC ANRUFEN',calling:'FOX PC WIRD ANGERUFEN…',incoming:'🔔 EINGEHENDER ANRUF',accept:'ANRUF ANNEHMEN',end:'ANRUF BEENDEN',activate:'DIESEN PC ALS FOX-EMPFÄNGER AKTIVIEREN',note:'PC und Mobilgerät werden unterschieden. Gleiches WLAN ist kein Problem.'},en:{title:'FOX DIRECT LINE',sub:'Direct call between mobile and FOX PC without QR pairing.',pc:'🖥️ FOX PC – RECEIVER',mobile:'📱 MOBILE – CALLER',ready:'FOX PC is online and ready to receive calls.',offline:'FOX PC receiver is not activated.',call:'CALL FOX PC',calling:'CALLING FOX PC…',incoming:'🔔 INCOMING CALL',accept:'ACCEPT CALL',end:'END CALL',activate:'ACTIVATE THIS PC AS FOX RECEIVER',note:'PC and mobile are distinguished by device metadata. Same Wi‑Fi is not a problem.'}}; const t=ui[locale]||ui.en;
 const mobile=/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent); const desktop=!mobile; const receiver=desktop&&localStorage.getItem('fox.receiver')==='1'; device.textContent=receiver?t.pc:t.mobile;title.textContent=t.title;subtitle.textContent=t.sub;note.textContent=t.note;hangupLabel.textContent=t.end;activateLabel.textContent=t.activate;sourceLabel.textContent=labels[source.value];targetLabel.textContent=labels[target.value];
 let peer=null,media=null,pending=null,stream=null,recognition=null,recognizing=false,stopping=false,previousInteractionId=null,control=null,ringTimer=null,audioCtx=null,ringing=false;
 const peerId='FOX-WDFOX-PC'; const setStatus=x=>status.textContent=x;
 const loadPeer=()=>new Promise((resolve,reject)=>{if(window.Peer)return resolve();const s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js';s.onload=()=>window.Peer?resolve():reject(Error('PeerJS unavailable'));s.onerror=reject;document.head.appendChild(s)});
 const unlockRingAudio=()=>{try{if(!audioCtx)audioCtx=new (window.AudioContext||window.webkitAudioContext)();if(audioCtx.state==='suspended')void audioCtx.resume();return audioCtx}catch{return null}};
 const ringTone=()=>{const ctx=unlockRingAudio();if(!ctx||ctx.state!=='running')return;try{const now=ctx.currentTime;[0,0.22,0.44].forEach((offset,i)=>{const o=ctx.createOscillator(),g=ctx.createGain();o.type='sine';o.frequency.value=i===1?660:880;g.gain.setValueAtTime(0.0001,now+offset);g.gain.exponentialRampToValueAtTime(0.11,now+offset+0.015);g.gain.exponentialRampToValueAtTime(0.0001,now+offset+0.18);o.connect(g).connect(ctx.destination);o.start(now+offset);o.stop(now+offset+0.2)});}catch{}};
 const startRing=()=>{if(ringing)return;ringing=true;ringTone();let flash=false;document.title='📞 FOX – EINGEHENDER ANRUF';ringTimer=setInterval(()=>{flash=!flash;document.title=flash?'📞 FOX – EINGEHENDER ANRUF':'FOX DIRECT LINE';ringTone();try{navigator.vibrate?.([220,120,220])}catch{}},1200)};
 const stopRing=()=>{ringing=false;if(ringTimer)clearInterval(ringTimer);ringTimer=null;document.title='FOX DIRECT LINE'};
 ['pointerdown','touchstart','keydown'].forEach(evt=>document.addEventListener(evt,unlockRingAudio,{passive:true,capture:true}));
 const ensureMic=async()=>stream||await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});
 const speak=text=>{if(!text||!speechSynthesis)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang=speechLocale(target.value);u.rate=1;speechSynthesis.speak(u)};
 const translate=async(text,src,dst)=>{const prompt=`Translate only this spoken sentence from ${labels[src]} to ${labels[dst]}. Return only a natural, grammatically correct standard/formal translation in the target language. Preserve meaning, names, numbers, dates, negation, tense, politeness and tone. Do not add or remove meaning. Sentence: ${text}`;const r=await fetch('/api/gemini-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:prompt,previousInteractionId:previousInteractionId||null,systemInstruction:'You are a professional real-time interpreter. Output only the target-language translation.',thinkingLevel:'low'})});const j=await r.json().catch(()=>({}));if(!r.ok)throw Error(j.error||`Gemini HTTP ${r.status}`);previousInteractionId=j.interactionId||previousInteractionId;return String(j.text||j.translation||'').trim()};
 const startRecognition=()=>{const C=window.SpeechRecognition||window.webkitSpeechRecognition;if(!C){setStatus('❌ SpeechRecognition nie je podporované. Použite Chrome/Edge.');return}if(recognizing)return;stopping=false;recognition=new C();recognition.lang=speechLocale(source.value);recognition.continuous=true;recognition.interimResults=true;recognition.onstart=()=>{recognizing=true;setStatus('🎙️ '+(receiver?t.ready:'HOVORÍTE…'))};recognition.onerror=e=>{if(!stopping)setStatus('❌ SpeechRecognition: '+(e.error||'error'))};recognition.onresult=async e=>{for(let i=e.resultIndex;i<e.results.length;i++){const r=e.results[i],txt=r[0]?.transcript?.trim()||'';if(!txt)continue;if(r.isFinal){transcript.textContent=txt;try{const out=await translate(txt,source.value,target.value);translation.textContent=out;if(control?.open)control.send({type:'direct-translation',text:out,target:target.value});speak(out)}catch(err){setStatus('❌ PREKLAD: '+(err.message||err))}}else transcript.textContent=txt}};recognition.onend=()=>{recognizing=false;if(!stopping&&media?.open)setTimeout(()=>{if(!recognizing)startRecognition()},250)};try{recognition.start()}catch{}};
 const stopRecognition=()=>{stopping=true;try{recognition?.stop()}catch{}recognizing=false};
 const attachCall=c=>{media=c;c.on('stream',s=>{const a=new Audio();a.autoplay=true;a.srcObject=s;window.__FOX_DIRECT_AUDIO__=a;a.play().catch(()=>{});setStatus('🟢 '+t.ready)});c.on('close',()=>{stopRecognition();stopRing();setStatus(t.offline)});c.on('error',e=>{stopRing();setStatus('❌ WebRTC: '+(e.type||e.message||'error'))})};
 const answer=async()=>{if(!pending)return;try{stopRing();stream=await ensureMic();const c=pending;pending=null;c.answer(stream);attachCall(c);setStatus('🟢 '+t.ready);callBtn.classList.add('hidden');hangup.classList.remove('hidden');startRecognition()}catch(e){setStatus('❌ '+(e.message||e))}};
 const initReceiver=async()=>{await loadPeer();peer=new Peer(peerId,{config:{iceServers:[{urls:'stun:stun.l.google.com:19302'}]},metadata:{deviceType:'desktop',foxRole:'receiver',foxVersion:'direct-v2'}});peer.on('open',()=>setStatus('🟢 '+t.ready));peer.on('call',c=>{if(c.metadata?.foxScreen)return;pending=c;setStatus(t.incoming);callLabel.textContent=t.accept;callBtn.classList.remove('hidden');startRing()});peer.on('connection',c=>{control=c;c.on('data',m=>{if(m?.type==='direct-translation'){translation.textContent=m.text;speak(m.text)}})});peer.on('error',e=>{stopRing();setStatus('❌ PeerJS: '+(e.type||e.message||'error'))});peer.on('disconnected',()=>{try{peer.reconnect()}catch{}});callBtn.onclick=answer};
 const initCaller=async()=>{await loadPeer();peer=new Peer(undefined,{config:{iceServers:[{urls:'stun:stun.l.google.com:19302'}]},metadata:{deviceType:mobile?'mobile':'desktop',foxRole:'caller',foxVersion:'direct-v2'}});peer.on('open',()=>setStatus(t.offline));callBtn.onclick=async()=>{try{setStatus(t.calling);stream=await ensureMic();control=peer.connect(peerId,{reliable:true,label:'fox-direct-control',metadata:{deviceType:mobile?'mobile':'desktop',foxRole:'caller'}});control.on('open',()=>{});media=peer.call(peerId,stream,{metadata:{foxDirect:true,deviceType:mobile?'mobile':'desktop',foxRole:'caller',source:source.value,target:target.value}});attachCall(media);callBtn.classList.add('hidden');hangup.classList.remove('hidden');startRecognition()}catch(e){setStatus('❌ '+(e.type||e.message||e))}}};
 const stop=()=>{stopRecognition();stopRing();try{media?.close()}catch{};try{control?.close()}catch{};media=null;control=null;try{stream?.getTracks().forEach(t=>t.stop())}catch{};stream=null;hangup.classList.add('hidden');callBtn.classList.remove('hidden');callLabel.textContent=receiver?t.accept:t.call;setStatus(t.offline)};
 hangup.onclick=stop; $('[data-swap]').onclick=()=>{const x=source.value;source.value=target.value;target.value=x;sourceLabel.textContent=labels[source.value];targetLabel.textContent=labels[target.value];if(recognizing){stopRecognition();startRecognition()}};source.onchange=()=>{sourceLabel.textContent=labels[source.value];if(recognizing){stopRecognition();startRecognition()}};target.onchange=()=>targetLabel.textContent=labels[target.value];
 if(desktop&&!receiver){activate.classList.remove('hidden');callBtn.classList.add('hidden');setStatus(t.offline);activate.onclick=()=>{localStorage.setItem('fox.receiver','1');location.reload()}} else {(async()=>{try{if(receiver)await initReceiver();else await initCaller()}catch(e){setStatus('❌ '+(e.message||e))}})()}
}
</script>
