---
import type { Locale } from "../data/content";
interface Props { locale: Locale }
const { locale } = Astro.props;
const labels = {
  de: ["WEITERBILDUNG", "Zertifikate &", "Qualifikationen", "Prüfungsergebnis", "Zertifikat ansehen", "Überprüfen", "Privater Prüfungsnachweis, keine akkreditierte Zertifizierung."],
  en: ["CONTINUING EDUCATION", "Certificates &", "Qualifications", "Exam score", "View certificate", "Verify", "Private exam certificate, not accredited certification."],
  sk: ["ODBORNÉ VZDELÁVANIE", "Certifikáty a", "kvalifikácie", "Výsledok skúšky", "Zobraziť certifikát", "Overiť", "Súkromný doklad o skúške, nie akreditovaná certifikácia."],
  fr: ["FORMATION CONTINUE", "Certificats et", "qualifications", "Résultat", "Voir le certificat", "Vérifier", "Attestation privée, certification non accréditée."],
  hr: ["STRUČNO USAVRŠAVANJE", "Certifikati i", "kvalifikacije", "Rezultat ispita", "Pogledaj certifikat", "Provjeri", "Privatna potvrda o ispitu, neakreditirana certifikacija."],
  pl: ["DOSKONALENIE ZAWODOWE", "Certyfikaty i", "kwalifikacje", "Wynik egzaminu", "Zobacz certyfikat", "Zweryfikuj", "Prywatne potwierdzenie egzaminu, bez akredytacji."],
  it: ["FORMAZIONE CONTINUA", "Certificati e", "qualifiche", "Esito dell’esame", "Vedi certificato", "Verifica", "Attestato privato, non una certificazione accreditata."],
  es: ["FORMACIÓN CONTINUA", "Certificados y", "cualificaciones", "Resultado del examen", "Ver certificado", "Verificar", "Certificado privado de examen, no acreditado."],
  sv: ["FORTBILDNING", "Certifikat och", "kvalifikationer", "Provresultat", "Visa certifikat", "Verifiera", "Privat provintyg, inte ackrediterad certifiering."]
} as const;
const t = labels[locale];
const carouselLabels = {
de:["Grafische Vorschau","MUSTER · KEIN NACHWEIS","Weitere Qualifikation","Vorheriges Zertifikat","Nächstes Zertifikat"],
en:["Graphic preview","SAMPLE · NOT A CREDENTIAL","Future qualification","Previous certificate","Next certificate"],
sk:["Grafická ukážka","VZOR · NIE JE CERTIFIKÁTOM","Ďalšia kvalifikácia","Predchádzajúci certifikát","Ďalší certifikát"],
fr:["Aperçu graphique","EXEMPLE · NON VALIDE","Future qualification","Certificat précédent","Certificat suivant"],
hr:["Grafički primjer","UZORAK · NIJE POTVRDA","Buduća kvalifikacija","Prethodni certifikat","Sljedeći certifikat"],
pl:["Przykład graficzny","WZÓR · NIE JEST CERTYFIKATEM","Przyszła kwalifikacja","Poprzedni certyfikat","Następny certyfikat"],
it:["Anteprima grafica","ESEMPIO · NON VALIDO","Futura qualifica","Certificato precedente","Certificato successivo"],
es:["Vista gráfica","MUESTRA · NO VÁLIDA","Futura cualificación","Certificado anterior","Certificado siguiente"],
sv:["Grafiskt exempel","EXEMPEL · EJ GILTIGT","Framtida kvalifikation","Föregående certifikat","Nästa certifikat"]
} as const;
const c = carouselLabels[locale];
const certificates = [
  {title:"AI Act Fundamentals",issuer:"Regulation AI",date:"2026-11-20",score:"93 %",image:"/images/certificates/ai-act-fundamentals.png",original:"https://www.regulation-ai.eu/de/certificate/?id=AI-2026-C0B609E0",verify:"https://www.regulation-ai.eu/de/verify/?id=AI-2026-C0B609E0"},
  {title:c[2],issuer:c[0],date:"",score:"",image:"",original:"",verify:""}
];
---
<section class="portfolio-section section-wrap certificates-section" id="certifikaty" aria-labelledby="certificates-heading">
  <div class="section-heading split-heading"><div><p class="eyebrow">{t[0]}</p><h2 id="certificates-heading">{t[1]}<br/><span>{t[2]}</span></h2></div></div>
  <div class="certificate-carousel" data-certificate-carousel>
    <div class="certificate-viewport" data-certificate-viewport>
      <div class="certificate-track">
      {certificates.map((cert,i) => <article class:list={["project-card","certificate-card",!cert.original && "certificate-sample"]} data-certificate-slide={i}>
        <div class="project-topline"><span>{cert.issuer}</span><span>{cert.score || "✦"}</span></div>
        {cert.original ? <a class="project-window certificate-window" href={cert.image} target="_blank" rel="noopener noreferrer" aria-label={t[4]+": "+cert.title}><img src={cert.image} alt={cert.title+" – Peter Ferenc"} width="1277" height="898" loading="lazy" decoding="async"/></a> : <div class="project-window certificate-window sample-window"><div class="sample-certificate"><span class="sample-emblem" aria-hidden="true">✦</span><strong>CERTIFICATE</strong><span class="sample-rule"></span><span>{c[1]}</span><span class="sample-rule short"></span></div></div>}
        <div class="project-info certificate-info"><h3>{cert.title}</h3>{cert.original ? <span class="certificate-links"><a href={cert.image} target="_blank" rel="noopener noreferrer">{t[4]} ↗</a><a href={cert.verify} target="_blank" rel="noopener noreferrer" title={t[6]}>{t[5]} ↗</a></span> : <span>{c[0]}</span>}</div>
      </article>)}
      </div>
    </div>
    <div class="certificate-controls" aria-label={t[1]+" "+t[2]}><button class="certificate-arrow" type="button" data-certificate-prev aria-label={c[3]}>‹</button><div class="certificate-dots">{certificates.map((cert,i)=><button type="button" class:list={["certificate-dot",i===0&&"is-active"]} data-certificate-dot={i} aria-label={cert.title} aria-current={i===0?"true":"false"}></button>)}</div><button class="certificate-arrow" type="button" data-certificate-next aria-label={c[4]}>›</button></div>
  </div>
  <p class="certificate-note">{t[6]}</p>
</section>
<style>
.certificates-section{padding-top:0}
.certificate-carousel{margin-top:8px;position:relative}
.certificate-viewport{overflow-x:auto;scrollbar-width:none;scroll-snap-type:x mandatory}
.certificate-viewport::-webkit-scrollbar{display:none}
.certificate-track{display:flex;gap:22px;align-items:stretch}
.certificate-card{flex:0 0 calc((100% - 44px)/3);min-width:0;background:#fff;color:#17202c;scroll-snap-align:start}
.certificate-window{display:block;height:249px;min-height:249px;background:#f4f4f4}
.certificate-window img{display:block;width:100%;height:100%;object-fit:cover;object-position:top}
.certificate-info a{color:inherit;text-decoration:underline;white-space:nowrap}.certificate-info .certificate-links{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:4px 10px}.certificate-info .certificate-links a:first-child{color:#c34d00;font-weight:700}
.certificate-sample{background:#172235;color:#fff}
.sample-window{background:#28364d;display:grid;place-items:center;padding:15px}
.sample-certificate{border:2px solid #d9b875;outline:1px solid #d9b875;outline-offset:-7px;color:#e9d5a9;background:#182437;width:100%;height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;text-align:center;padding:12px;font-family:Georgia,serif}
.sample-emblem{font-size:36px}.sample-certificate strong{font-size:25px;letter-spacing:.1em}.sample-certificate span:last-of-type{font-size:10px}.sample-rule{height:1px;background:#d9b875;width:65%}.sample-rule.short{width:40%}
.certificate-controls{display:flex;justify-content:center;align-items:center;gap:12px;margin-top:18px}
.certificate-arrow{width:42px;height:42px;border-radius:50%;border:1px solid #ddd;background:#fff;font-size:27px;line-height:1;cursor:pointer}
.certificate-arrow:hover{border-color:#f36a0a;color:#f36a0a}
.certificate-dots{display:flex;gap:8px}.certificate-dot{width:9px;height:9px;border:0;border-radius:999px;background:#d6d6d6;padding:0;cursor:pointer;transition:.2s}.certificate-dot.is-active{width:26px;background:#f36a0a}
.certificate-note{font-size:11px;color:#535b67;margin:8px 0 0}
@media(max-width:900px){.certificate-card{flex-basis:calc((100% - 22px)/2)}.certificate-window{height:225px;min-height:225px}}
@media(max-width:640px){.certificate-track{gap:14px}.certificate-card{flex-basis:100%}}
</style>
<script>
document.querySelectorAll<HTMLElement>('[data-certificate-carousel]').forEach(carousel=>{
 const viewport=carousel.querySelector<HTMLElement>('[data-certificate-viewport]');
 const slides=Array.from(carousel.querySelectorAll<HTMLElement>('[data-certificate-slide]'));
 const dots=Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-certificate-dot]'));
 if(!viewport||!slides.length)return;
 let index=0;
 const render=(next:number)=>{index=(next+slides.length)%slides.length;
 if(viewport.scrollWidth<=viewport.clientWidth+2){slides.forEach((slide,i)=>slide.style.order=String((i-index+slides.length)%slides.length));viewport.scrollLeft=0;}
 else{slides.forEach(slide=>slide.style.order="");viewport.scrollTo({left:slides[index].offsetLeft-slides[0].offsetLeft,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});}
 dots.forEach((dot,i)=>{dot.classList.toggle('is-active',i===index);dot.setAttribute('aria-current',String(i===index));});};
 carousel.querySelector('[data-certificate-prev]')?.addEventListener('click',()=>render(index-1));
 carousel.querySelector('[data-certificate-next]')?.addEventListener('click',()=>render(index+1));
 dots.forEach((dot,i)=>dot.addEventListener('click',()=>render(i)));
 viewport.addEventListener('scroll',()=>{if(viewport.scrollWidth<=viewport.clientWidth+2)return;const nearest=slides.reduce((best,slide,i)=>Math.abs(slide.offsetLeft-slides[0].offsetLeft-viewport.scrollLeft)<Math.abs(slides[best].offsetLeft-slides[0].offsetLeft-viewport.scrollLeft)?i:best,0);index=nearest;dots.forEach((dot,i)=>{dot.classList.toggle('is-active',i===index);dot.setAttribute('aria-current',String(i===index));});},{passive:true});
 window.addEventListener('resize',()=>render(index));
});
</script>
