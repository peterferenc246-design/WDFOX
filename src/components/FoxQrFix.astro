<script is:inline>
(() => {
  const loadQr = () => new Promise((resolve, reject) => {
    if (window.QRCode) return resolve(window.QRCode);
    const existing = document.querySelector('script[data-fox-qrcode]');
    if (existing) {
      existing.addEventListener('load', () => resolve(window.QRCode), { once: true });
      existing.addEventListener('error', reject, { once: true });
      return;
    }
    const s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
    s.async = true;
    s.dataset.foxQrcode = '1';
    s.onload = () => resolve(window.QRCode);
    s.onerror = reject;
    document.head.appendChild(s);
  });

  const render = async () => {
    const box = document.querySelector('[data-qr]');
    const link = document.querySelector('[data-link]');
    const invite = document.querySelector('[data-invite]');
    if (!box || !link || !link.value) return;
    if (box.dataset.foxQrValue === link.value && box.children.length) return;
    try {
      const QRCode = await loadQr();
      box.innerHTML = '';
      new QRCode(box, {
        text: link.value,
        width: 210,
        height: 210,
        correctLevel: QRCode.CorrectLevel.M
      });
      box.dataset.foxQrValue = link.value;
      invite?.classList.remove('hidden');
    } catch (e) {
      box.textContent = 'QR sa nepodarilo načítať.';
      console.warn('FOX QR error', e);
    }
  };

  const boot = () => {
    render();
    const root = document.querySelector('[data-fox-live]');
    if (root && !root.dataset.foxQrObserver) {
      root.dataset.foxQrObserver = '1';
      new MutationObserver(() => render()).observe(root, { subtree: true, childList: true, attributes: true });
    }
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, { once: true });
  else boot();
  setInterval(render, 500);
})();
</script>
