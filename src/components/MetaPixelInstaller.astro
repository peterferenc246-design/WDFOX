---
const locale = Astro.props.locale ?? "de";
const labels = {
  de:{kicker:"META PIXEL",title:"Meta Pixel Tester installieren",text:"Prüfe Meta Pixel direkt im Browser. Die offizielle Meta-Erweiterung heißt heute Meta Ads Data Advisor und war früher Meta Pixel Helper.",button:"Zu Chrome – installieren →",note:"Offiziell von Meta · kostenlos · Chrome"},
  en:{kicker:"META PIXEL",title:"Install the Meta Pixel tester",text:"Check Meta Pixel directly in your browser. Meta’s official extension is now called Meta Ads Data Advisor, formerly Meta Pixel Helper.",button:"Open Chrome – install →",note:"Official Meta extension · free · Chrome"},
  sk:{kicker:"META PIXEL",title:"Nainštalovať Meta Pixel tester",text:"Skontroluj Meta Pixel priamo v prehliadači. Oficiálne rozšírenie Meta sa dnes volá Meta Ads Data Advisor, predtým Meta Pixel Helper.",button:"Otvoriť Chrome – nainštalovať →",note:"Oficiálne Meta rozšírenie · zdarma · Chrome"},
  fr:{kicker:"META PIXEL",title:"Installer le testeur Meta Pixel",text:"Vérifiez Meta Pixel directement dans votre navigateur. L’extension officielle de Meta s’appelle désormais Meta Ads Data Advisor, anciennement Meta Pixel Helper.",button:"Ouvrir Chrome – installer →",note:"Extension officielle Meta · gratuite · Chrome"},
  hr:{kicker:"META PIXEL",title:"Instaliraj Meta Pixel tester",text:"Provjeri Meta Pixel izravno u pregledniku. Službeno Meta proširenje sada se zove Meta Ads Data Advisor, prije Meta Pixel Helper.",button:"Otvori Chrome – instaliraj →",note:"Službeno Meta proširenje · besplatno · Chrome"},
  pl:{kicker:"META PIXEL",title:"Zainstaluj tester Meta Pixel",text:"Sprawdź Meta Pixel bezpośrednio w przeglądarce. Oficjalne rozszerzenie Meta nazywa się teraz Meta Ads Data Advisor, wcześniej Meta Pixel Helper.",button:"Otwórz Chrome – zainstaluj →",note:"Oficjalne Meta rozszerzenie · bezpłatne · Chrome"},
  it:{kicker:"META PIXEL",title:"Installa il tester Meta Pixel",text:"Controlla Meta Pixel direttamente nel browser. L’estensione ufficiale di Meta ora si chiama Meta Ads Data Advisor, in precedenza Meta Pixel Helper.",button:"Apri Chrome – installa →",note:"Estensione ufficiale Meta · gratuita · Chrome"},
  es:{kicker:"META PIXEL",title:"Instala el tester de Meta Pixel",text:"Comprueba Meta Pixel directamente en el navegador. La extensión oficial de Meta ahora se llama Meta Ads Data Advisor, antes Meta Pixel Helper.",button:"Abrir Chrome – instalar →",note:"Extensión oficial de Meta · gratuita · Chrome"},
  sv:{kicker:"META PIXEL",title:"Installera Meta Pixel-testaren",text:"Kontrollera Meta Pixel direkt i webbläsaren. Metas officiella tillägg heter nu Meta Ads Data Advisor, tidigare Meta Pixel Helper.",button:"Öppna Chrome – installera →",note:"Officiellt Meta-tillägg · gratis · Chrome"}
} as const;
const t = labels[locale as keyof typeof labels] ?? labels.de;
const chromeUrl = "https://chromewebstore.google.com/detail/meta-ads-data-advisor/fdgfkebogiimcoedlicjlajpkdmockpc";
---
<section class="pixel-installer" id="meta-pixel-installer" aria-labelledby="pixel-installer-title">
  <div class="pixel-installer-copy">
    <span class="pixel-installer-kicker">✦ {t.kicker}</span>
    <h2 id="pixel-installer-title">{t.title}</h2>
    <p>{t.text}</p>
    <small>{t.note}</small>
  </div>
  <a class="pixel-installer-button" href={chromeUrl} target="_blank" rel="noopener noreferrer">{t.button}</a>
</section>
<style>
.pixel-installer{width:min(1180px,calc(100% - 40px));margin:26px auto 0;padding:22px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px;background:#0f1012;color:#fff;border:1px solid #2d3138;border-left:5px solid #f36a0a;border-radius:16px;box-sizing:border-box}.pixel-installer-copy{display:flex;flex-direction:column;gap:6px}.pixel-installer-kicker{font-size:11px;font-weight:900;letter-spacing:.13em;color:#ff7a22}.pixel-installer h2{margin:0;font-size:clamp(19px,2vw,27px);line-height:1.15}.pixel-installer p{margin:0;color:#aeb1b7;font-size:13px;line-height:1.55;max-width:760px}.pixel-installer small{color:#737983;font-size:11px}.pixel-installer-button{display:inline-flex;align-items:center;justify-content:center;white-space:nowrap;background:#f36a0a;color:#fff;text-decoration:none;font-weight:900;font-size:13px;padding:14px 18px;border-radius:11px;box-shadow:0 10px 26px rgba(243,106,10,.18)}.pixel-installer-button:hover{filter:brightness(1.08)}@media(max-width:700px){.pixel-installer{width:calc(100% - 24px);flex-direction:column;align-items:stretch}.pixel-installer-button{width:100%;box-sizing:border-box}}
</style>

<script is:inline>
(() => {
  // FOX screen-share visibility fix.
  const revealRemoteScreen = () => {
    document.querySelectorAll('[data-fox-remote-screen]').forEach((video) => {
      if (video.srcObject) {
        video.style.display = 'block';
        video.style.visibility = 'visible';
        video.removeAttribute('hidden');
      }
    });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', revealRemoteScreen, { once: true });
  else revealRemoteScreen();
  new MutationObserver(revealRemoteScreen).observe(document.documentElement, { childList: true, subtree: true });
  setInterval(revealRemoteScreen, 500);

  // FOX consent-based, bidirectional screen sharing.
  // Important: a screen is NEVER captured just because the other participant
  // requests it. The owner must explicitly approve the request first.
  const state = { peer:null, remoteId:null, requestPending:false, requestId:null, stream:null };
  const lang = () => (document.documentElement.lang || 'sk').slice(0,2).toLowerCase();
  const text = (key) => {
    const de = { request:'Der Partner möchte Ihren Bildschirm sehen.', allow:'ERLAUBEN', deny:'ABLEHNEN', sent:'Bildschirmfreigabe angefragt. Warte auf Zustimmung…', denied:'Bildschirmfreigabe abgelehnt.', sharing:'Ihr Bildschirm wird für den Partner freigegeben.', stopped:'Bildschirmfreigabe beendet.', requested:'Der Partner hat eine Bildschirmfreigabe angefragt.', error:'Bildschirmfreigabe fehlgeschlagen.' };
    const en = { request:'The partner wants to see your screen.', allow:'ALLOW', deny:'DENY', sent:'Screen sharing requested. Waiting for approval…', denied:'Screen sharing denied.', sharing:'Your screen is being shared with the partner.', stopped:'Screen sharing stopped.', requested:'The partner requested screen sharing.', error:'Screen sharing failed.' };
    const sk = { request:'Partner chce vidieť tvoju obrazovku.', allow:'POVOLIŤ', deny:'ZAMIETNUŤ', sent:'Požiadavka odoslaná. Čakám na povolenie partnera…', denied:'Zdieľanie obrazovky bolo zamietnuté.', sharing:'Tvoja obrazovka sa zdieľa s partnerom.', stopped:'Zdieľanie obrazovky zastavené.', requested:'Partner požiadal o zdieľanie tvojej obrazovky.', error:'Zdieľanie obrazovky sa nepodarilo.' };
    return (lang()==='de'?de:lang()==='en'?en:sk)[key] || sk[key];
  };
  const getPeer = () => window.__FOX_PEER__ || state.peer;
  const getRemoteId = () => state.remoteId || window.__FOX_REMOTE_ID__ || new URLSearchParams(location.search).get('foxPeer');
  const getControl = () => {
    const peer = getPeer();
    const rid = getRemoteId();
    if (!peer || !rid) return null;
    const list = peer.connections?.[rid] || [];
    return list.find(c => c?.type === 'data' && c?.open && (c.label === 'fox-control' || c.metadata?.foxControl)) || list.find(c => c?.type === 'data' && c?.open) || null;
  };
  const sendControl = (message) => {
    const c = getControl();
    if (!c) return false;
    try { c.send(message); return true; } catch { return false; }
  };
  const stopLocalShare = () => {
    state.stream?.getTracks().forEach(t => t.stop());
    state.stream = null;
    const local = document.querySelector('[data-local-screen]');
    if (local) local.srcObject = null;
    document.querySelector('[data-local-screen-status]')?.replaceChildren();
    sendControl({ type:'screen-share-stopped', requestId:state.requestId });
  };
  const makeDialog = () => {
    if (document.querySelector('[data-fox-screen-consent]')) return document.querySelector('[data-fox-screen-consent]');
    const box = document.createElement('div');
    box.dataset.foxScreenConsent = 'true';
    box.innerHTML = `<div class="fox-consent-backdrop"><div class="fox-consent-card" role="dialog" aria-modal="true"><div class="fox-consent-title">🖥️ FOX SCREEN</div><p data-fox-consent-text></p><div class="fox-consent-actions"><button type="button" data-fox-consent-deny>${text('deny')}</button><button type="button" data-fox-consent-allow>${text('allow')}</button></div></div></div>`;
    document.body.appendChild(box);
    return box;
  };
  const showRequest = (requestId, remoteId) => {
    state.requestId = requestId; state.remoteId = remoteId; state.requestPending = true;
    const box = makeDialog();
    box.querySelector('[data-fox-consent-text]').textContent = text('request');
    box.style.display = 'block';
    box.querySelector('[data-fox-consent-deny]').onclick = () => {
      sendControl({ type:'screen-response', requestId, approved:false });
      box.style.display='none'; state.requestPending=false;
    };
    box.querySelector('[data-fox-consent-allow]').onclick = async () => {
      box.style.display='none'; state.requestPending=false;
      try {
        if (!navigator.mediaDevices?.getDisplayMedia) throw Error('getDisplayMedia');
        const stream = await navigator.mediaDevices.getDisplayMedia({ video:{ frameRate:{ ideal:15, max:30 } }, audio:false });
        state.stream = stream;
        const local = document.querySelector('[data-local-screen]');
        if (local) { local.srcObject = stream; local.play().catch(()=>{}); }
        document.querySelector('[data-local-screen-status]')?.replaceChildren(document.createTextNode('● LIVE'));
        const peer = getPeer();
        const call = peer?.call?.(remoteId, stream, { metadata:{ foxScreen:true, requestId, consent:true } });
        if (!call) throw Error('PeerJS');
        call.on?.('close', stopLocalShare);
        call.on?.('error', () => {});
        sendControl({ type:'screen-response', requestId, approved:true });
        const track = stream.getVideoTracks()[0];
        track?.addEventListener('ended', stopLocalShare, { once:true });
      } catch (e) {
        sendControl({ type:'screen-response', requestId, approved:false, error:e?.name || 'error' });
      }
    };
  };
  const requestPartnerScreen = () => {
    const rid = getRemoteId();
    if (!getPeer() || !rid) { document.querySelector('[data-comm-status]')?.replaceChildren(document.createTextNode('Najprv vytvorte aktívne spojenie.')); return; }
    const requestId = `${Date.now()}-${Math.random().toString(36).slice(2)}`;
    state.requestId = requestId; state.remoteId = rid; state.requestPending = true;
    if (sendControl({ type:'screen-request', requestId, from: getPeer()?.id || '' })) {
      document.querySelector('[data-comm-status]')?.replaceChildren(document.createTextNode(text('sent')));
    } else {
      state.requestPending=false;
      document.querySelector('[data-comm-status]')?.replaceChildren(document.createTextNode('Spojenie pre požiadavku nie je pripravené.'));
    }
  };
  const attachControlListener = () => {
    const peer = getPeer();
    if (!peer) return;
    state.peer = peer;
    const rid = getRemoteId();
    if (rid) state.remoteId = rid;
    const connections = peer.connections || {};
    Object.keys(connections).forEach(id => {
      (connections[id] || []).forEach(c => {
        if (!c || c.__foxScreenControlAttached || c.type !== 'data') return;
        c.__foxScreenControlAttached = true;
        c.on?.('data', m => {
          if (!m || typeof m !== 'object') return;
          if (m.type === 'screen-request') showRequest(m.requestId, c.peer);
          if (m.type === 'screen-response') {
            state.requestPending=false;
            document.querySelector('[data-comm-status]')?.replaceChildren(document.createTextNode(m.approved ? text('sharing') : text('denied')));
          }
          if (m.type === 'screen-share-stopped') {
            const remote = document.querySelector('[data-remote-screen]');
            if (remote) remote.srcObject=null;
            document.querySelector('[data-remote-screen-status]')?.replaceChildren();
          }
        });
      });
    });
  };
  const installPeerHook = () => {
    const peer = getPeer();
    if (!peer || peer.__foxConsentHooked) return;
    peer.__foxConsentHooked = true;
    state.peer = peer;
    const originalOn = peer.on.bind(peer);
    peer.on = (event, handler) => {
      if (event === 'connection') {
        return originalOn(event, c => { state.remoteId = c?.peer || state.remoteId; setTimeout(attachControlListener, 0); return handler(c); });
      }
      return originalOn(event, handler);
    };
    setTimeout(attachControlListener, 100);
  };
  const installUi = () => {
    const button = document.querySelector('[data-screen]');
    if (!button || button.__foxConsentButton) return;
    button.__foxConsentButton = true;
    const label = button.querySelector('[data-screen-label]');
    if (label) label.textContent = lang()==='de' ? 'BILDSCHIRM DES PARTNERS ANFORDERN' : lang()==='en' ? 'REQUEST PARTNER SCREEN' : 'POŽIADAŤ O OBRAZOVKU PARTNERA';
    button.title = lang()==='de' ? 'Bildschirm des Partners anfordern' : lang()==='en' ? 'Request partner screen' : 'Požiadať o obrazovku partnera';
    document.addEventListener('click', e => {
      const target = e.target?.closest?.('[data-screen]');
      if (!target) return;
      e.preventDefault(); e.stopPropagation(); e.stopImmediatePropagation();
      requestPartnerScreen();
    }, true);
  };
  const boot = () => { installUi(); installPeerHook(); attachControlListener(); };
  boot();
  setInterval(boot, 500);
})();
</script>

<style>
.fox-consent-backdrop{position:fixed;inset:0;z-index:99999;display:grid;place-items:center;padding:20px;background:rgba(10,14,24,.58);backdrop-filter:blur(4px)}
.fox-consent-card{width:min(440px,100%);box-sizing:border-box;background:#fff;border-radius:20px;padding:24px;box-shadow:0 24px 80px rgba(0,0,0,.3);border:1px solid #eee}
.fox-consent-title{font-size:13px;font-weight:900;color:#f36a0a;letter-spacing:.08em;margin-bottom:12px}
.fox-consent-card p{margin:0;color:#172033;font-size:16px;line-height:1.5;font-weight:700}
.fox-consent-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:20px}
.fox-consent-actions button{border:0;border-radius:12px;padding:13px;font-weight:900;cursor:pointer}
.fox-consent-actions button[data-fox-consent-deny]{background:#eef0f3;color:#172033}
.fox-consent-actions button[data-fox-consent-allow]{background:#18a957;color:#fff}
</style>
