<div class="fox-call-controls" data-fox-call-controls hidden>
  <button type="button" class="fox-mic" data-fox-mic>🎙 <span data-fox-mic-label>VYPNÚŤ MIKROFÓN</span></button>
  <button type="button" class="fox-hangup" data-fox-hangup>📵 <span data-hangup-label>UKONČIŤ HOVOR</span></button>
</div>

<style>
  .fox-call-controls{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0 0}
  .fox-call-controls[hidden]{display:none!important}
  .fox-call-controls button{width:100%;min-height:50px;border:0;border-radius:999px;padding:13px 16px;font-size:13px;font-weight:900;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
  .fox-mic{background:#eef0f3;color:#172033;box-shadow:0 8px 20px rgba(0,0,0,.06)}
  .fox-mic.is-muted{background:#171b25;color:#fff}
  .fox-hangup{background:#d92d20;color:#fff;box-shadow:0 10px 24px rgba(217,45,32,.22)}
  .fox-call-controls button:active{transform:translateY(1px)}
  @media(max-width:650px){.fox-call-controls{grid-template-columns:1fr}.fox-call-controls button{min-height:54px;font-size:14px}}
</style>

<script is:inline>
(() => {
  try {
    if (navigator.mediaDevices && !navigator.mediaDevices.__foxWrapped) {
      const original = navigator.mediaDevices.getUserMedia.bind(navigator.mediaDevices);
      navigator.mediaDevices.getUserMedia = async (...args) => {
        const stream = await original(...args);
        window.__foxLocalStream = stream;
        return stream;
      };
      navigator.mediaDevices.__foxWrapped = true;
    }
  } catch {}

  const setup = () => {
    const root = document.querySelector('[data-fox-live]');
    const wrap = document.querySelector('[data-fox-call-controls]');
    const mic = document.querySelector('[data-fox-mic]');
    const micLabel = document.querySelector('[data-fox-mic-label]');
    const hangup = document.querySelector('[data-fox-hangup]');
    const hangupLabel = document.querySelector('[data-hangup-label]');
    if (!root || !wrap || !mic || !micLabel || !hangup || !hangupLabel || wrap.dataset.ready === '1') return;
    wrap.dataset.ready = '1';

    const lang = (location.pathname.match(/^\/([^/]+)/)?.[1] || 'en').toLowerCase();
    const text = {
      micOn: lang === 'de' ? 'MIKROFON EINSCHALTEN' : lang === 'sk' ? 'ZAPNÚŤ MIKROFÓN' : 'TURN MICROPHONE ON',
      micOff: lang === 'de' ? 'MIKROFON AUSSCHALTEN' : lang === 'sk' ? 'VYPNÚŤ MIKROFÓN' : 'TURN MICROPHONE OFF',
      hangup: lang === 'de' ? 'ANRUF BEENDEN' : lang === 'sk' ? 'UKONČIŤ HOVOR' : 'END CALL',
      ending: lang === 'de' ? 'ANRUF WIRD BEENDET…' : lang === 'sk' ? 'HOVOR SA UKONČUJE…' : 'ENDING CALL…'
    };
    hangupLabel.textContent = text.hangup;

    const getStream = () => window.__foxLocalStream || null;
    const isCallMode = () => root.classList.contains('is-call-mode');
    const isLive = () => {
      const panel = root.querySelector('[data-communicator]');
      const status = panel?.querySelector('[data-comm-status]')?.textContent || '';
      return /HOVOR JE AKTÍVNY|CALL IS ACTIVE|ANRUF IST AKTIV|PRICHÁDZAJÚCI HOVOR|INCOMING CALL|EINGEHENDER ANRUF/i.test(status);
    };

    const sync = () => {
      const show = isCallMode() && isLive();
      wrap.hidden = !show;
      const track = getStream()?.getAudioTracks?.()[0];
      if (track) {
        mic.classList.toggle('is-muted', !track.enabled);
        micLabel.textContent = track.enabled ? text.micOff : text.micOn;
      }
    };

    mic.addEventListener('click', () => {
      const track = getStream()?.getAudioTracks?.()[0];
      if (!track) return;
      track.enabled = !track.enabled;
      const muted = !track.enabled;
      mic.classList.toggle('is-muted', muted);
      micLabel.textContent = muted ? text.micOn : text.micOff;

      const record = root.querySelector('[data-record]');
      if (muted && record?.classList.contains('recording')) record.click();
      else if (!muted && isLive() && !record?.classList.contains('recording')) record?.click();
    });

    hangup.addEventListener('click', () => {
      if (!isLive()) return;
      hangup.disabled = true;
      hangupLabel.textContent = text.ending;

      // Let the FOX LIVE TRANSLATOR send the hangup packet through the
      // existing PeerJS data connection before closing/reloading this device.
      if (typeof window.__foxEndCall === 'function') {
        try {
          window.__foxEndCall();
          return;
        } catch {}
      }

      try { getStream()?.getTracks?.().forEach(track => track.stop()); } catch {}
      window.__foxLocalStream = null;
      setTimeout(() => location.reload(), 150);
    });

    const observer = new MutationObserver(sync);
    observer.observe(root, {subtree:true, childList:true, characterData:true, attributes:true, attributeFilter:['class','disabled']});
    sync();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup, {once:true});
  else setup();
  setTimeout(setup, 200);
  setTimeout(setup, 700);
  setTimeout(setup, 1500);
  setTimeout(setup, 2500);
})();
</script>
