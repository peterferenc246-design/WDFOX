---
interface Props { locale: string }
const { locale } = Astro.props;
---
<script define:vars={{ locale }}>
(() => {
  const install = () => {
    const root = document.querySelector('[data-fox-live]');
    if (!root || root.dataset.foxGuardInstalled === '1') return;
    root.dataset.foxGuardInstalled = '1';

    const callButton = root.querySelector('[data-call]');
    const modeNote = root.querySelector('[data-mode-note]');
    const commStatus = root.querySelector('[data-comm-status]');
    if (!callButton) return;

    const lang = String(locale || document.documentElement.lang || 'en').slice(0, 2).toLowerCase();
    const notes = {
      de: { translator: 'Sprachübersetzung und Sprachausgabe.', communicator: 'Live-Kommunikation mit Übersetzung.', peer: '❌ Partnergerät nicht verfügbar.' },
      sk: { translator: 'Hlasový preklad a hlasový výstup.', communicator: 'Živá komunikácia s prekladom.', peer: '❌ Partnerské zariadenie nie je dostupné.' },
      en: { translator: 'Voice translation and spoken output.', communicator: 'Live communication with translation.', peer: '❌ Partner device is not available.' }
    };
    const t = notes[lang] || notes.en;

    const hasRealPeer = () => {
      const peerId = new URLSearchParams(window.location.search).get('foxPeer');
      return !!peerId && peerId.trim().length > 0;
    };

    const sync = () => {
      // A caller may only call a partner whose real PeerJS ID came from an invitation URL.
      callButton.disabled = !hasRealPeer();

      if (modeNote) {
        const communicator = root.querySelector('[data-mode="communicator"]')?.classList.contains('is-active');
        const wanted = communicator ? t.communicator : t.translator;
        if (!modeNote.textContent || /Hlasový preklad|Živá komunikácia|Sprachübersetzung|Live-Kommunikation|Voice translation|Live communication/i.test(modeNote.textContent)) {
          modeNote.textContent = wanted;
        }
      }

      if (commStatus && /peer-unavailable/i.test(commStatus.textContent || '')) {
        commStatus.textContent = t.peer;
      }
    };

    sync();
    const observer = new MutationObserver(sync);
    observer.observe(root, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['class', 'disabled'] });
    window.addEventListener('popstate', sync);
    window.addEventListener('hashchange', sync);
    setInterval(sync, 1000);
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', install, { once: true });
  else install();
  setTimeout(install, 100);
  setTimeout(install, 500);
})();
</script>
