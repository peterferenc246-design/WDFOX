<script>
(() => {
  const root = document.querySelector('[data-fox-live]') || document.querySelector('[data-app]');
  if (!root || window.__foxGeminiAudioBridge) return;
  window.__foxGeminiAudioBridge = true;

  const MODEL = 'gemini-3.5-live-translate-preview';
  const TOKEN_URL = 'https://wdfox.vercel.app/api/live-token';
  const WS_BASE = 'wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContentConstrained';
  const hasRemotePeer = new URLSearchParams(location.search).has('foxPeer');
  const localeNames = {de:'German',sk:'Slovak',en:'English',fr:'French',it:'Italian',pl:'Polish',es:'Spanish',sv:'Swedish',hr:'Croatian',cs:'Czech',nl:'Dutch',da:'Danish',fi:'Finnish',et:'Estonian',el:'Greek',hu:'Hungarian',ga:'Irish',lv:'Latvian',lt:'Lithuanian',mt:'Maltese',pt:'Portuguese',ro:'Romanian',sl:'Slovenian',bg:'Bulgarian'};
  const targetCodes = {pt:'pt-PT'};

  const q = (s) => root.querySelector(s);
  const status = q('[data-comm-status]') || q('[data-status]');
  const remoteAudio = q('[data-remote-audio]') || q('[data-audio-el]');
  const transcript = q('[data-transcript]');
  const translation = q('[data-translation]');
  const sourceSelect = q('[data-source]');
  const targetSelect = q('[data-target]');
  const playButton = q('[data-play]');
  const audioButton = q('[data-audio]');

  let socket = null;
  let socketReady = false;
  let captureContext = null;
  let captureSource = null;
  let captureProcessor = null;
  let captureSink = null;
  let outputContext = null;
  let nextPlayTime = 0;
  let activeStream = null;
  let activeTarget = '';
  let generation = 0;
  let reconnectTimer = null;
  let inputHistory = '';
  let outputHistory = '';
  let inputCurrent = '';
  let outputCurrent = '';
  let quotaBlocked = false;

  const setStatus = (text) => { if (status && text) status.textContent = text; };
  const stream = () => remoteAudio?.srcObject || null;
  const connected = () => !!stream()?.getAudioTracks?.().some(track => track.readyState === 'live');
  const targetLanguage = () => {
    const selectedSource = sourceSelect?.value || 'sk';
    const code = selectedSource;
    return targetCodes[code] || code;
  };

  function renderTranscripts() {
    const left = [inputHistory, inputCurrent].filter(Boolean).join(inputHistory && inputCurrent ? '\n' : '');
    const right = [outputHistory, outputCurrent].filter(Boolean).join(outputHistory && outputCurrent ? '\n' : '');
    if (left && transcript) transcript.textContent = left;
    if (right && translation) translation.textContent = right;
    if (right && playButton) playButton.disabled = false;
  }

  function mergePiece(current, piece) {
    piece = String(piece || '').trim();
    if (!piece) return current;
    if (!current) return piece;
    if (piece === current || current.endsWith(piece)) return current;
    if (piece.startsWith(current)) return piece;
    const spacer = /[\s,.;:!?]$/.test(current) || /^[,.;:!?]/.test(piece) ? '' : ' ';
    return current + spacer + piece;
  }

  function finalizeTurn() {
    if (inputCurrent) inputHistory = [inputHistory, inputCurrent].filter(Boolean).join(inputHistory ? '\n' : '').slice(-5000);
    if (outputCurrent) outputHistory = [outputHistory, outputCurrent].filter(Boolean).join(outputHistory ? '\n' : '').slice(-5000);
    inputCurrent = '';
    outputCurrent = '';
    renderTranscripts();
  }

  function base64FromBytes(bytes) {
    let binary = '';
    const step = 0x8000;
    for (let i = 0; i < bytes.length; i += step) {
      binary += String.fromCharCode(...bytes.subarray(i, Math.min(i + step, bytes.length)));
    }
    return btoa(binary);
  }

  function pcm16Base64(float32, inputRate) {
    const outputRate = 16000;
    let samples = float32;
    if (inputRate !== outputRate) {
      const ratio = inputRate / outputRate;
      const length = Math.max(1, Math.round(float32.length / ratio));
      const down = new Float32Array(length);
      let sourceOffset = 0;
      for (let i = 0; i < length; i++) {
        const nextOffset = Math.min(float32.length, Math.round((i + 1) * ratio));
        let sum = 0;
        let count = 0;
        for (; sourceOffset < nextOffset; sourceOffset++) {
          sum += float32[sourceOffset];
          count++;
        }
        down[i] = count ? sum / count : 0;
      }
      samples = down;
    }
    const pcm = new Int16Array(samples.length);
    for (let i = 0; i < samples.length; i++) {
      const s = Math.max(-1, Math.min(1, samples[i]));
      pcm[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
    }
    return base64FromBytes(new Uint8Array(pcm.buffer));
  }

  function ensureOutputContext() {
    if (!outputContext) {
      const AudioCtx = window.AudioContext || window.webkitAudioContext;
      if (!AudioCtx) return null;
      outputContext = new AudioCtx();
      nextPlayTime = outputContext.currentTime;
    }
    if (outputContext.state === 'suspended') outputContext.resume().catch(() => {});
    return outputContext;
  }

  function playTranslatedPcm(base64, mimeType) {
    const ctx = ensureOutputContext();
    if (!ctx || !base64) return;
    const binary = atob(base64);
    const bytes = new Uint8Array(binary.length);
    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    const frames = Math.floor(bytes.length / 2);
    if (!frames) return;
    const samples = new Float32Array(frames);
    const view = new DataView(bytes.buffer);
    for (let i = 0; i < frames; i++) samples[i] = view.getInt16(i * 2, true) / 32768;
    const match = String(mimeType || '').match(/rate=(\d+)/i);
    const rate = match ? Number(match[1]) : 24000;
    const buffer = ctx.createBuffer(1, samples.length, rate);
    buffer.copyToChannel(samples, 0);
    const node = ctx.createBufferSource();
    node.buffer = buffer;
    node.connect(ctx.destination);
    const startAt = Math.max(ctx.currentTime + 0.02, nextPlayTime);
    node.start(startAt);
    nextPlayTime = startAt + buffer.duration;
  }

  function stopCapture() {
    try { if (captureProcessor) captureProcessor.onaudioprocess = null; } catch {}
    try { captureSource?.disconnect(); } catch {}
    try { captureProcessor?.disconnect(); } catch {}
    try { captureSink?.disconnect(); } catch {}
    try { captureContext?.close(); } catch {}
    captureContext = captureSource = captureProcessor = captureSink = null;
  }

  function startCapture(mediaStream) {
    stopCapture();
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtx) {
      setStatus('❌ GEMINI LIVE: Web Audio API nie je dostupné');
      return;
    }
    captureContext = new AudioCtx();
    captureSource = captureContext.createMediaStreamSource(mediaStream);
    captureProcessor = captureContext.createScriptProcessor(4096, 1, 1);
    captureSink = captureContext.createGain();
    captureSink.gain.value = 0;
    captureSource.connect(captureProcessor);
    captureProcessor.connect(captureSink);
    captureSink.connect(captureContext.destination);
    captureContext.resume().catch(() => {});

    captureProcessor.onaudioprocess = (event) => {
      if (!socketReady || !socket || socket.readyState !== WebSocket.OPEN) return;
      const input = event.inputBuffer.getChannelData(0);
      let energy = 0;
      for (let i = 0; i < input.length; i += 32) energy += input[i] * input[i];
      const rms = Math.sqrt(energy / Math.ceil(input.length / 32));
      if (rms < 0.0012) return;
      const data = pcm16Base64(input, captureContext.sampleRate);
      socket.send(JSON.stringify({
        realtimeInput:{
          audio:{data,mimeType:'audio/pcm;rate=16000'}
        }
      }));
    };
  }

  function closeLive(reason = '') {
    generation++;
    socketReady = false;
    if (reconnectTimer) clearTimeout(reconnectTimer);
    reconnectTimer = null;
    try { socket?.close(1000, reason.slice(0, 100)); } catch {}
    socket = null;
    stopCapture();
    activeStream = null;
    activeTarget = '';
  }

  function scheduleReconnect(delay = 4000) {
    if (quotaBlocked || reconnectTimer) return;
    reconnectTimer = setTimeout(() => {
      reconnectTimer = null;
      tick();
    }, delay);
  }

  async function connectLive(mediaStream, target) {
    const myGeneration = ++generation;
    activeStream = mediaStream;
    activeTarget = target;
    socketReady = false;
    setStatus(`GEMINI LIVE: pripájam preklad → ${localeNames[target] || target}…`);

    try {
      const tokenResponse = await fetch(TOKEN_URL, {
        method:'POST',
        headers:{'Content-Type':'application/json',Accept:'application/json'},
        body:JSON.stringify({target}),
        cache:'no-store'
      });
      const tokenData = await tokenResponse.json().catch(() => ({}));
      if (!tokenResponse.ok || !tokenData?.token) throw new Error(tokenData?.error || `Token HTTP ${tokenResponse.status}`);
      if (myGeneration !== generation) return;

      const ws = new WebSocket(`${WS_BASE}?access_token=${encodeURIComponent(tokenData.token)}`);
      socket = ws;

      ws.onopen = () => {
        if (myGeneration !== generation) return ws.close();
        ws.send(JSON.stringify({
          setup:{
            model:`models/${MODEL}`,
            generationConfig:{
              responseModalities:['AUDIO'],
              translationConfig:{targetLanguageCode:target,echoTargetLanguage:false}
            },
            inputAudioTranscription:{},
            outputAudioTranscription:{}
          }
        }));
      };

      ws.onmessage = (event) => {
        if (myGeneration !== generation) return;
        let message;
        try { message = JSON.parse(event.data); } catch { return; }

        if (message?.setupComplete) {
          socketReady = true;
          quotaBlocked = false;
          startCapture(mediaStream);
          ensureOutputContext();
          setStatus(`🟢 GEMINI LIVE ✓ online → ${localeNames[target] || target}`);
          return;
        }

        if (message?.error) {
          const msg = String(message.error?.message || message.error || 'Gemini Live error');
          if (/429|resource_exhausted|quota/i.test(msg)) quotaBlocked = true;
          setStatus(`❌ GEMINI LIVE: ${msg}`);
          return;
        }

        const content = message?.serverContent;
        if (!content) return;
        if (content.inputTranscription?.text) {
          inputCurrent = mergePiece(inputCurrent, content.inputTranscription.text);
          renderTranscripts();
        }
        if (content.outputTranscription?.text) {
          outputCurrent = mergePiece(outputCurrent, content.outputTranscription.text);
          renderTranscripts();
        }
        const parts = content.modelTurn?.parts || [];
        for (const part of parts) {
          const inline = part?.inlineData;
          if (inline?.data) playTranslatedPcm(inline.data, inline.mimeType);
        }
        if (content.turnComplete) {
          finalizeTurn();
          setStatus(`🟢 GEMINI LIVE ✓ online → ${localeNames[target] || target}`);
        }
      };

      ws.onerror = () => {
        if (myGeneration !== generation) return;
        setStatus('❌ GEMINI LIVE: WebSocket spojenie zlyhalo');
      };

      ws.onclose = (event) => {
        if (myGeneration !== generation) return;
        socketReady = false;
        stopCapture();
        socket = null;
        activeStream = null;
        activeTarget = '';
        if (!quotaBlocked && connected()) {
          setStatus(`GEMINI LIVE: spojenie sa obnovuje…${event?.reason ? ' ' + event.reason : ''}`);
          scheduleReconnect(3500);
        }
      };
    } catch (error) {
      if (myGeneration !== generation) return;
      const msg = error?.message || 'pripojenie zlyhalo';
      if (/429|resource_exhausted|quota/i.test(msg)) quotaBlocked = true;
      setStatus(`❌ GEMINI LIVE: ${msg}`);
      activeStream = null;
      activeTarget = '';
      scheduleReconnect(5000);
    }
  }

  function tick() {
    const currentStream = stream();
    if (!connected() || !currentStream) {
      if (socket || captureContext) closeLive('remote audio ended');
      return;
    }
    if (sourceSelect?.value && targetSelect?.value && sourceSelect.value === targetSelect.value) {
      if (socket || captureContext) closeLive('same language');
      setStatus('🟢 PRIAMY HOVOR – preklad nie je potrebný');
      return;
    }
    const target = targetLanguage();
    if (!target) return;
    if (activeStream === currentStream && activeTarget === target && (socket || reconnectTimer)) return;
    if (socket || captureContext) closeLive('stream or language changed');
    quotaBlocked = false;
    connectLive(currentStream, target);
  }

  sourceSelect?.addEventListener('change', () => { quotaBlocked = false; closeLive('language changed'); setTimeout(tick, 100); });
  targetSelect?.addEventListener('change', () => { quotaBlocked = false; closeLive('language changed'); setTimeout(tick, 100); });
  audioButton?.addEventListener('click', () => ensureOutputContext());
  root.addEventListener('pointerdown', () => ensureOutputContext(), {passive:true});

  setInterval(tick, 750);
  tick();
})();
</script>