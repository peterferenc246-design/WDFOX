<div data-fox-bridge-root aria-hidden="true"></div>
<script is:inline>
(()=>{
 const root=document.querySelector('[data-fox-live]'); if(!root)return;
 const mobile=/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
 const IDS=['FOX-WDFOX','FOX-WDFOX-A','FOX-WDFOX-B','FOX-WDFOX-C','FOX-WDFOX-D'];
 let peers=[], activeData=null, activeCall=null, localStream=null, ringTimer=null, audioCtx=null;
 const q=s=>root.querySelector(s), status=q('[data-comm-status]');
 const st=t=>{if(status)status.textContent=t};
 const isolateCallButton=()=>{
   const old=q('[data-call]'); if(!old)return null;
   const fresh=old.cloneNode(true); fresh.disabled=old.disabled; old.replaceWith(fresh); return fresh;
 };
 const call=isolateCallButton(), callLabel=call?.querySelector('[data-call-label]');
 const unlock=()=>{try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume?.()}catch{}};
 ['pointerdown','touchstart','keydown'].forEach(e=>document.addEventListener(e,unlock,{capture:true,passive:true}));
 const ring=()=>{unlock();try{const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.frequency.value=880;g.gain.value=.12;o.connect(g).connect(audioCtx.destination);o.start();setTimeout(()=>o.stop(),180)}catch{}};
 const startRing=()=>{if(ringTimer)return;ring();ringTimer=setInterval(ring,1200)};
 const stopRing=()=>{if(ringTimer)clearInterval(ringTimer);ringTimer=null};
 const load=()=>new Promise((ok,bad)=>{if(window.Peer)return ok();const s=document.createElement('script');s.src='https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js';s.onload=()=>window.Peer?ok():bad(Error('PeerJS unavailable'));s.onerror=()=>bad(Error('PeerJS load failed'));document.head.appendChild(s)});
 const overlay=()=>{let b=document.querySelector('[data-fox-bridge-call]');if(b)return b;b=document.createElement('div');b.dataset.foxBridgeCall='1';b.style='position:fixed;inset:0;z-index:100001;display:grid;place-items:center;background:#0008;padding:20px';b.innerHTML='<div style="background:#fff;border-radius:22px;padding:26px;width:min(430px,100%);text-align:center"><b style="color:#f36a0a">FOX LIVE PC</b><h2>📞 PRICHÁDZAJÚCI HOVOR</h2><p>Mobil žiada o spojenie.</p><div style="display:grid;grid-template-columns:1fr 1fr;gap:10px"><button data-no style="padding:14px;border:0;border-radius:12px">ZAMIETNUŤ</button><button data-yes style="padding:14px;border:0;border-radius:12px;background:#18a957;color:white;font-weight:800">PRIJATIAŤ HOVOR</button></div></div>';
 document.body.appendChild(b);b.querySelector('[data-no]').onclick=()=>{stopRing();try{activeCall?.close()}catch{};try{activeData?.close()}catch{};b.remove();st('🟢 FOX PC ONLINE – čakám na hovor')};b.querySelector('[data-yes]').onclick=async()=>{stopRing();try{unlock();localStream=localStream||await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});activeCall?.answer(localStream);b.remove();st('🟢 HOVOR JE AKTÍVNY')}catch(e){st('❌ MIKROFÓN: '+e.message);b.remove()}};return b};
 const onData=c=>{activeData=c;c.on('data',m=>{if(m?.type==='call-request'){st('🔔 PRICHÁDZAJÚCI HOVOR');startRing();overlay()}});c.on('close',()=>{if(activeData===c)activeData=null;stopRing()})};
 const makePc=async id=>{try{const p=new Peer(id,{debug:1,config:{iceServers:[{urls:'stun:stun.l.google.com:19302'}]}});p.on('open',()=>{st('🟢 FOX PC ONLINE – pripravený prijímať hovory')});p.on('connection',onData);p.on('call',c=>{activeCall=c;st('🔔 PRICHÁDZAJÚCI HOVOR');startRing();overlay()});p.on('error',e=>{if(e.type!=='unavailable-id')st('⚠️ FOX PC: '+(e.type||e.message))});peers.push(p)}catch{}};
 const pcStart=async()=>{await load();for(const id of IDS)await makePc(id)};
 const waitOpen=c=>new Promise((resolve,reject)=>{let done=false;const finish=(fn,v)=>{if(done)return;done=true;clearTimeout(t);fn(v)};const t=setTimeout(()=>finish(reject,Error('timeout')),3500);c.on('open',()=>finish(resolve,c));c.on('error',e=>finish(reject,e));c.on('close',()=>finish(reject,Error('closed')))});
 const mobileCall=async e=>{e.preventDefault();e.stopImmediatePropagation();unlock();try{await load();const p=peers[0];if(!p||p.destroyed)throw Error('Mobilný PeerJS nie je pripravený');localStream=localStream||await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});if(call){call.disabled=true;if(callLabel)callLabel.textContent='VOLÁM…'};let ok=false;for(const id of IDS){try{st('📞 VOLÁM NA FOX PC…');const c=p.connect(id,{reliable:true,metadata:{fox:true}});await waitOpen(c);activeData=c;c.send({type:'call-request',source:q('[data-source]')?.value,target:q('[data-target]')?.value,at:Date.now()});const mc=p.call(id,localStream,{metadata:{fox:true}});activeCall=mc;mc.on('stream',s=>{const a=q('[data-remote-audio]')||new Audio();a.srcObject=s;a.autoplay=true;a.play?.().catch(()=>{})});mc.on('error',x=>st('❌ WEBRTC: '+(x.message||x.type)));ok=true;st('🟢 HOVOR SA PRIPÁJA…');break}catch{}}if(!ok){if(call){call.disabled=false;if(callLabel)callLabel.textContent='ANRUF STARTEN'}st('❌ FOX PC NIE JE ONLINE');}}catch(e){if(call)call.disabled=false;st('❌ '+(e.message||e))}};
 if(mobile){if(call){call.disabled=false;call.addEventListener('click',mobileCall,true)}setTimeout(()=>{load().then(()=>{const p=new Peer(undefined,{debug:1,config:{iceServers:[{urls:'stun:stun.l.google.com:19302'}]}});peers=[p];p.on('open',()=>st('🟢 MOBIL PRIPRAVEN – FOX PC je cieľ'));p.on('error',e=>st('❌ PeerJS: '+(e.type||e.message)))}).catch(e=>st('❌ PeerJS: '+e.message))},300)}else{setTimeout(()=>pcStart().catch(e=>st('❌ FOX PC: '+e.message)),300)}
})();
</script>