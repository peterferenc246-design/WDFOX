<script is:inline>
(() => {
  if (window.__FOX_CALL_TRANSLATION_FIX__) return;
  window.__FOX_CALL_TRANSLATION_FIX__ = true;

  const boot = () => {
    const root = document.querySelector('[data-fox-live]');
    if (!root || root.dataset.foxCallFixReady === '1') return;
    root.dataset.foxCallFixReady = '1';

    const source = root.querySelector('[data-source]');
    const target = root.querySelector('[data-target]');
    const transcript = root.querySelector('[data-transcript]');
    const translation = root.querySelector('[data-translation]');
    const play = root.querySelector('[data-play]');
    const status = root.querySelector('[data-status]');
    const commStatus = root.querySelector('[data-comm-status]');
    if (!source || !target || !transcript || !translation || !commStatus) return;

    const localeMap={bg:'bg-BG',hr:'hr-HR',cs:'cs-CZ',da:'da-DK',nl:'nl-NL',en:'en-US',et:'et-EE',fi:'fi-FI',fr:'fr-FR',de:'de-DE',el:'el-GR',hu:'hu-HU',ga:'ga-IE',it:'it-IT',lv:'lv-LV',lt:'lt-LT',mt:'mt-MT',pl:'pl-PL',pt:'pt-PT',ro:'ro-RO',sk:'sk-SK',sl:'sl-SI',es:'es-ES',sv:'sv-SE'};
    const locale=code=>localeMap[code]||code||'en-US';
    const names=Object.fromEntries([...source.options].map(o=>[o.value,o.textContent||o.value]));
    const active=()=>/hovor je aktívny|call is active|anruf ist aktiv|live|aktívny/i.test(String(commStatus.textContent||''));
    let translating=false;
    let lastTranslated='';
    let timer=null;
    let speechRate=1;
    let interactionId=null;
    let tts=false;

    const setStatus=t=>{if(status)status.textContent=t;};
    const setCallStatus=t=>{commStatus.textContent=t;};
    const chooseVoice=lang=>{const voices=window.speechSynthesis?.getVoices?.()||[];const exact=voices.find(v=>v.lang?.toLowerCase()===lang.toLowerCase());if(exact)return exact;const base=lang.split('-')[0].toLowerCase();return voices.find(v=>v.lang?.toLowerCase().startsWith(base+'-'))||voices.find(v=>v.lang?.toLowerCase()===base)};
    const speak=text=>{if(!text||!window.speechSynthesis)return;tts=true;try{window.speechSynthesis.cancel()}catch{};const u=new SpeechSynthesisUtterance(text);u.lang=locale(target.value);u.rate=speechRate;const voice=chooseVoice(u.lang);if(voice)u.voice=voice;u.onend=()=>{tts=false};u.onerror=()=>{tts=false};window.speechSynthesis.speak(u)};

    const translate=async text=>{
      const clean=String(text||'').trim();
      if(!clean||clean===lastTranslated||!active())return;
      if(translating)return;
      translating=true;lastTranslated=clean;
      setStatus('🧠 PREKLADÁM CEZ GEMINI…');
      try{
        const src=source.value,dst=target.value;
        const prompt=`Translate only this spoken sentence from ${names[src]||src} to ${names[dst]||dst}. Return only a natural, grammatically correct translation in the target language. Preserve names, numbers, dates, negation, tense, politeness and tone. Do not mix source-language words into the target language. Do not add or remove meaning. Sentence: ${clean}`;
        const response=await fetch('/api/gemini-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:prompt,previousInteractionId:interactionId,systemInstruction:'You are a professional real-time interpreter. Output only the target-language translation. Never explain the translation.',thinkingLevel:'low'})});
        const data=await response.json().catch(()=>({}));
        if(!response.ok)throw Error(data?.error||`Gemini HTTP ${response.status}`);
        const out=String(data?.text||data?.translation||'').trim();
        if(!out)throw Error('Gemini returned an empty translation');
        interactionId=data?.interactionId||interactionId;
        translation.textContent=out;if(play)play.disabled=false;
        setStatus('✅ PREKLAD HOTOVÝ');
        setCallStatus('🟢 HOVOR JE AKTÍVNY · 🎙 PREKLAD AKTÍVNY');
        speak(out);
      }catch(error){
        setStatus(`❌ GEMINI: ${error?.message||'Preklad sa nepodaril.'}`);
        setCallStatus(`🟢 HOVOR JE AKTÍVNY · ❌ PREKLAD: ${error?.message||'chyba'}`);
      }finally{translating=false}
    };

    const observe=()=>{
      if(!active())return;
      const text=String(transcript.textContent||'').trim();
      if(!text||text===lastTranslated)return;
      if(timer)clearTimeout(timer);
      timer=setTimeout(()=>{timer=null;const stable=String(transcript.textContent||'').trim();if(stable&&stable!==lastTranslated&&active())void translate(stable)},700);
    };

    new MutationObserver(observe).observe(transcript,{childList:true,characterData:true,subtree:true});
    root.querySelectorAll('[data-speed]').forEach(button=>button.addEventListener('click',()=>{speechRate=Number(button.dataset.speed||1)}));
    play?.addEventListener('click',()=>speak(translation.textContent||''),true);
    source.addEventListener('change',()=>{lastTranslated='';interactionId=null});
    target.addEventListener('change',()=>{interactionId=null});
    setInterval(observe,500);
  };
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>
