<script is:inline>
(() => {
  if (window.__FOX_CALL_TRANSLATION_FIX__) return;
  window.__FOX_CALL_TRANSLATION_FIX__ = true;
  const boot=()=>{
    const root=document.querySelector('[data-fox-live]');
    if(!root||root.dataset.foxCallFixReady==='1')return;
    root.dataset.foxCallFixReady='1';
    const source=root.querySelector('[data-source]'),target=root.querySelector('[data-target]'),transcript=root.querySelector('[data-transcript]'),translation=root.querySelector('[data-translation]'),play=root.querySelector('[data-play]'),status=root.querySelector('[data-status]'),commStatus=root.querySelector('[data-comm-status]'),callButton=root.querySelector('[data-call]'),recordButton=root.querySelector('[data-record]');
    if(!source||!target||!transcript||!translation||!commStatus||!callButton||!recordButton)return;
    const names=Object.fromEntries([...source.options].map(o=>[o.value,o.textContent||o.value]));
    const localeMap={bg:'bg-BG',hr:'hr-HR',cs:'cs-CZ',da:'da-DK',nl:'nl-NL',en:'en-US',et:'et-EE',fi:'fi-FI',fr:'fr-FR',de:'de-DE',el:'el-GR',hu:'hu-HU',ga:'ga-IE',it:'it-IT',lv:'lv-LV',lt:'lt-LT',mt:'mt-MT',pl:'pl-PL',pt:'pt-PT',ro:'ro-RO',sk:'sk-SK',sl:'sl-SI',es:'es-ES',sv:'sv-SE'};
    const locale=c=>localeMap[c]||c||'en-US';
    const active=()=>/hovor je aktívny|call is active|anruf ist aktiv|live|aktívny/i.test(String(commStatus.textContent||''));
    let recordHandler=null,wrapped=false,lastTranslated='',timer=null,translating=false,interactionId=null,speechRate=1;
    const capture=()=>{if(!recordHandler&&typeof recordButton.onclick==='function')recordHandler=recordButton.onclick;return !!recordHandler};
    const startFromTrustedGesture=e=>{if(!capture())return;if(!root.classList.contains('is-call-mode')||callButton.disabled||recordButton.classList.contains('recording'))return;try{recordHandler.call(recordButton,e)}catch(err){commStatus.textContent='❌ SpeechRecognition: '+(err?.message||'spustenie zlyhalo')}};
    const wrap=()=>{if(wrapped||!capture())return;const original=callButton.onclick;if(typeof original!=='function')return;wrapped=true;callButton.addEventListener('pointerup',startFromTrustedGesture,{capture:true});callButton.onclick=function(e){startFromTrustedGesture(e);return original.call(this,e)}};
    const speak=text=>{if(!text||!window.speechSynthesis)return;window.speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang=locale(target.value);u.rate=speechRate;window.speechSynthesis.speak(u)};
    const translate=async text=>{const clean=String(text||'').trim();if(!clean||clean===lastTranslated||!active()||translating)return;translating=true;lastTranslated=clean;if(status)status.textContent='🧠 PREKLADÁM CEZ GEMINI…';try{const src=source.value,dst=target.value;const r=await fetch('/api/gemini-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:`Translate only this spoken sentence from ${names[src]||src} to ${names[dst]||dst}. Return only the natural target-language translation. Preserve names, numbers, dates, negation, tense, politeness and tone. Sentence: ${clean}`,previousInteractionId:interactionId,systemInstruction:'You are a professional real-time interpreter. Output only the target-language translation.',thinkingLevel:'low'})});const j=await r.json().catch(()=>({}));if(!r.ok)throw Error(j?.error||`Gemini HTTP ${r.status}`);const out=String(j?.text||j?.translation||'').trim();if(!out)throw Error('Gemini returned an empty translation');interactionId=j?.interactionId||interactionId;translation.textContent=out;if(play)play.disabled=false;if(status)status.textContent='✅ PREKLAD HOTOVÝ';speak(out)}catch(e){if(status)status.textContent='❌ GEMINI: '+(e?.message||'Preklad sa nepodaril.')}finally{translating=false}};
    const observe=()=>{if(!active())return;const text=String(transcript.textContent||'').trim();if(!text||text===lastTranslated)return;clearTimeout(timer);timer=setTimeout(()=>{const stable=String(transcript.textContent||'').trim();if(stable&&stable!==lastTranslated)void translate(stable)},700)};
    const installConnectionHooks=conn=>{if(!conn||conn.__foxSessionHooks)return;conn.__foxSessionHooks=true;const originalSend=typeof conn.send==='function'?conn.send.bind(conn):null;if(originalSend)conn.send=payload=>{if(payload&&typeof payload==='object'&&payload.type==='translation'){const sourceText=String(transcript.textContent||'').trim();payload={...payload,sourceText:sourceText||payload.sourceText||''}}return originalSend(payload)};conn.on('data',m=>{if(!m||typeof m!=='object')return;if(m.type==='translation'){if(m.sourceText)transcript.textContent=m.sourceText;translation.textContent=String(m.text||'');if(play)play.disabled=!m.text;speak(String(m.text||''));}else if(m.type==='call-end'){try{window.speechSynthesis?.cancel?.()}catch{};try{recordButton.classList.remove('recording')}catch{};commStatus.textContent='Hovor bol ukončený druhým zariadením.';setTimeout(()=>location.reload(),120)}})};
    const patchPeer=()=>{const P=window.Peer;if(!P?.prototype?.on||P.prototype.__foxSessionPatch)return !!P?.prototype?.__foxSessionPatch;const originalOn=P.prototype.on;P.prototype.on=function(event,listener){if(event==='connection'&&typeof listener==='function'){return originalOn.call(this,event,c=>{listener.call(this,c);installConnectionHooks(c)})}return originalOn.call(this,event,listener)};if(typeof P.prototype.connect==='function&&!P.prototype.connect.__foxSessionPatch){const originalConnect=P.prototype.connect;const patchedConnect=function(...args){const c=originalConnect.apply(this,args);installConnectionHooks(c);return c};patchedConnect.__foxSessionPatch=true;P.prototype.connect=patchedConnect}P.prototype.__foxSessionPatch=true;return true};
    new MutationObserver(observe).observe(transcript,{childList:true,characterData:true,subtree:true});
    root.querySelectorAll('[data-speed]').forEach(b=>b.addEventListener('click',()=>speechRate=Number(b.dataset.speed||1)));
    play?.addEventListener('click',()=>speak(translation.textContent||''),true);
    source.addEventListener('change',()=>{lastTranslated='';interactionId=null});target.addEventListener('change',()=>{interactionId=null});
    const arm=setInterval(()=>{wrap();patchPeer()},50);setTimeout(()=>clearInterval(arm),20000);wrap();patchPeer();setInterval(observe,500);
  };
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot,{once:true});else boot();
})();
</script>
