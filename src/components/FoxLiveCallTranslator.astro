---
interface Props { locale: string }
const { locale } = Astro.props
const t = locale === 'de' ? { title:'FOX LIVE KOMMUNIKATOR', intro:'Live-Sprachverbindung mit Transkript und Übersetzung SK ↔ DE.', create:'VERBINDUNG ERSTELLEN', call:'ANRUF STARTEN', accept:'ANRUF ANNEHMEN', wait:'Warte auf das zweite Gerät…', incoming:'EINGEHENDER ANRUF', mic:'MIKROFON EINSCHALTEN', stop:'MIKROFON AUSSCHALTEN', sent:'GESENDET · DEUTSCH', received:'EMPFANGEN · SLOWAKISCH', share:'Einladung teilen', copy:'Link kopieren', copied:'Link kopiert.', invite:'Link senden oder QR-Code scannen.', processing:'Übersetzung…', ready:'Live-Übersetzung aktiv.', error:'Übersetzung fehlgeschlagen.', translated:'Übersetzte Stimme' } : { title:'FOX LIVE KOMUNIKÁTOR', intro:'Živý hlasový hovor so simultánnym prepisom a prekladom SK ↔ DE.', create:'VYTVORIŤ SPOJENIE', call:'USKUTOČNIŤ HOVOR', accept:'PRIJATIE HOVORU', wait:'Čakám na druhé zariadenie…', incoming:'PRICHÁDZAJÚCI HOVOR', mic:'ZAPNÚŤ MIKROFÓN', stop:'VYPNÚŤ MIKROFÓN', sent:'ODOSLANÉ · SLOVENČINA', received:'PRIJATÉ · DEUTSCH', share:'Zdieľať pozvánku', copy:'Kopírovať odkaz', copied:'Odkaz skopírovaný.', invite:'Pošli odkaz alebo nech klient naskenuje QR kód.', processing:'Preklad…', ready:'Preklad je aktívny.', error:'Preklad sa nepodaril.', translated:'Preložený hlas' }
---
<section class="fox-call" data-app data-copy={JSON.stringify(t)}>
<div class="shell"><p class="eyebrow">FOX TECHNOLOGY LAB</p><h2>{t.title}</h2><p class="intro">{t.intro}</p><div class="status" data-status>{t.wait}</div>
<div class="actions"><button class="primary" data-create>{t.create}</button><button class="call" data-call disabled>{t.call}</button><button class="secondary" data-share disabled>{t.share}</button><button class="secondary" data-copy>{t.copy}</button></div>
<div class="invite hidden" data-invite><input data-link readonly/><div class="qr-wrap"><div data-qr></div><small>{t.invite}</small></div></div>
<div class="grid"><article><header data-sent-label>{t.sent}</header><p data-sent>—</p></article><article><header data-received-label>{t.received}</header><p data-received>—</p></article></div>
<div class="live hidden" data-live><b>FOX LIVE PREKLAD</b><span data-translation>{t.ready}</span></div>
<div class="controls"><button class="mic" data-mic disabled>{t.mic}</button><button class="secondary" data-audio>🔊 AUDIO</button></div>
<audio data-audio-el autoplay playsinline></audio></div></section>
<style>
.fox-call{padding:0 0 42px}.shell{border-radius:28px;background:#121a2a;color:#fff;padding:30px;box-shadow:0 22px 60px rgba(20,24,35,.12)}.eyebrow{margin:0;color:#f36a0a;font-size:10px;font-weight:900;letter-spacing:.12em}.shell h2{margin:5px 0 8px;font-size:clamp(24px,4vw,38px);letter-spacing:-.03em}.intro{margin:0;color:#b9c1ce;font-size:14px;line-height:1.6}.status{margin:20px 0;padding:13px 15px;border-radius:13px;background:#1d2635;color:#dce2ea;font-size:13px}.actions,.controls{display:flex;gap:9px;flex-wrap:wrap}.actions button,.controls button{border:0;border-radius:12px;padding:12px 15px;font-size:11px;font-weight:900;cursor:pointer}.primary{background:#f36a0a;color:#fff}.call{background:#18a957;color:#fff}.secondary{background:#fff;color:#172033}.hidden{display:none!important}.actions button:disabled,.controls button:disabled{opacity:.4;cursor:default}.invite{margin-top:16px}.invite input{width:100%;box-sizing:border-box;border:1px solid #344054;border-radius:11px;background:#0d1420;color:#fff;padding:12px;font-size:13px}.qr-wrap{margin-top:14px;background:#fff;color:#172033;border-radius:16px;padding:14px;text-align:center;width:max-content;max-width:100%}.qr-wrap [data-qr]{width:210px;min-height:210px;display:flex;align-items:center;justify-content:center}.qr-wrap img,.qr-wrap canvas{display:block!important;max-width:210px;height:auto!important;margin:auto}.qr-wrap small{display:block;margin-top:9px;font-weight:800}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px}.grid article{background:#fff;color:#172033;border-radius:18px;padding:17px 19px;min-height:145px}.grid article+article{background:#fffdfa;border:1px solid #f6d8c3}.grid header{color:#f36a0a;font-weight:900;font-size:11px;letter-spacing:.06em}.grid p{margin:22px 0 0;font-size:16px;line-height:1.55}.live{display:flex;gap:15px;align-items:center;margin-top:14px;padding:12px 14px;border-radius:13px;background:#1d2635;font-size:11px}.live span{color:#b9c1ce}.controls{margin-top:14px}.shell audio{display:none}@media(max-width:700px){.shell{padding:22px;border-radius:22px}.actions,.controls{display:grid;grid-template-columns:1fr}.actions button,.controls button{width:100%}.grid{grid-template-columns:1fr}.grid article{min-height:120px}.qr-wrap{width:100%;box-sizing:border-box}}
</style>
<script>
const root=document.querySelector('[data-app]');
if(root){
 const t=JSON.parse(root.dataset.copy||'{}'),q=s=>root.querySelector(s),create=q('[data-create]'),callBtn=q('[data-call]'),share=q('[data-share]'),copyBtn=q('[data-copy]'),status=q('[data-status]'),invite=q('[data-invite]'),link=q('[data-link]'),qr=q('[data-qr]'),sent=q('[data-sent]'),received=q('[data-received]'),mic=q('[data-mic]'),live=q('[data-live]'),translation=q('[data-translation]'),audio=q('[data-audio-el]'),audioBtn=q('[data-audio]'),sentLabel=q('[data-sent-label]'),receivedLabel=q('[data-received-label]');
 let peer=null,stream=null,pendingCall=null,data=null,recognition=null,recognizing=false,roomUrl='',ring=null,audioCtx=null;
 const params=new URLSearchParams(location.search),remoteId=params.get('foxPeer'),role=remoteId?'client':'host',api='https://wdfox.vercel.app/api/translate-text';
 const set=s=>status.textContent=s;
 if(role==='client'){callBtn.disabled=false;callBtn.textContent=t.call;share.disabled=false}
 const load=()=>new Promise((ok,bad)=>{if(window.Peer)return ok();const s=document.createElement('script');s.src='https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js';s.onload=ok;s.onerror=bad;document.head.appendChild(s)});
 const loadQr=()=>new Promise((ok,bad)=>{if(window.QRCode)return ok();const s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';s.onload=ok;s.onerror=bad;document.head.appendChild(s)});
 const renderQr=async()=>{if(!qr||!roomUrl)return;try{await loadQr();qr.innerHTML='';new QRCode(qr,{text:roomUrl,width:210,height:210,colorDark:'#000000',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M})}catch(e){qr.textContent='QR'}};
 const openPeer=async()=>{await load();if(peer)return peer;peer=new Peer(undefined,{debug:1,config:{iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun.cloudflare.com:3478'}]}});peer.on('call',incoming);peer.on('connection',c=>wire(c));peer.on('error',e=>{console.error(e);set(t.error);if(role==='client'){callBtn.disabled=false;callBtn.textContent=t.call}});await new Promise((ok,bad)=>{const timer=setTimeout(()=>bad(new Error('Peer timeout')),15000);peer.once('open',id=>{clearTimeout(timer);ok(id)})});return peer};
 const local=async()=>{if(stream)return stream;if(!navigator.mediaDevices?.getUserMedia)throw new Error('Mikrofón nie je dostupný');stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});stream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;mic.textContent=t.stop;return stream};
 const prime=()=>{try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume().catch(()=>{})}catch(e){}};
 const ringStart=()=>{ringStop();try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume().catch(()=>{});const beep=()=>{const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.frequency.value=880;g.gain.value=.06;o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+.2)};beep();ring=setInterval(beep,1200)}catch(e){}};
 const ringStop=()=>{if(ring){clearInterval(ring);ring=null}};
 const speak=(s,lang)=>{if(!s||!window.speechSynthesis)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(s);u.lang=lang;u.rate=.96;try{speechSynthesis.speak(u)}catch(e){}};
 const playRemote=s=>{audio.srcObject=s;audio.muted=false;audio.volume=1;audio.play().catch(()=>{})};
 const wire=c=>{if(!c||c.__fox)return;c.__fox=true;data=c;c.on('data',m=>{if(m?.type==='translation'){sent.textContent=m.sourceText||m.transcript||'';received.textContent=m.translatedText||'';translation.textContent=t.ready;speak(m.translatedText||'',role==='host'?'de-DE':'sk-SK')}});c.on('close',()=>{if(data===c)data=null})};
 const incoming=c=>{pendingCall=c;set(t.incoming);callBtn.disabled=false;callBtn.textContent=t.accept;ringStart();c.on('stream',s=>playRemote(s))};
 const media=c=>{c.on('stream',s=>{playRemote(s);set('HOVOR AKTÍVNY');live.classList.remove('hidden');startRecognition()});c.on('close',()=>{live.classList.add('hidden');if(role==='client'){callBtn.disabled=false;callBtn.textContent=t.call}});c.on('error',e=>{console.error(e);set(t.error)})};
 const startRecognition=()=>{if(recognizing)return;const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){translation.textContent='SpeechRecognition nie je podporovaný';return}recognition=new SR();recognition.lang=role==='host'?'de-DE':'sk-SK';recognition.continuous=true;recognition.interimResults=true;recognition.onstart=()=>recognizing=true;recognition.onresult=e=>{let interim='';for(let i=e.resultIndex;i<e.results.length;i++){const s=e.results[i][0].transcript;if(e.results[i].isFinal)translate(s);else interim+=s}if(interim)sent.textContent=interim};recognition.onend=()=>{recognizing=false;if(!live.classList.contains('hidden'))setTimeout(startRecognition,300)};try{recognition.start()}catch(e){}};
 const translate=async s=>{s=s.trim();if(!s)return;sent.textContent=s;translation.textContent=t.processing;try{const source=role==='host'?'German':'Slovak',target=role==='host'?'Slovak':'German',r=await fetch(api,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:s,sourceLanguage:source,targetLanguage:target})});if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();received.textContent=d.translatedText||'';translation.textContent=t.ready;if(data?.open)data.send({type:'translation',sourceText:s,translatedText:d.translatedText||''});speak(d.translatedText||'',target==='German'?'de-DE':'sk-SK')}catch(e){console.error(e);translation.textContent=t.error}};
 const createRoom=async()=>{try{await openPeer();roomUrl=location.origin+location.pathname+'?foxPeer='+encodeURIComponent(peer.id);link.value=roomUrl;invite.classList.remove('hidden');share.disabled=false;copyBtn.disabled=false;set(t.wait);await renderQr()}catch(e){console.error(e);set(t.error)}};
 const call=async()=>{if(!remoteId)return;callBtn.disabled=true;prime();try{await openPeer();const s=await local();const c=peer.call(remoteId,s,{metadata:{foxLive:true}});media(c);const d=peer.connect(remoteId,{reliable:true,metadata:{foxLive:true}});wire(d);live.classList.remove('hidden');startRecognition();set('PRIPÁJAM HOVOR…')}catch(e){console.error(e);set(e.message||t.error);callBtn.disabled=false;callBtn.textContent=t.call}};
 const accept=async()=>{if(!pendingCall)return;callBtn.disabled=true;prime();ringStop();try{const s=await local(),c=pendingCall;pendingCall=null;c.answer(s);media(c);live.classList.remove('hidden');startRecognition();set('HOVOR AKTÍVNY')}catch(e){console.error(e);set(e.message||t.error);callBtn.disabled=false;callBtn.textContent=t.accept}};
 create.onclick=createRoom;callBtn.onclick=()=>role==='host'?accept():call();copyBtn.onclick=async()=>{const u=roomUrl||location.href;try{await navigator.clipboard.writeText(u);set(t.copied)}catch(e){link.value=u;link.select();document.execCommand('copy');set(t.copied)}};share.onclick=async()=>{const u=roomUrl||location.href;try{if(navigator.share)await navigator.share({title:t.title,url:u});else await navigator.clipboard.writeText(u)}catch(e){}};audioBtn.onclick=()=>{prime();audio.muted=false;audio.play().catch(()=>{});if(stream)stream.getAudioTracks().forEach(x=>x.enabled=true)};mic.onclick=()=>{if(stream){const x=stream.getAudioTracks()[0];x.enabled=!x.enabled;mic.textContent=x.enabled?t.stop:t.mic}};openPeer().catch(e=>console.warn(e));
}
</script>
