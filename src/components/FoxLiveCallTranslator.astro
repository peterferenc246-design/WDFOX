---
interface Props { locale: string; }
const { locale } = Astro.props;
const copy = {
  sk:{title:'FOX LIVE KOMUNIKÁTOR',intro:'Živý hlasový hovor so simultánnym prepisom a prekladom SK ↔ DE.',create:'VYTVORIŤ SPOJENIE',call:'USKUTOČNIŤ HOVOR',accept:'PRIJATIE HOVORU',calling:'VOLÁM…',accepting:'PRIJÍMAM HOVOR…',waiting:'Čakám na druhé zariadenie…',connected:'HOVOR AKTÍVNY',incoming:'PRICHÁDZAJÚCI HOVOR – druhá strana volá',share:'Zdieľať pozvánku',copy:'Kopírovať odkaz',code:'Kód spojenia',invite:'Pošli odkaz alebo nech klient naskenuje QR kód.',mic:'ZAPNÚŤ MIKROFÓN',stopMic:'VYPNÚŤ MIKROFÓN',outgoing:'ODOSLANÉ · SLOVENČINA',incomingLabel:'PRIJATÉ · DEUTSCH',outgoingMobile:'ODOSLANÉ · DEUTSCH',incomingMobile:'PRIJATÉ · SLOVENČINA',ownPlaceholder:'Tvoje hovorené slová sa zobrazia tu…',remotePlaceholder:'Preložená replika sa zobrazí tu…',processing:'Preklad…',ready:'Preklad je aktívny.',error:'Preklad sa nepodaril – pokračujem v hovore.',translator:'FOX LIVE PREKLAD',original:'Pôvodný hlas',translated:'Preložený hlas',language:'Režim: SK ↔ DE',privacy:'Zvuk zostáva v hovore; textový segment sa posiela na server na preklad.'},
  de:{title:'FOX LIVE KOMMUNIKATOR',intro:'Live-Sprachverbindung mit Transkript und Übersetzung SK ↔ DE.',create:'VERBINDUNG ERSTELLEN',call:'ANRUF STARTEN',accept:'ANRUF ANNEHMEN',calling:'ANRUF…',accepting:'ANRUF WIRD ANGENOMMEN…',waiting:'Warte auf das zweite Gerät…',connected:'ANRUF AKTIV',incoming:'EINGEHENDER ANRUF – die andere Seite ruft an',share:'Einladung teilen',copy:'Link kopieren',code:'Verbindungscode',invite:'Link senden oder QR-Code scannen.',mic:'MIKROFON EINSCHALTEN',stopMic:'MIKROFON AUSSCHALTEN',outgoing:'GESENDET · DEUTSCH',incomingLabel:'EMPFANGEN · SLOVAKISCH',outgoingMobile:'GESENDET · SLOVAKISCH',incomingMobile:'EMPFANGEN · DEUTSCH',ownPlaceholder:'Ihre gesprochenen Worte erscheinen hier…',remotePlaceholder:'Die übersetzte Antwort erscheint hier…',processing:'Übersetzung…',ready:'Live-Übersetzung aktiv.',error:'Übersetzung fehlgeschlagen – der Anruf bleibt aktiv.',translator:'FOX LIVE ÜBERSETZER',original:'Originalstimme',translated:'Übersetzte Stimme',language:'Modus: SK ↔ DE',privacy:'Audio bleibt im Anruf; das Sprachsegment wird zur Übersetzung an den Server gesendet.'},
  en:{title:'FOX LIVE COMMUNICATOR',intro:'Live voice call with transcript and translation SK ↔ DE.',create:'CREATE CONNECTION',call:'MAKE A CALL',accept:'ACCEPT CALL',calling:'CALLING…',accepting:'ACCEPTING CALL…',waiting:'Waiting for the second device…',connected:'CALL ACTIVE',incoming:'INCOMING CALL – the other side is calling',share:'Share invitation',copy:'Copy link',code:'Connection code',invite:'Send the link or scan the QR code.',mic:'TURN MICROPHONE ON',stopMic:'TURN MICROPHONE OFF',outgoing:'SENT · SLOVAK',incomingLabel:'RECEIVED · GERMAN',outgoingMobile:'SENT · GERMAN',incomingMobile:'RECEIVED · SLOVAK',ownPlaceholder:'Your spoken words will appear here…',remotePlaceholder:'The translated reply will appear here…',processing:'Translating…',ready:'Live translation active.',error:'Translation failed – the call remains active.',translator:'FOX LIVE TRANSLATOR',original:'Original voice',translated:'Translated voice',language:'Mode: SK ↔ DE',privacy:'Audio remains in the call; speech segments are sent to the server for translation.'}
};
const t=copy[locale as keyof typeof copy]||copy.en;
---
<section class="fox-call" data-call-app data-copy={JSON.stringify(t)}>
<div class="shell"><p class="eyebrow">FOX TECHNOLOGY LAB</p><h2>{t.title}</h2><p class="intro">{t.intro}</p><div class="status" data-status>{t.waiting}</div>
<div class="actions"><button class="primary" data-create>{t.create}</button><button class="call" data-call disabled>{t.call}</button><button class="secondary" data-share disabled>{t.share}</button><button class="secondary" data-copy disabled>{t.copy}</button></div>
<div class="invite hidden" data-invite><label>{t.code}</label><input data-link readonly/><p>{t.invite}</p></div><div class="qr" data-qr-panel hidden><div data-qr></div></div>
<div class="call-grid"><article class="transcript sent"><header data-sent-label>{t.outgoing}</header><p data-sent>{t.ownPlaceholder}</p></article><article class="transcript received"><header data-received-label>{t.incomingLabel}</header><p data-received>{t.remotePlaceholder}</p></article></div>
<div class="livebar hidden" data-livebar><strong>{t.translator}</strong><span data-translation-status>{t.ready}</span><span>{t.language}</span></div>
<div class="controls"><button class="mic" data-mic disabled>{t.mic}</button><button class="secondary" data-original disabled>{t.original}</button><button class="secondary active" data-translated disabled>{t.translated}</button></div>
<audio data-original-audio autoplay playsinline></audio><audio data-translation-audio autoplay playsinline></audio><p class="privacy">🔒 {t.privacy}</p></div></section>
<style>
.fox-call{padding:0 0 42px}.shell{border-radius:28px;background:#121a2a;color:#fff;padding:30px;box-shadow:0 22px 60px rgba(20,24,35,.12)}.eyebrow{margin:0;color:#f36a0a;font-size:10px;font-weight:900;letter-spacing:.12em}.shell h2{margin:5px 0 8px;font-size:clamp(24px,4vw,38px);letter-spacing:-.03em}.intro{margin:0;color:#b9c1ce;font-size:14px;line-height:1.6}.status{margin:20px 0;padding:13px 15px;border-radius:13px;background:#1d2635;color:#dce2ea;font-size:13px}.actions{display:flex;gap:9px;flex-wrap:wrap}.actions button,.controls button{border:0;border-radius:12px;padding:12px 15px;font-size:11px;font-weight:900;cursor:pointer}.primary{background:#f36a0a;color:#fff}.call{background:#18a957;color:#fff}.secondary{background:#fff;color:#172033}.secondary.active{background:#f36a0a;color:#fff}.actions button:disabled,.controls button:disabled{opacity:.4;cursor:default}.invite{margin-top:16px}.hidden{display:none!important}.invite label{display:block;margin-bottom:7px;color:#b9c1ce;font-size:10px;font-weight:800;text-transform:uppercase}.invite input{width:100%;box-sizing:border-box;border:1px solid #344054;border-radius:11px;background:#0d1420;color:#fff;padding:12px;font-size:13px}.invite p{margin:8px 0 0;color:#98a2b3;font-size:11px}.qr{display:flex;justify-content:center;margin:18px 0}.qr>div{background:#fff;padding:12px;border-radius:16px}.call-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px}.transcript{min-height:145px;border-radius:18px;padding:17px 19px;background:#fff;color:#172033}.transcript.received{background:#fffdfa;border:1px solid #f6d8c3}.transcript header{font-size:11px;font-weight:900;letter-spacing:.06em;color:#f36a0a}.transcript p{margin:22px 0 0;font-size:16px;line-height:1.55;white-space:pre-wrap}.livebar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:14px;padding:12px 14px;border-radius:13px;background:#1d2635;font-size:11px}.livebar span{color:#b9c1ce}.controls{display:flex;gap:9px;margin-top:14px}.privacy{margin:16px 0 0;text-align:center;color:#98a0ad;font-size:10px}.shell audio{display:none}@media(max-width:700px){.shell{padding:22px;border-radius:22px}.actions,.controls{display:grid;grid-template-columns:1fr}.actions button,.controls button{width:100%}.call-grid{grid-template-columns:1fr}.transcript{min-height:120px}}
</style>
<script>
const root=document.querySelector('[data-call-app]');
if(root){
 const text=JSON.parse(root.dataset.copy||'{}');const $=(s)=>root.querySelector(s);const create=$('[data-create]'),callBtn=$('[data-call]'),share=$('[data-share]'),copyBtn=$('[data-copy]'),invite=$('[data-invite]'),link=$('[data-link]'),qrPanel=$('[data-qr-panel]'),qr=$('[data-qr]'),status=$('[data-status]'),sent=$('[data-sent]'),received=$('[data-received]'),sentLabel=$('[data-sent-label]'),receivedLabel=$('[data-received-label]'),mic=$('[data-mic]'),livebar=$('[data-livebar]'),translationStatus=$('[data-translation-status]'),originalBtn=$('[data-original]'),translatedBtn=$('[data-translated]'),originalAudio=$('[data-original-audio]'),translationAudio=$('[data-translation-audio]');
 let peer=null,mediaCall=null,dataConn=null,pendingConn=null,stream=null,recorder=null,recording=false,queue=[],processing=false,translationMode=true,ready=false,ringtoneCtx=null,ringTimer=null,ringing=false;const params=new URLSearchParams(location.search),remoteId=params.get('foxPeer'),role=remoteId?'client':'host',API='https://wdfox.vercel.app/api/translate-voice';
 const setStatus=m=>status.textContent=m;const setLabels=()=>{if(role==='host'){sentLabel.textContent=text.outgoing;receivedLabel.textContent=text.incomingLabel}else{sentLabel.textContent=text.outgoingMobile;receivedLabel.textContent=text.incomingMobile}};setLabels();
 const primeAudio=async()=>{try{if(!ringtoneCtx)ringtoneCtx=new(window.AudioContext||window.webkitAudioContext)();if(ringtoneCtx.state==='suspended')await ringtoneCtx.resume()}catch(e){console.error('FOX audio init',e)}};
 const ringOnce=()=>{if(!ringtoneCtx||ringtoneCtx.state==='suspended')return;try{const n=ringtoneCtx.currentTime,g=ringtoneCtx.createGain(),a=ringtoneCtx.createOscillator(),b=ringtoneCtx.createOscillator();g.gain.setValueAtTime(.0001,n);g.gain.exponentialRampToValueAtTime(.18,n+.03);g.gain.exponentialRampToValueAtTime(.0001,n+.5);g.connect(ringtoneCtx.destination);a.type='sine';b.type='sine';a.frequency.value=880;b.frequency.value=660;a.connect(g);b.connect(g);a.start(n);b.start(n);a.stop(n+.5);b.stop(n+.5)}catch(e){console.error('FOX ringtone',e)}};
 const startRingtone=async()=>{if(role!=='host'||ringing)return;ringing=true;await primeAudio();ringOnce();ringTimer=setInterval(ringOnce,900)};const stopRingtone=()=>{ringing=false;if(ringTimer){clearInterval(ringTimer);ringTimer=null}};
 const loadScript=(src,test)=>new Promise((resolve,reject)=>{if(test())return resolve();const s=document.createElement('script');s.src=src;s.onload=resolve;s.onerror=()=>reject(new Error('Script load failed'));document.head.appendChild(s)});const loadPeer=()=>loadScript('https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js',()=>!!window.Peer);const loadQr=()=>loadScript('https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js',()=>!!window.QRCode);
 const startLocal=async()=>{if(!stream)stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true},video:false});stream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;mic.textContent=text.stopMic;return stream};
 const sendPacket=data=>{if(dataConn?.open){try{dataConn.send(data);return true}catch(e){console.error(e)}}return false};
 const speak=async(value,lang)=>{if(!('speechSynthesis'in window)||!value)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(value);u.lang=lang==='de'?'de-DE':'sk-SK';u.rate=.96;u.pitch=1;const voices=speechSynthesis.getVoices();const v=voices.find(x=>x.lang.toLowerCase().startsWith(u.lang.slice(0,2).toLowerCase()));if(v)u.voice=v;try{speechSynthesis.speak(u)}catch(e){console.error('FOX browser TTS',e)}};
 const showIncoming=d=>{if(d?.translatedText){received.textContent=d.translatedText;translationStatus.textContent=text.ready;if(translationMode)speak(d.translatedText,role==='host'?'de':'sk')}};
 const wireData=conn=>{dataConn=conn;conn.on('data',d=>{if(d?.type==='call-request'&&role==='host'){pendingConn=conn;callBtn.disabled=false;callBtn.textContent=text.accept;setStatus(text.incoming);startRingtone()}else if(d?.type==='call-accepted'&&role==='client'){setStatus(text.calling)}else if(d?.type==='translation')showIncoming(d)});conn.on('close',()=>{if(dataConn===conn)dataConn=null;stopRingtone()});conn.on('error',e=>console.error('FOX data',e))};
 const translateChunk=async blob=>{if(blob.size<1200)return;const form=new FormData();form.append('audio',blob,'fox-live.webm');form.append('sourceLanguage',role==='host'?'sk':'de');form.append('targetLanguage',role==='host'?'de':'sk');translationStatus.textContent=text.processing;try{const r=await fetch(API,{method:'POST',body:form});const raw=await r.text();let d={};try{d=JSON.parse(raw)}catch{}if(!r.ok)throw new Error(d?.error||`HTTP ${r.status}`);if(!d.transcript||!d.translatedText)throw new Error('Server returned no translation');sent.textContent=d.transcript;received.textContent=d.translatedText;translationStatus.textContent=text.ready;speak(d.translatedText,role==='host'?'de':'sk');if(!sendPacket({type:'translation',transcript:d.transcript,translatedText:d.translatedText}))throw new Error('Komunikačný kanál nie je pripojený')}catch(e){console.error('FOX translation',e);translationStatus.textContent=`${text.error} (${e instanceof Error?e.message:'chyba'})`}};
 const drain=async()=>{if(processing)return;processing=true;while(queue.length)await translateChunk(queue.shift());processing=false};
 const startTranslation=async()=>{if(recording||!stream)return;try{const type=MediaRecorder.isTypeSupported('audio/webm;codecs=opus')?'audio/webm;codecs=opus':'audio/webm';recorder=new MediaRecorder(stream,{mimeType:type});recorder.ondataavailable=e=>{if(e.data?.size){queue.push(e.data);drain()}};recorder.onstart=()=>{recording=true;translationStatus.textContent=text.ready};recorder.onerror=e=>console.error('FOX recorder',e);recorder.start(6000)}catch(e){console.error(e);translationStatus.textContent=text.error}};
 const stopTranslation=()=>{if(recorder){try{recorder.stop()}catch{}recorder=null}recording=false;queue=[]};const activateTranslation=async()=>{await startLocal();livebar.classList.remove('hidden');originalBtn.disabled=false;translatedBtn.disabled=false;originalAudio.volume=translationMode?0:1;await startTranslation()};
 const wireMedia=mc=>{mediaCall=mc;mc.on('stream',remote=>{originalAudio.srcObject=remote;originalAudio.volume=translationMode?0:1;originalAudio.play().catch(()=>{});setStatus(text.connected);activateTranslation().catch(e=>{console.error(e);setStatus(text.error)})});mc.on('close',()=>{mediaCall=null;stopTranslation();stopRingtone();setStatus(text.waiting)});mc.on('error',e=>{console.error('FOX media',e);setStatus(text.error)})};
 const acceptIncoming=async()=>{if(!pendingConn||!peer)return;try{stopRingtone();callBtn.disabled=true;callBtn.textContent=text.accepting;dataConn=pendingConn;await startLocal();sendPacket({type:'call-accepted'});wireMedia(peer.call(pendingConn.peer,stream,{metadata:{app:'FOX LIVE',version:'0.6.0'}}));pendingConn=null}catch(e){console.error(e);callBtn.disabled=false;callBtn.textContent=text.accept;setStatus(text.error)}};
 const requestCall=async()=>{if(!peer||!ready||!remoteId){setStatus(text.waiting);return}try{await startLocal();callBtn.disabled=true;callBtn.textContent=text.calling;setStatus(text.calling);const c=peer.connect(remoteId,{label:'fox-call-control',reliable:true,metadata:{app:'FOX LIVE',version:'0.6.0'}});wireData(c);c.on('open',()=>sendPacket({type:'call-request'}));c.on('error',e=>{console.error(e);setStatus(text.error)})}catch(e){console.error(e);callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.error)}};
 const createConnection=async()=>{try{await primeAudio();await loadPeer();if(peer)return;peer=new window.Peer({host:'0.peerjs.com',port:443,path:'/',secure:true,debug:1});peer.on('open',async id=>{ready=true;const roomUrl=`${location.origin}${location.pathname}?foxPeer=${encodeURIComponent(id)}`;link.value=roomUrl;invite.classList.remove('hidden');share.disabled=false;copyBtn.disabled=false;callBtn.disabled=!!remoteId;setStatus(text.waiting);if(role==='host'){await loadQr();qrPanel.hidden=false;new window.QRCode(qr,{text:roomUrl,width:180,height:180})}});peer.on('connection',conn=>wireData(conn));peer.on('call',async mc=>{try{await startLocal();mc.answer(stream);wireMedia(mc)}catch(e){console.error(e);setStatus(text.error)}});peer.on('disconnected',()=>{ready=false;try{peer.reconnect()}catch{}});peer.on('error',e=>{console.error('FOX Peer',e);setStatus(`FOX spojenie: ${e.type||'chyba'}`)})}catch(e){console.error(e);setStatus(text.error)}};
 create.addEventListener('click',createConnection);callBtn.addEventListener('click',()=>role==='host'?acceptIncoming():requestCall);share.addEventListener('click',async()=>{try{await navigator.share({title:text.title,url:link.value})}catch{}});copyBtn.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(link.value);copyBtn.textContent='OK';setTimeout(()=>copyBtn.textContent=text.copy,1200)}catch{link.select();document.execCommand('copy')}});mic.addEventListener('click',()=>{const tr=stream?.getAudioTracks()[0];if(!tr)return;tr.enabled=!tr.enabled;mic.textContent=tr.enabled?text.stopMic:text.mic});originalBtn.addEventListener('click',()=>{translationMode=false;originalAudio.volume=1;originalBtn.classList.add('active');translatedBtn.classList.remove('active')});translatedBtn.addEventListener('click',()=>{translationMode=true;originalAudio.volume=0;translatedBtn.classList.add('active');originalBtn.classList.remove('active')});
 if(role==='client'){create.click();callBtn.disabled=false;callBtn.textContent=text.call}
}
</script>
