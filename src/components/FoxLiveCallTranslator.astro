---
interface Props { locale: string }
const { locale } = Astro.props
const t = locale === 'de' ? { title:'FOX LIVE KOMMUNIKATOR', create:'VERBINDUNG ERSTELLEN', call:'ANRUF STARTEN', accept:'ANRUF ANNEHMEN', wait:'Warte auf das zweite Gerät…', incoming:'EINGEHENDER ANRUF', mic:'MIKROFON EINSCHALTEN', stop:'MIKROFON AUSSCHALTEN', processing:'Übersetzung…', ready:'Live-Übersetzung aktiv.', error:'Übersetzung fehlgeschlagen.', sent:'GESENDET · DEUTSCH', received:'EMPFANGEN · SLOWAKISCH' } : { title:'FOX LIVE KOMUNIKÁTOR', create:'VYTVORIŤ SPOJENIE', call:'USKUTOČNIŤ HOVOR', accept:'PRIJATIE HOVORU', wait:'Čakám na druhé zariadenie…', incoming:'PRICHÁDZAJÚCI HOVOR', mic:'ZAPNÚŤ MIKROFÓN', stop:'VYPNÚŤ MIKROFÓN', processing:'Preklad…', ready:'Preklad je aktívny.', error:'Preklad sa nepodaril.', sent:'ODOSLANÉ · SLOVENČINA', received:'PRIJATÉ · DEUTSCH' }
---
<section class="fox-call" data-app data-copy={JSON.stringify(t)}>
<div class="shell"><p class="eyebrow">FOX TECHNOLOGY LAB</p><h2>{t.title}</h2><div class="status" data-status>{t.wait}</div>
<div class="actions"><button class="primary" data-create>{t.create}</button><button class="call" data-call disabled>{t.call}</button></div>
<div class="invite hidden" data-invite><input data-link readonly/><button class="secondary" data-copy>Kopírovať</button><div class="qr-wrap"><div data-qr></div><small>📱 Naskenuj QR kód na druhom zariadení</small></div></div>
<div class="grid"><article><header data-sent-label>{t.sent}</header><p data-sent>—</p></article><article><header data-received-label>{t.received}</header><p data-received>—</p></article></div>
<div class="live hidden" data-live><b>FOX LIVE PREKLAD</b><span data-translation>{t.ready}</span></div>
<div class="controls"><button class="mic" data-mic disabled>{t.mic}</button><button class="secondary" data-audio>🔊 AUDIO</button></div>
<audio data-audio-el autoplay playsinline></audio></div></section>
<style>
.fox-call{padding-bottom:40px}.shell{background:#121a2a;color:#fff;border-radius:26px;padding:28px}.eyebrow{color:#f36a0a;font-size:10px;font-weight:900}.shell h2{font-size:32px}.status,.live{background:#1d2635;border-radius:12px;padding:13px;margin:16px 0}.actions,.controls{display:flex;gap:10px;flex-wrap:wrap}.actions button,.controls button{border:0;border-radius:12px;padding:12px 16px;font-weight:900;cursor:pointer}.primary{background:#f36a0a;color:#fff}.call{background:#18a957;color:#fff}.secondary{background:#fff;color:#172033}.hidden{display:none!important}.invite{margin-top:16px}.invite input{width:75%;padding:11px}.qr-wrap{margin-top:16px;background:#fff;color:#172033;border-radius:16px;padding:16px;text-align:center;width:max-content;max-width:100%}.qr-wrap [data-qr]{width:220px;min-height:220px;display:flex;align-items:center;justify-content:center}.qr-wrap img,.qr-wrap canvas{display:block!important;max-width:220px;height:auto!important;margin:auto}.qr-wrap small{display:block;margin-top:10px;font-weight:800}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:20px}.grid article{background:#fff;color:#172033;border-radius:16px;padding:18px;min-height:120px}.grid article+article{background:#fffdfa}.grid header{color:#f36a0a;font-weight:900;font-size:11px}.grid p{font-size:17px;line-height:1.5}.live{display:flex;gap:15px}.live span{color:#b9c1ce}.shell audio{display:none}@media(max-width:700px){.shell{padding:20px}.grid{grid-template-columns:1fr}.actions,.controls{display:grid;grid-template-columns:1fr}.actions button,.controls button{width:100%}.invite input{width:100%;box-sizing:border-box}.qr-wrap{width:100%;box-sizing:border-box}}
</style>
<script>
const root=document.querySelector('[data-app]');
if(root){
 const t=JSON.parse(root.dataset.copy||'{}'),q=s=>root.querySelector(s),create=q('[data-create]'),callBtn=q('[data-call]'),status=q('[data-status]'),invite=q('[data-invite]'),link=q('[data-link]'),copyBtn=q('[data-copy]'),qr=q('[data-qr]'),sent=q('[data-sent]'),received=q('[data-received]'),mic=q('[data-mic]'),live=q('[data-live]'),translation=q('[data-translation]'),audio=q('[data-audio-el]'),audioBtn=q('[data-audio]'),sentLabel=q('[data-sent-label]'),receivedLabel=q('[data-received-label]');
 let peer=null,stream=null,pendingCall=null,data=null,recognition=null,roomUrl='',ring=null,audioCtx=null;
 const params=new URLSearchParams(location.search),remoteId=params.get('foxPeer'),role=remoteId?'client':'host',api='https://wdfox.vercel.app/api/translate-text';
 const set=s=>status.textContent=s;
 if(role==='client'){callBtn.disabled=false;callBtn.textContent=t.call}
 const load=()=>new Promise((ok,bad)=>{if(window.Peer)return ok();const s=document.createElement('script');s.src='https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js';s.onload=ok;s.onerror=bad;document.head.appendChild(s)});
 const loadQr=()=>new Promise((ok,bad)=>{if(window.QRCode)return ok();const s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';s.onload=ok;s.onerror=bad;document.head.appendChild(s)});
 const renderQr=async()=>{if(!qr||!roomUrl)return;qr.innerHTML='';try{await loadQr();new QRCode(qr,{text:roomUrl,width:220,height:220,colorDark:'#000000',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.M})}catch(e){console.error('QR:',e);qr.innerHTML='<span>QR kód sa nepodarilo načítať.</span>'}};
 const openPeer=async()=>{await load();if(peer)return peer;peer=new Peer(undefined,{debug:1,config:{iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun.cloudflare.com:3478'}]}});peer.on('call',incoming);peer.on('connection',c=>wire(c));peer.on('error',e=>{console.error(e);set('PeerJS: '+(e?.type||'chyba'));if(role==='client'){callBtn.disabled=false;callBtn.textContent=t.call}});await new Promise((ok,bad)=>{const timer=setTimeout(()=>bad(new Error('Peer timeout')),15000);peer.once('open',id=>{clearTimeout(timer);ok(id)})});return peer};
 const local=async()=>{if(stream)return stream;if(!navigator.mediaDevices?.getUserMedia)throw new Error('Mikrofón nie je v tomto prehliadači dostupný');stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});stream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;mic.textContent=t.stop;return stream};
 const prime=()=>{try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume().catch(()=>{});if('speechSynthesis'in window)speechSynthesis.cancel()}catch(e){}};
 const ringStart=()=>{ringStop();try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume().catch(()=>{});const beep=()=>{const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.frequency.value=880;g.gain.value=.06;o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+.2)};beep();ring=setInterval(beep,1200)}catch(e){}};
 const ringStop=()=>{if(ring){clearInterval(ring);ring=null}};
 const speak=(s,lang)=>{if(!s||!window.speechSynthesis)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(s);u.lang=lang;u.volume=1;u.rate=.96;setTimeout(()=>{try{speechSynthesis.speak(u)}catch(e){}},30)};
 const playRemote=s=>{audio.srcObject=s;audio.muted=false;audio.volume=1;audio.autoplay=true;const p=audio.play();if(p?.catch)p.catch(()=>set('Klikni na 🔊 AUDIO pre povolenie zvuku.'))};
 const wire=c=>{if(!c||c.__fox)return;c.__fox=true;data=c;c.on('data',m=>{if(m?.type==='translation'){received.textContent=m.sourceText||'';sent.textContent=m.translatedText||'';translation.textContent=t.ready;speak(m.translatedText||'',role==='host'?'de-DE':'sk-SK')}});c.on('close',()=>{if(data===c)data=null})};
 const incoming=c=>{pendingCall=c;set(t.incoming);callBtn.disabled=false;callBtn.textContent=t.accept;ringStart();c.on('stream',s=>playRemote(s))};
 const media=async c=>{c.on('stream',s=>{playRemote(s);set('HOVOR AKTÍVNY');live.classList.remove('hidden');startRecognition()});c.on('close',()=>{live.classList.add('hidden');callBtn.disabled=false});c.on('error',e=>{console.error(e);set('Audio spojenie zlyhalo')})};
 const startRecognition=()=>{if(recognition)return;const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){translation.textContent='SpeechRecognition nie je podporovaný';return}recognition=new SR();recognition.lang=role==='host'?'de-DE':'sk-SK';recognition.continuous=true;recognition.interimResults=true;recognition.onresult=e=>{for(let i=e.resultIndex;i<e.results.length;i++){const s=e.results[i][0].transcript;if(e.results[i].isFinal)translate(s);else sent.textContent=s}};recognition.onend=()=>{recognition=null;if(!live.classList.contains('hidden'))setTimeout(startRecognition,300)};try{recognition.start()}catch(e){}};
 const translate=async s=>{s=s.trim();if(!s)return;sent.textContent=s;translation.textContent=t.processing;try{const source=role==='host'?'German':'Slovak',target=role==='host'?'Slovak':'German',r=await fetch(api,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:s,sourceLanguage:source,targetLanguage:target})});if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();received.textContent=d.translatedText||'';translation.textContent=t.ready;if(data?.open)data.send({type:'translation',sourceText:s,translatedText:d.translatedText||''});speak(d.translatedText||'',target==='German'?'de-DE':'sk-SK')}catch(e){console.error(e);translation.textContent=t.error}};
 const createRoom=async()=>{try{await openPeer();roomUrl=location.origin+location.pathname+'?foxPeer='+encodeURIComponent(peer.id);link.value=roomUrl;invite.classList.remove('hidden');await renderQr();set(t.wait)}catch(e){console.error(e);set('Chyba vytvorenia spojenia')}};
 const call=async()=>{if(!remoteId)return;callBtn.disabled=true;prime();try{await openPeer();const s=await local();const c=peer.call(remoteId,s,{metadata:{foxLive:true}});media(c);const d=peer.connect(remoteId,{reliable:true,metadata:{foxLive:true}});wire(d);live.classList.remove('hidden');startRecognition();set('PRIPÁJAM HOVOR…')}catch(e){console.error(e);set(e.message||'Hovor sa nepodaril');callBtn.disabled=false;callBtn.textContent=t.call}};
 const accept=async()=>{if(!pendingCall)return;callBtn.disabled=true;prime();ringStop();try{const s=await local(),c=pendingCall;pendingCall=null;c.answer(s);media(c);live.classList.remove('hidden');startRecognition();set('HOVOR AKTÍVNY')}catch(e){console.error(e);set(e.message||'Prijatie hovoru zlyhalo');callBtn.disabled=false}};
 create.onclick=createRoom;callBtn.onclick=()=>role==='host'?accept():call();copyBtn.onclick=async()=>{try{await navigator.clipboard?.writeText(link.value);set('Odkaz skopírovaný.')}catch(e){link.select()}};audioBtn.onclick=()=>{prime();audio.muted=false;audio.play().catch(()=>{});if(stream)stream.getAudioTracks().forEach(x=>x.enabled=true)};mic.onclick=()=>{if(stream){const x=stream.getAudioTracks()[0];x.enabled=!x.enabled;mic.textContent=x.enabled?t.stop:t.mic}};openPeer().catch(e=>console.warn(e));
}
</script>