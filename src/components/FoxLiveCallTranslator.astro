---
interface Props { locale: string; }
const { locale } = Astro.props;
const copy = {
  sk:{title:'FOX LIVE KOMUNIKÁTOR',intro:'Živý hlasový hovor so simultánnym prepisom a prekladom SK ↔ DE.',create:'VYTVORIŤ SPOJENIE',call:'USKUTOČNIŤ HOVOR',accept:'PRIJATIE HOVORU',calling:'VOLÁM…',connecting:'PRIPÁJAM HOVOR…',accepting:'PRIJÍMAM HOVOR…',waiting:'Čakám na druhé zariadenie…',connected:'HOVOR AKTÍVNY',incoming:'PRICHÁDZAJÚCI HOVOR – druhá strana volá',micPermission:'Povoľ mikrofón…',timeout:'Spojenie sa nepodarilo. Skús hovor znova.',share:'Zdieľať pozvánku',copy:'Kopírovať odkaz',code:'Kód spojenia',invite:'Pošli odkaz alebo nech klient naskenuje QR kód.',mic:'ZAPNÚŤ MIKROFÓN',stopMic:'VYPNÚŤ MIKROFÓN',outgoing:'ODOSLANÉ · SLOVENČINA',incomingLabel:'PRIJATÉ · DEUTSCH',outgoingMobile:'ODOSLANÉ · DEUTSCH',incomingMobile:'PRIJATÉ · SLOVENČINA',ownPlaceholder:'Tvoje hovorené slová sa zobrazia tu…',remotePlaceholder:'Preložená replika sa zobrazí tu…',processing:'Preklad…',ready:'Preklad je aktívny.',error:'Preklad sa nepodaril – pokračujem v hovore.',translator:'FOX LIVE PREKLAD',original:'Pôvodný hlas',translated:'Preložený hlas',language:'Režim: SK ↔ DE',privacy:'Zvuk zostáva v hovore; textový segment sa posiela na server na preklad.'},
  de:{title:'FOX LIVE KOMMUNIKATOR',intro:'Live-Sprachverbindung mit Transkript und Übersetzung SK ↔ DE.',create:'VERBINDUNG ERSTELLEN',call:'ANRUF STARTEN',accept:'ANRUF ANNEHMEN',calling:'ANRUF…',connecting:'ANRUF WIRD VERBUNDEN…',accepting:'ANRUF WIRD ANGENOMMEN…',waiting:'Warte auf das zweite Gerät…',connected:'ANRUF AKTIV',incoming:'EINGEHENDER ANRUF – die andere Seite ruft an',micPermission:'Mikrofon freigeben…',timeout:'Verbindung fehlgeschlagen. Bitte erneut anrufen.',share:'Einladung teilen',copy:'Link kopieren',code:'Verbindungscode',invite:'Link senden oder QR-Code scannen.',mic:'MIKROFON EINSCHALTEN',stopMic:'MIKROFON AUSSCHALTEN',outgoing:'GESENDET · DEUTSCH',incomingLabel:'EMPFANGEN · SLOVAKISCH',outgoingMobile:'GESENDET · SLOVAKISCH',incomingMobile:'EMPFANGEN · DEUTSCH',ownPlaceholder:'Ihre gesprochenen Worte erscheinen hier…',remotePlaceholder:'Die übersetzte Antwort erscheint hier…',processing:'Übersetzung…',ready:'Live-Übersetzung aktiv.',error:'Übersetzung fehlgeschlagen – der Anruf bleibt aktiv.',translator:'FOX LIVE ÜBERSETZER',original:'Originalstimme',translated:'Übersetzte Stimme',language:'Modus: SK ↔ DE',privacy:'Audio bleibt im Anruf; das Sprachsegment wird zur Übersetzung an den Server gesendet.'},
  en:{title:'FOX LIVE COMMUNICATOR',intro:'Live voice call with transcript and translation SK ↔ DE.',create:'CREATE CONNECTION',call:'MAKE A CALL',accept:'ACCEPT CALL',calling:'CALLING…',connecting:'CONNECTING CALL…',accepting:'ACCEPTING CALL…',waiting:'Waiting for the second device…',connected:'CALL ACTIVE',incoming:'INCOMING CALL – the other side is calling',micPermission:'Allow microphone…',timeout:'Connection failed. Please call again.',share:'Share invitation',copy:'Copy link',code:'Connection code',invite:'Send the link or scan the QR code.',mic:'TURN MICROPHONE ON',stopMic:'TURN MICROPHONE OFF',outgoing:'SENT · SLOVAK',incomingLabel:'RECEIVED · GERMAN',outgoingMobile:'SENT · GERMAN',incomingMobile:'RECEIVED · SLOVAK',ownPlaceholder:'Your spoken words will appear here…',remotePlaceholder:'The translated reply will appear here…',processing:'Translating…',ready:'Live translation active.',error:'Translation failed – the call remains active.',translator:'FOX LIVE TRANSLATOR',original:'Original voice',translated:'Translated voice',language:'Mode: SK ↔ DE',privacy:'Audio remains in the call; speech segments are sent to the server for translation.'}
};
const t=copy[locale as keyof typeof copy]||copy.en;
---
<section class="fox-call" data-call-app data-copy={JSON.stringify(t)}>
<div class="shell"><p class="eyebrow">FOX TECHNOLOGY LAB</p><h2>{t.title}</h2><p class="intro">{t.intro}</p><div class="status" data-status>{t.waiting}</div>
<div class="actions"><button class="primary" data-create>{t.create}</button><button class="call" data-call disabled>{t.call}</button><button class="secondary" data-share disabled>{t.share}</button><button class="secondary" data-copy disabled>{t.copy}</button></div>
<div class="invite hidden" data-invite><label>{t.code}</label><input data-link readonly/><p>{t.invite}</p></div><div class="qr" data-qr-panel hidden><div data-qr></div></div>
<div class="call-grid"><article class="transcript sent"><header data-sent-label>{t.outgoing}</header><p data-sent>{t.ownPlaceholder}</p></article><article class="transcript received"><header data-received-label>{t.incomingLabel}</header><p data-received>{t.remotePlaceholder}</p></article></div>
<div class="livebar hidden" data-livebar><strong>{t.translator}</strong><span data-translation-status>{t.ready}</span><span>{t.language}</span></div>
<div class="controls"><button class="mic" data-mic disabled>{t.mic}</button><button class="secondary" data-original disabled>{t.original}</button><button class="secondary active" data-translated disabled>{t.translated}</button></div>
<audio data-original-audio autoplay playsinline></audio><p class="privacy">🔒 {t.privacy}</p></div></section>
<style>
.fox-call{padding:0 0 42px}.shell{border-radius:28px;background:#121a2a;color:#fff;padding:30px;box-shadow:0 22px 60px rgba(20,24,35,.12)}.eyebrow{margin:0;color:#f36a0a;font-size:10px;font-weight:900;letter-spacing:.12em}.shell h2{margin:5px 0 8px;font-size:clamp(24px,4vw,38px);letter-spacing:-.03em}.intro{margin:0;color:#b9c1ce;font-size:14px;line-height:1.6}.status{margin:20px 0;padding:13px 15px;border-radius:13px;background:#1d2635;color:#dce2ea;font-size:13px}.actions{display:flex;gap:9px;flex-wrap:wrap}.actions button,.controls button{border:0;border-radius:12px;padding:12px 15px;font-size:11px;font-weight:900;cursor:pointer}.primary{background:#f36a0a;color:#fff}.call{background:#18a957;color:#fff}.secondary{background:#fff;color:#172033}.secondary.active{background:#f36a0a;color:#fff}.actions button:disabled,.controls button:disabled{opacity:.4;cursor:default}.invite{margin-top:16px}.hidden{display:none!important}.invite label{display:block;margin-bottom:7px;color:#b9c1ce;font-size:10px;font-weight:800;text-transform:uppercase}.invite input{width:100%;box-sizing:border-box;border:1px solid #344054;border-radius:11px;background:#0d1420;color:#fff;padding:12px;font-size:13px}.invite p{margin:8px 0 0;color:#98a2b3;font-size:11px}.qr{display:flex;justify-content:center;margin:18px 0}.qr>div{background:#fff;padding:12px;border-radius:16px}.call-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px}.transcript{min-height:145px;border-radius:18px;padding:17px 19px;background:#fff;color:#172033}.transcript.received{background:#fffdfa;border:1px solid #f6d8c3}.transcript header{font-size:11px;font-weight:900;letter-spacing:.06em;color:#f36a0a}.transcript p{margin:22px 0 0;font-size:16px;line-height:1.55;white-space:pre-wrap}.livebar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:14px;padding:12px 14px;border-radius:13px;background:#1d2635;font-size:11px}.livebar span{color:#b9c1ce}.controls{display:flex;gap:9px;margin-top:14px}.privacy{margin:16px 0 0;text-align:center;color:#98a0ad;font-size:10px}.shell audio{display:none}@media(max-width:700px){.shell{padding:22px;border-radius:22px}.actions,.controls{display:grid;grid-template-columns:1fr}.actions button,.controls button{width:100%}.call-grid{grid-template-columns:1fr}.transcript{min-height:120px}}
</style>
<script>
const root=document.querySelector('[data-call-app]');
if(root){
 const text=JSON.parse(root.dataset.copy||'{}');const $=(s)=>root.querySelector(s);const create=$('[data-create]'),callBtn=$('[data-call]'),share=$('[data-share]'),copyBtn=$('[data-copy]'),invite=$('[data-invite]'),link=$('[data-link]'),qrPanel=$('[data-qr-panel]'),qr=$('[data-qr]'),status=$('[data-status]'),sent=$('[data-sent]'),received=$('[data-received]'),sentLabel=$('[data-sent-label]'),receivedLabel=$('[data-received-label]'),mic=$('[data-mic]'),livebar=$('[data-livebar]'),translationStatus=$('[data-translation-status]'),originalBtn=$('[data-original]'),translatedBtn=$('[data-translated]'),originalAudio=$('[data-original-audio]');
 let peer=null,mediaCall=null,mediaConnected=false,dataConn=null,pendingConn=null,stream=null,recorder=null,recording=false,queue=[],processing=false,translationMode=true,ready=false,ringtoneCtx=null,ringTimer=null,ringing=false,callTimer=null,mediaTimer=null,roomUrl='';
 const params=new URLSearchParams(location.search),remoteId=params.get('foxPeer'),role=remoteId?'client':'host',API='https://wdfox.vercel.app/api/translate-voice';
 const setStatus=m=>status.textContent=m;const setLabels=()=>{if(role==='host'){sentLabel.textContent=text.outgoing;receivedLabel.textContent=text.incomingLabel}else{sentLabel.textContent=text.outgoingMobile;receivedLabel.textContent=text.incomingMobile}};setLabels();
 const clearTimers=()=>{if(callTimer){clearTimeout(callTimer);callTimer=null}if(mediaTimer){clearTimeout(mediaTimer);mediaTimer=null}};
 const primeAudio=async()=>{try{if(!ringtoneCtx)ringtoneCtx=new(window.AudioContext||window.webkitAudioContext)();if(ringtoneCtx.state==='suspended')await ringtoneCtx.resume();if('speechSynthesis'in window)speechSynthesis.getVoices()}catch(e){console.error('FOX audio init',e)}};
 const ringOnce=()=>{if(!ringtoneCtx||ringtoneCtx.state==='suspended')return;try{const n=ringtoneCtx.currentTime,g=ringtoneCtx.createGain(),a=ringtoneCtx.createOscillator(),b=ringtoneCtx.createOscillator();g.gain.setValueAtTime(.0001,n);g.gain.exponentialRampToValueAtTime(.18,n+.03);g.gain.exponentialRampToValueAtTime(.0001,n+.5);g.connect(ringtoneCtx.destination);a.type='sine';b.type='sine';a.frequency.value=880;b.frequency.value=660;a.connect(g);b.connect(g);a.start(n);b.start(n);a.stop(n+.5);b.stop(n+.5)}catch(e){console.error('FOX ringtone',e)}};
 const startRingtone=async()=>{if(role!=='host'||ringing)return;ringing=true;await primeAudio();ringOnce();ringTimer=setInterval(ringOnce,900)};const stopRingtone=()=>{ringing=false;if(ringTimer){clearInterval(ringTimer);ringTimer=null}};
 const loadScript=(src,test)=>new Promise((resolve,reject)=>{if(test())return resolve();const s=document.createElement('script');s.src=src;s.onload=resolve;s.onerror=()=>reject(new Error('Script load failed'));document.head.appendChild(s)});const loadPeer=()=>loadScript('https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js',()=>!!window.Peer);const loadQr=()=>loadScript('https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js',()=>!!window.QRCode);
 const renderQr=async()=>{if(!roomUrl)return;await loadQr();qr.innerHTML='';qrPanel.hidden=false;new window.QRCode(qr,{text:roomUrl,width:180,height:180,correctLevel:window.QRCode.CorrectLevel.M})};
 const startLocal=async()=>{if(stream)return stream;setStatus(text.micPermission);try{stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true},video:false});stream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;mic.textContent=text.stopMic;return stream}catch(e){console.error('FOX microphone',e);setStatus(`${text.error} (${e?.name||'MIC'})`);throw e}};
 const sendPacket=data=>{if(dataConn?.open){try{dataConn.send(data);return true}catch(e){console.error('FOX data send',e)}}return false};
 const speak=(value,lang)=>{if(!('speechSynthesis'in window)||!value)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(value);u.lang=lang==='de'?'de-DE':'sk-SK';u.rate=.96;u.pitch=1;const voices=speechSynthesis.getVoices();const v=voices.find(x=>x.lang.toLowerCase().startsWith(u.lang.slice(0,2).toLowerCase()));if(v)u.voice=v;try{speechSynthesis.speak(u)}catch(e){console.error('FOX browser TTS',e)}};
 const showIncoming=d=>{if(d?.translatedText){received.textContent=d.translatedText;translationStatus.textContent=text.ready;if(translationMode)speak(d.translatedText,role==='host'?'de':'sk')}};
 const wireData=conn=>{dataConn=conn;conn.on('open',()=>{if(role==='client'){setStatus(text.waiting);callBtn.disabled=false;callBtn.textContent=text.call}});conn.on('data',d=>{if(d?.type==='call-request'&&role==='host'){pendingConn=conn;callBtn.disabled=false;callBtn.textContent=text.accept;setStatus(text.incoming);startRingtone()}else if(d?.type==='call-accepted'&&role==='client'){setStatus(text.connecting);clearTimers();mediaTimer=setTimeout(()=>{if(!mediaConnected){setStatus(text.timeout);callBtn.disabled=false;callBtn.textContent=text.call}},20000)}else if(d?.type==='translation')showIncoming(d)});conn.on('close',()=>{if(dataConn===conn)dataConn=null;stopRingtone();if(role==='client'&&!mediaConnected){setStatus(text.timeout);callBtn.disabled=false;callBtn.textContent=text.call}});conn.on('error',e=>{console.error('FOX data',e);if(role==='client'){setStatus(text.timeout);callBtn.disabled=false;callBtn.textContent=text.call}})};
 const ensurePeer=async()=>{if(peer)return peer;await loadPeer();peer=new window.Peer();peer.on('open',()=>{ready=true;if(role==='client'){callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.waiting)}});peer.on('error',e=>{console.error('FOX Peer',e);if(role==='client'){setStatus(text.error);callBtn.disabled=false;callBtn.textContent=text.call}});if(role==='host'){peer.on('connection',wireData);peer.on('call',incoming=>{pendingConn=incoming;callBtn.disabled=false;callBtn.textContent=text.accept;setStatus(text.incoming);startRingtone()});}else{peer.on('connection',wireData);peer.on('call',incoming=>{if(stream)incoming.answer(stream);mediaCall=incoming;incoming.on('stream',remote=>{originalAudio.srcObject=remote;originalAudio.play().catch(()=>{});mediaConnected=true;setStatus(text.connected);callBtn.disabled=true;clearTimers()});});}return peer};
 const placeCall=async()=>{if(pendingConn){try{callBtn.disabled=true;callBtn.textContent=text.accepting;const s=await startLocal();pendingConn.answer(s);mediaCall=pendingConn;pendingConn=null;mediaCall.on('stream',remote=>{originalAudio.srcObject=remote;originalAudio.play().catch(()=>{});mediaConnected=true;setStatus(text.connected);clearTimers()});return}catch(e){callBtn.disabled=false;callBtn.textContent=text.accept;setStatus(text.error);return}}if(!remoteId){setStatus(text.waiting);return}try{await ensurePeer();if(!ready){setStatus(text.connecting);await new Promise((resolve,reject)=>{const timeout=setTimeout(()=>reject(new Error('Peer open timeout')),10000);const done=()=>{clearTimeout(timeout);resolve()};if(ready)done();else peer.once('open',done);});}const s=await startLocal();callBtn.disabled=true;callBtn.textContent=text.calling;setStatus(text.calling);dataConn=peer.connect(remoteId,{label:'fox-call-control',reliable:true});wireData(dataConn);const sendRequest=()=>{try{dataConn.send({type:'call-request'})}catch(e){console.error('FOX request',e);callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.error)}};if(dataConn.open)sendRequest();else dataConn.on('open',sendRequest);callTimer=setTimeout(()=>{if(!mediaConnected){callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.timeout)}},20000)}catch(e){console.error('FOX call',e);callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.error)}};
 create.addEventListener('click',async()=>{try{await ensurePeer();const onOpen=id=>{roomUrl=location.origin+location.pathname+'?foxPeer='+encodeURIComponent(id);link.value=roomUrl;invite.classList.remove('hidden');share.disabled=false;copyBtn.disabled=false;callBtn.disabled=true;setStatus(text.waiting);renderQr().catch(e=>console.error('FOX QR',e))};if(peer.open)onOpen(peer.id);else peer.once('open',()=>onOpen(peer.id));}catch(e){console.error('FOX create',e);setStatus(text.error)}});
 copyBtn.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(roomUrl);setStatus(text.invite)}catch{link.select();document.execCommand('copy')}});
 share.addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title:text.title,url:roomUrl})}catch{}}else{try{await navigator.clipboard.writeText(roomUrl);setStatus(text.invite)}catch{link.select();document.execCommand('copy')}}});
 callBtn.addEventListener('click',placeCall);
 mic.addEventListener('click',()=>{if(stream){stream.getAudioTracks().forEach(x=>x.enabled=!x.enabled);mic.textContent=stream.getAudioTracks()[0].enabled?text.stopMic:text.mic}});
 if(remoteId){callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.waiting);ensurePeer().catch(e=>{console.error('FOX client init',e);callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.error)})}
}
</script>
