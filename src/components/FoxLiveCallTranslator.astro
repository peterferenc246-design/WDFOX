---
interface Props { locale: string; }
const { locale } = Astro.props;
const copy = {
  sk: { title:'FOX LIVE KOMUNIKÁTOR', intro:'Živý hlasový hovor so simultánnym prepisom a prekladom SK ↔ DE.', create:'VYTVORIŤ SPOJENIE', call:'USKUTOČNIŤ HOVOR', accept:'PRIJATIE HOVORU', calling:'VOLÁM…', accepting:'PRIJÍMAM HOVOR…', waiting:'Čakám na druhé zariadenie…', connected:'HOVOR AKTÍVNY', incoming:'PRICHÁDZAJÚCI HOVOR – prijmi hovor', share:'Zdieľať pozvánku', copy:'Kopírovať odkaz', code:'Kód spojenia', invite:'Pošli odkaz alebo nech klient naskenuje QR kód.', mic:'ZAPNÚŤ MIKROFÓN', stopMic:'VYPNÚŤ MIKROFÓN', outgoing:'ODOSLANÉ · SLOVENČINA', incomingLabel:'PRIJATÉ · DEUTSCH', outgoingMobile:'ODOSLANÉ · DEUTSCH', incomingMobile:'PRIJATÉ · SLOVENČINA', ownPlaceholder:'Tvoje hovorené slová sa zobrazia tu…', remotePlaceholder:'Preložená replika sa zobrazí tu…', processing:'Preklad…', ready:'Preklad je aktívny.', error:'Preklad sa nepodaril – pokračujem v hovore.', translator:'FOX LIVE PREKLAD', original:'Pôvodný hlas', translated:'Preložený hlas', language:'Režim: SK ↔ DE', privacy:'Hlasové segmenty sa posielajú na server iba na účely prepisu, prekladu a syntézy hlasu.' },
  de: { title:'FOX LIVE KOMMUNIKATOR', intro:'Live-Sprachverbindung mit Transkript und Übersetzung SK ↔ DE.', create:'VERBINDUNG ERSTELLEN', call:'ANRUF STARTEN', accept:'ANRUF ANNEHMEN', calling:'ANRUF…', accepting:'ANRUF WIRD ANGENOMMEN…', waiting:'Warte auf das zweite Gerät…', connected:'ANRUF AKTIV', incoming:'EINGEHENDER ANRUF – Anruf annehmen', share:'Einladung teilen', copy:'Link kopieren', code:'Verbindungscode', invite:'Link senden oder QR-Code scannen.', mic:'MIKROFON EINSCHALTEN', stopMic:'MIKROFON AUSSCHALTEN', outgoing:'GESENDET · DEUTSCH', incomingLabel:'EMPFANGEN · SLOVAKISCH', outgoingMobile:'GESENDET · SLOVAKISCH', incomingMobile:'EMPFANGEN · DEUTSCH', ownPlaceholder:'Ihre gesprochenen Worte erscheinen hier…', remotePlaceholder:'Die übersetzte Antwort erscheint hier…', processing:'Übersetzung…', ready:'Live-Übersetzung aktiv.', error:'Übersetzung fehlgeschlagen – der Anruf bleibt aktiv.', translator:'FOX LIVE ÜBERSETZER', original:'Originalstimme', translated:'Übersetzte Stimme', language:'Modus: SK ↔ DE', privacy:'Sprachsegmente werden nur für Transkription, Übersetzung und Sprachsynthese an den Server gesendet.' },
  en: { title:'FOX LIVE COMMUNICATOR', intro:'Live voice call with transcript and translation SK ↔ DE.', create:'CREATE CONNECTION', call:'MAKE A CALL', accept:'ACCEPT CALL', calling:'CALLING…', accepting:'ACCEPTING CALL…', waiting:'Waiting for the second device…', connected:'CALL ACTIVE', incoming:'INCOMING CALL – accept it', share:'Share invitation', copy:'Copy link', code:'Connection code', invite:'Send the link or scan the QR code.', mic:'TURN MICROPHONE ON', stopMic:'TURN MICROPHONE OFF', outgoing:'SENT · SLOVAK', incomingLabel:'RECEIVED · GERMAN', outgoingMobile:'SENT · GERMAN', incomingMobile:'RECEIVED · SLOVAK', ownPlaceholder:'Your spoken words will appear here…', remotePlaceholder:'The translated reply will appear here…', processing:'Translating…', ready:'Live translation active.', error:'Translation failed – the call remains active.', translator:'FOX LIVE TRANSLATOR', original:'Original voice', translated:'Translated voice', language:'Mode: SK ↔ DE', privacy:'Voice segments are sent to the server only for transcription, translation and speech synthesis.' }
};
const t = copy[locale as keyof typeof copy] || copy.en;
---
<section class="fox-call" data-call-app data-copy={JSON.stringify(t)}>
  <div class="shell">
    <p class="eyebrow">FOX TECHNOLOGY LAB</p>
    <h2>{t.title}</h2>
    <p class="intro">{t.intro}</p>
    <div class="status" data-status>{t.waiting}</div>
    <div class="actions">
      <button class="primary" data-create>{t.create}</button>
      <button class="call" data-call disabled>{t.call}</button>
      <button class="secondary" data-share disabled>{t.share}</button>
      <button class="secondary" data-copy disabled>{t.copy}</button>
    </div>
    <div class="invite hidden" data-invite>
      <label>{t.code}</label><input data-link readonly /><p>{t.invite}</p>
    </div>
    <div class="qr" data-qr-panel hidden><div data-qr></div></div>
    <div class="call-grid">
      <article class="transcript sent"><header data-sent-label>{t.outgoing}</header><p data-sent>{t.ownPlaceholder}</p></article>
      <article class="transcript received"><header data-received-label>{t.incomingLabel}</header><p data-received>{t.remotePlaceholder}</p></article>
    </div>
    <div class="livebar hidden" data-livebar>
      <strong>{t.translator}</strong><span data-translation-status>{t.ready}</span><span>{t.language}</span>
    </div>
    <div class="controls">
      <button class="mic" data-mic disabled>{t.mic}</button>
      <button class="secondary" data-original disabled>{t.original}</button>
      <button class="secondary active" data-translated disabled>{t.translated}</button>
    </div>
    <audio data-original-audio autoplay playsinline></audio>
    <audio data-translation-audio autoplay playsinline></audio>
    <p class="privacy">🔒 {t.privacy}</p>
  </div>
</section>
<style>
.fox-call{padding:0 0 42px}.shell{border-radius:28px;background:#121a2a;color:#fff;padding:30px;box-shadow:0 22px 60px rgba(20,24,35,.12)}.eyebrow{margin:0;color:#f36a0a;font-size:10px;font-weight:900;letter-spacing:.12em}.shell h2{margin:5px 0 8px;font-size:clamp(24px,4vw,38px);letter-spacing:-.03em}.intro{margin:0;color:#b9c1ce;font-size:14px;line-height:1.6}.status{margin:20px 0;padding:13px 15px;border-radius:13px;background:#1d2635;color:#dce2ea;font-size:13px}.actions{display:flex;gap:9px;flex-wrap:wrap}.actions button,.controls button{border:0;border-radius:12px;padding:12px 15px;font-size:11px;font-weight:900;cursor:pointer}.primary{background:#f36a0a;color:#fff}.call{background:#18a957;color:#fff}.secondary{background:#fff;color:#172033}.secondary.active{background:#f36a0a;color:#fff}.actions button:disabled,.controls button:disabled{opacity:.4;cursor:default}.invite{margin-top:16px}.hidden{display:none!important}.invite label{display:block;margin-bottom:7px;color:#b9c1ce;font-size:10px;font-weight:800;text-transform:uppercase}.invite input{width:100%;box-sizing:border-box;border:1px solid #344054;border-radius:11px;background:#0d1420;color:#fff;padding:12px;font-size:13px}.invite p{margin:8px 0 0;color:#98a2b3;font-size:11px}.qr{display:flex;justify-content:center;margin:18px 0}.qr>div{background:#fff;padding:12px;border-radius:16px}.call-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px}.transcript{min-height:145px;border-radius:18px;padding:17px 19px;background:#fff;color:#172033}.transcript.received{background:#fffdfa;border:1px solid #f6d8c3}.transcript header{font-size:11px;font-weight:900;letter-spacing:.06em;color:#f36a0a}.transcript p{margin:22px 0 0;font-size:16px;line-height:1.55;white-space:pre-wrap}.livebar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:14px;padding:12px 14px;border-radius:13px;background:#1d2635;font-size:11px}.livebar span{color:#b9c1ce}.controls{display:flex;gap:9px;margin-top:14px}.privacy{margin:16px 0 0;text-align:center;color:#98a0ad;font-size:10px}.shell audio{display:none}@media(max-width:700px){.shell{padding:22px;border-radius:22px}.actions,.controls{display:grid;grid-template-columns:1fr}.actions button,.controls button{width:100%}.call-grid{grid-template-columns:1fr}.transcript{min-height:120px}}
</style>
<script define:vars={{ t }}>
const root=document.querySelector('[data-call-app]');
if(root){
 const text=JSON.parse(root.dataset.copy||'{}');
 const create=root.querySelector('[data-create]'); const callBtn=root.querySelector('[data-call]'); const share=root.querySelector('[data-share]'); const copyBtn=root.querySelector('[data-copy]'); const invite=root.querySelector('[data-invite]'); const link=root.querySelector('[data-link]'); const qrPanel=root.querySelector('[data-qr-panel]'); const qr=root.querySelector('[data-qr]'); const status=root.querySelector('[data-status]'); const sent=root.querySelector('[data-sent]'); const received=root.querySelector('[data-received]'); const sentLabel=root.querySelector('[data-sent-label]'); const receivedLabel=root.querySelector('[data-received-label]'); const mic=root.querySelector('[data-mic]'); const livebar=root.querySelector('[data-livebar]'); const translationStatus=root.querySelector('[data-translation-status]'); const originalBtn=root.querySelector('[data-original]'); const translatedBtn=root.querySelector('[data-translated]'); const originalAudio=root.querySelector('[data-original-audio]'); const translationAudio=root.querySelector('[data-translation-audio]');
 let peer=null,mediaCall=null,dataConn=null,stream=null,pendingConn=null,roomUrl='',ready=false,role=location.search.includes('foxPeer=')?'client':'host'; let recorder=null,recording=false,queue=[],processing=false,translationMode=true; const remoteId=new URLSearchParams(location.search).get('foxPeer');
 const API='https://wdfox.vercel.app/api/translate-voice';
 const loadScript=(src,test)=>new Promise((resolve,reject)=>{if(test())return resolve();const s=document.createElement('script');s.src=src;s.onload=resolve;s.onerror=reject;document.head.appendChild(s);});
 const loadPeer=()=>loadScript('https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js',()=>!!window.Peer); const loadQr=()=>loadScript('https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js',()=>!!window.QRCode);
 const setStatus=m=>status.textContent=m; const setLabels=()=>{if(role==='host'){sentLabel.textContent=text.outgoing;receivedLabel.textContent=text.incomingLabel;}else{sentLabel.textContent=text.outgoingMobile;receivedLabel.textContent=text.incomingMobile;}}; setLabels();
 const startLocal=async()=>{if(!stream)stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true},video:false});stream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;mic.textContent=text.stopMic;return stream;};
 const wireMedia=mc=>{mediaCall=mc;mc.on('stream',remote=>{originalAudio.srcObject=remote;originalAudio.volume=translationMode?0:1;originalAudio.play().catch(()=>{});});mc.on('close',()=>{mediaCall=null;stopTranslation();setStatus(text.waiting);});mc.on('error',()=>setStatus(text.error));};
 const sendPacket=data=>{if(dataConn?.open){try{dataConn.send(data);return true;}catch{}}return false;};
 const playBase64=async(b64,mime='audio/wav')=>{const bytes=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));const blob=new Blob([bytes],{type:mime});const url=URL.createObjectURL(blob);translationAudio.src=url;translationAudio.volume=1;await translationAudio.play().catch(()=>{});translationAudio.onended=()=>URL.revokeObjectURL(url);};
 const showIncomingPacket=data=>{if(data?.transcript){received.textContent=data.translatedText||data.transcript;translationStatus.textContent=text.ready;}if(data?.audioBase64&&translationMode)playBase64(data.audioBase64,data.audioMimeType||'audio/wav');};
 const translateChunk=async blob=>{if(blob.size<1200)return;const form=new FormData();form.append('audio',blob,'fox-live.webm');form.append('sourceLanguage',role==='host'?'sk':'de');form.append('targetLanguage',role==='host'?'de':'sk');form.append('speakResult','true');translationStatus.textContent=text.processing;try{const r=await fetch(API,{method:'POST',body:form});const data=await r.json();if(!r.ok)throw new Error(data?.error||'translation failed');sent.textContent=data.transcript||sent.textContent;received.textContent=data.translatedText||received.textContent;sendPacket({type:'translation',transcript:data.transcript,translatedText:data.translatedText,audioBase64:data.audioBase64||null,audioMimeType:data.audioMimeType||'audio/wav'});translationStatus.textContent=text.ready;}catch(e){translationStatus.textContent=text.error;}};
 const drainQueue=async()=>{if(processing)return;processing=true;while(queue.length){const b=queue.shift();await translateChunk(b);}processing=false;};
 const startTranslation=async()=>{if(recording||!stream)return;try{recorder=new MediaRecorder(stream,{mimeType:MediaRecorder.isTypeSupported('audio/webm;codecs=opus')?'audio/webm;codecs=opus':'audio/webm'});recorder.ondataavailable=e=>{if(e.data?.size){queue.push(e.data);drainQueue();}};recorder.onstart=()=>{recording=true;translationStatus.textContent=text.ready;};recorder.start(3000);}catch{translationStatus.textContent=text.error;}};
 const stopTranslation=()=>{if(recorder){try{recorder.stop()}catch{}recorder=null}recording=false;queue=[];};
 const activateTranslation=async()=>{await startLocal();livebar.classList.remove('hidden');originalBtn.disabled=false;translatedBtn.disabled=false;originalAudio.volume=translationMode?0:1;await startTranslation();};
 const acceptIncoming=async()=>{if(!pendingConn)return;try{callBtn.disabled=true;callBtn.textContent=text.accepting;await startLocal();const target=pendingConn.peer;sendPacket({type:'call-accepted'});mediaCall=peer.call(target,stream,{metadata:{app:'FOX LIVE',version:'0.4.0'}});wireMedia(mediaCall);pendingConn=null;await activateTranslation();setStatus(text.connected);}catch{callBtn.disabled=false;callBtn.textContent=text.accept;setStatus(text.error);}};
 const setupIncoming=conn=>{pendingConn=conn;dataConn=conn;conn.on('data',d=>{if(d?.type==='call-request'){callBtn.disabled=false;callBtn.textContent=text.accept;setStatus(text.incoming);}if(d?.type==='translation')showIncomingPacket(d);});conn.on('close',()=>{if(pendingConn===conn){pendingConn=null;callBtn.disabled=true;callBtn.textContent=text.call;}});};
 const requestCall=async()=>{if(!peer||!ready||!remoteId){setStatus(text.waiting);return;}try{await startLocal();callBtn.disabled=true;callBtn.textContent=text.calling;setStatus(text.calling);dataConn=peer.connect(remoteId,{label:'fox-call-control',reliable:true,metadata:{app:'FOX LIVE',version:'0.4.0'}});dataConn.on('open',()=>sendPacket({type:'call-request'}));dataConn.on('data',d=>{if(d?.type==='call-accepted')setStatus(text.calling);if(d?.type==='translation')showIncomingPacket(d);});dataConn.on('close',()=>{if(!mediaCall){callBtn.disabled=false;callBtn.textContent=text.call;}});}catch{callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.error);}};
 const initHost=async()=>{await loadPeer();peer=new window.Peer({host:'0.peerjs.com',port:443,path:'/',secure:true,debug:1});peer.on('open',id=>{ready=true;roomUrl=`${location.origin}${location.pathname}?foxPeer=${encodeURIComponent(id)}`;link.value=roomUrl;invite.classList.remove('hidden');share.disabled=false;copyBtn.disabled=false;setStatus(text.waiting);loadQr().then(()=>{qr.innerHTML='';new window.QRCode(qr,{text:roomUrl,width:210,height:210});qrPanel.hidden=false;});});peer.on('connection',setupIncoming);peer.on('error',()=>setStatus(text.error));};
 const initClient=async()=>{await loadPeer();peer=new window.Peer({host:'0.peerjs.com',port:443,path:'/',secure:true,debug:1});peer.on('open',()=>{ready=true;callBtn.disabled=false;setStatus(text.waiting);});peer.on('call',incoming=>{incoming.answer(stream||undefined);wireMedia(incoming);activateTranslation().catch(()=>{});});peer.on('connection',conn=>{dataConn=conn;conn.on('data',d=>{if(d?.type==='call-accepted')setStatus(text.calling);if(d?.type==='translation')showIncomingPacket(d);});});peer.on('error',()=>setStatus(text.error));};
 create.addEventListener('click',async()=>{create.disabled=true;try{await initHost();}catch{create.disabled=false;setStatus(text.error);}}); callBtn.addEventListener('click',()=>pendingConn?acceptIncoming():requestCall());
 copyBtn.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(roomUrl);setStatus(text.invite);}catch{link.select();document.execCommand('copy');}}); share.addEventListener('click',async()=>{try{await navigator.share({title:text.title,url:roomUrl});}catch{try{await navigator.clipboard.writeText(roomUrl);}catch{}}});
 mic.addEventListener('click',()=>{if(stream){const enabled=stream.getAudioTracks()[0].enabled;stream.getAudioTracks().forEach(x=>x.enabled=!enabled);mic.textContent=enabled?text.mic:text.stopMic;}});
 originalBtn.addEventListener('click',()=>{translationMode=false;originalAudio.volume=1;originalBtn.classList.add('active');translatedBtn.classList.remove('active');}); translatedBtn.addEventListener('click',()=>{translationMode=true;originalAudio.volume=0;originalBtn.classList.remove('active');translatedBtn.classList.add('active');});
 if(remoteId)initClient().catch(()=>setStatus(text.error));
}
</script>
