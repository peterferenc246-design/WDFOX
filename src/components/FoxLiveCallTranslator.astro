---
interface Props { locale: string; }
const { locale } = Astro.props;
const copy = {
 sk:{title:'FOX LIVE KOMUNIKÁTOR',intro:'Živý hlasový hovor so simultánnym prepisom a prekladom SK ↔ DE.',create:'VYTVORIŤ SPOJENIE',call:'USKUTOČNIŤ HOVOR',accept:'PRIJATIE HOVORU',calling:'VOLÁM…',connecting:'PRIPÁJAM HOVOR…',accepting:'PRIJÍMAM HOVOR…',waiting:'Čakám na druhé zariadenie…',connected:'HOVOR AKTÍVNY',incoming:'PRICHÁDZAJÚCI HOVOR – druhá strana volá',micPermission:'Povoľ mikrofón…',timeout:'Spojenie sa nepodarilo. Skús hovor znova.',share:'Zdieľať pozvánku',copy:'Kopírovať odkaz',code:'Kód spojenia',invite:'Pošli odkaz alebo nech klient naskenuje QR kód.',mic:'ZAPNÚŤ MIKROFÓN',stopMic:'VYPNÚŤ MIKROFÓN',outgoing:'ODOSLANÉ · SLOVENČINA',incomingLabel:'PRIJATÉ · DEUTSCH',outgoingMobile:'ODOSLANÉ · SLOVENČINA',incomingMobile:'PRIJATÉ · DEUTSCH',ownPlaceholder:'Tvoje hovorené slová sa zobrazia tu…',remotePlaceholder:'Preložená replika sa zobrazí tu…',processing:'Preklad…',ready:'Preklad je aktívny.',error:'Preklad sa nepodaril – hovor zostáva aktívny.',translator:'FOX LIVE PREKLAD',original:'Pôvodný hlas',translated:'Preložený hlas',language:'Režim: SK ↔ DE',privacy:'Hlas sa prenáša priamo medzi zariadeniami. Prekladá sa rozpoznaný text a výsledok sa prenáša druhej strane.'},
 de:{title:'FOX LIVE KOMMUNIKATOR',intro:'Live-Sprachverbindung mit Transkript und Übersetzung SK ↔ DE.',create:'VERBINDUNG ERSTELLEN',call:'ANRUF STARTEN',accept:'ANRUF ANNEHMEN',calling:'ANRUF…',connecting:'ANRUF WIRD VERBUNDEN…',accepting:'ANRUF WIRD ANGENOMMEN…',waiting:'Warte auf das zweite Gerät…',connected:'ANRUF AKTIV',incoming:'EINGEHENDER ANRUF – die andere Seite ruft an',micPermission:'Mikrofon freigeben…',timeout:'Verbindung fehlgeschlagen. Bitte erneut anrufen.',share:'Einladung teilen',copy:'Link kopieren',code:'Verbindungscode',invite:'Link senden oder QR-Code scannen.',mic:'MIKROFON EINSCHALTEN',stopMic:'MIKROFON AUSSCHALTEN',outgoing:'GESENDET · DEUTSCH',incomingLabel:'EMPFANGEN · SLOWAKISCH',outgoingMobile:'GESENDET · SLOWAKISCH',incomingMobile:'EMPFANGEN · DEUTSCH',ownPlaceholder:'Ihre gesprochenen Worte erscheinen hier…',remotePlaceholder:'Die übersetzte Antwort erscheint hier…',processing:'Übersetzung…',ready:'Live-Übersetzung aktiv.',error:'Übersetzung fehlgeschlagen – der Anruf bleibt aktiv.',translator:'FOX LIVE ÜBERSETZER',original:'Originalstimme',translated:'Übersetzte Stimme',language:'Modus: SK ↔ DE',privacy:'Die Sprache wird direkt zwischen den Geräten übertragen. Erkannter Text wird übersetzt und das Ergebnis an die andere Seite gesendet.'},
 en:{title:'FOX LIVE COMMUNICATOR',intro:'Live voice call with transcript and translation SK ↔ DE.',create:'CREATE CONNECTION',call:'MAKE A CALL',accept:'ACCEPT CALL',calling:'CALLING…',connecting:'CONNECTING CALL…',accepting:'ACCEPTING CALL…',waiting:'Waiting for the second device…',connected:'CALL ACTIVE',incoming:'INCOMING CALL – the other side is calling',micPermission:'Allow microphone…',timeout:'Connection failed. Please call again.',share:'Share invitation',copy:'Copy link',code:'Connection code',invite:'Send the link or scan the QR code.',mic:'TURN MICROPHONE ON',stopMic:'TURN MICROPHONE OFF',outgoing:'SENT · SLOVAK',incomingLabel:'RECEIVED · GERMAN',outgoingMobile:'SENT · SLOVAK',incomingMobile:'RECEIVED · GERMAN',ownPlaceholder:'Your spoken words will appear here…',remotePlaceholder:'The translated reply will appear here…',processing:'Translating…',ready:'Live translation active.',error:'Translation failed – the call remains active.',translator:'FOX LIVE TRANSLATOR',original:'Original voice',translated:'Translated voice',language:'Mode: SK ↔ DE',privacy:'Voice is transmitted directly between devices. Recognized text is translated and the result is sent to the other side.'}
};
const t=copy[locale as keyof typeof copy]||copy.en;
---
<section class="fox-call" data-call-app data-copy={JSON.stringify(t)}>
<div class="shell"><p class="eyebrow">FOX TECHNOLOGY LAB</p><h2>{t.title}</h2><p class="intro">{t.intro}</p><div class="status" data-status>{t.waiting}</div>
<div class="actions"><button class="primary" data-create>{t.create}</button><button class="call" data-call disabled>{t.call}</button><button class="secondary" data-share disabled>{t.share}</button><button class="secondary" data-copy disabled>{t.copy}</button></div>
<div class="invite hidden" data-invite><label>{t.code}</label><input data-link readonly/><p>{t.invite}</p></div><div class="qr" data-qr-panel hidden><div data-qr></div></div>
<div class="call-grid"><article class="transcript sent"><header data-sent-label>{t.outgoing}</header><p data-sent>{t.ownPlaceholder}</p></article><article class="transcript received"><header data-received-label>{t.incomingLabel}</header><p data-received>{t.remotePlaceholder}</p></article></div>
<div class="livebar hidden" data-livebar><strong>{t.translator}</strong><span data-translation-status>{t.ready}</span><span>{t.language}</span></div>
<div class="controls"><button class="mic" data-mic disabled>{t.mic}</button><button class="secondary active" data-translated disabled>{t.translated}</button></div>
<audio data-original-audio autoplay playsinline></audio><p class="privacy">🔒 {t.privacy}</p></div></section>
<style>
.fox-call{padding:0 0 42px}.shell{border-radius:28px;background:#121a2a;color:#fff;padding:30px;box-shadow:0 22px 60px rgba(20,24,35,.12)}.eyebrow{margin:0;color:#f36a0a;font-size:10px;font-weight:900;letter-spacing:.12em}.shell h2{margin:5px 0 8px;font-size:clamp(24px,4vw,38px);letter-spacing:-.03em}.intro{margin:0;color:#b9c1ce;font-size:14px;line-height:1.6}.status{margin:20px 0;padding:13px 15px;border-radius:13px;background:#1d2635;color:#dce2ea;font-size:13px}.actions{display:flex;gap:9px;flex-wrap:wrap}.actions button,.controls button{border:0;border-radius:12px;padding:12px 15px;font-size:11px;font-weight:900;cursor:pointer}.primary{background:#f36a0a;color:#fff}.call{background:#18a957;color:#fff}.secondary{background:#fff;color:#172033}.secondary.active{background:#f36a0a;color:#fff}.actions button:disabled,.controls button:disabled{opacity:.4;cursor:default}.invite{margin-top:16px}.hidden{display:none!important}.invite label{display:block;margin-bottom:7px;color:#b9c1ce;font-size:10px;font-weight:800;text-transform:uppercase}.invite input{width:100%;box-sizing:border-box;border:1px solid #344054;border-radius:11px;background:#0d1420;color:#fff;padding:12px;font-size:13px}.invite p{margin:8px 0 0;color:#98a2b3;font-size:11px}.qr{display:flex;justify-content:center;margin:18px 0}.qr>div{background:#fff;padding:12px;border-radius:16px}.call-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px}.transcript{min-height:145px;border-radius:18px;padding:17px 19px;background:#fff;color:#172033}.transcript.received{background:#fffdfa;border:1px solid #f6d8c3}.transcript header{font-size:11px;font-weight:900;letter-spacing:.06em;color:#f36a0a}.transcript p{margin:22px 0 0;font-size:16px;line-height:1.55;white-space:pre-wrap}.livebar{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:14px;padding:12px 14px;border-radius:13px;background:#1d2635;font-size:11px}.livebar span{color:#b9c1ce}.controls{display:flex;gap:9px;margin-top:14px}.privacy{margin:16px 0 0;text-align:center;color:#98a0ad;font-size:10px}.shell audio{display:none}@media(max-width:700px){.shell{padding:22px;border-radius:22px}.actions,.controls{display:grid;grid-template-columns:1fr}.actions button,.controls button{width:100%}.call-grid{grid-template-columns:1fr}.transcript{min-height:120px}}
</style>
<script>
const root=document.querySelector('[data-call-app]');
if(root){
 const text=JSON.parse(root.dataset.copy||'{}');const $=(s)=>root.querySelector(s);const create=$('[data-create]'),callBtn=$('[data-call]'),share=$('[data-share]'),copyBtn=$('[data-copy]'),invite=$('[data-invite]'),link=$('[data-link]'),qrPanel=$('[data-qr-panel]'),qr=$('[data-qr]'),status=$('[data-status]'),sent=$('[data-sent]'),received=$('[data-received]'),sentLabel=$('[data-sent-label]'),receivedLabel=$('[data-received-label]'),mic=$('[data-mic]'),livebar=$('[data-livebar]'),translationStatus=$('[data-translation-status]'),originalAudio=$('[data-original-audio]');
 let peer=null,stream=null,mediaCall=null,pendingMediaCall=null,dataConn=null,pendingConn=null,recognition=null,recognizing=false,roomUrl='';
 const params=new URLSearchParams(location.search),remoteId=params.get('foxPeer'),role=remoteId?'client':'host';
 const TEXT_API='https://wdfox.vercel.app/api/translate-text';
 const setStatus=m=>status.textContent=m;
 if(role==='host'){sentLabel.textContent=text.outgoing;receivedLabel.textContent=text.incomingLabel}else{sentLabel.textContent=text.outgoingMobile;receivedLabel.textContent=text.incomingMobile}
 const loadScript=(src,test)=>new Promise((resolve,reject)=>{if(test())return resolve();const s=document.createElement('script');s.src=src;s.onload=resolve;s.onerror=()=>reject(new Error('Script load failed'));document.head.appendChild(s)});
 const loadPeer=()=>loadScript('https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js',()=>!!window.Peer);const loadQr=()=>loadScript('https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js',()=>!!window.QRCode);
 const waitOpen=()=>new Promise((resolve,reject)=>{if(!peer)return reject(new Error('Peer not ready'));if(peer.open&&peer.id)return resolve(peer.id);const to=setTimeout(()=>reject(new Error('Peer open timeout')),15000);peer.once('open',id=>{clearTimeout(to);resolve(id)});peer.once('error',e=>{clearTimeout(to);reject(e)})});
 const startLocal=async()=>{if(stream)return stream;setStatus(text.micPermission);stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true},video:false});stream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;mic.textContent=text.stopMic;return stream};
 const speak=(value,lang)=>{if(!value||!('speechSynthesis'in window))return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(value);u.lang=lang==='de'?'de-DE':'sk-SK';u.rate=.96;try{speechSynthesis.speak(u)}catch(e){}};
 const showRemoteTranslation=d=>{if(d?.transcript)sent.textContent=d.transcript;if(d?.translatedText){received.textContent=d.translatedText;translationStatus.textContent=text.ready;speak(d.translatedText,role==='host'?'de':'sk')}};
 const sendTranslation=async phrase=>{const clean=String(phrase||'').trim();if(!clean||clean.length<2)return;sent.textContent=clean;translationStatus.textContent=text.processing;try{const r=await fetch(TEXT_API,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:clean,sourceLanguage:role==='host'?'German':'Slovak',targetLanguage:role==='host'?'Slovak':'German'})});if(!r.ok)throw new Error('HTTP '+r.status);const d=await r.json();received.textContent=d.translatedText||'';translationStatus.textContent=text.ready;if(dataConn?.open)dataConn.send({type:'translation',transcript:clean,translatedText:d.translatedText||''});speak(d.translatedText||'',role==='host'?'sk':'de')}catch(e){console.error('FOX text translate',e);translationStatus.textContent=text.error}};
 const startRecognition=()=>{if(recognizing)return;const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){translationStatus.textContent='SpeechRecognition nie je v tomto prehliadači dostupný';return}recognition=new SR();recognition.lang=role==='host'?'de-DE':'sk-SK';recognition.continuous=true;recognition.interimResults=true;recognition.maxAlternatives=1;recognition.onstart=()=>{recognizing=true};recognition.onresult=e=>{let interim='';for(let i=e.resultIndex;i<e.results.length;i++){const s=e.results[i][0].transcript;if(e.results[i].isFinal)void sendTranslation(s);else interim+=s}if(interim)sent.textContent=interim};recognition.onerror=e=>{if(e.error!=='no-speech'&&e.error!=='aborted')console.warn('FOX recognition',e.error)};recognition.onend=()=>{recognizing=false;if(livebar.classList.contains('hidden'))return;setTimeout(()=>{try{recognition?.start()}catch(e){}},250)};try{recognition.start()}catch(e){console.warn('FOX recognition start',e)}};
 const stopRecognition=()=>{recognizing=false;try{recognition?.stop()}catch(e){}};
 const attachMedia=mc=>{if(!mc||mc.__foxAttached)return;mc.__foxAttached=true;mediaCall=mc;mc.on('stream',remote=>{originalAudio.srcObject=remote;originalAudio.muted=true;originalAudio.autoplay=false;setStatus(text.connected);callBtn.disabled=true;callBtn.textContent=text.call});mc.on('close',()=>{stopRecognition();livebar.classList.add('hidden');setStatus(text.waiting);callBtn.disabled=false;callBtn.textContent=text.call});mc.on('error',e=>{console.error('FOX media',e);setStatus(text.error)})};
 const incomingMedia=mc=>{pendingMediaCall=mc;attachMedia(mc);setStatus(text.incoming);callBtn.disabled=false;callBtn.textContent=text.accept};
 const wireData=conn=>{if(!conn||conn.__foxWired)return;conn.__foxWired=true;dataConn=conn;conn.on('open',()=>{if(role==='client'){try{conn.send({type:'call-request'})}catch(e){}}});conn.on('data',d=>{if(d?.type==='call-request'&&role==='host'){pendingConn=conn;if(!pendingMediaCall){setStatus(text.incoming);callBtn.disabled=false;callBtn.textContent=text.accept}}if(d?.type==='translation')showRemoteTranslation(d)});conn.on('close',()=>{if(dataConn===conn)dataConn=null});conn.on('error',e=>console.warn('FOX data',e))};
 const ensurePeer=async()=>{if(peer){if(peer.disconnected)try{peer.reconnect()}catch(e){};return peer}await loadPeer();peer=new window.Peer(undefined,{debug:1,config:{iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun.cloudflare.com:3478'}]}});peer.on('error',e=>{console.error('FOX Peer',e);if(e?.type==='disconnected')try{peer.reconnect()}catch(_){}else setStatus(text.error)});peer.on('disconnected',()=>{try{peer.reconnect()}catch(e){}});peer.on('connection',wireData);peer.on('call',incomingMedia);await waitOpen();return peer};
 const renderQr=async()=>{if(!roomUrl)return;try{await loadQr();qr.innerHTML='';qrPanel.hidden=false;new window.QRCode(qr,{text:roomUrl,width:180,height:180,correctLevel:window.QRCode.CorrectLevel.M})}catch(e){console.error('FOX QR',e)}};
 const createRoom=async()=>{if(role!=='host')return;create.disabled=true;try{await ensurePeer();roomUrl=location.origin+location.pathname+'?foxPeer='+encodeURIComponent(peer.id);link.value=roomUrl;invite.classList.remove('hidden');share.disabled=false;copyBtn.disabled=false;callBtn.disabled=true;setStatus(text.waiting);await renderQr()}catch(e){console.error('FOX room',e);setStatus(text.error)}finally{create.disabled=false}};
 const placeCall=async()=>{if(role!=='client'||!remoteId)return;callBtn.disabled=true;callBtn.textContent=text.calling;setStatus(text.calling);try{await ensurePeer();await startLocal();const mc=peer.call(remoteId,stream,{metadata:{foxLive:true}});attachMedia(mc);mc.on('error',e=>{console.error('FOX outgoing media',e);setStatus(text.error);callBtn.disabled=false});try{const c=peer.connect(remoteId,{reliable:true,metadata:{foxLive:true}});wireData(c)}catch(e){console.warn('FOX data optional',e)}livebar.classList.remove('hidden');translationStatus.textContent=text.ready;startRecognition();setStatus(text.connecting)}catch(e){console.error('FOX call',e);setStatus(text.timeout);callBtn.disabled=false;callBtn.textContent=text.call}};
 const acceptCall=async()=>{if(role!=='host'||!pendingMediaCall)return;callBtn.disabled=true;callBtn.textContent=text.accepting;setStatus(text.accepting);try{const local=await startLocal();const mc=pendingMediaCall;pendingMediaCall=null;mc.answer(local);attachMedia(mc);if(pendingConn?.open)pendingConn.send({type:'call-accepted'});livebar.classList.remove('hidden');translationStatus.textContent=text.ready;startRecognition();setStatus(text.connected)}catch(e){console.error('FOX accept',e);setStatus(text.error);callBtn.disabled=false;callBtn.textContent=text.call}};
 create.addEventListener('click',createRoom);callBtn.addEventListener('click',()=>{if(role==='host')return acceptCall();return placeCall()});share.addEventListener('click',async()=>{try{if(navigator.share)await navigator.share({title:text.title,url:roomUrl})}catch(e){}});copyBtn.addEventListener('click',async()=>{if(!roomUrl)return;try{await navigator.clipboard.writeText(roomUrl);setStatus(text.waiting)}catch(e){link.select();document.execCommand('copy')}});mic.addEventListener('click',()=>{if(stream){const tr=stream.getAudioTracks()[0];tr.enabled=!tr.enabled;mic.textContent=tr.enabled?text.stopMic:text.mic}});
 ensurePeer().catch(e=>console.warn('FOX init',e));
}
</script>