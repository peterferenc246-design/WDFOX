---
interface Props { locale: string }
const { locale } = Astro.props
const t = locale === 'de'
  ? { title:'FOX LIVE KOMMUNIKATOR', intro:'Live-Sprachverbindung mit Transkript und Übersetzung SK ↔ DE.', create:'VERBINDUNG ERSTELLEN', call:'ANRUF STARTEN', accept:'ANRUF ANNEHMEN', wait:'Warte auf das zweite Gerät…', incoming:'EINGEHENDER ANRUF', mic:'MIKROFON EINSCHALTEN', stop:'MIKROFON AUSSCHALTEN', sent:'GESENDET · DEUTSCH', received:'EMPFANGEN · SLOWAKISCH', invite:'Einladung senden oder QR-Code scannen.', copied:'Link kopiert.' }
  : { title:'FOX LIVE KOMUNIKÁTOR', intro:'Živý hlasový hovor so simultánnym prepisom a prekladom SK ↔ DE.', create:'VYTVORIŤ SPOJENIE', call:'USKUTOČNIŤ HOVOR', accept:'PRIJATIE HOVORU', wait:'Čakám na druhé zariadenie…', incoming:'PRICHÁDZAJÚCI HOVOR', mic:'ZAPNÚŤ MIKROFÓN', stop:'VYPNÚŤ MIKROFÓN', sent:'ODOSLANÉ · SLOVENČINA', received:'PRIJATÉ · DEUTSCH', invite:'Pošli odkaz alebo naskenuj QR kód.', copied:'Odkaz skopírovaný.' }
---
<section class="fox-call" data-app data-copy={JSON.stringify(t)}>
  <div class="shell">
    <p class="eyebrow">FOX TECHNOLOGY LAB</p>
    <h2>{t.title}</h2>
    <p class="intro">{t.intro}</p>
    <div class="status" data-status>{t.wait}</div>
    <div class="actions">
      <button class="primary" data-create>{t.create}</button>
      <button class="call" data-call disabled>{t.call}</button>
    </div>
    <div class="invite hidden" data-invite>
      <input data-link readonly aria-label="Connection link" />
      <div class="qr-wrap"><div data-qr></div><small>{t.invite}</small></div>
    </div>
    <div class="grid">
      <article><header>{t.sent}</header><div class="history" data-sent>—</div></article>
      <article><header>{t.received}</header><div class="history" data-received>—</div></article>
    </div>
    <div class="live hidden" data-live><b>FOX LIVE PREKLAD</b><span data-translation>Čakám na hovorenú vetu…</span></div>
    <div class="controls">
      <button class="mic" data-mic disabled>{t.mic}</button>
      <button class="secondary" data-audio>🔊 AUDIO</button>
    </div>
    <audio data-audio-el autoplay playsinline></audio>
  </div>
</section>
<style>
.fox-call{padding:0 0 42px}.shell{border-radius:28px;background:#121a2a;color:#fff;padding:30px}.eyebrow{margin:0;color:#f36a0a;font-size:10px;font-weight:900;letter-spacing:.12em}.shell h2{margin:5px 0 8px;font-size:clamp(24px,4vw,38px)}.intro{margin:0;color:#b9c1ce;font-size:14px;line-height:1.6}.status{margin:20px 0;padding:13px 15px;border-radius:13px;background:#1d2635;color:#dce2ea;font-size:13px}.actions,.controls{display:flex;gap:9px;flex-wrap:wrap}.actions button,.controls button{border:0;border-radius:12px;padding:12px 15px;font-size:11px;font-weight:900;cursor:pointer;min-height:42px}.primary{background:#f36a0a;color:#fff}.call{background:#18a957;color:#fff}.secondary{background:#fff;color:#172033}.hidden{display:none!important}.actions button:disabled,.controls button:disabled{opacity:.4;cursor:not-allowed}.invite{margin-top:16px}.invite input{width:100%;box-sizing:border-box;border:1px solid #344054;border-radius:11px;background:#0d1420;color:#fff;padding:12px}.qr-wrap{margin-top:14px;background:#fff;color:#172033;border-radius:16px;padding:14px;text-align:center;width:max-content;max-width:100%}.qr-wrap [data-qr]{width:210px;min-height:210px;display:flex;align-items:center;justify-content:center}.qr-wrap img,.qr-wrap canvas{display:block!important;max-width:210px;height:auto!important;margin:auto}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px}.grid article{background:#fff;color:#172033;border-radius:18px;padding:17px 19px;min-height:145px}.grid article+article{background:#fffdfa;border:1px solid #f6d8c3}.grid header{color:#f36a0a;font-weight:900;font-size:11px}.history{margin-top:14px;max-height:360px;overflow:auto;font-size:15px;line-height:1.55;word-break:break-word}.flow{display:block}.sentence:not(:last-child)::after{content:' '}.live{display:flex;gap:15px;margin-top:14px;padding:12px 14px;border-radius:13px;background:#1d2635;font-size:11px}.live span{color:#b9c1ce}.controls{margin-top:14px}.shell audio{display:none}@media(max-width:700px){.shell{padding:18px;border-radius:22px}.actions,.controls{display:grid;grid-template-columns:1fr}.actions button,.controls button{width:100%;display:block}.grid{grid-template-columns:1fr}.qr-wrap{width:100%;box-sizing:border-box}.history{max-height:260px}}
</style>
<script>
const root=document.querySelector('[data-app]');
if(root){
 const t=JSON.parse(root.dataset.copy||'{}'),q=s=>root.querySelector(s),create=q('[data-create]'),callBtn=q('[data-call]'),status=q('[data-status]'),invite=q('[data-invite]'),link=q('[data-link]'),qr=q('[data-qr]'),sent=q('[data-sent]'),received=q('[data-received]'),mic=q('[data-mic]'),live=q('[data-live]'),translation=q('[data-translation]'),audio=q('[data-audio-el]'),audioBtn=q('[data-audio]');
 const params=new URLSearchParams(location.search),remoteId=params.get('foxPeer'),role=remoteId?'client':'host';
 const sourceLanguage=role==='host'?'Slovak':'German',targetLanguage=role==='host'?'German':'Slovak',sourceLocale=role==='host'?'sk-SK':'de-DE',targetLocale=role==='host'?'de-DE':'sk-SK';
 const API='https://wdfox-live-translator.vercel.app/api/translate-text';
 let peer=null,ready=null,stream=null,pending=null,data=null,queue=[],recognition=null,ring=null,audioCtx=null,recognizing=false,roomUrl='';
 const set=s=>status.textContent=s;
 const punct=s=>{s=String(s||'').trim();return s?(/[.!?…]$/.test(s)?s:s+'.'):''};
 const add=(box,text)=>{text=punct(text);if(!text)return;let flow=box.querySelector('.flow');if(!flow){box.innerHTML='';flow=document.createElement('div');flow.className='flow';box.appendChild(flow)}const el=document.createElement('span');el.className='sentence';el.textContent=text;flow.appendChild(el);box.scrollTop=box.scrollHeight};
 const clear=box=>{if(box.textContent.trim()==='—')box.innerHTML=''};
 const send=m=>{if(data?.open){try{data.send(m);return}catch(e){}}queue.push(m)};
 const flush=()=>{while(data?.open&&queue.length){try{data.send(queue.shift())}catch(e){break}}};
 const wire=c=>{if(!c||c.__fox)return;c.__fox=true;data=c;c.on('open',flush);c.on('data',m=>{if(m?.type==='translation'){clear(received);add(received,m.translatedText);translation.textContent='Preklad je aktívny.';speak(m.translatedText,targetLocale)}})};
 const loadPeer=()=>new Promise((ok,bad)=>{if(window.Peer)return ok();const s=document.createElement('script');s.src='https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js';s.onload=ok;s.onerror=bad;document.head.appendChild(s)});
 const openPeer=async()=>{await loadPeer();if(ready)return ready;peer=new Peer(undefined,{config:{iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun.cloudflare.com:3478'}]}});peer.on('call',incoming);peer.on('connection',wire);peer.on('error',e=>{console.error(e);set('PeerJS: '+(e?.type||e?.message||'chyba'))});ready=new Promise((ok,bad)=>{const tm=setTimeout(()=>bad(Error('PeerJS timeout')),20000);peer.once('open',id=>{clearTimeout(tm);ok(id)})});return ready};
 const local=async()=>{if(stream)return stream;stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});stream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;mic.textContent=t.stop;return stream};
 const prime=()=>{try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume().catch(()=>{})}catch(e){}};
 const ringStart=()=>{ringStop();prime();const beep=()=>{if(!audioCtx)return;const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.frequency.value=880;g.gain.value=.06;o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+.2)};beep();ring=setInterval(beep,1200)};
 const ringStop=()=>{if(ring){clearInterval(ring);ring=null}};
 const speak=(text,lang)=>{if(!text||!speechSynthesis)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang=lang;u.rate=.96;speechSynthesis.speak(u)};
 const play=s=>{audio.srcObject=s;audio.muted=false;audio.volume=1;audio.play().catch(()=>set('🔊 Klikni na AUDIO.'))};
 const incoming=c=>{pending=c;prime();set(t.incoming);callBtn.disabled=false;callBtn.textContent=t.accept;ringStart();c.on('stream',play)};
 const media=c=>{c.on('stream',s=>{play(s);live.classList.remove('hidden');set('HOVOR AKTÍVNY');startRecognition()});c.on('close',()=>{live.classList.add('hidden');set(t.wait);if(role==='client'){callBtn.disabled=false;callBtn.textContent=t.call}});c.on('error',e=>set('Hovor: '+(e?.message||'chyba')))};
 const startRecognition=()=>{if(recognizing)return;const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){translation.textContent='SpeechRecognition nie je podporovaný.';return}recognition=new SR();recognition.lang=sourceLocale;recognition.continuous=true;recognition.interimResults=true;recognition.onstart=()=>recognizing=true;recognition.onresult=e=>{let interim='';for(let i=e.resultIndex;i<e.results.length;i++){const text=e.results[i][0].transcript.trim();if(e.results[i].isFinal)translate(text);else interim+=text}if(interim)translation.textContent=sourceLanguage+': '+interim};recognition.onend=()=>{recognizing=false;if(!live.classList.contains('hidden'))setTimeout(startRecognition,300)};try{recognition.start()}catch(e){}};
 const translate=async text=>{text=text.trim();if(!text)return;clear(sent);add(sent,text);translation.textContent='Preklad…';try{const r=await fetch(API,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text,sourceLanguage,targetLanguage})});const raw=await r.text();let d={};try{d=JSON.parse(raw)}catch{}if(!r.ok)throw Error(d.error||`HTTP ${r.status}`);const translated=String(d.translatedText||'').trim();if(!translated)throw Error('Prázdny preklad');clear(received);add(received,translated);translation.textContent='Preklad je aktívny.';send({type:'translation',sourceText:text,translatedText:translated});speak(translated,targetLocale)}catch(e){console.error('FOX translation',e);translation.textContent='Preklad sa nepodaril: '+(e?.message||'chyba API')}};
 const createRoom=async()=>{prime();invite.classList.remove('hidden');set('Vytváram spojenie…');try{const id=await openPeer();roomUrl=location.origin+location.pathname+'?foxPeer='+encodeURIComponent(id);link.value=roomUrl;await renderQr();set(t.wait)}catch(e){set('Spojenie sa nepodarilo: '+e.message)}};
 const renderQr=async()=>{try{qr.innerHTML='';if(!window.QRCode){const s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';await new Promise((ok,bad)=>{s.onload=ok;s.onerror=bad;document.head.appendChild(s)})}new QRCode(qr,{text:roomUrl,width:210,height:210})}catch(e){console.error('QR',e)}};
 const call=async()=>{callBtn.disabled=true;prime();try{await openPeer();const s=await local();const c=peer.call(remoteId,s);media(c);const d=peer.connect(remoteId,{reliable:true});wire(d);live.classList.remove('hidden');startRecognition();set('PRIPÁJAM HOVOR…')}catch(e){set(e.message||'Chyba');callBtn.disabled=false;callBtn.textContent=t.call}};
 const accept=async()=>{if(!pending)return;callBtn.disabled=true;prime();ringStop();try{const s=await local(),c=pending;pending=null;c.answer(s);media(c);live.classList.remove('hidden');startRecognition();set('HOVOR AKTÍVNY')}catch(e){set(e.message||'Chyba');callBtn.disabled=false;callBtn.textContent=t.accept}};
 create.onclick=createRoom;callBtn.onclick=()=>role==='host'?accept():call();audioBtn.onclick=()=>{prime();audio.muted=false;audio.play().catch(()=>{});if(stream)stream.getAudioTracks().forEach(x=>x.enabled=true)};mic.onclick=()=>{if(stream){const x=stream.getAudioTracks()[0];x.enabled=!x.enabled;mic.textContent=x.enabled?t.stop:t.mic}};
 if(role==='client'){callBtn.disabled=false;callBtn.textContent=t.call}else openPeer().catch(()=>{});
}
</script>
