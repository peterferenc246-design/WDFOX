---
interface Props { locale: string }
const { locale } = Astro.props
const t = locale === 'de' ? { title:'FOX LIVE KOMMUNIKATOR', create:'VERBINDUNG ERSTELLEN', call:'ANRUF STARTEN', accept:'ANRUF ANNEHMEN', wait:'Warte auf das zweite Gerät…', sent:'GESENDET · DEUTSCH', received:'EMPFANGEN · SLOWAKISCH', invite:'Einladung senden oder QR-Code scannen.', copy:'Link kopieren', copied:'Link kopiert.', mic:'MIKROFON EINSCHALTEN', stop:'MIKROFON AUSSCHALTEN' } : { title:'FOX LIVE KOMUNIKÁTOR', create:'VYTVORIŤ SPOJENIE', call:'USKUTOČNIŤ HOVOR', accept:'PRIJATIE HOVORU', wait:'Čakám na druhé zariadenie…', sent:'ODOSLANÉ · DEUTSCH', received:'PRIJATÉ · SLOVENČINA', invite:'Pošli odkaz alebo naskenuj QR kód.', copy:'Kopírovať odkaz', copied:'Odkaz skopírovaný.', mic:'ZAPNÚŤ MIKROFÓN', stop:'VYPNÚŤ MIKROFÓN' }
---
<section class="fox-call" data-app data-copy={JSON.stringify(t)}>
<div class="shell"><p class="eyebrow">FOX TECHNOLOGY LAB</p><h2>{t.title}</h2><div class="status" data-status>{t.wait}</div>
<div class="actions"><button class="primary" data-create>{t.create}</button><button class="call" data-call disabled>{t.call}</button><button class="secondary" data-copy>{t.copy}</button></div>
<div class="invite hidden" data-invite><input data-link readonly/><div class="qr-wrap"><div data-qr></div><small>{t.invite}</small></div></div>
<div class="grid"><article><header data-sent-label>{t.sent}</header><div class="history" data-sent>—</div></article><article><header data-received-label>{t.received}</header><div class="history" data-received>—</div></article></div>
<div class="live" data-live><b>FOX LIVE PREKLAD</b><span data-translation>Čakám na hovorenú vetu…</span></div>
<div class="controls"><button class="mic" data-mic disabled>{t.mic}</button><button class="secondary" data-audio>🔊 AUDIO</button></div><audio data-audio-el autoplay playsinline></audio></div></section>
<style>
.fox-call{padding:0 0 42px}.shell{border-radius:28px;background:#121a2a;color:#fff;padding:30px}.eyebrow{margin:0;color:#f36a0a;font-size:10px;font-weight:900;letter-spacing:.12em}.shell h2{margin:5px 0 8px;font-size:clamp(24px,4vw,38px)}.status{margin:20px 0;padding:13px 15px;border-radius:13px;background:#1d2635;color:#dce2ea;font-size:13px}.actions,.controls{display:flex;gap:9px;flex-wrap:wrap}.actions button,.controls button{border:0;border-radius:12px;padding:12px 15px;font-size:11px;font-weight:900;cursor:pointer;min-height:44px}.primary{background:#f36a0a;color:#fff}.call{background:#18a957;color:#fff}.secondary{background:#fff;color:#172033}.hidden{display:none!important}.actions button:disabled,.controls button:disabled{opacity:.4;cursor:not-allowed}.invite{margin-top:16px}.invite input{width:100%;box-sizing:border-box;border:1px solid #344054;border-radius:11px;background:#0d1420;color:#fff;padding:12px}.qr-wrap{margin-top:14px;background:#fff;color:#172033;border-radius:16px;padding:14px;text-align:center;width:max-content;max-width:100%}.qr-wrap [data-qr]{width:210px;min-height:210px;display:flex;align-items:center;justify-content:center}.qr-wrap img,.qr-wrap canvas{display:block!important;max-width:210px;height:auto!important;margin:auto}.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px}.grid article{background:#fff;color:#172033;border-radius:18px;padding:17px 19px;min-height:145px}.grid article+article{background:#fffdfa;border:1px solid #f6d8c3}.grid header{color:#f36a0a;font-weight:900;font-size:11px}.history{margin-top:14px;max-height:360px;overflow:auto;line-height:1.55;font-size:15px}.turn{display:inline;padding:0;margin:0;background:transparent;font-size:15px;line-height:1.55;white-space:normal}.turn::after{content:' '}.turn small{display:inline;margin:0 7px 0 2px;color:#7a8494;font-size:9px;font-weight:800;white-space:nowrap}.live{display:flex;gap:15px;margin-top:14px;padding:12px 14px;border-radius:13px;background:#1d2635;font-size:11px}.live span{color:#b9c1ce}.controls{margin-top:14px}.shell audio{display:none}@media(max-width:700px){.shell{padding:22px}.actions,.controls{display:grid;grid-template-columns:1fr;width:100%}.actions button,.controls button{display:block;width:100%;min-height:48px}.grid{grid-template-columns:1fr}.qr-wrap{width:100%;box-sizing:border-box}.history{font-size:15px;line-height:1.6}.turn{font-size:15px}}
</style>
<script>
const root=document.querySelector('[data-app]');
if(root){
 const t=JSON.parse(root.dataset.copy||'{}');
 const q=(s)=>root.querySelector(s),create=q('[data-create]'),callBtn=q('[data-call]'),copyBtn=q('[data-copy]'),status=q('[data-status]'),invite=q('[data-invite]'),link=q('[data-link]'),qr=q('[data-qr]'),sent=q('[data-sent]'),received=q('[data-received]'),mic=q('[data-mic]'),live=q('[data-live]'),translation=q('[data-translation]'),audio=q('[data-audio-el]'),audioBtn=q('[data-audio]');
 const params=new URLSearchParams(location.search),remoteId=params.get('foxPeer'),role=remoteId?'client':'host';
 const sourceLanguage=role==='host'?'Slovak':'German',targetLanguage=role==='host'?'German':'Slovak',sourceLocale=role==='host'?'sk-SK':'de-DE',targetLocale=role==='host'?'de-DE':'sk-SK';
 const API='https://wdfox-live-translator.vercel.app/api/translate-text';
 let peer=null,ready=null,stream=null,pending=null,data=null,queue=[],recognition=null,ring=null,audioCtx=null,recognizing=false,roomUrl='';
 const set=s=>status.textContent=s;
 const sentence=s=>{s=String(s||'').trim();if(!s)return '';return /[.!?…]$/.test(s)?s:s+'.'};
 const add=(box,text,lang)=>{text=sentence(text);if(!text)return;const el=document.createElement('span');el.className='turn';el.textContent=text;const sm=document.createElement('small');sm.textContent=lang;el.appendChild(sm);box.appendChild(el);box.scrollTop=box.scrollHeight};
 const clear=(box)=>{if(box.firstElementChild?.textContent==='—')box.firstElementChild.remove()};
 const send=m=>{if(data?.open){try{data.send(m);return}catch(e){}}queue.push(m)};
 const flush=()=>{while(data?.open&&queue.length){try{data.send(queue.shift())}catch(e){break}}};
 const wire=c=>{if(!c||c.__fox)return;c.__fox=true;data=c;c.on('open',flush);c.on('data',m=>{if(m?.type==='translation'){clear(received);add(received,m.translatedText,targetLanguage);translation.textContent='Preklad je aktívny.';speak(sentence(m.translatedText),targetLocale)}})};
 const loadPeer=()=>new Promise((ok,bad)=>{if(window.Peer)return ok();const s=document.createElement('script');s.src='https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js';s.onload=ok;s.onerror=bad;document.head.appendChild(s)});
 const openPeer=async()=>{await loadPeer();if(ready)return ready;peer=new Peer(undefined,{config:{iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun.cloudflare.com:3478'}]}});peer.on('call',incoming);peer.on('connection',wire);peer.on('error',e=>{console.error(e);set('PeerJS: '+(e?.type||e?.message||'chyba'))});ready=new Promise((ok,bad)=>{const tm=setTimeout(()=>bad(Error('PeerJS timeout')),20000);peer.once('open',id=>{clearTimeout(tm);ok(id)})});return ready};
 const local=async()=>{if(stream)return stream;stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});stream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;mic.textContent=t.stop;return stream};
 const prime=()=>{try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();audioCtx.resume().catch(()=>{})}catch(e){}};
 const ringStart=()=>{ringStop();prime();const beep=()=>{if(!audioCtx)return;const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.frequency.value=880;g.gain.value=.06;o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+.2)};beep();ring=setInterval(beep,1200)};
 const ringStop=()=>{if(ring){clearInterval(ring);ring=null}};
 const speak=(text,lang)=>{if(!text||!speechSynthesis)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(sentence(text));u.lang=lang;u.rate=.96;speechSynthesis.speak(u)};
 const play=s=>{audio.srcObject=s;audio.muted=false;audio.volume=1;audio.play().catch(()=>set('🔊 Klikni na AUDIO.'))};
 const incoming=c=>{pending=c;prime();set('PRICHÁDZAJÚCI HOVOR — ZVONÍ');callBtn.disabled=false;callBtn.textContent=t.accept;ringStart();c.on('stream',play)};
 const media=c=>{c.on('stream',s=>{play(s);live.classList.remove('hidden');set('HOVOR AKTÍVNY');startRecognition()});c.on('close',()=>set(t.wait));c.on('error',e=>set('Hovor: '+(e?.message||'chyba')))};
 const startRecognition=()=>{if(recognizing)return;const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){set('SpeechRecognition nie je podporovaný.');return}recognition=new SR();recognition.lang=sourceLocale;recognition.continuous=true;recognition.interimResults=true;recognition.onstart=()=>recognizing=true;recognition.onresult=e=>{let interim='';for(let i=e.resultIndex;i<e.results.length;i++){const text=e.results[i][0].transcript.trim();if(e.results[i].isFinal)translate(text);else interim+=text}if(interim)translation.textContent=sourceLanguage+': '+interim};recognition.onend=()=>{recognizing=false;if(!live.classList.contains('hidden'))setTimeout(startRecognition,300)};try{recognition.start()}catch(e){}};
 const translate=async text=>{text=sentence(text);if(!text)return;clear(sent);add(sent,text,sourceLanguage);translation.textContent='Preklad…';try{const r=await fetch(API,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text,sourceLanguage,targetLanguage})});const raw=await r.text();let d={};try{d=JSON.parse(raw)}catch{}if(!r.ok)throw Error(d.error||`HTTP ${r.status}`);const translated=sentence(d.translatedText);if(!translated)throw Error('Prázdny preklad');clear(received);add(received,translated,targetLanguage);translation.textContent='Preklad je aktívny.';send({type:'translation',sourceText:text,translatedText:translated});speak(translated,targetLocale)}catch(e){console.error('FOX translation',e);translation.textContent='Preklad sa nepodaril: '+(e?.message||'chyba API')}};
 const createRoom=async()=>{prime();invite.classList.remove('hidden');set('Vytváram spojenie…');try{const id=await openPeer();roomUrl=location.origin+location.pathname+'?foxPeer='+encodeURIComponent(id);link.value=roomUrl;await renderQr();set(t.wait)}catch(e){set('Spojenie sa nepodarilo: '+e.message)}};
 const renderQr=async()=>{try{qr.innerHTML='';if(window.QRCode)new QRCode(qr,{text:roomUrl,width:210,height:210});else{const s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';s.onload=()=>new QRCode(qr,{text:roomUrl,width:210,height:210});document.head.appendChild(s)}}catch(e){}};
 const call=async()=>{callBtn.disabled=true;prime();try{await openPeer();const s=await local();const c=peer.call(remoteId,s);media(c);const d=peer.connect(remoteId,{reliable:true});wire(d);live.classList.remove('hidden');startRecognition();set('PRIPÁJAM HOVOR…')}catch(e){set(e.message||'Chyba');callBtn.disabled=false;callBtn.textContent=t.call}};
 const accept=async()=>{if(!pending)return;callBtn.disabled=true;prime();ringStop();try{const s=await local(),c=pending;pending=null;c.answer(s);media(c);live.classList.remove('hidden');startRecognition();set('HOVOR AKTÍVNY')}catch(e){set(e.message||'Chyba');callBtn.disabled=false;callBtn.textContent=t.accept}};
 create.onclick=createRoom;callBtn.onclick=()=>role==='host'?accept():call();copyBtn.onclick=async()=>{const u=roomUrl||location.href;try{await navigator.clipboard.writeText(u);set(t.copied)}catch(e){link.value=u;link.select();document.execCommand('copy')}};audioBtn.onclick=()=>{prime();audio.muted=false;audio.play().catch(()=>{});if(stream)stream.getAudioTracks().forEach(x=>x.enabled=true)};mic.onclick=()=>{if(stream){const x=stream.getAudioTracks()[0];x.enabled=!x.enabled;mic.textContent=x.enabled?t.stop:t.mic}};
 if(role==='client'){callBtn.disabled=false;callBtn.textContent=t.call;mic.disabled=true}else openPeer().catch(()=>{});
}
</script>
