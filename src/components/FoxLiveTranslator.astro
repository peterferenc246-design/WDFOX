---
import type { Locale } from "../data/content";
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<section class="fox-translator section-wrap" id="translator" data-translator data-page-locale={locale}>
  <div class="translator-shell">
    <div class="translator-head">
      <div>
        <p class="eyebrow"><span></span> FOX TECHNOLOGY LAB</p>
        <h2>FOX <strong>LIVE TRANSLATOR</strong></h2>
        <p class="translator-intro" data-i18n="intro"></p>
      </div>
      <div class="translator-tools">
        <button class="copy-top" type="button" data-copy disabled title="" aria-label="">⧉ <span data-i18n="copy"></span></button>
        <div class="eu-badge">🇪🇺 <span data-i18n="eu"></span></div>
      </div>
    </div>

    <div class="mode-switch" role="tablist" aria-label="" data-i18n-aria="modes">
      <button type="button" class="mode is-active" data-mode="translator" role="tab" aria-selected="true" data-i18n="translatorMode"></button>
      <button type="button" class="mode" data-mode="communicator" role="tab" aria-selected="false" data-i18n="communicatorMode"></button>
    </div>
    <p class="mode-note" data-mode-note></p>

    <div class="language-bar">
      <label><span data-i18n="speak"></span><select data-source aria-label=""></select></label>
      <button class="swap" type="button" data-swap aria-label="⇄">⇄</button>
      <label><span data-i18n="translateTo"></span><select data-target aria-label=""></select></label>
    </div>

    <div class="translator-main">
      <button class="record" type="button" data-record>
        <span class="record-icon">🎤</span><span data-record-label></span>
      </button>
      <p class="hint" data-status></p>
    </div>

    <div class="translation-grid">
      <article class="speech-card"><header><span data-source-label></span><span class="live-dot">●</span></header><p data-transcript></p></article>
      <article class="speech-card result"><header><span data-target-label></span><div class="play-area"><button type="button" class="play" data-play disabled aria-label="">🔊</button><div class="speed-controls" data-speed-controls aria-label="Playback speed"><button type="button" data-speed="0.75">0.75×</button><button type="button" class="is-active" data-speed="1">1×</button><button type="button" data-speed="1.25">1.25×</button><button type="button" data-speed="1.5">1.5×</button></div></div></header><p data-translation></p></article>
    </div>
    <p class="translator-note">🔒 <span data-i18n="privacy"></span></p>
  </div>
</section>

<style>
.fox-translator{padding-top:42px;padding-bottom:42px}.translator-shell{position:relative;overflow:hidden;border:1px solid #ececec;border-radius:28px;background:linear-gradient(135deg,#fff 0%,#fffaf6 100%);box-shadow:0 22px 60px rgba(20,24,35,.08);padding:34px}.translator-shell:before{content:"";position:absolute;left:0;top:0;right:0;height:5px;background:#f36a0a}.translator-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px}.translator-head h2{margin:5px 0 8px;font-size:clamp(28px,4vw,44px);line-height:1;letter-spacing:-.04em;color:#121a2a}.translator-head h2 strong{color:#f36a0a}.translator-intro{max-width:680px;margin:0;color:#667085;font-size:15px;line-height:1.65}.translator-tools{display:flex;align-items:center;gap:9px}.copy-top{display:flex;align-items:center;gap:6px;white-space:nowrap;border:1px solid #eee;border-radius:999px;background:#fff;color:#172033;padding:10px 13px;font-size:12px;font-weight:800;box-shadow:0 7px 20px rgba(0,0,0,.05);cursor:pointer}.copy-top:hover:not(:disabled){border-color:#f36a0a;color:#f36a0a}.copy-top:disabled{opacity:.42;cursor:default}.eu-badge{display:flex;align-items:center;gap:8px;white-space:nowrap;border:1px solid #eee;border-radius:999px;background:#fff;padding:10px 14px;font-size:13px;font-weight:800;box-shadow:0 7px 20px rgba(0,0,0,.05)}.mode-switch{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:26px;padding:5px;border:1px solid #eee;border-radius:15px;background:#f7f7f7;max-width:560px}.mode{border:0;border-radius:11px;background:transparent;padding:12px 16px;color:#667085;font-size:12px;font-weight:900;letter-spacing:.03em;cursor:pointer}.mode.is-active{background:#fff;color:#f36a0a;box-shadow:0 5px 15px rgba(0,0,0,.07)}.mode-note{margin:9px 0 0;color:#8a93a3;font-size:12px}.language-bar{display:grid;grid-template-columns:1fr 58px 1fr;align-items:end;gap:14px;margin:22px 0 18px}.language-bar label{display:flex;flex-direction:column;gap:7px;color:#777;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.language-bar select{width:100%;border:1px solid #ddd;border-radius:14px;background:#fff;padding:14px 44px 14px 15px;color:#172033;font-size:15px;font-weight:700;outline:none}.language-bar select:focus{border-color:#f36a0a;box-shadow:0 0 0 3px rgba(243,106,10,.12)}.swap{height:48px;border:1px solid #eee;border-radius:14px;background:#fff;color:#f36a0a;font-size:25px;font-weight:800;cursor:pointer;box-shadow:0 6px 15px rgba(0,0,0,.04)}.translator-main{text-align:center;padding:8px 0 22px}.record{position:relative;display:inline-flex;align-items:center;gap:12px;border:0;border-radius:999px;background:#f36a0a;color:#fff;padding:15px 25px 15px 18px;font-size:14px;font-weight:900;letter-spacing:.02em;cursor:pointer;box-shadow:0 12px 28px rgba(243,106,10,.28);transition:.2s}.record:hover{transform:translateY(-1px);box-shadow:0 15px 32px rgba(243,106,10,.34)}.record.recording{background:#171b25}.record-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.16);font-size:18px}.hint{margin:11px auto 0;max-width:650px;color:#8a93a3;font-size:12px}.translation-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.speech-card{min-height:155px;border:1px solid #e9e9e9;border-radius:19px;background:#fff;padding:17px 19px}.speech-card.result{border-color:#f6d8c3;background:#fffdfa}.speech-card header{display:flex;align-items:center;justify-content:space-between;color:#f36a0a;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.06em}.speech-card p{margin:24px 0 0;color:#202938;font-size:17px;line-height:1.55;white-space:pre-wrap}.live-dot{font-size:9px;opacity:.35}.play-area{display:flex;align-items:center;gap:8px}.play{border:0;background:transparent;font-size:18px;cursor:pointer}.play:disabled{opacity:.3;cursor:default}.speed-controls{display:flex;align-items:center;gap:3px;border:1px solid #eee;border-radius:999px;background:#fff;padding:2px}.speed-controls button{border:0;border-radius:999px;background:transparent;color:#667085;padding:4px 7px;font-size:10px;font-weight:800;cursor:pointer}.speed-controls button:hover{color:#f36a0a}.speed-controls button.is-active{background:#f36a0a;color:#fff}.translator-note{margin:16px 0 0;text-align:center;color:#98a0ad;font-size:11px}@media(max-width:650px){.fox-translator{padding-top:25px;padding-bottom:25px}.translator-shell{padding:22px;border-radius:22px}.translator-head{display:block}.translator-tools{margin-top:15px;justify-content:flex-start;flex-wrap:wrap}.copy-top span{display:none}.mode-switch{max-width:none}.language-bar{grid-template-columns:1fr 48px 1fr;gap:8px}.translation-grid{grid-template-columns:1fr}.speech-card{min-height:125px}.speech-card p{font-size:15px}.record{width:100%;justify-content:center}.speech-card.result header{align-items:flex-start}.play-area{flex-wrap:wrap;justify-content:flex-end}.speed-controls{order:2;width:100%;justify-content:center}.speed-controls button{flex:1;padding:6px 4px}}
</style>

<script define:vars={{ locale }}>
const root=document.querySelector('[data-translator]');
if(root){
const languages=[['bg','🇧🇬 Български'],['hr','🇭🇷 Hrvatski'],['cs','🇨🇿 Čeština'],['da','🇩🇰 Dansk'],['nl','🇳🇱 Nederlands'],['en','🇬🇧 English'],['et','🇪🇪 Eesti'],['fi','🇫🇮 Suomi'],['fr','🇫🇷 Français'],['de','🇩🇪 Deutsch'],['el','🇬🇷 Ελληνικά'],['hu','🇭🇺 Magyar'],['ga','🇮🇪 Gaeilge'],['it','🇮🇹 Italiano'],['lv','🇱🇻 Latviešu'],['lt','🇱🇹 Lietuvių'],['lb','🇱🇺 Lëtzebuergesch'],['mt','🇲🇹 Malti'],['pl','🇵🇱 Polski'],['pt','🇵🇹 Português'],['ro','🇷🇴 Română'],['sk','🇸🇰 Slovenčina'],['sl','🇸🇮 Slovenščina'],['es','🇪🇸 Español'],['sv','🇸🇪 Svenska']];
const ui={de:{intro:'Professioneller Sprachübersetzer für die Kommunikation mit Kunden in der gesamten Europäischen Union.',copy:'Kopieren',eu:'24 EU-Sprachen',translatorMode:'🔄 ÜBERSETZER',communicatorMode:'☎️ KOMMUNIKATOR',modes:'Kommunikationsmodus',speak:'Sprechen',translateTo:'Übersetzen in',swap:'Sprachen tauschen',start:'SPRECHEN STARTEN',stop:'STOPPEN',processing:'VERARBEITUNG…',ready:'Übersetzung bereit.',recording:'Aufnahme läuft… sprechen Sie natürlich.',initial:'Klicken Sie auf die Schaltfläche und sprechen Sie natürlich. Die Übersetzung erscheint nach dem Stoppen.',tooLarge:'Die Aufnahme ist zu groß. Bitte kürzer sprechen.',mic:'Mikrofonzugriff ist für die Sprachübersetzung erforderlich.',copyFail:'Kopieren fehlgeschlagen.',copied:'Kopiert',communicatorNote:'Modus für die zukünftige Live-Sprachverbindung mit Kunden vorbereitet.',translatorNote:'Gesprochenen Satz in die gewählte Sprache übersetzen.',transcript:'Ihr gesprochener Text erscheint hier…',translation:'Übersetzung erscheint hier…',play:'Übersetzung abspielen',privacy:'Audio wird nur zur Übersetzung verarbeitet. Der API-Schlüssel bleibt auf dem Server.'},
 en:{intro:'Professional voice translator for communication with clients across the European Union.',copy:'Copy',eu:'24 EU languages',translatorMode:'🔄 TRANSLATOR',communicatorMode:'☎️ COMMUNICATOR',modes:'Communication mode',speak:'Speak',translateTo:'Translate to',swap:'Swap languages',start:'START SPEAKING',stop:'STOP',processing:'PROCESSING…',ready:'Translation ready.',recording:'Recording… speak naturally.',initial:'Press the button and speak naturally. The translation appears after you stop recording.',tooLarge:'The recording is too large. Please speak for a shorter time.',mic:'Microphone access is required for voice translation.',copyFail:'Copy failed.',copied:'Copied',communicatorNote:'Mode prepared for the future live voice connection with clients.',translatorNote:'Translate a spoken sentence into the selected language.',transcript:'Your spoken text will appear here…',translation:'Translation will appear here…',play:'Play translation',privacy:'Audio is processed only for translation. The API key remains on the server.'},
 sk:{intro:'Profesionálny hlasový prekladač pre komunikáciu s klientmi v celej Európskej únii.',copy:'Kopírovať',eu:'24 jazykov EÚ',translatorMode:'🔄 PREKLADAČ',communicatorMode:'☎️ KOMUNIKÁTOR',modes:'Režim komunikácie',speak:'Hovorím',translateTo:'Preložiť do',swap:'Vymeniť jazyky',start:'ZAČAŤ HOVORIŤ',stop:'ZASTAVIŤ',processing:'SPRACOVÁVAM…',ready:'Preklad je pripravený.',recording:'Nahrávam… hovorte prirodzene.',initial:'Stlačte tlačidlo a hovorte prirodzene. Preklad sa zobrazí po zastavení nahrávania.',tooLarge:'Nahrávka je príliš veľká. Skúste hovoriť kratšie.',mic:'Povolenie mikrofónu je potrebné pre hlasový preklad.',copyFail:'Kopírovanie sa nepodarilo.',copied:'Skopírované',communicatorNote:'Režim pripravený pre budúce živé hlasové spojenie s klientom.',translatorNote:'Preložte hovorenú vetu do zvoleného jazyka.',transcript:'Váš hovorený text sa zobrazí tu…',translation:'Preklad sa zobrazí tu…',play:'Prehrať preklad',privacy:'Hlas sa spracuje iba na účely prekladu. API kľúč zostáva na serveri.'},
 fr:{intro:'Traducteur vocal professionnel pour communiquer avec vos clients dans toute l’Union européenne.',copy:'Copier',eu:'24 langues de l’UE',translatorMode:'🔄 TRADUCTEUR',communicatorMode:'☎️ COMMUNICATEUR',modes:'Mode de communication',speak:'Je parle',translateTo:'Traduire en',swap:'Inverser les langues',start:'COMMENCER À PARLER',stop:'ARRÊTER',processing:'TRAITEMENT…',ready:'Traduction prête.',recording:'Enregistrement… parlez naturellement.',initial:'Appuyez sur le bouton et parlez naturellement. La traduction apparaît après l’arrêt.',tooLarge:'Enregistrement trop volumineux. Parlez moins longtemps.',mic:'L’accès au microphone est nécessaire pour la traduction vocale.',copyFail:'Échec de la copie.',copied:'Copié',communicatorNote:'Mode préparé pour la future connexion vocale en direct avec les clients.',translatorNote:'Traduire une phrase parlée dans la langue choisie.',transcript:'Votre texte parlé apparaîtra ici…',translation:'La traduction apparaîtra ici…',play:'Lire la traduction',privacy:'L’audio est traité uniquement pour la traduction. La clé API reste sur le serveur.'},
 hr:{intro:'Profesionalni glasovni prevoditelj za komunikaciju s klijentima diljem Europske unije.',copy:'Kopiraj',eu:'24 jezika EU',translatorMode:'🔄 PREVODITELJ',communicatorMode:'☎️ KOMUNIKATOR',modes:'Način komunikacije',speak:'Govorim',translateTo:'Prevedi na',swap:'Zamijeni jezike',start:'ZAPOČNI GOVOR',stop:'ZAUSTAVI',processing:'OBRADA…',ready:'Prijevod je spreman.',recording:'Snimanje… govorite prirodno.',initial:'Pritisnite gumb i govorite prirodno. Prijevod će se prikazati nakon zaustavljanja.',tooLarge:'Snimka je prevelika. Govorite kraće.',mic:'Za glasovni prijevod potreban je pristup mikrofonu.',copyFail:'Kopiranje nije uspjelo.',copied:'Kopirano',communicatorNote:'Način pripremljen za buduću živu glasovnu vezu s klijentima.',translatorNote:'Prevedite izgovorenu rečenicu na odabrani jezik.',transcript:'Vaš izgovoreni tekst prikazat će se ovdje…',translation:'Prijevod će se prikazati ovdje…',play:'Reproduciraj prijevod',privacy:'Audio se obrađuje samo za prijevod. API ključ ostaje na poslužitelju.'},
 pl:{intro:'Profesjonalny tłumacz głosowy do komunikacji z klientami w całej Unii Europejskiej.',copy:'Kopiuj',eu:'24 języki UE',translatorMode:'🔄 TŁUMACZ',communicatorMode:'☎️ KOMUNIKATOR',modes:'Tryb komunikacji',speak:'Mówię',translateTo:'Tłumacz na',swap:'Zamień języki',start:'ZACZNIJ MÓWIĆ',stop:'STOP',processing:'PRZETWARZANIE…',ready:'Tłumaczenie gotowe.',recording:'Nagrywanie… mów naturalnie.',initial:'Naciśnij przycisk i mów naturalnie. Tłumaczenie pojawi się po zatrzymaniu nagrywania.',tooLarge:'Nagranie jest za duże. Mów krócej.',mic:'Do tłumaczenia głosowego potrzebny jest dostęp do mikrofonu.',copyFail:'Kopiowanie nie powiodło się.',copied:'Skopiowano',communicatorNote:'Tryb przygotowany do przyszłego połączenia głosowego na żywo z klientami.',translatorNote:'Przetłumacz wypowiedziane zdanie na wybrany język.',transcript:'Twój wypowiedziany tekst pojawi się tutaj…',translation:'Tłumaczenie pojawi się tutaj…',play:'Odtwórz tłumaczenie',privacy:'Audio jest przetwarzane wyłącznie do tłumaczenia. Klucz API pozostaje na serwerze.'},
 it:{intro:'Traduttore vocale professionale per comunicare con i clienti in tutta l’Unione Europea.',copy:'Copia',eu:'24 lingue UE',translatorMode:'🔄 TRADUTTORE',communicatorMode:'☎️ COMUNICATORE',modes:'Modalità di comunicazione',speak:'Parlo',translateTo:'Traduci in',swap:'Scambia lingue',start:'INIZIA A PARLARE',stop:'STOP',processing:'ELABORAZIONE…',ready:'Traduzione pronta.',recording:'Registrazione… parla naturalmente.',initial:'Premi il pulsante e parla naturalmente. La traduzione apparirà dopo aver interrotto la registrazione.',tooLarge:'La registrazione è troppo grande. Parla per meno tempo.',mic:'È necessario consentire l’accesso al microfono per la traduzione vocale.',copyFail:'Copia non riuscita.',copied:'Copiato',communicatorNote:'Modalità preparata per il futuro collegamento vocale in diretta con i clienti.',translatorNote:'Traduci una frase pronunciata nella lingua selezionata.',transcript:'Il testo pronunciato apparirà qui…',translation:'La traduzione apparirà qui…',play:'Riproduci traduzione',privacy:'L’audio viene elaborato solo per la traduzione. La chiave API resta sul server.'},
 es:{intro:'Traductor de voz profesional para comunicarse con clientes en toda la Unión Europea.',copy:'Copiar',eu:'24 idiomas de la UE',translatorMode:'🔄 TRADUCTOR',communicatorMode:'☎️ COMUNICADOR',modes:'Modo de comunicación',speak:'Hablo',translateTo:'Traducir a',swap:'Cambiar idiomas',start:'EMPEZAR A HABLAR',stop:'DETENER',processing:'PROCESANDO…',ready:'Traducción lista.',recording:'Grabando… habla con naturalidad.',initial:'Pulsa el botón y habla con naturalidad. La traducción aparecerá al detener la grabación.',tooLarge:'La grabación es demasiado grande. Habla durante menos tiempo.',mic:'Se necesita acceso al micrófono para la traducción de voz.',copyFail:'No se pudo copiar.',copied:'Copiado',communicatorNote:'Modo preparado para la futura conexión de voz en directo con clientes.',translatorNote:'Traduce una frase hablada al idioma seleccionado.',transcript:'Tu texto hablado aparecerá aquí…',translation:'La traducción aparecerá aquí…',play:'Reproducir traducción',privacy:'El audio se procesa solo para la traducción. La clave API permanece en el servidor.'},
 sv:{intro:'Professionell röstöversättare för kommunikation med kunder i hela Europeiska unionen.',copy:'Kopiera',eu:'24 EU-språk',translatorMode:'🔄 ÖVERSÄTTARE',communicatorMode:'☎️ KOMMUNIKATÖR',modes:'Kommunikationsläge',speak:'Jag talar',translateTo:'Översätt till',swap:'Byt språk',start:'BÖRJA TALA',stop:'STOPPA',processing:'BEARBETAR…',ready:'Översättningen är klar.',recording:'Spelar in… tala naturligt.',initial:'Tryck på knappen och tala naturligt. Översättningen visas när du stoppar inspelningen.',tooLarge:'Inspelningen är för stor. Tala kortare.',mic:'Mikrofonåtkomst krävs för röstöversättning.',copyFail:'Kopieringen misslyckades.',copied:'Kopierat',communicatorNote:'Läge förberett för framtida direktspråksanslutning med kunder.',translatorNote:'Översätt en talad mening till valt språk.',transcript:'Din talade text visas här…',translation:'Översättningen visas här…',play:'Spela upp översättning',privacy:'Ljudet behandlas endast för översättning. API-nyckeln stannar på servern.'}};
const t=ui[locale]||ui.en;const labels=Object.fromEntries(languages);const source=root.querySelector('[data-source]'),target=root.querySelector('[data-target]'),swap=root.querySelector('[data-swap]'),record=root.querySelector('[data-record]'),recordLabel=root.querySelector('[data-record-label]'),status=root.querySelector('[data-status]'),transcript=root.querySelector('[data-transcript]'),translation=root.querySelector('[data-translation]'),sourceLabel=root.querySelector('[data-source-label]'),targetLabel=root.querySelector('[data-target-label]'),play=root.querySelector('[data-play]'),copy=root.querySelector('[data-copy]'),modeNote=root.querySelector('[data-mode-note]'),speedControls=[...root.querySelectorAll('[data-speed]')],modes=[...root.querySelectorAll('[data-mode]')];
root.querySelectorAll('[data-i18n]').forEach(el=>{const k=el.dataset.i18n;if(t[k]!==undefined)el.textContent=t[k];});root.querySelector('[data-i18n-aria]').setAttribute('aria-label',t.modes);source.parentElement.querySelector('span').textContent=t.speak;target.parentElement.querySelector('span').textContent=t.translateTo;source.setAttribute('aria-label',t.speak);target.setAttribute('aria-label',t.translateTo);swap.setAttribute('aria-label',t.swap);copy.title=t.copy;copy.setAttribute('aria-label',t.copy);play.setAttribute('aria-label',t.play);recordLabel.textContent=t.start;status.textContent=t.initial;modeNote.textContent=t.translatorNote;transcript.textContent=t.transcript;translation.textContent=t.translation;
for(const [code,name] of languages){source.add(new Option(name,code));target.add(new Option(name,code));}source.value=locale==='sk'?'sk':locale;target.value=locale==='sk'?'de':locale==='de'?'sk':'en';const sync=()=>{sourceLabel.textContent=labels[source.value].replace(/^\S+\s/,'');targetLabel.textContent=labels[target.value].replace(/^\S+\s/,'');};sync();
let recorder=null,chunks=[],audioUrl=null,currentMode='translator',currentAudio=null,currentSpeed=1;const setBusy=v=>record.disabled=v;swap.addEventListener('click',()=>{const x=source.value;source.value=target.value;target.value=x;sync();});modes.forEach(btn=>btn.addEventListener('click',()=>{currentMode=btn.dataset.mode;modes.forEach(b=>{const active=b===btn;b.classList.toggle('is-active',active);b.setAttribute('aria-selected',String(active));});modeNote.textContent=currentMode==='communicator'?t.communicatorNote:t.translatorNote;}));copy.addEventListener('click',async()=>{const text=translation.textContent?.trim();if(!text||text===t.translation)return;try{await navigator.clipboard.writeText(text);const old=copy.innerHTML;copy.innerHTML='✓ <span>'+t.copied+'</span>';setTimeout(()=>copy.innerHTML=old,1400);}catch{status.textContent='❌ '+t.copyFail;}});
speedControls.forEach(btn=>btn.addEventListener('click',()=>{currentSpeed=Number(btn.dataset.speed);speedControls.forEach(b=>b.classList.toggle('is-active',b===btn));if(currentAudio){currentAudio.playbackRate=currentSpeed;currentAudio.preservesPitch=true;}}));
const mime=()=>['audio/mp4','audio/webm;codecs=opus','audio/webm'].find(x=>MediaRecorder.isTypeSupported(x))||'';
record.addEventListener('click',async()=>{if(recorder?.state==='recording'){recorder.stop();return;}try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});chunks=[];const mt=mime();recorder=new MediaRecorder(stream,mt?{mimeType:mt}:undefined);record.classList.add('recording');recordLabel.textContent=t.stop;status.textContent=t.recording;recorder.ondataavailable=e=>{if(e.data.size)chunks.push(e.data)};recorder.onstop=async()=>{stream.getTracks().forEach(x=>x.stop());record.classList.remove('recording');recordLabel.textContent=t.processing;setBusy(true);const blob=new Blob(chunks,{type:recorder.mimeType||'audio/mp4'});if(blob.size>4*1024*1024){status.textContent='❌ '+t.tooLarge;setBusy(false);recordLabel.textContent=t.start;return;}const fd=new FormData();fd.append('audio',blob,'speech.m4a');fd.append('sourceLanguage',source.value);fd.append('targetLanguage',target.value);fd.append('speakResult','true');try{const res=await fetch('https://wdfox.vercel.app/api/translate-voice',{method:'POST',body:fd});const data=await res.json();if(!res.ok)throw new Error(data.error||'Translation failed');transcript.textContent=data.transcript;translation.textContent=data.translatedText;copy.disabled=false;status.textContent=t.ready;if(audioUrl)URL.revokeObjectURL(audioUrl);if(currentAudio){currentAudio.pause();currentAudio=null;}if(data.audioBase64){const bytes=Uint8Array.from(atob(data.audioBase64),c=>c.charCodeAt(0));audioUrl=URL.createObjectURL(new Blob([bytes],{type:data.audioMimeType||'audio/wav'}));play.disabled=false;play.onclick=()=>{if(currentAudio){currentAudio.pause();currentAudio.currentTime=0;}currentAudio=new Audio(audioUrl);currentAudio.playbackRate=currentSpeed;currentAudio.preservesPitch=true;currentAudio.play();};}else play.disabled=true;}catch(e){status.textContent='❌ '+(e instanceof Error?e.message:'Translation failed');}finally{setBusy(false);recordLabel.textContent=t.start;}};recorder.start();}catch{status.textContent='❌ '+t.mic;record.classList.remove('recording');setBusy(false);recordLabel.textContent=t.start;}});
}
</script>