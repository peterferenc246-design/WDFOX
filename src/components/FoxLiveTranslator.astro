---
import type { Locale } from "../data/content";
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<section class="fox-translator section-wrap" id="translator" data-translator data-page-locale={locale}>
  <div class="translator-shell">
    <div class="translator-head">
      <div>
        <p class="eyebrow"><span></span> FOX TECHNOLOGY LAB</p>
        <h2>FOX <strong>LIVE TRANSLATOR</strong></h2>
        <p class="translator-intro">Profesionálny hlasový prekladač pre komunikáciu s klientmi v celej Európskej únii.</p>
      </div>
      <div class="translator-tools">
        <button class="copy-top" type="button" data-copy disabled title="Kopírovať preklad" aria-label="Kopírovať preklad">⧉ <span>Kopírovať</span></button>
        <div class="eu-badge">🇪🇺 <span>24 jazykov EÚ</span></div>
      </div>
    </div>

    <div class="mode-switch" role="tablist" aria-label="Režim komunikácie">
      <button type="button" class="mode is-active" data-mode="translator" role="tab" aria-selected="true">🔄 TRANSLATOR</button>
      <button type="button" class="mode" data-mode="communicator" role="tab" aria-selected="false">☎️ KOMUNIKÁTOR</button>
    </div>
    <p class="mode-note" data-mode-note>Preložte hovorenú vetu do zvoleného jazyka.</p>

    <div class="language-bar">
      <label><span>Hovorím</span><select data-source aria-label="Zdrojový jazyk"></select></label>
      <button class="swap" type="button" data-swap aria-label="Vymeniť jazyky">⇄</button>
      <label><span>Preložiť do</span><select data-target aria-label="Cieľový jazyk"></select></label>
    </div>

    <div class="translator-main">
      <button class="record" type="button" data-record><span class="record-icon">🎤</span><span data-record-label>ZAČAŤ HOVORIŤ</span><small data-timer>20 s</small></button>
      <p class="hint" data-status>Stlačte tlačidlo a hovorte prirodzene. Preklad sa zobrazí po zastavení nahrávania.</p>
    </div>

    <div class="translation-grid">
      <article class="speech-card"><header><span data-source-label>Slovenčina</span><span class="live-dot">●</span></header><p data-transcript>Váš hovorený text sa zobrazí tu…</p></article>
      <article class="speech-card result"><header><span data-target-label>Deutsch</span><button type="button" class="play" data-play disabled aria-label="Prehrať preklad">🔊</button></header><p data-translation>Preklad sa zobrazí tu…</p></article>
    </div>
    <p class="translator-note">🔒 Hlas sa spracuje iba na účely prekladu. API kľúč zostáva na serveri.</p>
  </div>
</section>

<style>
.fox-translator{padding-top:42px;padding-bottom:42px}.translator-shell{position:relative;overflow:hidden;border:1px solid #ececec;border-radius:28px;background:linear-gradient(135deg,#fff 0%,#fffaf6 100%);box-shadow:0 22px 60px rgba(20,24,35,.08);padding:34px}.translator-shell:before{content:"";position:absolute;left:0;top:0;right:0;height:5px;background:#f36a0a}.translator-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px}.translator-head h2{margin:5px 0 8px;font-size:clamp(28px,4vw,44px);line-height:1;letter-spacing:-.04em;color:#121a2a}.translator-head h2 strong{color:#f36a0a}.translator-intro{max-width:680px;margin:0;color:#667085;font-size:15px;line-height:1.65}.translator-tools{display:flex;align-items:center;gap:9px}.copy-top{display:flex;align-items:center;gap:6px;white-space:nowrap;border:1px solid #eee;border-radius:999px;background:#fff;color:#172033;padding:10px 13px;font-size:12px;font-weight:800;box-shadow:0 7px 20px rgba(0,0,0,.05);cursor:pointer}.copy-top:hover:not(:disabled){border-color:#f36a0a;color:#f36a0a}.copy-top:disabled{opacity:.42;cursor:default}.eu-badge{display:flex;align-items:center;gap:8px;white-space:nowrap;border:1px solid #eee;border-radius:999px;background:#fff;padding:10px 14px;font-size:13px;font-weight:800;box-shadow:0 7px 20px rgba(0,0,0,.05)}.mode-switch{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:26px;padding:5px;border:1px solid #eee;border-radius:15px;background:#f7f7f7;max-width:560px}.mode{border:0;border-radius:11px;background:transparent;padding:12px 16px;color:#667085;font-size:12px;font-weight:900;letter-spacing:.03em;cursor:pointer}.mode.is-active{background:#fff;color:#f36a0a;box-shadow:0 5px 15px rgba(0,0,0,.07)}.mode-note{margin:9px 0 0;color:#8a93a3;font-size:12px}.language-bar{display:grid;grid-template-columns:1fr 58px 1fr;align-items:end;gap:14px;margin:22px 0 18px}.language-bar label{display:flex;flex-direction:column;gap:7px;color:#777;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.language-bar select{width:100%;border:1px solid #ddd;border-radius:14px;background:#fff;padding:14px 44px 14px 15px;color:#172033;font-size:15px;font-weight:700;outline:none}.language-bar select:focus{border-color:#f36a0a;box-shadow:0 0 0 3px rgba(243,106,10,.12)}.swap{height:48px;border:1px solid #eee;border-radius:14px;background:#fff;color:#f36a0a;font-size:25px;font-weight:800;cursor:pointer;box-shadow:0 6px 15px rgba(0,0,0,.04)}.translator-main{text-align:center;padding:8px 0 22px}.record{position:relative;display:inline-flex;align-items:center;gap:12px;border:0;border-radius:999px;background:#f36a0a;color:#fff;padding:15px 25px 15px 18px;font-size:14px;font-weight:900;letter-spacing:.02em;cursor:pointer;box-shadow:0 12px 28px rgba(243,106,10,.28);transition:.2s}.record:hover{transform:translateY(-1px);box-shadow:0 15px 32px rgba(243,106,10,.34)}.record.recording{background:#171b25}.record-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.16);font-size:18px}.record small{font-size:11px;opacity:.8}.hint{margin:11px auto 0;max-width:650px;color:#8a93a3;font-size:12px}.translation-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.speech-card{min-height:155px;border:1px solid #e9e9e9;border-radius:19px;background:#fff;padding:17px 19px}.speech-card.result{border-color:#f6d8c3;background:#fffdfa}.speech-card header{display:flex;align-items:center;justify-content:space-between;color:#f36a0a;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.06em}.speech-card p{margin:24px 0 0;color:#202938;font-size:17px;line-height:1.55;white-space:pre-wrap}.live-dot{font-size:9px;opacity:.35}.play{border:0;background:transparent;font-size:18px;cursor:pointer}.play:disabled{opacity:.3;cursor:default}.translator-note{margin:16px 0 0;text-align:center;color:#98a0ad;font-size:11px}@media(max-width:650px){.fox-translator{padding-top:25px;padding-bottom:25px}.translator-shell{padding:22px;border-radius:22px}.translator-head{display:block}.translator-tools{margin-top:15px;justify-content:flex-start;flex-wrap:wrap}.copy-top span{display:none}.mode-switch{max-width:none}.language-bar{grid-template-columns:1fr 48px 1fr;gap:8px}.translation-grid{grid-template-columns:1fr}.speech-card{min-height:125px}.speech-card p{font-size:15px}.record{width:100%;justify-content:center}}
</style>

<script define:vars={{ locale }}>
const root=document.querySelector('[data-translator]');
if(root){
const languages=[['bg','🇧🇬 Български'],['hr','🇭🇷 Hrvatski'],['cs','🇨🇿 Čeština'],['da','🇩🇰 Dansk'],['nl','🇳🇱 Nederlands'],['en','🇬🇧 English'],['et','🇪🇪 Eesti'],['fi','🇫🇮 Suomi'],['fr','🇫🇷 Français'],['de','🇩🇪 Deutsch'],['el','🇬🇷 Ελληνικά'],['hu','🇭🇺 Magyar'],['ga','🇮🇪 Gaeilge'],['it','🇮🇹 Italiano'],['lv','🇱🇻 Latviešu'],['lt','🇱🇹 Lietuvių'],['lb','🇱🇺 Lëtzebuergesch'],['mt','🇲🇹 Malti'],['pl','🇵🇱 Polski'],['pt','🇵🇹 Português'],['ro','🇷🇴 Română'],['sk','🇸🇰 Slovenčina'],['sl','🇸🇮 Slovenščina'],['es','🇪🇸 Español'],['sv','🇸🇪 Svenska']];
const source=root.querySelector('[data-source]'),target=root.querySelector('[data-target]'),swap=root.querySelector('[data-swap]'),record=root.querySelector('[data-record]'),label=root.querySelector('[data-record-label]'),timer=root.querySelector('[data-timer]'),status=root.querySelector('[data-status]'),transcript=root.querySelector('[data-transcript]'),translation=root.querySelector('[data-translation]'),sourceLabel=root.querySelector('[data-source-label]'),targetLabel=root.querySelector('[data-target-label]'),play=root.querySelector('[data-play]'),copy=root.querySelector('[data-copy]'),modes=[...root.querySelectorAll('[data-mode]')],modeNote=root.querySelector('[data-mode-note]');
const labels=Object.fromEntries(languages);const pageLocale=languages.some(x=>x[0]===locale)?locale:'en';
for(const [code,name] of languages){source.add(new Option(name,code));target.add(new Option(name,code));}
source.value=pageLocale;target.value=pageLocale==='sk'?'de':'sk';
const sync=()=>{sourceLabel.textContent=labels[source.value].replace(/^\S+\s/,'');targetLabel.textContent=labels[target.value].replace(/^\S+\s/,'');};sync();
let recorder=null,chunks=[],started=0,interval=null,audioUrl=null,currentMode='translator';
const setBusy=v=>{record.disabled=v;};
swap.addEventListener('click',()=>{const x=source.value;source.value=target.value;target.value=x;sync();});
modes.forEach(btn=>btn.addEventListener('click',()=>{currentMode=btn.dataset.mode;modes.forEach(b=>{const active=b===btn;b.classList.toggle('is-active',active);b.setAttribute('aria-selected',String(active));});modeNote.textContent=currentMode==='communicator'?'Režim pripravený pre budúce živé hlasové spojenie s klientom.':'Preložte hovorenú vetu do zvoleného jazyka.';}));
copy.addEventListener('click',async()=>{const text=translation.textContent?.trim();if(!text||text==='Preklad sa zobrazí tu…')return;try{await navigator.clipboard.writeText(text);const old=copy.innerHTML;copy.innerHTML='✓ <span>Skopírované</span>';setTimeout(()=>copy.innerHTML=old,1400);}catch(e){status.textContent='❌ Kopírovanie sa nepodarilo.';}});
const mime=()=>['audio/mp4','audio/webm;codecs=opus','audio/webm'].find(x=>MediaRecorder.isTypeSupported(x))||'';
record.addEventListener('click',async()=>{if(recorder?.state==='recording'){recorder.stop();return;}try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});chunks=[];const mt=mime();recorder=new MediaRecorder(stream,mt?{mimeType:mt}:undefined);started=Date.now();record.classList.add('recording');label.textContent='ZASTAVIŤ';status.textContent='Nahrávam… hovorte prirodzene.';timer.textContent='20 s';recorder.ondataavailable=e=>{if(e.data.size)chunks.push(e.data)};recorder.onstop=async()=>{stream.getTracks().forEach(t=>t.stop());record.classList.remove('recording');clearInterval(interval);label.textContent='SPRACOVÁVAM…';setBusy(true);const blob=new Blob(chunks,{type:recorder.mimeType||'audio/mp4'});if(blob.size>4*1024*1024){status.textContent='Nahrávka je príliš veľká. Skúste kratšiu vetu.';setBusy(false);label.textContent='ZAČAŤ HOVORIŤ';return;}const fd=new FormData();fd.append('audio',blob,'speech.m4a');fd.append('sourceLanguage',source.value);fd.append('targetLanguage',target.value);fd.append('speakResult','true');try{const res=await fetch('https://wdfox.vercel.app/api/translate-voice',{method:'POST',body:fd});const data=await res.json();if(!res.ok)throw new Error(data.error||'Translation failed');transcript.textContent=data.transcript;translation.textContent=data.translatedText;copy.disabled=false;status.textContent='Preklad je pripravený.';if(audioUrl)URL.revokeObjectURL(audioUrl);if(data.audioBase64){const bytes=Uint8Array.from(atob(data.audioBase64),c=>c.charCodeAt(0));audioUrl=URL.createObjectURL(new Blob([bytes],{type:data.audioMimeType||'audio/wav'}));play.disabled=false;play.onclick=()=>new Audio(audioUrl).play();}else play.disabled=true;}catch(e){status.textContent='❌ '+(e instanceof Error?e.message:'Preklad sa nepodaril.');}finally{setBusy(false);label.textContent='ZAČAŤ HOVORIŤ';timer.textContent='20 s';}};recorder.start();interval=setInterval(()=>{const left=Math.max(0,20-Math.floor((Date.now()-started)/1000));timer.textContent=left+' s';if(left<=0&&recorder.state==='recording')recorder.stop();},250);}catch(e){status.textContent='❌ Povolenie mikrofónu je potrebné pre hlasový preklad.';record.classList.remove('recording');setBusy(false);}});
}
</script>
