---
interface Props { locale: string }
const { locale } = Astro.props;
---
<section class="fox-translator section-wrap" id="translator" data-translator data-page-locale={locale}>
  <div class="translator-shell">
    <div class="translator-head"><div><p class="eyebrow"><span></span> FOX TECHNOLOGY LAB</p><h2>FOX <strong>LIVE TRANSLATOR</strong></h2><p class="translator-intro" data-i18n="intro"></p></div><div class="translator-tools"><div class="eu-badge">🇪🇺 <span data-i18n="eu"></span></div></div></div>
    <div class="mode-switch" role="tablist"><button type="button" class="mode is-active" data-mode="translator" role="tab" aria-selected="true" data-i18n="translatorMode"></button><button type="button" class="mode" data-mode="communicator" role="tab" aria-selected="false" data-i18n="communicatorMode"></button></div>
    <p class="mode-note" data-mode-note></p>
    <div class="language-bar"><label><span data-i18n="speak"></span><select data-source></select></label><button class="swap" type="button" data-swap>⇄</button><label><span data-i18n="translateTo"></span><select data-target></select></label></div>
    <div class="translator-main"><button class="record" type="button" data-record>🎤 <span data-record-label></span></button><p class="hint" data-status></p></div>
    <div class="communicator-panel hidden" data-communicator>
      <div class="comm-status" data-comm-status></div>
      <div class="comm-actions"><button class="record" type="button" data-create>🔗 <span data-i18n="create"></span></button><button class="call" type="button" data-call disabled>📞 <span data-call-label data-i18n="call"></span></button><button class="secondary" type="button" data-share disabled>⧉ <span data-i18n="share"></span></button></div>
      <div class="invite hidden" data-invite><div class="invite-link"><input data-link readonly /><button class="secondary" type="button" data-copy-link>⧉</button></div><div class="qr-wrap"><div data-qr></div><small data-i18n="invite"></small></div></div>
      <div class="comm-controls"><button class="secondary" type="button" data-mic disabled>🎙 <span data-mic-label data-i18n="mic"></span></button><button class="secondary" type="button" data-audio>🔊 AUDIO</button><button class="screen-btn" type="button" data-screen disabled>🖥 <span data-screen-label data-i18n="screen"></span></button><button class="secondary hidden" type="button" data-screen-stop>⛔ <span data-i18n="stopScreen"></span></button></div>
      <div class="screen-grid"><div class="screen-card"><header><span data-i18n="myScreen"></span><span data-local-screen-status></span></header><video data-local-screen autoplay playsinline muted></video></div><div class="screen-card"><header><span data-i18n="remoteScreen"></span><span data-remote-screen-status></span></header><video data-remote-screen autoplay playsinline></video></div></div>
    </div>
    <div class="translation-grid"><article class="speech-card"><header><span data-source-label></span><span>●</span></header><p data-transcript></p></article><article class="speech-card result"><header><span data-target-label></span><div><button type="button" class="play" data-play disabled>🔊</button><span class="speed-controls"><button data-speed="0.75">0.75×</button><button class="is-active" data-speed="1">1×</button><button data-speed="1.25">1.25×</button><button data-speed="1.5">1.5×</button></span></div></header><p data-translation></p></article></div>
    <p class="translator-note">🔒 <span data-i18n="privacy"></span></p><audio data-remote-audio autoplay playsinline></audio>
  </div>
</section>
<style>
.fox-translator{padding:42px 0}.translator-shell{position:relative;overflow:hidden;border:1px solid #ececec;border-radius:28px;background:linear-gradient(135deg,#fff 0%,#fffaf6 100%);box-shadow:0 22px 60px rgba(20,24,35,.08);padding:34px}.translator-shell:before{content:"";position:absolute;inset:0 0 auto;height:5px;background:#f36a0a}.translator-head{display:flex;justify-content:space-between;gap:24px}.translator-head h2{margin:5px 0 8px;font-size:clamp(28px,4vw,44px);line-height:1;letter-spacing:-.04em;color:#121a2a}.translator-head h2 strong{color:#f36a0a}.translator-intro{max-width:680px;margin:0;color:#667085;font-size:15px;line-height:1.65}.eu-badge,.secondary{border:1px solid #eee;border-radius:999px;background:#fff;color:#172033;padding:10px 14px;font-size:12px;font-weight:800;box-shadow:0 7px 20px rgba(0,0,0,.05)}.mode-switch{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:26px;padding:5px;border:1px solid #eee;border-radius:15px;background:#f7f7f7;max-width:560px}.mode{border:0;border-radius:11px;background:transparent;padding:12px 16px;color:#667085;font-size:12px;font-weight:900;cursor:pointer}.mode.is-active{background:#fff;color:#f36a0a;box-shadow:0 5px 15px rgba(0,0,0,.07)}.mode-note{margin:9px 0;color:#8a93a3;font-size:12px}.language-bar{display:grid;grid-template-columns:1fr 58px 1fr;align-items:end;gap:14px;margin:22px 0 18px}.language-bar label{display:flex;flex-direction:column;gap:7px;color:#777;font-size:11px;font-weight:800;text-transform:uppercase}.language-bar select{width:100%;border:1px solid #ddd;border-radius:14px;background:#fff;padding:14px;color:#172033;font-size:15px;font-weight:700}.swap{height:48px;border:1px solid #eee;border-radius:14px;background:#fff;color:#f36a0a;font-size:25px;font-weight:800;cursor:pointer}.translator-main{text-align:center;padding:8px 0 22px}.record,.call,.screen-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;border-radius:999px;background:#f36a0a;color:#fff;padding:15px 24px;font-size:13px;font-weight:900;cursor:pointer;box-shadow:0 12px 28px rgba(243,106,10,.28)}.record.recording{background:#171b25}.call{background:#18a957}.screen-btn{background:#4257d6}.call:disabled,.secondary:disabled,.record:disabled,.screen-btn:disabled{opacity:.42;cursor:default}.hint{margin:11px auto 0;color:#8a93a3;font-size:12px}.translation-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.speech-card{min-height:155px;border:1px solid #e9e9e9;border-radius:19px;background:#fff;padding:17px 19px}.speech-card.result{border-color:#f6d8c3;background:#fffdfa}.speech-card header{display:flex;justify-content:space-between;align-items:center;color:#f36a0a;font-size:12px;font-weight:900;text-transform:uppercase}.speech-card p{margin:24px 0 0;color:#202938;font-size:17px;line-height:1.55;white-space:pre-wrap}.play{border:0;background:transparent;font-size:18px;cursor:pointer}.speed-controls{display:inline-flex;gap:2px;margin-left:5px;border:1px solid #eee;border-radius:999px;padding:2px;background:#fff}.speed-controls button{border:0;border-radius:999px;background:transparent;padding:4px 6px;font-size:10px;cursor:pointer}.speed-controls button.is-active{background:#f36a0a;color:#fff}.hidden{display:none!important}.communicator-panel{margin:8px 0 22px;padding:18px;border:1px solid #f6d8c3;border-radius:20px;background:#fffdfa}.comm-status{padding:12px;border-radius:12px;background:#f7f7f7;color:#667085;font-size:12px}.comm-actions,.comm-controls{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}.comm-actions button,.comm-controls button{min-height:42px}.invite{margin-top:14px}.invite-link{display:grid;grid-template-columns:1fr auto;gap:8px}.invite-link input{width:100%;box-sizing:border-box;border:1px solid #ddd;border-radius:11px;padding:12px}.qr-wrap{margin-top:12px;border:1px solid #eee;border-radius:16px;background:#fff;padding:12px;text-align:center;width:max-content;max-width:100%}.qr-wrap [data-qr]{width:210px;min-height:210px;display:grid;place-items:center}.qr-wrap img,.qr-wrap canvas{max-width:210px;height:auto!important}.screen-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}.screen-card{border:1px solid #e8e8e8;border-radius:16px;background:#fff;padding:10px}.screen-card header{display:flex;justify-content:space-between;color:#667085;font-size:11px;font-weight:900;text-transform:uppercase;margin-bottom:8px}.screen-card video{display:block;width:100%;min-height:180px;max-height:420px;object-fit:contain;background:#111;border-radius:10px}.translator-shell audio{display:none}.is-call-mode .translator-main{display:none}.is-call-mode .mode-note{color:#f36a0a;font-weight:700}@media(max-width:650px){.translator-shell{padding:22px;border-radius:22px}.translator-head{display:block}.language-bar{grid-template-columns:1fr 46px 1fr;gap:8px}.translation-grid,.screen-grid{grid-template-columns:1fr}.comm-actions,.comm-controls{display:grid;grid-template-columns:1fr}.comm-actions button,.comm-controls button,.call,.record,.screen-btn{width:100%}.qr-wrap{width:100%;box-sizing:border-box}}
</style>
<script define:vars={{ locale }}>
const root=document.querySelector('[data-translator]');
if(root){
const languages=[['bg','🇧🇬 Български'],['hr','🇭🇷 Hrvatski'],['cs','🇨🇿 Čeština'],['da','🇩🇰 Dansk'],['nl','🇳🇱 Nederlands'],['en','🇬🇧 English'],['et','🇪🇪 Eesti'],['fi','🇫🇮 Suomi'],['fr','🇫🇷 Français'],['de','🇩🇪 Deutsch'],['el','🇬🇷 Ελληνικά'],['hu','🇭🇺 Magyar'],['ga','🇮🇪 Gaeilge'],['it','🇮🇹 Italiano'],['lv','🇱🇻 Latviešu'],['lt','🇱🇹 Lietuvių'],['lb','🇱🇺 Lëtzebuergesch'],['mt','🇲🇹 Malti'],['pl','🇵🇱 Polski'],['pt','🇵🇹 Português'],['ro','🇷🇴 Română'],['sk','🇸🇰 Slovenčina'],['sl','🇸🇮 Slovenščina'],['es','🇪🇸 Español'],['sv','🇸🇪 Svenska']];
const labels=Object.fromEntries(languages);
const ui={sk:{intro:'Profesionálny hlasový prekladač a komunikátor pre klientov v celej EÚ.',eu:'24 jazykov EÚ',translatorMode:'🔄 PREKLADAČ',communicatorMode:'☎️ KOMUNIKÁTOR',speak:'HOVORÍM',translateTo:'PRELOŽIŤ DO',start:'ZAČAŤ HOVORIŤ',stop:'ZASTAVIŤ',ready:'Preklad je pripravený.',initial:'Stlačte tlačidlo a hovorte.',recording:'Nahrávam…',processing:'SPRACOVÁVAM…',translatorNote:'Preložte hovorenú vetu do zvoleného jazyka.',communicatorNote:'Vytvorte spojenie, pošlite QR druhému zariadeniu a uskutočnite hovor.',create:'VYTVORIŤ SPOJENIE',call:'USKUTOČNIŤ HOVOR',accept:'PRIJATIE HOVORU',share:'KOPÍROVAŤ POZVÁNKU',invite:'Naskenujte QR na druhom zariadení a stlačte USKUTOČNIŤ HOVOR.',waiting:'Čakám na druhé zariadenie…',incoming:'🔔 PRICHÁDZAJÚCI HOVOR – PRIJATIE HOVORU',calling:'VOLÁM…',active:'HOVOR JE AKTÍVNY',mic:'ZAPNÚŤ MIKROFÓN',screen:'ZDIEĽAŤ MOJU OBRAZOVKU',stopScreen:'ZASTAVIŤ ZDIEĽANIE',myScreen:'MOJA OBRAZOVKA',remoteScreen:'OBRAZOVKA PARTNERA',screenReady:'Obrazovka sa zdieľa.',screenStopped:'Zdieľanie obrazovky zastavené.',privacy:'Preklad prebieha cez zabezpečený server. API kľúč zostáva na serveri.'},en:{intro:'Professional voice translator and communicator for clients across the EU.',eu:'24 EU languages',translatorMode:'🔄 TRANSLATOR',communicatorMode:'☎️ COMMUNICATOR',speak:'SPEAK',translateTo:'TRANSLATE TO',start:'START SPEAKING',stop:'STOP',ready:'Translation ready.',initial:'Press the button and speak.',recording:'Recording…',processing:'PROCESSING…',translatorNote:'Translate a spoken sentence into the selected language.',communicatorNote:'Create a connection, send the QR to the second device and make a call.',create:'CREATE CONNECTION',call:'MAKE A CALL',accept:'ACCEPT CALL',share:'COPY INVITATION',invite:'Scan the QR on the second device and press MAKE A CALL.',waiting:'Waiting for the second device…',incoming:'🔔 INCOMING CALL – ACCEPT CALL',calling:'CALLING…',active:'CALL IS ACTIVE',mic:'TURN MICROPHONE ON',screen:'SHARE MY SCREEN',stopScreen:'STOP SHARING',myScreen:'MY SCREEN',remoteScreen:'PARTNER SCREEN',screenReady:'Screen is being shared.',screenStopped:'Screen sharing stopped.',privacy:'Translation runs through the secure server. The API key stays on the server.'},de:{intro:'Professioneller Sprachübersetzer und Kommunikator für Kunden in der EU.',eu:'24 EU-Sprachen',translatorMode:'🔄 ÜBERSETZER',communicatorMode:'☎️ KOMMUNIKATOR',speak:'SPRECHEN',translateTo:'ÜBERSETZEN IN',start:'SPRECHEN STARTEN',stop:'STOPP',ready:'Übersetzung bereit.',initial:'Taste drücken und sprechen.',recording:'Aufnahme…',processing:'VERARBEITUNG…',translatorNote:'Gesprochenen Satz in die gewählte Sprache übersetzen.',communicatorNote:'Verbindung erstellen, QR an das zweite Gerät senden und Anruf starten.',create:'VERBINDUNG ERSTELLEN',call:'ANRUF STARTEN',accept:'ANRUF ANNEHMEN',share:'EINLADUNG KOPIEREN',invite:'QR am zweiten Gerät scannen und ANRUF STARTEN drücken.',waiting:'Warte auf das zweite Gerät…',incoming:'🔔 EINGEHENDER ANRUF – ANRUF ANNEHMEN',calling:'ANRUF…',active:'ANRUF IST AKTIV',mic:'MIKROFON EINSCHALTEN',screen:'MEINEN BILDSCHIRM TEILEN',stopScreen:'TEILEN BEENDEN',myScreen:'MEIN BILDSCHIRM',remoteScreen:'BILDSCHIRM DES PARTNERS',screenReady:'Bildschirm wird geteilt.',screenStopped:'Bildschirmfreigabe beendet.',privacy:'Die Übersetzung läuft über den sicheren Server. Der API-Schlüssel bleibt auf dem Server.'}};
const t=ui[locale]||ui.en;const $=s=>root.querySelector(s);const source=$('[data-source]'),target=$('[data-target]'),swap=$('[data-swap]'),record=$('[data-record]'),recordLabel=$('[data-record-label]'),status=$('[data-status]'),transcript=$('[data-transcript]'),translation=$('[data-translation]'),sourceLabel=$('[data-source-label]'),targetLabel=$('[data-target-label]'),play=$('[data-play]'),modeNote=$('[data-mode-note]'),comm=$('[data-communicator]'),commStatus=$('[data-comm-status]'),create=$('[data-create]'),callBtn=$('[data-call]'),callLabel=$('[data-call-label]'),share=$('[data-share]'),invite=$('[data-invite]'),link=$('[data-link]'),copyLink=$('[data-copy-link]'),qr=$('[data-qr]'),mic=$('[data-mic]'),micLabel=$('[data-mic-label]'),audioBtn=$('[data-audio]'),remoteAudio=$('[data-remote-audio]'),screenBtn=$('[data-screen]'),screenLabel=$('[data-screen-label]'),screenStop=$('[data-screen-stop]'),localScreen=$('[data-local-screen]'),remoteScreen=$('[data-remote-screen]'),localScreenStatus=$('[data-local-screen-status]'),remoteScreenStatus=$('[data-remote-screen-status]');
const modes=[...root.querySelectorAll('[data-mode]')];root.querySelectorAll('[data-i18n]').forEach(el=>{const k=el.dataset.i18n;if(t[k]!==undefined)el.textContent=t[k]});recordLabel.textContent=t.start;status.textContent=t.initial;modeNote.textContent=t.translatorNote;micLabel.textContent=t.mic;screenLabel.textContent=t.screen;for(const [code,name] of languages){source.add(new Option(name,code));target.add(new Option(name,code))}source.value=languages.some(x=>x[0]===locale)?locale:'en';target.value=source.value==='sk'?'en':'sk';const getLocale=c=>({sk:'sk-SK',en:'en-US',de:'de-DE',fr:'fr-FR',es:'es-ES',it:'it-IT',pl:'pl-PL',cs:'cs-CZ',hu:'hu-HU',nl:'nl-NL',pt:'pt-PT',ro:'ro-RO',bg:'bg-BG',hr:'hr-HR',da:'da-DK',el:'el-GR',fi:'fi-FI',sv:'sv-SE'})[c]||c;
let currentMode='translator',recognition=null,recognizing=false,peer=null,peerReady=false,remoteId=new URLSearchParams(location.search).get('foxPeer'),dataConn=null,mediaConn=null,pendingCall=null,localStream=null,screenStream=null,screenCall=null,ringTimer=null,audioCtx=null,ringing=false,interactionId=null;
const loadScript=(src,test)=>new Promise((resolve,reject)=>{if(test())return resolve();const s=document.createElement('script');s.src=src;s.onload=resolve;s.onerror=reject;document.head.appendChild(s)});const loadPeer=()=>loadScript('https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js',()=>!!window.Peer);const loadQr=()=>loadScript('https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js',()=>!!window.QRCode);
const setComm=v=>{commStatus.textContent=v};const primeAudio=()=>{try{audioCtx??=new (window.AudioContext||window.webkitAudioContext)();audioCtx.resume()}catch{}};const startRing=()=>{if(ringing)return;ringing=true;primeAudio();let on=true;ringTimer=setInterval(()=>{document.title=on?'📞 FOX LIVE':'FOX LIVE';on=!on;try{navigator.vibrate?.([220,120,220])}catch{}try{const o=audioCtx?.createOscillator(),g=audioCtx?.createGain();if(o&&g){o.frequency.value=880;g.gain.value=.035;o.connect(g).connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+.18)}}catch{}},900)};const stopRing=()=>{ringing=false;if(ringTimer)clearInterval(ringTimer);ringTimer=null;document.title='FOX LIVE TRANSLATOR'};
const send=m=>{if(dataConn?.open)try{dataConn.send(m)}catch{}};const attachMedia=mc=>{mediaConn=mc;mc.on('stream',s=>{remoteAudio.srcObject=s;remoteAudio.muted=true;remoteAudio.volume=0;remoteAudio.play().catch(()=>{})});mc.on('close',()=>{stopRecognition();setComm(t.waiting)});mc.on('error',e=>setComm('Hovor: '+(e?.message||'chyba')))};
const attachScreen=(mc,local=false)=>{if(local)screenCall=mc;mc.on('stream',s=>{remoteScreen.srcObject=s;remoteScreen.style.display='block';remoteScreen.play().catch(()=>{});remoteScreenStatus.textContent='● LIVE'});mc.on('close',()=>{remoteScreen.srcObject=null;remoteScreenStatus.textContent=''});mc.on('error',e=>{remoteScreenStatus.textContent='CHYBA: '+(e?.message||'WebRTC')})};
const stopScreenShare=()=>{try{screenCall?.close()}catch{};screenCall=null;if(screenStream){screenStream.getTracks().forEach(x=>x.stop());screenStream=null}localScreen.srcObject=null;localScreenStatus.textContent='';screenBtn.classList.remove('hidden');screenStop.classList.add('hidden');screenBtn.disabled=!peerReady||!remoteId;setComm(t.screenStopped)};
const startScreenShare=async()=>{if(!peerReady||!remoteId){setComm('❌ Najprv vytvorte a aktivujte spojenie.');return}if(!navigator.mediaDevices){setComm('❌ Tento prehliadač nemá MediaDevices.');return}if(typeof navigator.mediaDevices.getDisplayMedia!=='function'){setComm('❌ Tento mobilný prehliadač nepodporuje zdieľanie obrazovky. Skúste Chrome/Edge alebo FOX Android aplikáciu.');return}screenBtn.disabled=true;setComm('🖥 Otváram výber obrazovky…');try{const stream=await navigator.mediaDevices.getDisplayMedia({video:{displaySurface:'monitor',frameRate:{ideal:15,max:20}},audio:false});const tracks=stream.getVideoTracks();if(tracks.length!==1)throw new Error('FOX potrebuje presne jednu obrazovku.');screenStream=stream;localScreen.srcObject=stream;localScreenStatus.textContent='● LIVE';screenBtn.classList.add('hidden');screenStop.classList.remove('hidden');const track=tracks[0];track.addEventListener('ended',stopScreenShare,{once:true});const c=peer.call(remoteId,stream,{metadata:{foxScreen:true,kind:'screen',version:2}});screenCall=c;attachScreen(c,true);c.on('close',()=>{if(screenCall===c)screenCall=null});c.on('error',e=>{setComm('❌ WebRTC obrazovky: '+(e?.message||'chyba'));stopScreenShare()});setComm(t.screenReady)}catch(e){screenBtn.disabled=false;const n=e?.name||'';setComm(n==='NotAllowedError'?'Zdieľanie obrazovky bolo zamietnuté alebo zrušené.':`❌ Obrazovku sa nepodarilo zdieľať: ${e?.message||e}`)}};
const wireData=c=>{dataConn=c;remoteId=c.peer;screenBtn.disabled=false;c.on('open',()=>{setComm(t.active);screenBtn.disabled=false});c.on('close',()=>{setComm(t.waiting);screenBtn.disabled=true;stopScreenShare()});c.on('error',e=>setComm('Data: '+(e?.message||'chyba')));c.on('data',m=>{if(m?.type==='call-request'){primeAudio();startRing();callBtn.disabled=false;callLabel.textContent=t.accept;setComm(t.incoming)}else if(m?.type==='speech'){translateIncoming(m)}else if(m?.type==='translation'){translation.textContent=m.text||''}})};
const openPeer=async()=>{await loadPeer();if(peerReady)return;peer=new Peer(undefined,{config:{iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun.cloudflare.com:3478'}]}});peer.on('connection',c=>wireData(c));peer.on('call',mc=>{if(mc.metadata?.foxScreen){mc.answer();attachScreen(mc,false);remoteScreenStatus.textContent='● PRICHÁDZA';return}pendingCall=mc;primeAudio();startRing();callBtn.disabled=false;callLabel.textContent=t.accept;setComm(t.incoming)});peer.on('disconnected',()=>setComm('PeerJS odpojený – pripájam…'));peer.on('error',e=>setComm('PeerJS: '+(e?.type||e?.message||'chyba')));await new Promise((resolve,reject)=>{const tm=setTimeout(()=>reject(Error('PeerJS timeout')),20000);peer.once('open',()=>{clearTimeout(tm);peerReady=true;resolve()})})};
const createRoom=async()=>{primeAudio();create.disabled=true;setComm('Vytváram spojenie…');try{await openPeer();link.value=location.origin+location.pathname+'?foxPeer='+encodeURIComponent(peer.id)+'&foxSource='+encodeURIComponent(source.value)+'&foxTarget='+encodeURIComponent(target.value);invite.classList.remove('hidden');share.disabled=false;copyLink.disabled=false;screenBtn.disabled=true;await loadQr();qr.innerHTML='';new QRCode(qr,{text:link.value,width:210,height:210});setComm(t.waiting)}catch(e){create.disabled=false;setComm('❌ '+(e?.message||'Spojenie sa nepodarilo'))}};
const ensureLocal=async()=>{if(localStream)return localStream;localStream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});localStream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;return localStream};
const requestCall=async()=>{if(!remoteId){setComm(t.waiting);return}try{primeAudio();callBtn.disabled=true;callLabel.textContent=t.call;await openPeer();await ensureLocal();const c=peer.connect(remoteId,{reliable:true,label:'fox-control'});wireData(c);await new Promise((resolve,reject)=>{if(c.open)return resolve();const tm=setTimeout(()=>reject(Error('Data connection timeout')),15000);c.once('open',()=>{clearTimeout(tm);resolve()});c.once('error',reject)});send({type:'call-request',source:source.value,target:target.value,at:Date.now()});attachMedia(peer.call(remoteId,localStream));setComm(t.calling)}catch(e){callBtn.disabled=false;callLabel.textContent=t.call;setComm('❌ '+(e?.message||'Hovor sa nepodaril'))}};
const acceptCall=async()=>{if(!pendingCall)return;try{primeAudio();stopRing();callBtn.disabled=true;await ensureLocal();const mc=pendingCall;pendingCall=null;mc.answer(localStream);attachMedia(mc);setComm(t.active);startRecognition()}catch(e){callBtn.disabled=false;callLabel.textContent=t.accept;setComm('❌ '+(e?.message||'Prijatie hovoru zlyhalo'))}};
const translateIncoming=async m=>{try{const r=await fetch('/api/gemini-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({text:m.text,source:m.source,target:m.target,previousInteractionId:interactionId})});const j=await r.json();if(j?.interactionId)interactionId=j.interactionId;const text=j?.text||j?.translation||'';translation.textContent=text;play.disabled=!text;send({type:'translation',id:m.id,text})}catch{setComm('Preklad sa nepodaril.')}};
const startRecognition=()=>{if(recognizing)return;const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){setComm('Tento prehliadač nepodporuje rozpoznávanie reči. Použite Chrome/Edge.');return}recognition=new SR();recognition.lang=getLocale(source.value);recognition.continuous=true;recognition.interimResults=true;recognition.maxAlternatives=1;recognition.onstart=()=>{recognizing=true;setComm(t.active)};recognition.onerror=e=>{recognizing=false;if(e.error!=='aborted')setComm('SpeechRecognition: '+e.error)};recognition.onresult=e=>{let interim='';for(let i=e.resultIndex;i<e.results.length;i++){const text=e.results[i][0].transcript.trim();if(e.results[i].isFinal&&text){transcript.textContent=text;send({type:'speech',id:Date.now()+Math.random(),text,source:source.value,target:target.value})}else interim+=text}if(interim)transcript.textContent=interim};recognition.onend=()=>{recognizing=false;if(currentMode==='communicator'&&mediaConn?.open)setTimeout(startRecognition,250)};try{recognition.start()}catch{}};const stopRecognition=()=>{try{recognition?.stop()}catch{}recognizing=false};
record.onclick=()=>{primeAudio();if(recognizing){stopRecognition();record.classList.remove('recording');recordLabel.textContent=t.start;status.textContent=t.initial}else{startRecognition();record.classList.add('recording');recordLabel.textContent=t.stop;status.textContent=t.recording}};
modes.forEach(b=>b.onclick=()=>{currentMode=b.dataset.mode;modes.forEach(x=>{const a=x===b;x.classList.toggle('is-active',a);x.setAttribute('aria-selected',String(a))});comm.classList.toggle('hidden',currentMode!=='communicator');root.classList.toggle('is-call-mode',currentMode==='communicator');modeNote.textContent=currentMode==='communicator'?t.communicatorNote:t.translatorNote});
create.onclick=createRoom;callBtn.onclick=()=>remoteId?requestCall():acceptCall;share.onclick=async()=>{try{await navigator.clipboard.writeText(link.value);setComm(t.share)}catch{link.select();document.execCommand('copy')}};copyLink.onclick=share.onclick;screenBtn.onclick=startScreenShare;screenStop.onclick=stopScreenShare;audioBtn.onclick=()=>{primeAudio();window.speechSynthesis?.resume?.();remoteAudio.muted=true;setComm(t.active)};mic.onclick=()=>{const tr=localStream?.getAudioTracks?.()[0];if(!tr)return;tr.enabled=!tr.enabled;micLabel.textContent=tr.enabled?t.mic:'ZAPNÚŤ MIKROFÓN'};swap.onclick=()=>{const x=source.value;source.value=target.value;target.value=x;sourceLabel.textContent=labels[source.value];targetLabel.textContent=labels[target.value]};source.onchange=()=>{sourceLabel.textContent=labels[source.value]};target.onchange=()=>{targetLabel.textContent=labels[target.value]};sourceLabel.textContent=labels[source.value];targetLabel.textContent=labels[target.value];
play.onclick=()=>{if(translation.textContent)window.speechSynthesis?.speak(new SpeechSynthesisUtterance(translation.textContent))};root.querySelectorAll('[data-speed]').forEach(b=>b.onclick=()=>{root.querySelectorAll('[data-speed]').forEach(x=>x.classList.remove('is-active'));b.classList.add('is-active');window.__foxSpeechRate=Number(b.dataset.speed)});
(async()=>{const qs=new URLSearchParams(location.search);const qsSource=qs.get('foxSource'),qsTarget=qs.get('foxTarget');if(qsSource&&qsTarget){source.value=qsTarget;target.value=qsSource;sourceLabel.textContent=labels[source.value];targetLabel.textContent=labels[target.value];currentMode='communicator';modes.forEach(b=>{const a=b.dataset.mode==='communicator';b.classList.toggle('is-active',a);b.setAttribute('aria-selected',String(a))});comm.classList.remove('hidden');root.classList.add('is-call-mode');modeNote.textContent=t.communicatorNote;try{await openPeer();callBtn.disabled=false;callLabel.textContent=t.call;setComm(t.waiting)}catch(e){setComm('❌ '+(e?.message||'Spojenie sa nepodarilo'))}}})();
}
</script>