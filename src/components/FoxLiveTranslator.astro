---
interface Props { locale: string }
const { locale } = Astro.props;
---
<section class="fox-translator section-wrap" id="translator" data-translator data-page-locale={locale}>
  <div class="translator-shell">
    <div class="translator-head">
      <div>
        <p class="eyebrow"><span></span> FOX TECHNOLOGY LAB</p>
        <h2>FOX <strong>LIVE TRANSLATOR</strong></h2>
        <p class="translator-intro" data-i18n="intro"></p>
      </div>
      <div class="translator-tools">
        <button class="copy-top" type="button" data-copy disabled>⧉ <span data-i18n="copy"></span></button>
        <div class="eu-badge">🇪🇺 <span data-i18n="eu"></span></div>
      </div>
    </div>

    <div class="mode-switch" role="tablist" data-i18n-aria="modes">
      <button type="button" class="mode is-active" data-mode="translator" role="tab" aria-selected="true" data-i18n="translatorMode"></button>
      <button type="button" class="mode" data-mode="communicator" role="tab" aria-selected="false" data-i18n="communicatorMode"></button>
    </div>
    <p class="mode-note" data-mode-note></p>

    <div class="language-bar">
      <label><span data-i18n="speak"></span><select data-source></select></label>
      <button class="swap" type="button" data-swap aria-label="⇄">⇄</button>
      <label><span data-i18n="translateTo"></span><select data-target></select></label>
    </div>

    <div class="translator-main" data-translator-controls>
      <button class="record" type="button" data-record><span class="record-icon">🎤</span><span data-record-label></span></button>
      <p class="hint" data-status></p>
    </div>

    <div class="communicator-panel hidden" data-communicator>
      <div class="comm-status" data-comm-status></div>
      <div class="comm-actions">
        <button class="record comm-create" type="button" data-create>🔗 <span data-i18n="create"></span></button>
        <button class="call" type="button" data-call disabled>📞 <span data-call-label data-i18n="call"></span></button>
        <button class="secondary comm-copy" type="button" data-share disabled>⧉ <span data-i18n="share"></span></button>
      </div>
      <div class="invite hidden" data-invite>
        <div class="invite-link"><input data-link readonly aria-label="Connection link" /><button type="button" class="secondary" data-copy-link>⧉</button></div>
        <div class="qr-wrap"><div data-qr></div><small data-i18n="invite"></small></div>
      </div>
      <div class="comm-controls">
        <button class="secondary" type="button" data-mic disabled>🎙 <span data-mic-label data-i18n="mic"></span></button>
        <button class="secondary" type="button" data-audio>🔊 AUDIO</button>
      </div>
    </div>

    <div class="translation-grid">
      <article class="speech-card"><header><span data-source-label></span><span class="live-dot">●</span></header><p data-transcript></p></article>
      <article class="speech-card result"><header><span data-target-label></span><div class="play-area"><button type="button" class="play" data-play disabled aria-label="">🔊</button><div class="speed-controls"><button type="button" data-speed="0.75">0.75×</button><button type="button" class="is-active" data-speed="1">1×</button><button type="button" data-speed="1.25">1.25×</button><button type="button" data-speed="1.5">1.5×</button></div></div></header><p data-translation></p></article>
    </div>
    <p class="translator-note">🔒 <span data-i18n="privacy"></span></p>
    <audio data-remote-audio autoplay playsinline></audio>
  </div>
</section>
<style>
.fox-translator{padding-top:42px;padding-bottom:42px}.translator-shell{position:relative;overflow:hidden;border:1px solid #ececec;border-radius:28px;background:linear-gradient(135deg,#fff 0%,#fffaf6 100%);box-shadow:0 22px 60px rgba(20,24,35,.08);padding:34px}.translator-shell:before{content:"";position:absolute;left:0;top:0;right:0;height:5px;background:#f36a0a}.translator-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24px}.translator-head h2{margin:5px 0 8px;font-size:clamp(28px,4vw,44px);line-height:1;letter-spacing:-.04em;color:#121a2a}.translator-head h2 strong{color:#f36a0a}.translator-intro{max-width:680px;margin:0;color:#667085;font-size:15px;line-height:1.65}.translator-tools{display:flex;align-items:center;gap:9px}.copy-top,.secondary{display:flex;align-items:center;gap:6px;white-space:nowrap;border:1px solid #eee;border-radius:999px;background:#fff;color:#172033;padding:10px 13px;font-size:12px;font-weight:800;box-shadow:0 7px 20px rgba(0,0,0,.05);cursor:pointer}.copy-top:disabled,.secondary:disabled{opacity:.42;cursor:default}.eu-badge{display:flex;align-items:center;gap:8px;white-space:nowrap;border:1px solid #eee;border-radius:999px;background:#fff;padding:10px 14px;font-size:13px;font-weight:800;box-shadow:0 7px 20px rgba(0,0,0,.05)}.mode-switch{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:26px;padding:5px;border:1px solid #eee;border-radius:15px;background:#f7f7f7;max-width:560px}.mode{border:0;border-radius:11px;background:transparent;padding:12px 16px;color:#667085;font-size:12px;font-weight:900;letter-spacing:.03em;cursor:pointer}.mode.is-active{background:#fff;color:#f36a0a;box-shadow:0 5px 15px rgba(0,0,0,.07)}.mode-note{margin:9px 0 0;color:#8a93a3;font-size:12px}.language-bar{display:grid;grid-template-columns:1fr 58px 1fr;align-items:end;gap:14px;margin:22px 0 18px}.language-bar label{display:flex;flex-direction:column;gap:7px;color:#777;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.language-bar select{width:100%;border:1px solid #ddd;border-radius:14px;background:#fff;padding:14px 44px 14px 15px;color:#172033;font-size:15px;font-weight:700;outline:none}.swap{height:48px;border:1px solid #eee;border-radius:14px;background:#fff;color:#f36a0a;font-size:25px;font-weight:800;cursor:pointer;box-shadow:0 6px 15px rgba(0,0,0,.04)}.translator-main{text-align:center;padding:8px 0 22px}.record{position:relative;display:inline-flex;align-items:center;gap:12px;border:0;border-radius:999px;background:#f36a0a;color:#fff;padding:15px 25px 15px 18px;font-size:14px;font-weight:900;letter-spacing:.02em;cursor:pointer;box-shadow:0 12px 28px rgba(243,106,10,.28);transition:.2s}.record.recording{background:#171b25}.record-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.16);font-size:18px}.hint{margin:11px auto 0;max-width:650px;color:#8a93a3;font-size:12px}.translation-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.speech-card{min-height:155px;border:1px solid #e9e9e9;border-radius:19px;background:#fff;padding:17px 19px}.speech-card.result{border-color:#f6d8c3;background:#fffdfa}.speech-card header{display:flex;align-items:center;justify-content:space-between;color:#f36a0a;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.06em}.speech-card p{margin:24px 0 0;color:#202938;font-size:17px;line-height:1.55;white-space:pre-wrap}.live-dot{font-size:9px;opacity:.35}.play-area{display:flex;align-items:center;gap:8px}.play{border:0;background:transparent;font-size:18px;cursor:pointer}.play:disabled{opacity:.3}.speed-controls{display:flex;align-items:center;gap:3px;border:1px solid #eee;border-radius:999px;background:#fff;padding:2px}.speed-controls button{border:0;border-radius:999px;background:transparent;color:#667085;padding:4px 7px;font-size:10px;font-weight:800;cursor:pointer}.speed-controls button.is-active{background:#f36a0a;color:#fff}.hidden{display:none!important}.communicator-panel{margin:8px 0 22px;padding:18px;border:1px solid #f6d8c3;border-radius:20px;background:#fffdfa}.comm-status{padding:11px 13px;border-radius:12px;background:#f7f7f7;color:#667085;font-size:12px}.comm-actions,.comm-controls{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}.comm-actions button,.comm-controls button{min-height:42px}.comm-create{padding:12px 18px}.call{border:0;border-radius:999px;background:#18a957;color:#fff;padding:12px 18px;font-size:12px;font-weight:900;cursor:pointer}.call:disabled{opacity:.42;cursor:default}.invite{margin-top:14px}.invite-link{display:grid;grid-template-columns:1fr auto;gap:8px}.invite-link input{width:100%;box-sizing:border-box;border:1px solid #ddd;border-radius:11px;background:#fff;color:#172033;padding:12px}.qr-wrap{margin-top:12px;background:#fff;color:#172033;border:1px solid #eee;border-radius:16px;padding:12px;text-align:center;width:max-content;max-width:100%}.qr-wrap [data-qr]{width:210px;min-height:210px;display:flex;align-items:center;justify-content:center}.qr-wrap img,.qr-wrap canvas{display:block!important;max-width:210px;height:auto!important;margin:auto}.comm-controls .secondary{border-radius:12px}.translator-shell audio{display:none}.is-call-mode .translator-main{display:none}.is-call-mode .mode-note{color:#f36a0a;font-weight:700}@media(max-width:650px){.fox-translator{padding-top:25px;padding-bottom:25px}.translator-shell{padding:22px;border-radius:22px}.translator-head{display:block}.translator-tools{margin-top:15px;justify-content:flex-start;flex-wrap:wrap}.mode-switch{max-width:none}.language-bar{grid-template-columns:1fr 48px 1fr;gap:8px}.translation-grid{grid-template-columns:1fr}.speech-card{min-height:125px}.speech-card p{font-size:15px}.record,.call{width:100%;justify-content:center}.comm-actions,.comm-controls{display:grid;grid-template-columns:1fr}.comm-actions button,.comm-controls button{width:100%}.qr-wrap{width:100%;box-sizing:border-box}.invite-link{grid-template-columns:1fr auto}}
</style>
<script define:vars={{ locale }}>
const root=document.querySelector('[data-translator]');
if(root){
const languages=[['bg','🇧🇬 Български'],['hr','🇭🇷 Hrvatski'],['cs','🇨🇿 Čeština'],['da','🇩🇰 Dansk'],['nl','🇳🇱 Nederlands'],['en','🇬🇧 English'],['et','🇪🇪 Eesti'],['fi','🇫🇮 Suomi'],['fr','🇫🇷 Français'],['de','🇩🇪 Deutsch'],['el','🇬🇷 Ελληνικά'],['hu','🇭🇺 Magyar'],['ga','🇮🇪 Gaeilge'],['it','🇮🇹 Italiano'],['lv','🇱🇻 Latviešu'],['lt','🇱🇹 Lietuvių'],['lb','🇱🇺 Lëtzebuergesch'],['mt','🇲🇹 Malti'],['pl','🇵🇱 Polski'],['pt','🇵🇹 Português'],['ro','🇷🇴 Română'],['sk','🇸🇰 Slovenčina'],['sl','🇸🇮 Slovenščina'],['es','🇪🇸 Español'],['sv','🇸🇪 Svenska']];
const ui={sk:{intro:'Profesionálny hlasový prekladač pre komunikáciu s klientmi v celej Európskej únii.',copy:'Kopírovať',eu:'24 jazykov EÚ',translatorMode:'🔄 PREKLADAČ',communicatorMode:'☎️ KOMUNIKÁTOR',modes:'Režim komunikácie',speak:'HOVORÍM',translateTo:'PRELOŽIŤ DO',start:'ZAČAŤ HOVORIŤ',stop:'ZASTAVIŤ',processing:'SPRACOVÁVAM…',ready:'Preklad je pripravený.',recording:'Nahrávam… hovorte prirodzene.',initial:'Stlačte tlačidlo a hovorte prirodzene. Preklad sa zobrazí po zastavení nahrávania.',tooLarge:'Nahrávka je príliš veľká. Skúste hovoriť kratšie.',mic:'ZAPNÚŤ MIKROFÓN',copyFail:'Kopírovanie sa nepodarilo.',copied:'Skopírované',translatorNote:'Preložte hovorenú vetu do zvoleného jazyka.',communicatorNote:'Nastavte jazyk, ktorým budete hovoriť, a jazyk prekladu. Potom vytvorte spojenie.',create:'VYTVORIŤ SPOJENIE',call:'USKUTOČNIŤ HOVOR',accept:'PRIJATIE HOVORU',share:'KOPÍROVAŤ POZVÁNKU',invite:'Naskenujte QR kód druhým zariadením. Potom stlačte USKUTOČNIŤ HOVOR.',waiting:'Čakám na druhé zariadenie…',incoming:'PRICHÁDZAJÚCI HOVOR – PRIJATIE HOVORU',calling:'VOLÁM…',active:'HOVOR JE AKTÍVNY',translation:'Preklad sa zobrazí tu…',transcript:'Váš hovorený text sa zobrazí tu…',privacy:'Hlas sa spracuje iba na účely prekladu. API kľúč zostáva na serveri.'},en:{intro:'Professional voice translator for communication with clients across the European Union.',copy:'Copy',eu:'24 EU languages',translatorMode:'🔄 TRANSLATOR',communicatorMode:'☎️ COMMUNICATOR',modes:'Communication mode',speak:'SPEAK',translateTo:'TRANSLATE TO',start:'START SPEAKING',stop:'STOP',processing:'PROCESSING…',ready:'Translation ready.',recording:'Recording… speak naturally.',initial:'Press the button and speak naturally. The translation appears after you stop recording.',tooLarge:'The recording is too large. Please speak for a shorter time.',mic:'TURN MICROPHONE ON',copyFail:'Copy failed.',copied:'Copied',translatorNote:'Translate a spoken sentence into the selected language.',communicatorNote:'Set the language you speak and the translation language, then create the connection.',create:'CREATE CONNECTION',call:'MAKE A CALL',accept:'ACCEPT CALL',share:'COPY INVITATION',invite:'Scan the QR code with the second device. Then press MAKE A CALL.',waiting:'Waiting for the second device…',incoming:'INCOMING CALL – ACCEPT CALL',calling:'CALLING…',active:'CALL IS ACTIVE',translation:'Translation appears here…',transcript:'Your spoken text will appear here…',privacy:'Audio is processed only for translation. The API key remains on the server.'},de:{intro:'Professioneller Sprachübersetzer für die Kommunikation mit Kunden in der gesamten Europäischen Union.',copy:'Kopieren',eu:'24 EU-Sprachen',translatorMode:'🔄 ÜBERSETZER',communicatorMode:'☎️ KOMMUNIKATOR',modes:'Kommunikationsmodus',speak:'SPRECHEN',translateTo:'ÜBERSETZEN IN',start:'SPRECHEN STARTEN',stop:'STOPPEN',processing:'VERARBEITUNG…',ready:'Übersetzung bereit.',recording:'Aufnahme läuft… sprechen Sie natürlich.',initial:'Drücken Sie die Taste und sprechen Sie natürlich. Die Übersetzung erscheint nach dem Stoppen.',tooLarge:'Die Aufnahme ist zu groß.',mic:'MIKROFON EINSCHALTEN',copyFail:'Kopieren fehlgeschlagen.',copied:'Kopiert',translatorNote:'Gesprochenen Satz in die gewählte Sprache übersetzen.',communicatorNote:'Sprech- und Übersetzungssprache einstellen und danach die Verbindung erstellen.',create:'VERBINDUNG ERSTELLEN',call:'ANRUF STARTEN',accept:'ANRUF ANNEHMEN',share:'EINLADUNG KOPIEREN',invite:'QR-Code mit dem zweiten Gerät scannen und danach ANRUF STARTEN drücken.',waiting:'Warte auf das zweite Gerät…',incoming:'EINGEHENDER ANRUF – ANRUF ANNEHMEN',calling:'ANRUF…',active:'ANRUF IST AKTIV',translation:'Übersetzung erscheint hier…',transcript:'Ihr gesprochener Text erscheint hier…',privacy:'Audio wird nur zur Übersetzung verarbeitet. Der API-Schlüssel bleibt auf dem Server.'}};
const t=ui[locale]||ui.en;
const $=s=>root.querySelector(s),source=$('[data-source]'),target=$('[data-target]'),swap=$('[data-swap]'),record=$('[data-record]'),recordLabel=$('[data-record-label]'),status=$('[data-status]'),transcript=$('[data-transcript]'),translation=$('[data-translation]'),sourceLabel=$('[data-source-label]'),targetLabel=$('[data-target-label]'),play=$('[data-play]'),copy=$('[data-copy]'),modeNote=$('[data-mode-note]'),modes=[...root.querySelectorAll('[data-mode]')],comm=$('[data-communicator]'),commStatus=$('[data-comm-status]'),create=$('[data-create]'),callBtn=$('[data-call]'),callLabel=$('[data-call-label]'),share=$('[data-share]'),invite=$('[data-invite]'),link=$('[data-link]'),copyLink=$('[data-copy-link]'),qr=$('[data-qr]'),mic=$('[data-mic]'),micLabel=$('[data-mic-label]'),audioBtn=$('[data-audio]'),remoteAudio=$('[data-remote-audio]');
const labels=Object.fromEntries(languages);
root.querySelectorAll('[data-i18n]').forEach(el=>{const k=el.dataset.i18n;if(t[k]!==undefined)el.textContent=t[k]});root.querySelector('[data-i18n-aria]')?.setAttribute('aria-label',t.modes);recordLabel.textContent=t.start;status.textContent=t.initial;modeNote.textContent=t.translatorNote;transcript.textContent=t.transcript;translation.textContent=t.translation;micLabel.textContent=t.mic;
for(const [code,name] of languages){source.add(new Option(name,code));target.add(new Option(name,code));}
source.value=locale==='sk'?'sk':locale;target.value=locale==='sk'?'de':locale==='de'?'sk':'en';
const sync=()=>{sourceLabel.textContent=(labels[source.value]||source.value).replace(/^\S+\s/,'');targetLabel.textContent=(labels[target.value]||target.value).replace(/^\S+\s/,'');localStorage.setItem('foxLangSource',source.value);localStorage.setItem('foxLangTarget',target.value)};sync();
let recorder=null,chunks=[],audioUrl=null,currentAudio=null,currentSpeed=1,currentMode='translator';
const mime=()=>['audio/mp4','audio/webm;codecs=opus','audio/webm'].find(x=>window.MediaRecorder?.isTypeSupported(x))||'';const setBusy=v=>record.disabled=v;
swap.onclick=()=>{const x=source.value;source.value=target.value;target.value=x;sync()};
root.querySelectorAll('[data-speed]').forEach(btn=>btn.onclick=()=>{currentSpeed=Number(btn.dataset.speed);root.querySelectorAll('[data-speed]').forEach(b=>b.classList.toggle('is-active',b===btn));if(currentAudio)currentAudio.playbackRate=currentSpeed});
copy.onclick=async()=>{const text=translation.textContent?.trim();if(!text||text===t.translation)return;try{await navigator.clipboard.writeText(text);copy.innerHTML='✓ <span>'+t.copied+'</span>';setTimeout(()=>{copy.innerHTML='⧉ <span>'+t.copy+'</span>'},1400)}catch{status.textContent='❌ '+t.copyFail}};
record.onclick=async()=>{if(currentMode!=='translator')return;if(recorder?.state==='recording'){recorder.stop();return}try{const stream=await navigator.mediaDevices.getUserMedia({audio:true});chunks=[];const mt=mime();recorder=new MediaRecorder(stream,mt?{mimeType:mt}:undefined);record.classList.add('recording');recordLabel.textContent=t.stop;status.textContent=t.recording;recorder.ondataavailable=e=>{if(e.data.size)chunks.push(e.data)};recorder.onstop=async()=>{stream.getTracks().forEach(x=>x.stop());record.classList.remove('recording');recordLabel.textContent=t.processing;setBusy(true);const blob=new Blob(chunks,{type:recorder.mimeType||'audio/mp4'});if(blob.size>4*1024*1024){status.textContent='❌ '+t.tooLarge;setBusy(false);recordLabel.textContent=t.start;return}const fd=new FormData();fd.append('audio',blob,'speech.m4a');fd.append('sourceLanguage',source.value);fd.append('targetLanguage',target.value);fd.append('speakResult','true');try{const res=await fetch('https://wdfox.vercel.app/api/translate-voice',{method:'POST',body:fd});const data=await res.json();if(!res.ok)throw Error(data.error||'Translation failed');transcript.textContent=data.transcript;translation.textContent=data.translatedText;copy.disabled=false;status.textContent=t.ready;if(audioUrl)URL.revokeObjectURL(audioUrl);if(currentAudio){currentAudio.pause();currentAudio=null}if(data.audioBase64){const bytes=Uint8Array.from(atob(data.audioBase64),c=>c.charCodeAt(0));audioUrl=URL.createObjectURL(new Blob([bytes],{type:data.audioMimeType||'audio/wav'}));play.disabled=false;play.onclick=()=>{if(currentAudio)currentAudio.pause();currentAudio=new Audio(audioUrl);currentAudio.playbackRate=currentSpeed;currentAudio.play()}}}else play.disabled=true}catch(e){status.textContent='❌ '+(e?.message||'Translation failed')}finally{setBusy(false);recordLabel.textContent=t.start}};recorder.start()}catch{status.textContent='❌ '+t.mic;record.classList.remove('recording');setBusy(false);recordLabel.textContent=t.start}};

let peer=null,ready=false,params=new URLSearchParams(location.search),remoteId=params.get('foxPeer'),dataConn=null,pendingCall=null,mediaStream=null,recognition=null,recognizing=false,interactionId=null,ringTimer=null,audioCtx=null;
const loadScript=(src,test)=>new Promise((resolve,reject)=>{if(test())return resolve();const s=document.createElement('script');s.src=src;s.onload=resolve;s.onerror=reject;document.head.appendChild(s)});const loadPeer=()=>loadScript('https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js',()=>!!window.Peer);const setComm=s=>{commStatus.textContent=s};
const prime=()=>{try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)({latencyHint:'interactive'});if(audioCtx.state==='suspended')audioCtx.resume().catch(()=>{})}catch{}};const ringStop=()=>{if(ringTimer){clearInterval(ringTimer);ringTimer=null}};const ringStart=()=>{ringStop();prime();const beep=()=>{if(!audioCtx)return;const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.frequency.value=880;g.gain.value=.12;o.connect(g);g.connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+.28)};beep();ringTimer=setInterval(beep,1200)};
const loadQr=()=>loadScript('https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js',()=>!!window.QRCode);const renderQr=async()=>{await loadQr();qr.innerHTML='';new QRCode(qr,{text:link.value,width:210,height:210})};const getName=code=>(labels[code]||code).replace(/^\S+\s/,'');
const sendData=m=>{if(dataConn?.open){try{dataConn.send(m)}catch{}}};const speak=(text,lang)=>{if(!speechSynthesis)return;speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang=lang==='sk'?'sk-SK':lang==='de'?'de-DE':lang==='en'?'en-US':lang+'-'+lang.toUpperCase();u.rate=currentSpeed;speechSynthesis.speak(u)};
const translateLive=async text=>{const prompt=`You are the live interpreter in FOX LIVE COMMUNICATOR. Translate ONLY the spoken sentence from ${getName(source.value)} to ${getName(target.value)}. Return only the translation, no explanation, no quotation marks. Sentence: ${text}`;try{const r=await fetch('/api/gemini-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:prompt,previousInteractionId:interactionId,systemInstruction:'You are a low-latency professional interpreter. Translate faithfully, preserve tone, names and meaning. Never add commentary.'})});const d=await r.json();if(!r.ok)throw Error(d.error||'Gemini translation failed');interactionId=d.previousInteractionId||d.interactionId||interactionId;const out=String(d.text||'').trim();if(out){translation.textContent=out;sendData({type:'translation',sourceText:text,translatedText:out,source:source.value,target:target.value});speak(out,target.value)}}catch(e){translation.textContent='❌ '+(e?.message||'Gemini translation failed')}};
const startRecognition=()=>{if(recognizing)return;const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){setComm('SpeechRecognition nie je v tomto prehliadači podporovaný.');return}recognition=new SR();recognition.lang=source.value==='sk'?'sk-SK':source.value==='de'?'de-DE':source.value==='en'?'en-US':source.value+'-'+source.value.toUpperCase();recognition.continuous=true;recognition.interimResults=true;recognition.onstart=()=>recognizing=true;recognition.onresult=e=>{let interim='';for(let i=e.resultIndex;i<e.results.length;i++){const text=e.results[i][0].transcript.trim();if(e.results[i].isFinal){transcript.textContent=text;translateLive(text)}else interim+=text}if(interim)transcript.textContent=interim};recognition.onend=()=>{recognizing=false;if(currentMode==='communicator'&&mediaStream)setTimeout(startRecognition,250)};try{recognition.start()}catch{}};
const localStream=async()=>{if(mediaStream)return mediaStream;mediaStream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});mediaStream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;return mediaStream};const playRemote=s=>{remoteAudio.srcObject=s;remoteAudio.muted=true;remoteAudio.play().catch(()=>{})};
const activateCall=mc=>{mc.on('stream',playRemote);mc.on('close',()=>{setComm(t.waiting);mic.disabled=true;ringStop()});mc.on('error',e=>setComm('Hovor: '+(e?.message||'chyba')));comm.classList.remove('hidden');root.classList.add('is-call-mode');setComm(t.active);startRecognition()};
const wireData=c=>{dataConn=c;c.on('data',m=>{if(m?.type==='call-request'&&currentMode==='communicator'&&!pendingCall){prime();ringStart();callBtn.disabled=false;callLabel.textContent=t.accept;setComm(t.incoming)}if(m?.type==='call-cancel'){ringStop();setComm(t.waiting)}if(m?.type==='translation'&&m.translatedText){translation.textContent=m.translatedText;speak(m.translatedText,m.target||target.value)}})};
const openPeer=async()=>{await loadPeer();if(ready)return;peer=new Peer(undefined,{config:{iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun:stun.cloudflare.com:3478'}]}});peer.on('connection',wireData);peer.on('call',mc=>{pendingCall=mc;prime();ringStart();callBtn.disabled=false;callLabel.textContent=t.accept;setComm(t.incoming)});peer.on('error',e=>setComm('PeerJS: '+(e?.type||e?.message||'chyba')));await new Promise((resolve,reject)=>{const tm=setTimeout(()=>reject(Error('PeerJS timeout')),20000);peer.once('open',()=>{clearTimeout(tm);ready=true;resolve()})})};
const createRoom=async()=>{prime();create.disabled=true;setComm('Vytváram spojenie…');try{await openPeer();const id=peer.id;link.value=location.origin+location.pathname+'?foxPeer='+encodeURIComponent(id)+'&foxSource='+encodeURIComponent(source.value)+'&foxTarget='+encodeURIComponent(target.value);invite.classList.remove('hidden');share.disabled=false;copyLink.disabled=false;await renderQr();setComm(t.waiting)}catch(e){create.disabled=false;setComm(e?.message||'Spojenie sa nepodarilo')}};
const requestCall=async()=>{if(!remoteId||!ready){setComm(t.waiting);return}try{prime();callBtn.disabled=true;callLabel.textContent=t.call;await localStream();const c=peer.connect(remoteId,{reliable:true,label:'fox-call-control'});wireData(c);const send=()=>sendData({type:'call-request',at:Date.now(),source:source.value,target:target.value});if(c.open)send();else c.on('open',send);const mc=peer.call(remoteId,mediaStream);activateCall(mc);setComm(t.calling)}catch(e){callBtn.disabled=false;callLabel.textContent=t.call;setComm(e?.message||'Hovor sa nepodaril')}};
const acceptCall=async()=>{if(!pendingCall)return;try{prime();ringStop();callBtn.disabled=true;await localStream();const mc=pendingCall;pendingCall=null;mc.answer(mediaStream);activateCall(mc);setComm(t.active)}catch(e){callBtn.disabled=false;callLabel.textContent=t.accept;setComm(e?.message||'Hovor sa nepodaril')}};
callBtn.onclick=()=>{if(remoteId)requestCall();else acceptCall()};create.onclick=createRoom;copyLink.onclick=async()=>{try{await navigator.clipboard.writeText(link.value);setComm(t.share)}catch{link.select();document.execCommand('copy')}};share.onclick=async()=>{try{await navigator.clipboard.writeText(link.value);setComm(t.share)}catch{link.select();document.execCommand('copy')}};audioBtn.onclick=()=>{prime();speechSynthesis?.resume?.();setComm(t.active)};mic.onclick=()=>{if(mediaStream){const tr=mediaStream.getAudioTracks()[0];tr.enabled=!tr.enabled;micLabel.textContent=tr.enabled?t.mic:'ZAPNÚŤ MIKROFÓN'}};
source.onchange=()=>{sync();interactionId=null};target.onchange=()=>{sync();interactionId=null};modes.forEach(btn=>btn.onclick=()=>{currentMode=btn.dataset.mode;modes.forEach(b=>{const a=b===btn;b.classList.toggle('is-active',a);b.setAttribute('aria-selected',String(a))});root.classList.toggle('is-call-mode',currentMode==='communicator');comm.classList.toggle('hidden',currentMode!=='communicator');modeNote.textContent=currentMode==='communicator'?t.communicatorNote:t.translatorNote;if(currentMode==='communicator'){prime();setComm(remoteId?'Pripravené na hovor.':'Najprv vytvorte spojenie.')}else{ringStop()}});
if(remoteId){const invitedSource=params.get('foxSource'),invitedTarget=params.get('foxTarget');if(invitedSource&&invitedTarget){source.value=invitedTarget;target.value=invitedSource;sync()}currentMode='communicator';modes.forEach(b=>{const a=b.dataset.mode==='communicator';b.classList.toggle('is-active',a);b.setAttribute('aria-selected',String(a))});root.classList.add('is-call-mode');comm.classList.remove('hidden');modeNote.textContent=t.communicatorNote;callBtn.disabled=false;callLabel.textContent=t.call;setComm(t.waiting);openPeer().catch(e=>setComm(e?.message||'PeerJS chyba'))}else{openPeer().catch(()=>{})}
}
</script>
