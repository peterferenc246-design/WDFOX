---
interface Props { locale: string }
const { locale } = Astro.props;
---
<section class="fox-translator section-wrap" id="translator" data-fox-live>
  <div class="translator-shell">
    <div class="translator-head">
      <div>
        <p class="eyebrow"><span></span> FOX TECHNOLOGY LAB</p>
        <h2>FOX <strong>LIVE TRANSLATOR</strong></h2>
        <p class="translator-intro" data-i18n="intro"></p>
      </div>
      <div class="translator-tools"><div class="eu-badge">🇪🇺 <span data-i18n="eu"></span></div></div>
    </div>

    <div class="mode-switch" role="tablist">
      <button type="button" class="mode is-active" data-mode="translator" role="tab" aria-selected="true" data-i18n="translatorMode"></button>
      <button type="button" class="mode" data-mode="communicator" role="tab" aria-selected="false" data-i18n="communicatorMode"></button>
    </div>
    <p class="mode-note" data-mode-note></p>

    <div class="language-bar">
      <label><span data-i18n="speak"></span><select data-source></select></label>
      <button class="swap" type="button" data-swap>⇄</button>
      <label><span data-i18n="translateTo"></span><select data-target></select></label>
    </div>

    <div class="translator-main">
      <button class="record" type="button" data-record>🎤 <span data-record-label></span></button>
      <p class="hint" data-status></p>
    </div>

    <div class="communicator-panel hidden" data-communicator>
      <div class="comm-status" data-comm-status></div>
      <div class="comm-actions">
        <button class="record" type="button" data-create>🔗 <span data-i18n="create"></span></button>
        <button class="call" type="button" data-call disabled>📞 <span data-call-label data-i18n="call"></span></button>
        <button class="secondary" type="button" data-share disabled>⧉ <span data-i18n="share"></span></button>
      </div>
      <div class="invite hidden" data-invite>
        <div class="invite-link"><input data-link readonly /><button class="secondary" type="button" data-copy-link>⧉</button></div>
        <div class="qr-wrap"><div data-qr></div><small data-i18n="invite"></small></div>
      </div>
      <div class="comm-controls">
        <button class="secondary" type="button" data-mic disabled>🎙 <span data-mic-label data-i18n="mic"></span></button>
        <button class="secondary" type="button" data-audio>🔊 AUDIO</button>
        <button class="screen-btn" type="button" data-screen disabled>🖥 <span data-screen-label></span></button>
        <button class="secondary hidden" type="button" data-screen-stop>⛔ <span data-i18n="stopScreen"></span></button>
      </div>
      <div class="screen-grid">
        <div class="screen-card"><header><span data-i18n="myScreen"></span><span data-local-screen-status></span></header><video data-local-screen autoplay playsinline muted></video></div>
        <div class="screen-card"><header><span data-i18n="remoteScreen"></span><span data-remote-screen-status></span></header><video data-remote-screen autoplay playsinline></video></div>
      </div>
    </div>

    <div class="translation-grid">
      <article class="speech-card"><header><span data-source-label></span><span>●</span></header><p data-transcript></p></article>
      <article class="speech-card result">
        <header><span data-target-label></span><div><button type="button" class="play" data-play disabled>🔊</button><span class="speed-controls"><button data-speed="0.75">0.75×</button><button class="is-active" data-speed="1">1×</button><button data-speed="1.25">1.25×</button><button data-speed="1.5">1.5×</button></span></div></header>
        <p data-translation></p>
      </article>
    </div>

    <p class="translator-note">🔒 <span data-i18n="privacy"></span></p>
    <audio data-remote-audio autoplay playsinline></audio>
  </div>
</section>

<style>
.fox-translator{padding:42px 0}.translator-shell{position:relative;overflow:hidden;border:1px solid #ececec;border-radius:28px;background:linear-gradient(135deg,#fff 0%,#fffaf6 100%);box-shadow:0 22px 60px rgba(20,24,35,.08);padding:34px}.translator-shell:before{content:"";position:absolute;inset:0 0 auto;height:5px;background:#f36a0a}.translator-head{display:flex;justify-content:space-between;gap:24px}.translator-head h2{margin:5px 0 8px;font-size:clamp(28px,4vw,44px);line-height:1;letter-spacing:-.04em;color:#121a2a}.translator-head h2 strong{color:#f36a0a}.translator-intro{max-width:680px;margin:0;color:#667085;font-size:15px;line-height:1.65}.eu-badge,.secondary{border:1px solid #eee;border-radius:999px;background:#fff;color:#172033;padding:10px 14px;font-size:12px;font-weight:800;box-shadow:0 7px 20px rgba(0,0,0,.05)}.mode-switch{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:26px;padding:5px;border:1px solid #eee;border-radius:15px;background:#f7f7f7;max-width:560px}.mode{border:0;border-radius:11px;background:transparent;padding:12px 16px;color:#667085;font-size:12px;font-weight:900;cursor:pointer}.mode.is-active{background:#fff;color:#f36a0a;box-shadow:0 5px 15px rgba(0,0,0,.07)}.mode-note{margin:9px 0;color:#8a93a3;font-size:12px}.language-bar{display:grid;grid-template-columns:1fr 58px 1fr;align-items:end;gap:14px;margin:22px 0 18px}.language-bar label{display:flex;flex-direction:column;gap:7px;color:#777;font-size:11px;font-weight:800;text-transform:uppercase}.language-bar select{width:100%;border:1px solid #ddd;border-radius:14px;background:#fff;padding:14px;color:#172033;font-size:15px;font-weight:700}.swap{height:48px;border:1px solid #eee;border-radius:14px;background:#fff;color:#f36a0a;font-size:25px;font-weight:800;cursor:pointer}.translator-main{text-align:center;padding:8px 0 22px}.record,.call,.screen-btn{display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;border-radius:999px;background:#f36a0a;color:#fff;padding:15px 24px;font-size:13px;font-weight:900;cursor:pointer;box-shadow:0 12px 28px rgba(243,106,10,.28)}.record.recording{background:#171b25}.call{background:#18a957}.screen-btn{background:#4257d6}.call:disabled,.secondary:disabled,.record:disabled,.screen-btn:disabled{opacity:.42;cursor:default}.hint{margin:11px auto 0;color:#8a93a3;font-size:12px}.translation-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.speech-card{min-height:155px;border:1px solid #e9e9e9;border-radius:19px;background:#fff;padding:17px 19px}.speech-card.result{border-color:#f6d8c3;background:#fffdfa}.speech-card header{display:flex;justify-content:space-between;align-items:center;color:#f36a0a;font-size:12px;font-weight:900;text-transform:uppercase}.speech-card p{margin:24px 0 0;color:#202938;font-size:17px;line-height:1.55;white-space:pre-wrap}.play{border:0;background:transparent;font-size:18px;cursor:pointer}.speed-controls{display:inline-flex;gap:2px;margin-left:5px;border:1px solid #eee;border-radius:999px;padding:2px;background:#fff}.speed-controls button{border:0;border-radius:999px;background:transparent;padding:4px 6px;font-size:10px;cursor:pointer}.speed-controls button.is-active{background:#f36a0a;color:#fff}.hidden{display:none!important}.communicator-panel{margin:8px 0 22px;padding:18px;border:1px solid #f6d8c3;border-radius:20px;background:#fffdfa}.comm-status{padding:12px;border-radius:12px;background:#f7f7f7;color:#667085;font-size:12px;min-height:18px}.comm-actions,.comm-controls{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px}.comm-actions button,.comm-controls button{min-height:42px}.invite{margin-top:14px}.invite-link{display:grid;grid-template-columns:1fr auto;gap:8px}.invite-link input{width:100%;box-sizing:border-box;border:1px solid #ddd;border-radius:11px;padding:12px}.qr-wrap{margin-top:12px;border:1px solid #eee;border-radius:16px;background:#fff;padding:12px;text-align:center;width:max-content;max-width:100%}.qr-wrap [data-qr]{width:210px;min-height:210px;display:grid;place-items:center}.qr-wrap img,.qr-wrap canvas{max-width:210px;height:auto!important}.screen-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}.screen-card{border:1px solid #e8e8e8;border-radius:16px;background:#fff;padding:10px}.screen-card header{display:flex;justify-content:space-between;color:#667085;font-size:11px;font-weight:900;text-transform:uppercase;margin-bottom:8px}.screen-card video{display:block;width:100%;min-height:180px;max-height:420px;object-fit:contain;background:#111;border-radius:10px}.translator-shell audio{display:none}.is-call-mode .translator-main{display:none}.is-call-mode .mode-note{color:#f36a0a;font-weight:700}.incoming-overlay{position:fixed;inset:0;z-index:99990;display:grid;place-items:center;padding:20px;background:rgba(10,14,24,.58);backdrop-filter:blur(4px)}.incoming-card{width:min(440px,100%);background:#fff;border-radius:20px;padding:24px;box-shadow:0 24px 80px rgba(0,0,0,.3);text-align:center}.incoming-title{font-size:13px;font-weight:900;color:#f36a0a;letter-spacing:.08em}.incoming-card p{color:#172033;font-size:18px;font-weight:800;line-height:1.45}.incoming-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}.incoming-actions button{border:0;border-radius:12px;padding:14px;font-weight:900;cursor:pointer}.incoming-actions .deny{background:#eef0f3;color:#172033}.incoming-actions .allow{background:#18a957;color:#fff}@media(max-width:650px){.translator-shell{padding:22px;border-radius:22px}.translator-head{display:block}.language-bar{grid-template-columns:1fr 46px 1fr;gap:8px}.translation-grid,.screen-grid{grid-template-columns:1fr}.comm-actions,.comm-controls{display:grid;grid-template-columns:1fr}.comm-actions button,.comm-controls button,.call,.record,.screen-btn{width:100%}.qr-wrap{width:100%;box-sizing:border-box}}
</style>

<script define:vars={{ locale }}>
const root=document.querySelector('[data-fox-live]');
if(root){
  const languages=[['bg','🇧🇬 Български'],['hr','🇭🇷 Hrvatski'],['cs','🇨🇿 Čeština'],['da','🇩🇰 Dansk'],['nl','🇳🇱 Nederlands'],['en','🇬🇧 English'],['et','🇪🇪 Eesti'],['fi','🇫🇮 Suomi'],['fr','🇫🇷 Français'],['de','🇩🇪 Deutsch'],['el','🇬🇷 Ελληνικά'],['hu','🇭🇺 Magyar'],['ga','🇮🇪 Gaeilge'],['it','🇮🇹 Italiano'],['lv','🇱🇻 Latviešu'],['lt','🇱🇹 Lietuvių'],['mt','🇲🇹 Malti'],['pl','🇵🇱 Polski'],['pt','🇵🇹 Português'],['ro','🇷🇴 Română'],['sk','🇸🇰 Slovenčina'],['sl','🇸🇮 Slovenščina'],['es','🇪🇸 Español'],['sv','🇸🇪 Svenska']];
  const labels=Object.fromEntries(languages);
  const ui={
    sk:{intro:'Profesionálny hlasový prekladač a komunikátor pre klientov v celej EÚ.',eu:'24 jazykov EÚ',translatorMode:'🔄 PREKLADAČ',communicatorMode:'☎️ KOMUNIKÁTOR',speak:'HOVORÍM',translateTo:'PRELOŽIŤ DO',start:'ZAČAŤ HOVORIŤ',stop:'ZASTAVIŤ',ready:'Preklad je pripravený.',initial:'Stlačte tlačidlo a hovorte.',recording:'HOVORÍTE…',processing:'SPRACOVÁVAM…',create:'VYTVORIŤ SPOJENIE',call:'USKUTOČNIŤ HOVOR',accept:'PRIJATIE HOVORU',share:'KOPÍROVAŤ POZVÁNKU',invite:'Naskenujte QR na druhom zariadení a stlačte USKUTOČNIŤ HOVOR.',waiting:'Čakám na druhé zariadenie…',incoming:'🔔 PRICHÁDZAJÚCI HOVOR',calling:'VOLÁM…',active:'HOVOR JE AKTÍVNY',mic:'ZAPNÚŤ MIKROFÓN',screen:'POŽIADAŤ O OBRAZOVKU PARTNERA',stopScreen:'ZASTAVIŤ ZDIEĽANIE',myScreen:'MOJA OBRAZOVKA',remoteScreen:'OBRAZOVKA PARTNERA',privacy:'Preklad prebieha cez zabezpečený server. API kľúč zostáva na serveri.'},
    en:{intro:'Professional voice translator and communicator for clients across the EU.',eu:'24 EU languages',translatorMode:'🔄 TRANSLATOR',communicatorMode:'☎️ COMMUNICATOR',speak:'SPEAK',translateTo:'TRANSLATE TO',start:'START SPEAKING',stop:'STOP',ready:'Translation ready.',initial:'Press the button and speak.',recording:'SPEAKING…',processing:'PROCESSING…',create:'CREATE CONNECTION',call:'MAKE A CALL',accept:'ACCEPT CALL',share:'COPY INVITATION',invite:'Scan the QR on the second device and press MAKE A CALL.',waiting:'Waiting for the second device…',incoming:'🔔 INCOMING CALL',calling:'CALLING…',active:'CALL IS ACTIVE',mic:'TURN MICROPHONE ON',screen:'REQUEST PARTNER SCREEN',stopScreen:'STOP SHARING',myScreen:'MY SCREEN',remoteScreen:'PARTNER SCREEN',privacy:'Translation runs through the secure server. The API key stays on the server.'},
    de:{intro:'Professioneller Sprachübersetzer und Kommunikator für Kunden in der EU.',eu:'24 EU-Sprachen',translatorMode:'🔄 ÜBERSETZER',communicatorMode:'☎️ KOMMUNIKATOR',speak:'SPRECHEN',translateTo:'ÜBERSETZEN IN',start:'SPRECHEN STARTEN',stop:'STOPP',ready:'Übersetzung bereit.',initial:'Taste drücken und sprechen.',recording:'SIE SPRECHEN…',processing:'VERARBEITUNG…',create:'VERBINDUNG ERSTELLEN',call:'ANRUF STARTEN',accept:'ANRUF ANNEHMEN',share:'EINLADUNG KOPIEREN',invite:'QR am zweiten Gerät scannen und ANRUF STARTEN drücken.',waiting:'Warte auf das zweite Gerät…',incoming:'🔔 EINGEHENDER ANRUF',calling:'ANRUF…',active:'ANRUF IST AKTIV',mic:'MIKROFON EINSCHALTEN',screen:'BILDSCHIRM DES PARTNERS ANFORDERN',stopScreen:'TEILEN BEENDEN',myScreen:'MEIN BILDSCHIRM',remoteScreen:'BILDSCHIRM DES PARTNERS',privacy:'Die Übersetzung läuft über den sicheren Server. Der API-Schlüssel bleibt auf dem Server.'}
  };
  const t=ui[locale]||ui.en;
  const $=s=>root.querySelector(s);
  const source=$('[data-source]'),target=$('[data-target]'),swap=$('[data-swap]'),record=$('[data-record]'),recordLabel=$('[data-record-label]'),status=$('[data-status]'),transcript=$('[data-transcript]'),translation=$('[data-translation]'),sourceLabel=$('[data-source-label]'),targetLabel=$('[data-target-label]'),play=$('[data-play]'),modeNote=$('[data-mode-note]'),comm=$('[data-communicator]'),commStatus=$('[data-comm-status]'),create=$('[data-create]'),callBtn=$('[data-call]'),callLabel=$('[data-call-label]'),share=$('[data-share]'),invite=$('[data-invite]'),link=$('[data-link]'),copyLink=$('[data-copy-link]'),qr=$('[data-qr]'),mic=$('[data-mic]'),micLabel=$('[data-mic-label]'),audioBtn=$('[data-audio]'),remoteAudio=$('[data-remote-audio]'),screenBtn=$('[data-screen]'),screenLabel=$('[data-screen-label]'),screenStop=$('[data-screen-stop]'),localScreen=$('[data-local-screen]'),remoteScreen=$('[data-remote-screen]'),localScreenStatus=$('[data-local-screen-status]'),remoteScreenStatus=$('[data-remote-screen-status]');
  const modes=[...root.querySelectorAll('[data-mode]')];
  root.querySelectorAll('[data-i18n]').forEach(el=>{const k=el.dataset.i18n;if(t[k]!==undefined)el.textContent=t[k]});
  recordLabel.textContent=t.start;status.textContent=t.initial;modeNote.textContent=t.translatorMode? (locale==='de'? 'Sprachübersetzung und Live-Kommunikation.':'Hlasový preklad a živá komunikácia.') : '';micLabel.textContent=t.mic;screenLabel.textContent=t.screen;
  for(const [code,name] of languages){source.add(new Option(name,code));target.add(new Option(name,code))}
  source.value=languages.some(x=>x[0]===locale)?locale:'en';target.value=source.value==='sk'?'en':'sk';
  const localeMap={bg:'bg-BG',hr:'hr-HR',cs:'cs-CZ',da:'da-DK',nl:'nl-NL',en:'en-US',et:'et-EE',fi:'fi-FI',fr:'fr-FR',de:'de-DE',el:'el-GR',hu:'hu-HU',ga:'ga-IE',it:'it-IT',lv:'lv-LV',lt:'lt-LT',mt:'mt-MT',pl:'pl-PL',pt:'pt-PT',ro:'ro-RO',sk:'sk-SK',sl:'sl-SI',es:'es-ES',sv:'sv-SE'};
  const getLocale=c=>localeMap[c]||c;
  let currentMode='translator',recognition=null,recognizing=false,peer=null,peerReady=false,remoteId=new URLSearchParams(location.search).get('foxPeer'),dataConn=null,mediaConn=null,pendingCall=null,localStream=null,screenStream=null,screenCall=null,ringTimer=null,audioCtx=null,ringing=false,interactionId=null,speechRate=1,stopping=false;
  const loadScript=(src,test)=>new Promise((resolve,reject)=>{if(test())return resolve();const s=document.createElement('script');s.src=src;s.onload=resolve;s.onerror=reject;document.head.appendChild(s)});
  const loadPeer=()=>loadScript('https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js',()=>!!window.Peer);
  const loadQr=()=>loadScript('https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js',()=>!!window.QRCode);
  const setComm=v=>{commStatus.textContent=v};
  const primeAudio=()=>{try{audioCtx??=new (window.AudioContext||window.webkitAudioContext)();audioCtx.resume()}catch{}};
  const startRing=()=>{if(ringing)return;ringing=true;primeAudio();let on=true;ringTimer=setInterval(()=>{document.title=on?'📞 FOX LIVE':'FOX LIVE';on=!on;try{navigator.vibrate?.([220,120,220])}catch{}try{const o=audioCtx?.createOscillator(),g=audioCtx?.createGain();if(o&&g){o.frequency.value=880;g.gain.value=.035;o.connect(g).connect(audioCtx.destination);o.start();o.stop(audioCtx.currentTime+.18)}}catch{}},900)};
  const stopRing=()=>{ringing=false;if(ringTimer)clearInterval(ringTimer);ringTimer=null;document.title='FOX LIVE TRANSLATOR'};
  const send=m=>{if(dataConn?.open)try{dataConn.send(m)}catch{}};
  const speakText=(text)=>{if(!text||!window.speechSynthesis)return;window.speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang=getLocale(target.value);u.rate=speechRate;const voices=window.speechSynthesis.getVoices?.()||[];const exact=voices.find(v=>v.lang?.toLowerCase()===u.lang.toLowerCase());const base=u.lang.split('-')[0].toLowerCase();const voice=exact||voices.find(v=>v.lang?.toLowerCase().startsWith(base+'-'))||voices.find(v=>v.lang?.toLowerCase()===base);if(voice)u.voice=voice;window.speechSynthesis.speak(u)};
  const translateRequest=async(text,src,dst,previous)=>{const prompt=`Translate only this spoken sentence from ${labels[src]||src} to ${labels[dst]||dst}. Return only a natural, grammatically correct standard/formal translation in the target language. Translate meaning, not word-for-word. Preserve names, numbers, dates, negation, tense, politeness and tone. Do not mix source-language words into the target language. Do not add or remove meaning. Sentence: ${String(text).trim()}`;const r=await fetch('/api/gemini-chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:prompt,previousInteractionId:previous||null,systemInstruction:'You are a professional real-time interpreter. Output only the target-language translation. Use standard, grammatically correct language.',thinkingLevel:'low'})});const j=await r.json().catch(()=>({}));if(!r.ok)throw Error(j?.error||`Gemini HTTP ${r.status}`);const out=String(j?.text||j?.translation||'').trim();if(!out)throw Error('Gemini returned an empty translation');return {text:out,id:j?.interactionId||previous||null};};
  const translateIncoming=async m=>{try{const result=await translateRequest(m.text,m.source,m.target,interactionId);interactionId=result.id;transcript.textContent=m.text;translation.textContent=result.text;play.disabled=false;speakText(result.text);send({type:'translation',id:m.id,text:result.text,source:m.source,target:m.target})}catch(e){setComm('❌ PREKLAD: '+(e?.message||'Preklad sa nepodaril.'))}};
  const attachMedia=mc=>{mediaConn=mc;mc.on('stream',s=>{remoteAudio.srcObject=s;remoteAudio.muted=true;remoteAudio.volume=0;remoteAudio.play().catch(()=>{})});mc.on('close',()=>{stopRecognition();setComm(t.waiting)});mc.on('error',e=>setComm('❌ Hovor: '+(e?.message||'chyba')))};
  const clearRemoteScreen=()=>{remoteScreen.srcObject=null;remoteScreenStatus.textContent=''};
  const stopScreenShare=()=>{try{screenCall?.close()}catch{};screenCall=null;if(screenStream){screenStream.getTracks().forEach(x=>x.stop());screenStream=null}localScreen.srcObject=null;localScreenStatus.textContent='';screenBtn.classList.remove('hidden');screenStop.classList.add('hidden');screenBtn.disabled=!peerReady||!remoteId};
  const attachScreenCall=mc=>{mc.on('stream',s=>{remoteScreen.srcObject=s;remoteScreen.style.display='block';remoteScreenStatus.textContent='● LIVE';remoteScreen.play().catch(()=>{});setComm('🖥 '+(locale==='de'?'Bildschirm des Partners ist live.':'Obrazovka partnera je LIVE.'))});mc.on('close',clearRemoteScreen);mc.on('error',e=>{remoteScreenStatus.textContent='CHYBA';setComm('❌ WebRTC obrazovky: '+(e?.message||'chyba'))})};
  const requestPartnerScreen=()=>{if(!peerReady||!remoteId){setComm('❌ '+(locale==='de'?'Zuerst eine aktive Verbindung herstellen.':'Najprv vytvorte aktívne spojenie.'));return}const requestId=`${Date.now()}-${Math.random().toString(36).slice(2)}`;send({type:'screen-request',requestId});setComm(locale==='de'?'Bildschirmfreigabe angefragt. Warte auf Zustimmung…':'Požiadavka odoslaná. Čakám na povolenie partnera…')};
  const showConsent=async(requestId,from)=>{const old=root.querySelector('[data-consent]');old?.remove();const box=document.createElement('div');box.dataset.consent='1';box.className='incoming-overlay';box.innerHTML=`<div class="incoming-card" role="dialog" aria-modal="true"><div class="incoming-title">🖥️ FOX SCREEN</div><p>${locale==='de'?'Der Partner möchte Ihren Bildschirm sehen.':'Partner chce vidieť vašu obrazovku.'}</p><div class="incoming-actions"><button class="deny" type="button">${locale==='de'?'ABLEHNEN':'ZAMIETNUŤ'}</button><button class="allow" type="button">${locale==='de'?'ERLAUBEN':'POVOLIŤ'}</button></div></div>`;document.body.appendChild(box);const [deny,allow]=box.querySelectorAll('button');deny.onclick=()=>{send({type:'screen-response',requestId,approved:false});box.remove()};allow.onclick=async()=>{box.remove();try{if(!navigator.mediaDevices?.getDisplayMedia)throw Error('getDisplayMedia');const stream=await navigator.mediaDevices.getDisplayMedia({video:{frameRate:{ideal:15,max:30}},audio:false});screenStream=stream;localScreen.srcObject=stream;localScreenStatus.textContent='● LIVE';screenBtn.classList.add('hidden');screenStop.classList.remove('hidden');const c=peer.call(from,stream,{metadata:{foxScreen:true,requestId,consent:true}});screenCall=c;c.on('close',stopScreenShare);c.on('error',stopScreenShare);send({type:'screen-response',requestId,approved:true});stream.getVideoTracks()[0]?.addEventListener('ended',stopScreenShare,{once:true})}catch(e){send({type:'screen-response',requestId,approved:false,error:e?.name||'error'});setComm(locale==='de'?'Bildschirmfreigabe wurde nicht gestartet.':'Zdieľanie obrazovky sa nepodarilo spustiť.')}}};
  const wireData=c=>{dataConn=c;remoteId=c.peer;screenBtn.disabled=false;c.on('open',()=>{setComm(t.active);screenBtn.disabled=false});c.on('close',()=>{setComm(t.waiting);screenBtn.disabled=true;stopScreenShare();clearRemoteScreen()});c.on('error',e=>setComm('❌ Data: '+(e?.message||'chyba')));c.on('data',m=>{if(!m||typeof m!=='object')return;if(m.type==='call-request'){primeAudio();startRing();callBtn.disabled=false;callLabel.textContent=t.accept;setComm(t.incoming)}else if(m.type==='speech'){void translateIncoming(m)}else if(m.type==='translation'){translation.textContent=m.text||'';transcript.textContent=m.source?labels[m.source]+' → '+(m.text||''):transcript.textContent;speakText(m.text||'')}else if(m.type==='screen-request'){void showConsent(m.requestId,c.peer)}else if(m.type==='screen-response'){setComm(m.approved?(locale==='de'?'Bildschirmfreigabe erlaubt.':'Partner povolil zdieľanie obrazovky.'): (locale==='de'?'Bildschirmfreigabe abgelehnt.':'Partner zamietol zdieľanie obrazovky.'))}else if(m.type==='screen-share-stopped'){clearRemoteScreen()}})};
  const openPeer=async()=>{await loadPeer();if(peerReady)return;peer=new Peer(undefined,{config:{iceServers:[{urls:'stun:stun.l.google.com:19302'},{urls:'stun.cloudflare.com:3478'}]}});peer.on('connection',c=>wireData(c));peer.on('call',mc=>{if(mc.metadata?.foxScreen){mc.answer();attachScreenCall(mc);remoteScreenStatus.textContent='● PRICHÁDZA';setComm(locale==='de'?'Bildschirm des Partners kommt…':'Prichádza obrazovka partnera…');return}pendingCall=mc;primeAudio();startRing();callBtn.disabled=false;callLabel.textContent=t.accept;setComm(t.incoming)});peer.on('disconnected',()=>setComm('⚠️ PeerJS odpojený – pripájam…'));peer.on('error',e=>setComm('❌ PeerJS: '+(e?.type||e?.message||'chyba')));await new Promise((resolve,reject)=>{const tm=setTimeout(()=>reject(Error('PeerJS timeout')),20000);peer.once('open',()=>{clearTimeout(tm);peerReady=true;screenBtn.disabled=!remoteId;resolve()})})};
  const ensureLocal=async()=>{if(localStream)return localStream;localStream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});localStream.getAudioTracks().forEach(x=>x.enabled=true);mic.disabled=false;return localStream};
  const startRecognition=()=>{const Ctor=window.SpeechRecognition||window.webkitSpeechRecognition;if(!Ctor){setComm(locale==='de'?'Spracherkennung wird in diesem Browser nicht unterstützt. Chrome/Edge verwenden.':'Tento prehliadač nepodporuje rozpoznávanie reči. Použite Chrome/Edge.');return}if(recognizing)return;stopping=false;recognition=new Ctor();recognition.lang=getLocale(source.value);recognition.continuous=true;recognition.interimResults=true;recognition.maxAlternatives=1;recognition.onstart=()=>{recognizing=true;record.classList.add('recording');recordLabel.textContent=t.stop;status.textContent=t.recording};recognition.onerror=e=>{recognizing=false;if(!stopping)setComm('❌ SpeechRecognition: '+(e.error||'error'))};recognition.onresult=e=>{let interim='';for(let i=e.resultIndex;i<e.results.length;i++){const r=e.results[i],txt=r[0]?.transcript?.trim()||'';if(r.isFinal&&txt){transcript.textContent=txt;if(currentMode==='communicator')send({type:'speech',id:Date.now()+Math.random(),text:txt,source:source.value,target:target.value});else void translateIncoming({id:Date.now()+Math.random(),text:txt,source:source.value,target:target.value})}else if(txt)interim+=txt+' '}if(interim.trim())transcript.textContent=interim.trim()};recognition.onend=()=>{recognizing=false;if(!stopping&&currentMode==='communicator'&&mediaConn?.open)setTimeout(()=>{if(!recognizing&&!stopping)startRecognition()},200)};try{recognition.start()}catch{setComm('❌ Hlasové rozpoznávanie sa nedá spustiť.')}};
  const stopRecognition=()=>{stopping=true;try{recognition?.stop()}catch{}recognizing=false;record.classList.remove('recording');recordLabel.textContent=t.start};
  const createRoom=async()=>{primeAudio();create.disabled=true;setComm(locale==='de'?'Verbindung wird erstellt…':'Vytváram spojenie…');try{await openPeer();link.value=location.origin+location.pathname+'?foxPeer='+encodeURIComponent(peer.id)+'&foxSource='+encodeURIComponent(source.value)+'&foxTarget='+encodeURIComponent(target.value);invite.classList.remove('hidden');share.disabled=false;copyLink.disabled=false;setComm(t.waiting)}catch(e){create.disabled=false;setComm('❌ '+(e?.message||'Spojenie sa nepodarilo'))}};
  const requestCall=async()=>{if(!remoteId){setComm(t.waiting);return}try{primeAudio();await openPeer();await ensureLocal();const c=peer.connect(remoteId,{reliable:true,label:'fox-control'});wireData(c);await new Promise((resolve,reject)=>{if(c.open)return resolve();const tm=setTimeout(()=>reject(Error('Data connection timeout')),15000);c.once('open',()=>{clearTimeout(tm);resolve()});c.once('error',reject)});send({type:'call-request',source:source.value,target:target.value,at:Date.now()});const mc=peer.call(remoteId,localStream,{metadata:{foxAudio:true}});attachMedia(mc);setComm(t.calling);callBtn.disabled=true;callLabel.textContent=t.call;setTimeout(()=>{if(currentMode==='communicator'&&!recognizing)startRecognition()},500)}catch(e){callBtn.disabled=false;callLabel.textContent=t.call;setComm('❌ '+(e?.message||'Hovor sa nepodaril'))}};
  const acceptCall=async()=>{if(!pendingCall)return;try{primeAudio();stopRing();await ensureLocal();const mc=pendingCall;pendingCall=null;mc.answer(localStream);attachMedia(mc);callBtn.disabled=true;setComm(t.active);startRecognition()}catch(e){callBtn.disabled=false;callLabel.textContent=t.accept;setComm('❌ '+(e?.message||'Prijatie hovoru zlyhalo'))}};
  const stopCall=()=>{stopRecognition();try{mediaConn?.close()}catch{};mediaConn=null;try{screenCall?.close()}catch{};stopScreenShare();if(dataConn){try{dataConn.close()}catch{};dataConn=null}setComm(t.waiting);callBtn.disabled=!remoteId;callLabel.textContent=t.call};
  const setMode=m=>{currentMode=m;modes.forEach(b=>{const a=b.dataset.mode===m;b.classList.toggle('is-active',a);b.setAttribute('aria-selected',String(a))});comm.classList.toggle('hidden',m!=='communicator');root.classList.toggle('is-call-mode',m==='communicator');modeNote.textContent=m==='communicator'?(locale==='de'? 'Live-Kommunikation mit Übersetzung.':'Živá komunikácia s prekladom.'):(locale==='de'?'Sprachübersetzung und Vorlesefunktion.':'Hlasový preklad a hlasový výstup.');if(m==='translator'&&recognizing)stopRecognition()};
  const syncLabels=()=>{sourceLabel.textContent=labels[source.value]||source.value;targetLabel.textContent=labels[target.value]||target.value;recordLabel.textContent=recognizing?t.stop:t.start;micLabel.textContent=t.mic;screenLabel.textContent=t.screen};
  modes.forEach(b=>b.onclick=()=>setMode(b.dataset.mode));
  swap.onclick=()=>{const x=source.value;source.value=target.value;target.value=x;syncLabels();if(recognizing){stopRecognition();startRecognition()}};
  source.onchange=()=>{syncLabels();if(recognizing){stopRecognition();startRecognition()}};target.onchange=syncLabels;
  record.onclick=()=>{primeAudio();if(recognizing)stopRecognition();else startRecognition()};
  create.onclick=createRoom;callBtn.onclick=()=>pendingCall?acceptCall():requestCall();share.onclick=async()=>{try{await navigator.clipboard.writeText(link.value);setComm(t.share)}catch{link.select();document.execCommand('copy')}};copyLink.onclick=share.onclick;
  mic.onclick=()=>{const tr=localStream?.getAudioTracks?.()[0];if(!tr)return;tr.enabled=!tr.enabled;micLabel.textContent=tr.enabled?t.mic:(locale==='de'?'MIKROFON EINSCHALTEN':'ZAPNÚŤ MIKROFÓN')};audioBtn.onclick=()=>{primeAudio();window.speechSynthesis?.resume?.();setComm(t.active)};
  screenBtn.onclick=requestPartnerScreen;screenStop.onclick=stopScreenShare;
  play.onclick=()=>speakText(translation.textContent);root.querySelectorAll('[data-speed]').forEach(b=>b.onclick=()=>{root.querySelectorAll('[data-speed]').forEach(x=>x.classList.remove('is-active'));b.classList.add('is-active');speechRate=Number(b.dataset.speed||1);if(translation.textContent)speakText(translation.textContent)});
  syncLabels();
  (async()=>{const qs=new URLSearchParams(location.search),qsSource=qs.get('foxSource'),qsTarget=qs.get('foxTarget');if(qsSource&&qsTarget){source.value=qsTarget;target.value=qsSource;syncLabels();setMode('communicator');try{await openPeer();callBtn.disabled=false;callLabel.textContent=t.call;setComm(t.waiting)}catch(e){setComm('❌ '+(e?.message||'Spojenie sa nepodarilo'))}}})();
}
</script>