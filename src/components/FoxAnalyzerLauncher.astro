---
const locale = Astro.props.locale ?? "de";
const labels = {
  de:{open:"Website kostenlos testen",close:"Analyzer schließen",kicker:"FOX TECHNOLOGY LAB",title:"Teste deine Website – direkt hier.",text:"SEO · Google · Meta · Performance · Conversion · UX",choose:"Wähle bis zu 2 Tests",run:"Ausgewählte Tests starten →",selected:"ausgewählt",limit:"Maximal 2 Tests auswählen"},
  en:{open:"Test your website for free",close:"Close analyzer",kicker:"FOX TECHNOLOGY LAB",title:"Test your website – right here.",text:"SEO · Google · Meta · Performance · Conversion · UX",choose:"Choose up to 2 tests",run:"Run selected tests →",selected:"selected",limit:"Select a maximum of 2 tests"},
  sk:{open:"Otestovať web zdarma",close:"Zavrieť analyzátor",kicker:"FOX TECHNOLOGY LAB",title:"Otestuj svoj web – priamo tu.",text:"SEO · Google · Meta · Výkon · Konverzia · UX",choose:"Vyber si až 2 testy",run:"Spustiť vybrané testy →",selected:"vybrané",limit:"Vybrať môžeš maximálne 2 testy"},
  fr:{open:"Tester votre site gratuitement",close:"Fermer l’analyseur",kicker:"FOX TECHNOLOGY LAB",title:"Testez votre site – directement ici.",text:"SEO · Google · Meta · Performance · Conversion · UX",choose:"Choisissez jusqu’à 2 tests",run:"Lancer les tests sélectionnés →",selected:"sélectionnés",limit:"Sélectionnez au maximum 2 tests"},
  hr:{open:"Besplatno testiraj web",close:"Zatvori analizator",kicker:"FOX TECHNOLOGY LAB",title:"Testiraj svoju web-stranicu – ovdje.",text:"SEO · Google · Meta · Performanse · Konverzija · UX",choose:"Odaberi do 2 testa",run:"Pokreni odabrane testove →",selected:"odabrano",limit:"Odaberi najviše 2 testa"},
  pl:{open:"Przetestuj stronę za darmo",close:"Zamknij analizator",kicker:"FOX TECHNOLOGY LAB",title:"Przetestuj swoją stronę – tutaj.",text:"SEO · Google · Meta · Wydajność · Konwersja · UX",choose:"Wybierz do 2 testów",run:"Uruchom wybrane testy →",selected:"wybrane",limit:"Wybierz maksymalnie 2 testy"},
  it:{open:"Testa il sito gratis",close:"Chiudi analizzatore",kicker:"FOX TECHNOLOGY LAB",title:"Testa il tuo sito – direttamente qui.",text:"SEO · Google · Meta · Prestazioni · Conversione · UX",choose:"Scegli fino a 2 test",run:"Avvia i test selezionati →",selected:"selezionati",limit:"Seleziona al massimo 2 test"},
  es:{open:"Prueba tu web gratis",close:"Cerrar analizador",kicker:"FOX TECHNOLOGY LAB",title:"Prueba tu web – directamente aquí.",text:"SEO · Google · Meta · Rendimiento · Conversión · UX",choose:"Elige hasta 2 pruebas",run:"Iniciar pruebas seleccionadas →",selected:"seleccionadas",limit:"Selecciona como máximo 2 pruebas"},
  sv:{open:"Testa din webbplats gratis",close:"Stäng analysverktyget",kicker:"FOX TECHNOLOGY LAB",title:"Testa din webbplats – direkt här.",text:"SEO · Google · Meta · Prestanda · Konvertering · UX",choose:"Välj upp till 2 tester",run:"Starta valda tester →",selected:"valda",limit:"Välj högst 2 tester"}
} as const;
const t=labels[locale as keyof typeof labels]??labels.de;
---
<div class="fox-launcher" id="fox-analyzer-launcher" data-locale={locale}>
  <div class="fox-launcher-bar"><div class="fox-launcher-copy"><span class="fox-launcher-kicker">✦ {t.kicker}</span><strong>{t.title}</strong><small>{t.text}</small></div><button class="fox-launcher-button" type="button" aria-expanded="false"><span>⌁</span><span data-label>{t.open}</span><span>↓</span></button></div>
  <div class="fox-analyzer-panel" id="fox-analyzer-panel" hidden><iframe src={`/analyzer/?embed=1&lang=${locale}`} title="FOX Web Analyzer" loading="lazy"></iframe></div>
</div>
<style>
.fox-launcher{width:100%;margin:0 auto;scroll-margin-top:20px;border-top:10px solid #f36a0a;border-bottom:10px solid #f36a0a;background:#0f1012;color:#fff;position:relative;z-index:5}.fox-launcher-bar{min-height:112px;padding:18px clamp(20px,5vw,72px);display:flex;align-items:center;justify-content:space-between;gap:24px}.fox-launcher-copy{display:flex;flex-direction:column;gap:5px}.fox-launcher-kicker{font-size:12px;font-weight:900;letter-spacing:.12em;color:#ff7a22}.fox-launcher-copy strong{font-size:clamp(20px,2.2vw,32px);line-height:1.1}.fox-launcher-copy small{color:#aeb1b7;font-size:13px}.fox-launcher-button{border:0;background:#f36a0a;color:#fff;border-radius:14px;padding:17px 24px;font-size:15px;font-weight:900;cursor:pointer;box-shadow:0 12px 30px rgba(243,106,10,.22);display:inline-flex;align-items:center;gap:10px;white-space:nowrap}.fox-analyzer-panel{background:#0b0c0f;padding:0}.fox-analyzer-panel iframe{display:block;width:100%;height:min(2850px,calc(100vh + 2050px));min-height:1900px;border:0;background:#0b0c0f}.fox-analyzer-panel iframe{color-scheme:dark}@media(max-width:700px){.fox-launcher-bar{align-items:stretch;flex-direction:column}.fox-launcher-button{justify-content:center}.fox-analyzer-panel iframe{min-height:2550px}}
</style>
<script>
const launcher=document.getElementById("fox-analyzer-launcher");
if(launcher){
 const hero=document.querySelector(".hero-section");if(hero)hero.insertAdjacentElement("afterend",launcher);
 const button=launcher.querySelector(".fox-launcher-button"),panel=launcher.querySelector(".fox-analyzer-panel"),label=launcher.querySelector("[data-label]"),iframe=launcher.querySelector("iframe"),locale=launcher.dataset.locale||"de";
 const closeLabels={de:"Analyzer schließen",en:"Close analyzer",sk:"Zavrieť analyzátor",fr:"Fermer l’analyseur",hr:"Zatvori analizator",pl:"Zamknij analizator",it:"Chiudi analizzatore",es:"Cerrar analizador",sv:"Stäng analysverktyget"};
 const L={de:["Wähle bis zu 2 Tests","Ausgewählte Tests starten →","ausgewählt","Maximal 2 Tests auswählen"],en:["Choose up to 2 tests","Run selected tests →","selected","Select a maximum of 2 tests"],sk:["Vyber si až 2 testy","Spustiť vybrané testy →","vybrané","Vybrať môžeš maximálne 2 testy"],fr:["Choisissez jusqu’à 2 tests","Lancer les tests sélectionnés →","sélectionnés","Sélectionnez au maximum 2 tests"],hr:["Odaberi do 2 testa","Pokreni odabrane testove →","odabrano","Odaberi najviše 2 testa"],pl:["Wybierz do 2 testów","Uruchom wybrane testy →","wybrane","Wybierz maksymalnie 2 testy"],it:["Scegli fino a 2 test","Avvia i test selezionati →","selezionati","Seleziona al massimo 2 test"],es:["Elige hasta 2 pruebas","Iniciar pruebas seleccionadas →","seleccionadas","Selecciona como máximo 2 pruebas"],sv:["Välj upp till 2 tester","Starta valda tester →","valda","Välj högst 2 tester"]};const txt=L[locale]||L.de;
 const install=()=>{try{const d=iframe?.contentDocument;if(!d)return;let box=d.getElementById("fox-selection");if(!box){const tool=d.querySelector(".tool");if(!tool)return;box=d.createElement("div");box.id="fox-selection";box.className="fox-selection";box.innerHTML=`<div class="fox-selection-title">${txt[0]}</div><div class="fox-selection-grid"></div><div class="fox-selection-footer"><span class="fox-selection-count">0 / 2</span><button class="fox-run" type="button" disabled>${txt[1]}</button></div>`;tool.prepend(box);}
 const grid=box.querySelector(".fox-selection-grid");if(!grid||grid.children.length)return;const cats=[["⌕","SEO","Technical SEO","seo"],["G","Google","Search & Lighthouse","google"],["◎","Meta / Facebook","Open Graph & social","meta"],["↯","Performance","Core Web Vitals","performance"],["◈","UX","Mobile & accessibility","ux"],["◇","Security","HTTPS & trust","security"],["↗","Conversion","CTA & Ads","conversion"]];grid.innerHTML=cats.map(c=>`<button class="fox-select" type="button" data-key="${c[3]}"><b>${c[0]} ${c[1]}</b><small>${c[2]}</small></button>`).join("");
 const selected=new Set(),count=box.querySelector(".fox-selection-count"),run=box.querySelector(".fox-run");const refresh=()=>{count.textContent=`${selected.size} / 2 ${txt[2]}`;run.disabled=selected.size===0;grid.querySelectorAll(".fox-select").forEach(b=>{b.disabled=selected.size>=2&&!selected.has(b.dataset.key);b.classList.toggle("active",selected.has(b.dataset.key))})};
 grid.querySelectorAll(".fox-select").forEach(b=>b.addEventListener("click",()=>{const k=b.dataset.key;if(selected.has(k))selected.delete(k);else if(selected.size<2)selected.add(k);else{count.textContent=txt[3];return}refresh()}));refresh();
 run.addEventListener("click",()=>{const keys=[...selected];if(!keys.length)return;const url=d.querySelector("#url");if(url&&!url.value)url.value="https://foxprof.club/";const form=d.querySelector("#form");if(!form)return;form.requestSubmit();const filter=()=>{const result=d.querySelector("#result");if(!result||result.hidden){setTimeout(filter,200);return}const tests=new Set(keys);[...result.querySelectorAll(":scope > .section")].forEach(s=>{const h=(s.querySelector("h2")?.textContent||"").toLowerCase();let keep=false;if(tests.has("seo")&&/technical|technische|technické|testy|tests|testy techniczne|test tecnici|pruebas técnicas|tekniska/i.test(h))keep=true;if(tests.has("google")&&/google.*lighthouse/i.test(h))keep=true;if(tests.has("performance")&&/core web vitals/i.test(h))keep=true;if(tests.has("conversion")&&/ads|conversion|konverzia|conversión|conversione/i.test(h))keep=true;if(tests.has("ux")&&/accessibility|prístupnosť|accessibilité|accesibilidad|mobile/i.test(h))keep=true;if(tests.has("security")&&/security|trust|https/i.test(h))keep=true;if(tests.has("meta")&&[...s.querySelectorAll(".card strong")].some(x=>/open graph/i.test(x.textContent||"")))keep=true;s.style.display=keep?"":"none"});result.scrollIntoView({behavior:"smooth",block:"start"})};filter()});
 }catch(e){console.debug("FOX selection",e)}};
 iframe?.addEventListener("load",install);
 button?.addEventListener("click",()=>{const open=button.getAttribute("aria-expanded")==="true";button.setAttribute("aria-expanded",String(!open));panel.hidden=open;label.textContent=!open?(closeLabels[locale]||closeLabels.de):t.open;if(!open)setTimeout(()=>{install();launcher.scrollIntoView({behavior:"smooth",block:"start"})},80)});
}
</script>
