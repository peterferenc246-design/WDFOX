---
const locale = Astro.props.locale ?? "de";
const labels = {
  de: { open:"Website kostenlos testen", close:"Analyzer schließen", kicker:"FOX TECHNOLOGY LAB", title:"Teste deine Website – direkt hier.", text:"SEO · Google · Meta · Performance · Conversion · UX", choose:"Wähle bis zu 2 Tests", run:"Ausgewählte Tests starten →", selected:"ausgewählt", limit:"Maximal 2 Kategorien auswählen" },
  en: { open:"Test your website for free", close:"Close analyzer", kicker:"FOX TECHNOLOGY LAB", title:"Test your website – right here.", text:"SEO · Google · Meta · Performance · Conversion · UX", choose:"Choose up to 2 tests", run:"Run selected tests →", selected:"selected", limit:"Select a maximum of 2 categories" },
  sk: { open:"Otestovať web zdarma", close:"Zavrieť analyzátor", kicker:"FOX TECHNOLOGY LAB", title:"Otestuj svoj web – priamo tu.", text:"SEO · Google · Meta · Výkon · Konverzia · UX", choose:"Vyber si až 2 testy", run:"Spustiť vybrané testy →", selected:"vybrané", limit:"Vybrať môžeš maximálne 2 kategórie" },
  fr: { open:"Tester votre site gratuitement", close:"Fermer l’analyseur", kicker:"FOX TECHNOLOGY LAB", title:"Testez votre site – directement ici.", text:"SEO · Google · Meta · Performance · Conversion · UX", choose:"Choisissez jusqu’à 2 tests", run:"Lancer les tests sélectionnés →", selected:"sélectionnés", limit:"Sélectionnez au maximum 2 catégories" },
  hr: { open:"Besplatno testiraj web", close:"Zatvori analizator", kicker:"FOX TECHNOLOGY LAB", title:"Testiraj svoju web-stranicu – ovdje.", text:"SEO · Google · Meta · Performanse · Konverzija · UX", choose:"Odaberi do 2 testa", run:"Pokreni odabrane testove →", selected:"odabrano", limit:"Odaberi najviše 2 kategorije" },
  pl: { open:"Przetestuj stronę za darmo", close:"Zamknij analizator", kicker:"FOX TECHNOLOGY LAB", title:"Przetestuj swoją stronę – tutaj.", text:"SEO · Google · Meta · Wydajność · Konwersja · UX", choose:"Wybierz do 2 testów", run:"Uruchom wybrane testy →", selected:"wybrane", limit:"Wybierz maksymalnie 2 kategorie" },
  it: { open:"Testa il sito gratis", close:"Chiudi analizzatore", kicker:"FOX TECHNOLOGY LAB", title:"Testa il tuo sito – direttamente qui.", text:"SEO · Google · Meta · Prestazioni · Conversione · UX", choose:"Scegli fino a 2 test", run:"Avvia i test selezionati →", selected:"selezionati", limit:"Seleziona al massimo 2 categorie" },
  es: { open:"Prueba tu web gratis", close:"Cerrar analizador", kicker:"FOX TECHNOLOGY LAB", title:"Prueba tu web – directamente aquí.", text:"SEO · Google · Meta · Rendimiento · Conversión · UX", choose:"Elige hasta 2 pruebas", run:"Iniciar pruebas seleccionadas →", selected:"seleccionadas", limit:"Selecciona como máximo 2 categorías" },
  sv: { open:"Testa din webbplats gratis", close:"Stäng analysverktyget", kicker:"FOX TECHNOLOGY LAB", title:"Testa din webbplats – direkt här.", text:"SEO · Google · Meta · Prestanda · Konvertering · UX", choose:"Välj upp till 2 tester", run:"Starta valda tester →", selected:"valda", limit:"Välj högst 2 kategorier" }
} as const;
const t = labels[locale as keyof typeof labels] ?? labels.de;
---
<div class="fox-launcher" id="fox-analyzer-launcher" data-locale={locale}>
  <div class="fox-launcher-bar"><div class="fox-launcher-copy"><span class="fox-launcher-kicker">✦ {t.kicker}</span><strong>{t.title}</strong><small>{t.text}</small></div><button class="fox-launcher-button" type="button" aria-expanded="false" aria-controls="fox-analyzer-panel"><span class="fox-launcher-icon">⌁</span><span data-label>{t.open}</span><span class="fox-launcher-chevron">↓</span></button></div>
  <div class="fox-analyzer-panel" id="fox-analyzer-panel" hidden><iframe src={`/analyzer/?embed=1&lang=${locale}`} title="FOX Web Analyzer" loading="lazy"></iframe></div>
</div>
<style>
.fox-launcher{width:100%;margin:0 auto;scroll-margin-top:20px;border-top:10px solid #f36a0a;border-bottom:10px solid #f36a0a;background:#0f1012;color:#fff;position:relative;z-index:5}.fox-launcher-bar{min-height:112px;padding:18px clamp(20px,5vw,72px);display:flex;align-items:center;justify-content:space-between;gap:24px}.fox-launcher-copy{display:flex;flex-direction:column;gap:5px}.fox-launcher-kicker{font-size:12px;font-weight:900;letter-spacing:.12em;color:#ff7a22}.fox-launcher-copy strong{font-size:clamp(20px,2.2vw,32px);line-height:1.1}.fox-launcher-copy small{color:#aeb1b7;font-size:13px}.fox-launcher-button{border:0;background:#f36a0a;color:#fff;border-radius:14px;padding:17px 24px;font-size:15px;font-weight:900;cursor:pointer;box-shadow:0 12px 30px rgba(243,106,10,.22);display:inline-flex;align-items:center;gap:10px;white-space:nowrap;transition:transform .2s,background .2s}.fox-launcher-button:hover{transform:translateY(-2px);background:#ff7415}.fox-launcher-icon{font-size:20px}.fox-launcher-chevron{font-size:18px;transition:transform .25s}.fox-launcher.is-open .fox-launcher-chevron{transform:rotate(180deg)}.fox-analyzer-panel{background:#0b0c0f;padding:0}.fox-analyzer-panel iframe{display:block;width:100%;height:min(2850px,calc(100vh + 2050px));min-height:1900px;border:0;border-radius:0;background:#0b0c0f;box-shadow:none}@media(max-width:700px){.fox-launcher-bar{align-items:stretch;flex-direction:column}.fox-launcher-button{justify-content:center}.fox-analyzer-panel iframe{min-height:2550px}}
</style>
<script>
const launcher=document.getElementById("fox-analyzer-launcher");
if(launcher){
 const hero=document.querySelector(".hero-section");if(hero)hero.insertAdjacentElement("afterend",launcher);
 const button=launcher.querySelector(".fox-launcher-button"),panel=launcher.querySelector(".fox-analyzer-panel"),label=launcher.querySelector("[data-label]"),iframe=launcher.querySelector("iframe"),locale=launcher.dataset.locale||"de";
 const L={de:{choose:"Wähle bis zu 2 Tests",run:"Ausgewählte Tests starten →",selected:"ausgewählt",limit:"Maximal 2 Kategorien auswählen"},en:{choose:"Choose up to 2 tests",run:"Run selected tests →",selected:"selected",limit:"Select a maximum of 2 categories"},sk:{choose:"Vyber si až 2 testy",run:"Spustiť vybrané testy →",selected:"vybrané",limit:"Vybrať môžeš maximálne 2 kategórie"},fr:{choose:"Choisissez jusqu’à 2 tests",run:"Lancer les tests sélectionnés →",selected:"sélectionnés",limit:"Sélectionnez au maximum 2 catégories"},hr:{choose:"Odaberi do 2 testa",run:"Pokreni odabrane testove →",selected:"odabrano",limit:"Odaberi najviše 2 kategorije"},pl:{choose:"Wybierz do 2 testów",run:"Uruchom wybrane testy →",selected:"wybrane",limit:"Wybierz maksymalnie 2 kategorie"},it:{choose:"Scegli fino a 2 test",run:"Avvia i test selezionati →",selected:"selezionati",limit:"Seleziona al massimo 2 categorie"},es:{choose:"Elige hasta 2 pruebas",run:"Iniciar pruebas seleccionadas →",selected:"seleccionadas",limit:"Selecciona como máximo 2 categorías"},sv:{choose:"Välj upp till 2 tester",run:"Starta valda tester →",selected:"valda",limit:"Välj högst 2 kategorier"}}[locale]||{choose:"Choose up to 2 tests",run:"Run selected tests →",selected:"selected",limit:"Select a maximum of 2 categories"};
 const inject=()=>{try{const d=iframe.contentDocument;if(!d)return;let s=d.getElementById("fox-ui-overrides");if(s)s.remove();s=d.createElement("style");s.id="fox-ui-overrides";s.textContent=`html,body{background:#0b0c0f!important;color:#f5f5f5!important}body{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important}.page{background:#0b0c0f!important;padding:34px 22px 70px!important}.wrap{max-width:1380px!important}.back{color:#aeb1b7!important}.analyzer{background:#111318!important;border:1px solid #292d35!important;border-radius:28px!important;padding:42px!important;box-shadow:0 30px 90px rgba(0,0,0,.45)!important}.eyebrow{color:#ff7a22!important}.hero h1{color:#fff!important}.hero h1 em{color:#ff7a22!important}.hero p{color:#bfc3ca!important}.chips span{background:#181b21!important;border-color:#30343c!important;color:#dfe2e7!important}.tool{background:#15181e!important;color:#f5f5f5!important;border:1px solid #30343c!important;border-radius:22px!important;box-shadow:none!important}.input{background:#0e1014!important;border-color:#383d47!important}.input input{color:#fff!important}.help,.foot{color:#7f858f!important}.result{border-top-color:#30343c!important}.score{background:linear-gradient(135deg,#24170e,#181b21)!important;border:1px solid #4a3425!important}.score strong{color:#ff7a22!important}.card,.metric{background:#0f1115!important;border-color:#30343c!important;color:#f5f5f5!important}.card p,.metric small{color:#8f959e!important}.metric span{color:#d9dce1!important}.section h2{color:#fff!important}.action{background:#181b21!important;color:#e9ebef!important;border-color:#383d47!important}.fox-selection{margin:0 0 26px;padding:18px;border:1px solid #30343c;border-radius:18px;background:#0f1115}.fox-selection-title{font-size:13px;font-weight:900;color:#fff;margin-bottom:12px}.fox-selection-grid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:9px}.fox-select{border:1px solid #30343c;background:#12151a;color:#fff;border-radius:14px;padding:13px 10px;text-align:left;cursor:pointer;min-height:78px;display:flex;flex-direction:column;gap:6px}.fox-select:hover{border-color:#f36a0a}.fox-select.active{border-color:#f36a0a;background:#25170e;box-shadow:inset 0 0 0 1px #f36a0a}.fox-select b{font-size:12px}.fox-select small{color:#818792;font-size:10px}.fox-select.active small{color:#ffad7b}.fox-selection-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:13px}.fox-selection-count{font-size:11px;color:#8f959e}.fox-run{border:0;border-radius:11px;padding:11px 17px;background:#f36a0a;color:#fff;font-weight:900;cursor:pointer}.fox-run:disabled{opacity:.35;cursor:not-allowed}@media(max-width:1050px){.fox-selection-grid{grid-template-columns:repeat(4,1fr)}}@media(max-width:650px){.analyzer{padding:22px 15px!important}.page{padding:18px 10px 50px!important}.fox-selection-grid{grid-template-columns:repeat(2,1fr)}.fox-selection-footer{align-items:stretch;flex-direction:column}.fox-run{width:100%}}`;d.head.appendChild(s);
 const tool=d.querySelector(".tool");if(!tool)return;let box=d.getElementById("fox-selection");if(!box){box=d.createElement("div");box.id="fox-selection";box.className="fox-selection";box.innerHTML=`<div class="fox-selection-title">${L.choose}</div><div class="fox-selection-grid"></div><div class="fox-selection-footer"><span class="fox-selection-count">0 / 2</span><button class="fox-run" type="button" disabled>${L.run}</button></div>`;tool.prepend(box)}
 const grid=box.querySelector(".fox-selection-grid");if(!grid.children.length){const cats=[["⌕","SEO","Technical SEO","seo"],["G","Google","Search & Lighthouse","google"],["◎","Meta / Facebook","Open Graph & social","meta"],["↯","Performance","Core Web Vitals","performance"],["◈","UX","Mobile & accessibility","ux"],["◇","Security","HTTPS & trust","security"],["↗","Conversion","CTA & Ads","conversion"]];grid.innerHTML=cats.map(c=>`<button class="fox-select" type="button" data-key="${c[3]}"><b>${c[0]} ${c[1]}</b><small>${c[2]}</small></button>`).join("")}
 const selected=new Set(),count=box.querySelector(".fox-selection-count"),run=box.querySelector(".fox-run");grid.querySelectorAll(".fox-select").forEach(b=>b.addEventListener("click",()=>{const k=b.dataset.key;if(selected.has(k)){selected.delete(k);b.classList.remove("active")}else{if(selected.size>=2){count.textContent=L.limit;return}selected.add(k);b.classList.add("active")}count.textContent=`${selected.size} / 2 ${L.selected}`;run.disabled=!selected.size}));
 const classify=(text,key)=>{const x=text.toLowerCase();const m={seo:/technical seo|robots|sitemap|canonical|schema|meta title|meta description|hreflang|favicon|viewport|html language|noindex|redirect|headings|links|images|crawlability|indexability/,google:/google|lighthouse|crawlability|final url/,meta:/open graph|twitter cards|social/,performance:/core web vitals|lcp|inp|cls|fcp|ttfb|performance/,ux:/accessibility|mobile|ux/,security:/https|security|trust|legal/,conversion:/ads|conversion|cta|message match|benefit|ad destination/};return m[key]?.test(x)};
 const filterResults=keys=>{const d=iframe.contentDocument,r=d?.querySelector("#result");if(!r)return;const sections=[...r.querySelectorAll(".section")];sections.forEach(sec=>{const heading=(sec.querySelector("h2")?.textContent||"").trim();const sectionText=sec.textContent||"";let show=keys.some(k=>classify(heading,k));if(!show&&/techn/i.test(heading))show=keys.some(k=>k==="seo"||k==="meta"||k==="security");if(!show&&/google/i.test(heading))show=keys.includes("google");if(!show&&/core web/i.test(heading))show=keys.includes("performance");if(!show&&/ads|conversion/i.test(heading))show=keys.includes("conversion");if(!show&&/recommend/i.test(heading))show=false;sec.style.display=show?"":"none";
 if(show&&(/techn/i.test(heading)||/google/i.test(heading))){[...sec.querySelectorAll(".card")].forEach(card=>{const txt=card.textContent||"";const keep=keys.some(k=>classify(txt,k));card.style.display=keep?"":"none"});[...sec.querySelectorAll(".metric")].forEach(metric=>{const txt=metric.textContent||"";const keep=keys.some(k=>classify(txt,k));metric.style.display=keep?"":"none"})}
 });
 const top=r.querySelector(".top");if(top){[...top.querySelectorAll(".card")].forEach(card=>{const keep=keys.some(k=>classify(card.textContent||"",k));card.style.display=keep?"":"none"})}
 r.dataset.foxSelected=keys.join(",");r.scrollIntoView({behavior:"smooth",block:"start"})};
 run.addEventListener("click",()=>{if(!selected.size)return;const keys=[...selected];run.disabled=true;const d=iframe.contentDocument;const form=d?.querySelector("#form");if(!form)return;form.requestSubmit();const wait=()=>{const r=d?.querySelector("#result");if(!r||r.hidden){setTimeout(wait,250);return}filterResults(keys);run.disabled=false};setTimeout(wait,300)});
 }catch(e){console.debug("FOX Analyzer UI",e)}};
 iframe?.addEventListener("load",inject);if(iframe?.contentDocument?.readyState==="complete")inject();
 button?.addEventListener("click",()=>{const open=launcher.classList.toggle("is-open");button.setAttribute("aria-expanded",String(open));panel.hidden=!open;label.textContent=open?(labels[locale]?.close||"Close analyzer"):labels[locale]?.open||"Test website";if(open)setTimeout(()=>{inject();launcher.scrollIntoView({behavior:"smooth",block:"start"})},80);else setTimeout(()=>launcher.querySelector(".fox-launcher-bar")?.scrollIntoView({behavior:"smooth",block:"center"}),40)});
}
</script>