---
const locale = Astro.props.locale ?? "de";
const labels = {
 de:{open:"Website kostenlos testen",close:"Analyzer schließen",kicker:"FOX TECHNOLOGY LAB",title:"Teste deine Website – direkt hier.",text:"SEO · Google · Meta/Facebook · Meta Pixel · X/Twitter · Performance · UX · Security · Conversion",choose:"Wähle bis zu 2 Tests",run:"Ausgewählte Tests starten →",selected:"ausgewählt",limit:"Maximal 2 Kategorien auswählen"},
 en:{open:"Test your website for free",close:"Close analyzer",kicker:"FOX TECHNOLOGY LAB",title:"Test your website – right here.",text:"SEO · Google · Meta/Facebook · Meta Pixel · X/Twitter · Performance · UX · Security · Conversion",choose:"Choose up to 2 tests",run:"Run selected tests →",selected:"selected",limit:"Select a maximum of 2 categories"},
 sk:{open:"Otestovať web zdarma",close:"Zavrieť analyzátor",kicker:"FOX TECHNOLOGY LAB",title:"Otestuj svoj web – priamo tu.",text:"SEO · Google · Meta/Facebook · Meta Pixel · X/Twitter · Výkon · UX · Bezpečnosť · Konverzia",choose:"Vyber si až 2 testy",run:"Spustiť vybrané testy →",selected:"vybrané",limit:"Vybrať môžeš maximálne 2 kategórie"},
 fr:{open:"Tester votre site gratuitement",close:"Fermer l’analyseur",kicker:"FOX TECHNOLOGY LAB",title:"Testez votre site – directement ici.",text:"SEO · Google · Meta/Facebook · Meta Pixel · X/Twitter · Performance · UX · Sécurité · Conversion",choose:"Choisissez jusqu’à 2 tests",run:"Lancer les tests sélectionnés →",selected:"sélectionnés",limit:"Sélectionnez au maximum 2 catégories"},
 hr:{open:"Besplatno testiraj web",close:"Zatvori analizator",kicker:"FOX TECHNOLOGY LAB",title:"Testiraj svoju web-stranicu – ovdje.",text:"SEO · Google · Meta/Facebook · Meta Pixel · X/Twitter · Performanse · UX · Sigurnost · Konverzija",choose:"Odaberi do 2 testa",run:"Pokreni odabrane testove →",selected:"odabrano",limit:"Odaberi najviše 2 kategorije"},
 pl:{open:"Przetestuj stronę za darmo",close:"Zamknij analizator",kicker:"FOX TECHNOLOGY LAB",title:"Przetestuj swoją stronę – tutaj.",text:"SEO · Google · Meta/Facebook · Meta Pixel · X/Twitter · Wydajność · UX · Bezpieczeństwo · Konwersja",choose:"Wybierz do 2 testów",run:"Uruchom wybrane testy →",selected:"wybrane",limit:"Wybierz maksymalnie 2 kategorie"},
 it:{open:"Testa il sito gratis",close:"Chiudi analizzatore",kicker:"FOX TECHNOLOGY LAB",title:"Testa il tuo sito – direttamente qui.",text:"SEO · Google · Meta/Facebook · Meta Pixel · X/Twitter · Prestazioni · UX · Sicurezza · Conversione",choose:"Scegli fino a 2 test",run:"Avvia i test selezionati →",selected:"selezionati",limit:"Seleziona al massimo 2 categorie"},
 es:{open:"Prueba tu web gratis",close:"Cerrar analizador",kicker:"FOX TECHNOLOGY LAB",title:"Prueba tu web – directamente aquí.",text:"SEO · Google · Meta/Facebook · Meta Pixel · X/Twitter · Rendimiento · UX · Seguridad · Conversión",choose:"Elige hasta 2 pruebas",run:"Iniciar pruebas seleccionadas →",selected:"seleccionadas",limit:"Selecciona como máximo 2 categorías"},
 sv:{open:"Testa din webbplats gratis",close:"Stäng analysverktyget",kicker:"FOX TECHNOLOGY LAB",title:"Testa din webbplats – direkt här.",text:"SEO · Google · Meta/Facebook · Meta Pixel · X/Twitter · Prestanda · UX · Säkerhet · Konvertering",choose:"Välj upp till 2 tester",run:"Starta valda tester →",selected:"valda",limit:"Välj högst 2 kategorier"}
} as const;
const t=labels[locale as keyof typeof labels]??labels.de;
---
<div class="fox-launcher" id="fox-analyzer-launcher" data-locale={locale}>
 <div class="fox-launcher-bar"><div class="fox-launcher-copy"><span class="fox-launcher-kicker">✦ {t.kicker}</span><strong>{t.title}</strong><small>{t.text}</small></div><button class="fox-launcher-button" type="button" aria-expanded="false" aria-controls="fox-analyzer-panel"><span class="fox-launcher-icon">⌁</span><span data-label data-open={t.open} data-close={t.close}>{t.open}</span><span class="fox-launcher-chevron">↓</span></button></div>
 <div class="fox-analyzer-panel" id="fox-analyzer-panel" hidden><iframe src={`/analyzer/?embed=1&lang=${locale}`} title="FOX Web Analyzer" loading="lazy"></iframe></div>
</div>
<style>
.fox-launcher{width:100%;margin:0 auto;scroll-margin-top:20px;border-top:10px solid #f36a0a;border-bottom:10px solid #f36a0a;background:#0f1012;color:#fff;position:relative;z-index:5}.fox-launcher-bar{min-height:112px;padding:18px clamp(20px,5vw,72px);display:flex;align-items:center;justify-content:space-between;gap:24px}.fox-launcher-copy{display:flex;flex-direction:column;gap:5px}.fox-launcher-kicker{font-size:12px;font-weight:900;letter-spacing:.12em;color:#ff7a22}.fox-launcher-copy strong{font-size:clamp(20px,2.2vw,32px);line-height:1.1}.fox-launcher-copy small{color:#aeb1b7;font-size:13px}.fox-launcher-button{border:0;background:#f36a0a;color:#fff;border-radius:14px;padding:17px 24px;font-size:15px;font-weight:900;cursor:pointer;box-shadow:0 12px 30px rgba(243,106,10,.22);display:inline-flex;align-items:center;gap:10px;white-space:nowrap}.fox-launcher-icon{font-size:20px}.fox-launcher-chevron{font-size:18px;transition:transform .25s}.fox-launcher.is-open .fox-launcher-chevron{transform:rotate(180deg)}.fox-analyzer-panel{background:#0b0c0f;padding:0}.fox-analyzer-panel iframe{display:block;width:100%;height:min(3000px,calc(100vh + 2200px));min-height:2050px;border:0;background:#0b0c0f}@media(max-width:700px){.fox-launcher-bar{align-items:stretch;flex-direction:column}.fox-launcher-button{justify-content:center}.fox-analyzer-panel iframe{min-height:2800px}}
</style>
<script>
const launcher=document.getElementById("fox-analyzer-launcher");
if(launcher){
 const hero=document.querySelector(".hero-section");if(hero)hero.insertAdjacentElement("afterend",launcher);
 const button=launcher.querySelector(".fox-launcher-button"),panel=launcher.querySelector(".fox-analyzer-panel"),label=launcher.querySelector("[data-label]"),iframe=launcher.querySelector("iframe"),locale=launcher.dataset.locale||"de";
 const L={de:{choose:"Wähle bis zu 2 Tests",run:"Ausgewählte Tests starten →",selected:"ausgewählt",limit:"Maximal 2 Kategorien auswählen"},en:{choose:"Choose up to 2 tests",run:"Run selected tests →",selected:"selected",limit:"Select a maximum of 2 categories"},sk:{choose:"Vyber si až 2 testy",run:"Spustiť vybrané testy →",selected:"vybrané",limit:"Vybrať môžeš maximálne 2 kategórie"},fr:{choose:"Choisissez jusqu’à 2 tests",run:"Lancer les tests sélectionnés →",selected:"sélectionnés",limit:"Sélectionnez au maximum 2 catégories"},hr:{choose:"Odaberi do 2 testa",run:"Pokreni odabrane testove →",selected:"odabrano",limit:"Odaberi najviše 2 kategorije"},pl:{choose:"Wybierz do 2 testów",run:"Uruchom wybrane testy →",selected:"wybrane",limit:"Wybierz maksymalnie 2 kategorie"},it:{choose:"Scegli fino a 2 test",run:"Avvia i testy selezionati →",selected:"selezionati",limit:"Seleziona al massimo 2 categorie"},es:{choose:"Elige hasta 2 pruebas",run:"Iniciar pruebas seleccionadas →",selected:"seleccionadas",limit:"Selecciona como máximo 2 categorías"},sv:{choose:"Välj upp till 2 tester",run:"Starta valda tester →",selected:"valda",limit:"Välj högst 2 kategorier"}}[locale]||{choose:"Choose up to 2 tests",run:"Run selected tests →",selected:"selected",limit:"Select a maximum of 2 categories"};
 let selected=new Set();
 const cats=[["⌕","SEO","Technical SEO","seo"],["G","Google","Search & Lighthouse","google"],["◎","Meta / Facebook","Open Graph","meta"],["●","Meta Pixel","Pixel & Tracking","pixel"],["𝕏","X / Twitter","Twitter Cards","twitter"],["↯","Performance","Core Web Vitals","performance"],["◈","UX","Mobile & accessibility","ux"],["◇","Security","HTTPS & trust","security"],["↗","Conversion","CTA & Ads","conversion"]];
 const classify=(text,key)=>{const x=text.toLowerCase();const m={seo:/technical seo|robots|sitemap|canonical|schema|meta title|meta description|hreflang|favicon|viewport|html language|noindex|redirect|headings|links|images|crawlability|indexability/,google:/google|lighthouse|final url/,meta:/open graph|og:title|og:description|og:image|og:url/,pixel:/meta pixel|fbevents|fbq\s*\(|pageview|pixel init|consent \/ gdpr/,twitter:/twitter cards|twitter:card|twitter:title|twitter:description|twitter:image|x\/twitter|x-twitter/,performance:/core web vitals|lcp|inp|cls|fcp|ttfb|performance/,ux:/accessibility|mobile|ux/,security:/https|security|trust|legal/,conversion:/ads|conversion|cta|message match|benefit|ad destination/};return !!m[key]?.test(x)};
 const filterResults=()=>{const d=iframe.contentDocument,r=d?.querySelector("#result");if(!r||!selected.size)return;const keys=[...selected];[...r.querySelectorAll(".section")].forEach(sec=>{const h=(sec.querySelector("h2")?.textContent||"").trim();let show=keys.some(k=>classify(h,k));if(!show&&/techn/i.test(h))show=keys.some(k=>["seo","meta","pixel","twitter","security"].includes(k));if(!show&&/google/i.test(h))show=keys.includes("google");if(!show&&/core web/i.test(h))show=keys.includes("performance");if(!show&&/ads|conversion/i.test(h))show=keys.includes("conversion");sec.style.display=show?"":"none";if(show)[...sec.querySelectorAll(".card,.metric")].forEach(el=>{const keep=keys.some(k=>classify(el.textContent||"",k));el.style.display=keep?"":"none"})});const top=r.querySelector(".top");if(top)[...top.querySelectorAll(".card")].forEach(el=>{el.style.display=keys.some(k=>classify(el.textContent||"",k))?"":"none"})};
 const inject=()=>{try{const d=iframe.contentDocument;if(!d)return;let s=d.getElementById("fox-ui-overrides");if(!s){s=d.createElement("style");s.id="fox-ui-overrides";s.textContent='.page{background:#0b0c0f!important}.analyzer{background:#111318!important;border:1px solid #292d35!important}.tool{background:#15181e!important;color:#f5f5f5!important;border:1px solid #30343c!important}.fox-selection{margin:0 0 26px;padding:18px;border:1px solid #30343c;border-radius:18px;background:#0f1115}.fox-selection-title{font-size:13px;font-weight:900;margin-bottom:12px}.fox-selection-grid{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:9px}.fox-select{border:1px solid #30343c;background:#12151a;color:#fff;border-radius:14px;padding:13px 10px;text-align:left;cursor:pointer;min-height:78px;display:flex;flex-direction:column;gap:6px}.fox-select.active{border-color:#f36a0a;background:#25170e;box-shadow:inset 0 0 0 1px #f36a0a}.fox-select b{font-size:12px}.fox-select small{color:#818792;font-size:10px}.fox-select.active small{color:#ffad7b}.fox-selection-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:13px}.fox-selection-count{font-size:11px;color:#8f959e}.fox-run{border:0;border-radius:11px;padding:11px 17px;background:#f36a0a;color:#fff;font-weight:900;cursor:pointer}.fox-run:disabled{opacity:.35}@media(max-width:1050px){.fox-selection-grid{grid-template-columns:repeat(4,1fr)}}@media(max-width:650px){.fox-selection-grid{grid-template-columns:repeat(2,1fr)}.fox-selection-footer{flex-direction:column}.fox-run{width:100%}}';d.head.appendChild(s)}
 const tool=d.querySelector(".tool");if(!tool)return;let box=d.getElementById("fox-selection");if(!box){box=d.createElement("div");box.id="fox-selection";box.className="fox-selection";box.innerHTML=`<div class="fox-selection-title">${L.choose}</div><div class="fox-selection-grid"></div><div class="fox-selection-footer"><span class="fox-selection-count">0 / 2</span><button class="fox-run" type="button" disabled>${L.run}</button></div>`;tool.prepend(box)}
 const grid=box.querySelector(".fox-selection-grid");if(!grid.children.length)grid.innerHTML=cats.map(c=>`<button class="fox-select" type="button" data-key="${c[3]}"><b>${c[0]} ${c[1]}</b><small>${c[2]}</small></button>`).join("");
 const count=box.querySelector(".fox-selection-count"),run=box.querySelector(".fox-run");grid.querySelectorAll(".fox-select").forEach(b=>b.onclick=()=>{const k=b.dataset.key;if(selected.has(k)){selected.delete(k);b.classList.remove("active")}else{if(selected.size>=2){count.textContent=L.limit;return}selected.add(k);b.classList.add("active")}count.textContent=`${selected.size} / 2 ${L.selected}`;run.disabled=!selected.size});run.onclick=()=>{const form=d.querySelector("#form");if(form)form.requestSubmit()};const result=d.querySelector("#result");if(result){const observer=new MutationObserver(filterResults);observer.observe(result,{childList:true,subtree:true,attributes:true});setTimeout(filterResults,100)}
 }catch(e){}}
 iframe.addEventListener("load",inject);if(iframe.contentDocument?.readyState==="complete")inject();
 button?.addEventListener("click",()=>{const open=launcher.classList.toggle("is-open");button.setAttribute("aria-expanded",String(open));panel.hidden=!open;label.textContent=open?label.dataset.close:label.dataset.open;if(open)setTimeout(()=>launcher.scrollIntoView({behavior:"smooth",block:"start"}),80);else setTimeout(()=>launcher.querySelector(".fox-launcher-bar")?.scrollIntoView({behavior:"smooth",block:"center"}),40)});
}
</script>