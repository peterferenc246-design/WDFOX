---
interface Props { locale: string; }
const { locale } = Astro.props;
const copy = {
  sk: { title:'FOX P2P KOMUNIKÁTOR', intro:'Priame hlasové spojenie medzi počítačom alebo mobilom bez WhatsAppu.', create:'VYTVORIŤ SPOJENIE', call:'USKUTOČNIŤ HOVOR', calling:'VOLÁM…', accept:'PRIJATIE HOVORU', accepting:'PRIJÍMAM HOVOR…', incoming:'PRICHÁDZAJÚCI HOVOR – stlač PRIJATIE HOVORU', share:'Zdieľať pozvánku', copy:'Kopírovať odkaz', code:'Kód spojenia', waiting:'Čakám na druhé zariadenie…', connected:'Spojenie je aktívne.', start:'ZAPNÚŤ MIKROFÓN', stop:'VYPNÚŤ MIKROFÓN', invite:'Pošli odkaz alebo nech klient naskenuje QR kód na obrazovke počítača.', qr:'NASKENUJTE QR KÓD MOBILOM', error:'Spojenie sa nepodarilo vytvoriť.', needConnection:'Najprv vytvor spojenie.', ringing:'Klient žiada o hovor…', rejected:'Hovor bol odmietnutý.' },
  de: { title:'FOX P2P KOMMUNIKATOR', intro:'Direkte Sprachverbindung zwischen Computer oder Smartphone – ohne WhatsApp.', create:'VERBINDUNG ERSTELLEN', call:'ANRUF STARTEN', calling:'ANRUF…', accept:'ANRUF ANNEHMEN', accepting:'ANRUF WIRD ANGENOMMEN…', incoming:'EINGEHENDER ANRUF – Anruf annehmen', share:'Einladung teilen', copy:'Link kopieren', code:'Verbindungscode', waiting:'Warte auf das zweite Gerät…', connected:'Verbindung ist aktiv.', start:'MIKROFON EINSCHALTEN', stop:'MIKROFON AUSSCHALTEN', invite:'Link senden oder den QR-Code auf dem Computerbildschirm mit dem Smartphone scannen.', qr:'QR-CODE MIT DEM SMARTPHONE SCANNEN', error:'Verbindung konnte nicht hergestellt werden.', needConnection:'Bitte zuerst eine Verbindung erstellen.', ringing:'Der Kunde fordert einen Anruf an…', rejected:'Der Anruf wurde abgelehnt.' },
  en: { title:'FOX P2P COMMUNICATOR', intro:'Direct voice connection between computer or smartphone – without WhatsApp.', create:'CREATE CONNECTION', call:'MAKE A CALL', calling:'CALLING…', accept:'ACCEPT CALL', accepting:'ACCEPTING CALL…', incoming:'INCOMING CALL – press ACCEPT CALL', share:'Share invitation', copy:'Copy link', code:'Connection code', waiting:'Waiting for the second device…', connected:'Connection is active.', start:'TURN MICROPHONE ON', stop:'TURN MICROPHONE OFF', invite:'Send the link or let the client scan the QR code on the computer screen.', qr:'SCAN QR CODE WITH SMARTPHONE', error:'Connection could not be established.', needConnection:'Create a connection first.', ringing:'The client is requesting a call…', rejected:'The call was rejected.' }
};
const t = copy[locale as keyof typeof copy] || copy.en;
---
<section class="fox-p2p" data-p2p data-copy={JSON.stringify(t)}>
  <div class="p2p-shell">
    <p class="eyebrow">FOX TECHNOLOGY LAB</p>
    <h2>{t.title}</h2>
    <p class="intro">{t.intro}</p>
    <div class="p2p-status" data-status>{t.waiting}</div>
    <div class="p2p-layout">
      <div class="p2p-content">
        <div class="p2p-actions">
          <button class="primary" data-create>{t.create}</button>
          <button class="call" data-call disabled>{t.call}</button>
          <button class="secondary" data-share disabled>{t.share}</button>
          <button class="secondary" data-copy disabled>{t.copy}</button>
        </div>
        <div class="invite" data-invite hidden>
          <label>{t.code}</label>
          <input data-link readonly />
          <p>{t.invite}</p>
        </div>
        <button class="mic" data-mic disabled>{t.start}</button>
      </div>
      <aside class="qr-panel" data-qr-panel hidden>
        <div class="qr-box" data-qr></div>
        <p>{t.qr}</p>
      </aside>
    </div>
    <audio data-audio autoplay playsinline></audio>
  </div>
</section>
<style>
.fox-p2p{padding:0 0 42px}.p2p-shell{border:1px solid #ececec;border-radius:28px;background:#121a2a;color:#fff;padding:30px;box-shadow:0 22px 60px rgba(20,24,35,.12)}.p2p-shell h2{margin:5px 0 8px;font-size:clamp(24px,4vw,38px);letter-spacing:-.03em}.eyebrow{margin:0;color:#f36a0a;font-size:10px;font-weight:900;letter-spacing:.12em}.intro{margin:0;color:#b9c1ce;font-size:14px;line-height:1.6}.p2p-status{margin:20px 0;padding:13px 15px;border-radius:13px;background:#1d2635;color:#dce2ea;font-size:13px}.p2p-layout{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:24px;align-items:center}.p2p-actions{display:flex;gap:9px;flex-wrap:wrap}.p2p-actions button,.mic{border:0;border-radius:12px;padding:12px 15px;font-size:11px;font-weight:900;cursor:pointer}.primary{background:#f36a0a;color:#fff}.call{background:#18a957;color:#fff}.mic{background:#f36a0a;color:#fff}.secondary{background:#fff;color:#172033}.p2p-actions button:disabled,.mic:disabled{opacity:.4;cursor:default}.invite{margin-top:16px}.invite label{display:block;margin-bottom:7px;color:#b9c1ce;font-size:10px;font-weight:800;text-transform:uppercase}.invite input{width:100%;box-sizing:border-box;border:1px solid #344054;border-radius:11px;background:#0d1420;color:#fff;padding:12px;font-size:13px}.invite p{margin:8px 0 0;color:#98a2b3;font-size:11px}.mic{margin-top:16px}.qr-panel{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:16px;border-radius:18px;background:#fff;color:#172033}.qr-box{width:210px;height:210px;display:grid;place-items:center}.qr-box img,.qr-box canvas{display:block;max-width:100%;max-height:100%}.qr-panel p{margin:10px 0 0;text-align:center;font-size:10px;font-weight:900;letter-spacing:.05em}.fox-p2p audio{display:none}@media(max-width:760px){.p2p-layout{grid-template-columns:1fr}.qr-panel{max-width:260px;margin:0 auto}.p2p-actions{display:grid;grid-template-columns:1fr}.p2p-actions button{width:100%}.mic{width:100%}}@media(max-width:650px){.p2p-shell{padding:22px;border-radius:22px}}
</style>
<script define:vars={{ t }}>
const root=document.querySelector('[data-p2p]');
if(root){
  const text=JSON.parse(root.dataset.copy||'{}');
  const create=root.querySelector('[data-create]'); const callBtn=root.querySelector('[data-call]'); const share=root.querySelector('[data-share]'); const copyBtn=root.querySelector('[data-copy]'); const invite=root.querySelector('[data-invite]'); const link=root.querySelector('[data-link]'); const mic=root.querySelector('[data-mic]'); const status=root.querySelector('[data-status]'); const audio=root.querySelector('[data-audio]'); const qrPanel=root.querySelector('[data-qr-panel]'); const qr=root.querySelector('[data-qr]');
  let peer=null,mediaCall=null,dataConn=null,stream=null,roomUrl='',pendingConn=null,hostPeerId=null,role='host',ready=false;
  const remoteId=new URLSearchParams(location.search).get('foxPeer');
  const loadScript=(src,test)=>new Promise((resolve,reject)=>{if(test())return resolve();const s=document.createElement('script');s.src=src;s.onload=resolve;s.onerror=reject;document.head.appendChild(s);});
  const loadPeer=()=>loadScript('https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js',()=>!!window.Peer);
  const loadQr=()=>loadScript('https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js',()=>!!window.QRCode);
  const peerOptions={host:'0.peerjs.com',port:443,path:'/',secure:true,debug:1};
  const setStatus=msg=>{status.textContent=msg;};
  const setConnected=()=>{status.textContent=text.connected;mic.disabled=false;callBtn.disabled=true;callBtn.textContent=text.call;};
  const startLocalStream=async()=>{if(!stream)stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:true,noiseSuppression:true,autoGainControl:true}});stream.getAudioTracks().forEach(track=>track.enabled=true);mic.disabled=false;mic.textContent=text.stop;return stream;};
  const makeLink=id=>`${location.origin}${location.pathname}?foxPeer=${encodeURIComponent(id)}`;
  const renderQr=async()=>{await loadQr();qr.innerHTML='';new window.QRCode(qr,{text:roomUrl,width:210,height:210,colorDark:'#000000',colorLight:'#ffffff',correctLevel:window.QRCode.CorrectLevel.M});qrPanel.hidden=false;};
  const wireMediaCall=(mc,autoAnswer=false)=>{
    mediaCall=mc;
    mc.on('stream',remote=>{audio.srcObject=remote;audio.play().catch(()=>{});setConnected();});
    mc.on('close',()=>{mediaCall=null;callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.waiting);});
    mc.on('error',()=>{mediaCall=null;callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.error);});
    if(autoAnswer) mc.answer(stream||undefined);
  };
  const setupPeerEvents=()=>{
    peer.on('disconnected',()=>{setStatus('Signalizácia bola prerušená – obnovujem spojenie…');try{peer.reconnect();}catch{}});
    peer.on('error',e=>{setStatus(text.error+(e?.type?` (${e.type})`:''));});
  };
  const acceptIncoming=async()=>{
    if(!pendingConn)return;
    try{
      callBtn.disabled=true;callBtn.textContent=text.accepting;
      const s=await startLocalStream();
      const target=pendingConn.peer;
      try{pendingConn.send({type:'call-accepted'});}catch{}
      mediaCall=peer.call(target,s,{metadata:{app:'FOX P2P',version:'0.3.0'}});
      wireMediaCall(mediaCall,false);
      pendingConn=null;
    }catch(e){callBtn.disabled=false;callBtn.textContent=text.accept;setStatus(text.error);}
  };
  const rejectIncoming=()=>{if(pendingConn){try{pendingConn.send({type:'call-rejected'});pendingConn.close()}catch{}pendingConn=null;}callBtn.disabled=true;callBtn.textContent=text.call;setStatus(text.rejected);};
  const setupIncomingConnection=conn=>{
    pendingConn=conn;
    const activate=()=>{callBtn.disabled=false;callBtn.textContent=text.accept;setStatus(text.incoming);};
    conn.on('open',activate);
    conn.on('data',data=>{
      if(data?.type==='call-request')activate();
      if(data?.type==='call-cancel'){pendingConn=null;callBtn.disabled=true;callBtn.textContent=text.call;setStatus(text.waiting);}
    });
    conn.on('close',()=>{if(pendingConn===conn){pendingConn=null;callBtn.disabled=true;callBtn.textContent=text.call;setStatus(text.waiting);}});
    conn.on('error',()=>{if(pendingConn===conn){pendingConn=null;callBtn.disabled=true;callBtn.textContent=text.call;setStatus(text.error);}});
  };
  const requestCall=async()=>{
    if(!peer||!ready||!remoteId){setStatus(text.needConnection);return;}
    try{
      const s=await startLocalStream();
      callBtn.disabled=true;callBtn.textContent=text.calling;setStatus(text.calling);
      if(!dataConn||!dataConn.open){dataConn=peer.connect(remoteId,{label:'fox-call-control',reliable:true,metadata:{app:'FOX P2P',version:'0.3.0'}});}
      const sendRequest=()=>{try{dataConn.send({type:'call-request'});}catch{setStatus(text.error);callBtn.disabled=false;callBtn.textContent=text.call;}};
      if(dataConn.open)sendRequest();else dataConn.on('open',sendRequest);
      dataConn.on('data',data=>{
        if(data?.type==='call-accepted'){setStatus(text.calling);}
        if(data?.type==='call-rejected'){callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.rejected);}
      });
      dataConn.on('close',()=>{if(!mediaCall){callBtn.disabled=false;callBtn.textContent=text.call;}});
    }catch(e){callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.error);}
  };
  create.addEventListener('click',async()=>{
    try{
      await loadPeer(); role='host'; peer=new window.Peer(peerOptions); setupPeerEvents();
      peer.on('open',id=>{hostPeerId=id;ready=true;roomUrl=makeLink(id);link.value=roomUrl;invite.hidden=false;share.disabled=false;copyBtn.disabled=false;callBtn.disabled=true;setStatus(text.waiting);renderQr().catch(()=>{});});
      peer.on('connection',setupIncomingConnection);
      peer.on('call',incoming=>{if(stream)wireMediaCall(incoming,true);else{pendingConn={peer:incoming.peer,media:incoming};callBtn.disabled=false;callBtn.textContent=text.accept;setStatus(text.incoming);}});
      create.disabled=true;
    }catch(e){setStatus(text.error);}
  });
  callBtn.addEventListener('click',()=>{if(pendingConn && pendingConn.peer && !pendingConn.send)acceptIncoming();else requestCall();});
  copyBtn.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(roomUrl);setStatus(text.invite);}catch{link.select();document.execCommand('copy');}});
  share.addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title:text.title,url:roomUrl});}catch{}}else{try{await navigator.clipboard.writeText(roomUrl);setStatus(text.invite);}catch{link.select();document.execCommand('copy');}}});
  mic.addEventListener('click',()=>{if(stream){stream.getAudioTracks().forEach(x=>x.enabled=!x.enabled);mic.textContent=stream.getAudioTracks()[0].enabled?text.stop:text.start;}});
  if(remoteId){
    role='client';
    (async()=>{
      try{
        await loadPeer(); peer=new window.Peer(peerOptions); setupPeerEvents();
        peer.on('open',()=>{ready=true;callBtn.disabled=false;setStatus(text.waiting);});
        peer.on('call',incoming=>{try{wireMediaCall(incoming,true);}catch{setStatus(text.error);}});
        peer.on('connection',conn=>{dataConn=conn;conn.on('data',data=>{if(data?.type==='call-accepted')setStatus(text.calling);if(data?.type==='call-rejected'){callBtn.disabled=false;callBtn.textContent=text.call;setStatus(text.rejected);}});});
      }catch(e){setStatus(text.error);}
    })();
  }
}
</script>
