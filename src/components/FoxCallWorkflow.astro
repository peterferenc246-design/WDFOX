---
---
<div class="fox-call-workflow" data-fox-call-workflow hidden>
  <div class="fox-invite-card" role="dialog" aria-modal="true" aria-labelledby="fox-invite-title">
    <div class="fox-invite-icon">🔗</div>
    <strong id="fox-invite-title">FOX PRIVÁTNE SPOJENIE</strong>
    <p data-invite-message>Táto pozvánka je určená na spojenie s konkrétnym FOX komunikátorom.</p>
    <button type="button" data-invite-accept>✓ POTVRDIŤ POZVÁNKU</button>
    <small data-invite-status></small>
  </div>
</div>
<style>
.fox-call-workflow{position:fixed;inset:0;z-index:2147483641;display:grid;place-items:center;padding:20px;background:rgba(10,14,24,.62);backdrop-filter:blur(6px)}
.fox-call-workflow[hidden]{display:none!important}
.fox-invite-card{width:min(460px,100%);box-sizing:border-box;padding:30px;border-radius:24px;background:#fff;border:2px solid #f36a0a;box-shadow:0 26px 100px rgba(0,0,0,.38);text-align:center}
.fox-invite-icon{font-size:42px;margin-bottom:8px}.fox-invite-card strong{display:block;color:#172033;font-size:21px;font-weight:900}.fox-invite-card p{color:#667085;font-size:14px;line-height:1.55;margin:12px 0 22px}.fox-invite-card button{width:100%;border:0;border-radius:999px;background:#18a957;color:#fff;padding:16px 20px;font-size:14px;font-weight:900;cursor:pointer}.fox-invite-card button:disabled{opacity:.5;cursor:default}.fox-invite-card small{display:block;margin-top:12px;color:#667085;font-size:12px}
</style>
<script is:inline>
(() => {
  const root=document.querySelector('[data-fox-call-workflow]');
  if(!root)return;
  const qs=new URLSearchParams(location.search), targetId=qs.get('foxPeer');
  const callBtn=()=>document.querySelector('[data-call]');
  const callLabel=()=>document.querySelector('[data-call-label]');
  const remoteAudio=()=>document.querySelector('[data-remote-audio]');
  const record=()=>document.querySelector('[data-record]');
  const inviteAccept=root.querySelector('[data-invite-accept]');
  const inviteStatus=root.querySelector('[data-invite-status]');
  const inviteMessage=root.querySelector('[data-invite-message]');
  const isDe=document.documentElement.lang?.toLowerCase().startsWith('de')||location.pathname.includes('/de/');
  if(!targetId){
    root.remove();
    return;
  }
  inviteMessage.textContent=isDe?'Diese Einladung verbindet Sie mit dem vorgesehenen FOX-Kommunikator.':'Táto pozvánka vás pripojí ku konkrétnemu FOX komunikátoru.';
  inviteAccept.textContent=isDe?'✓ EINLADUNG BESTÄTIGEN':'✓ POTVRDIŤ POZVÁNKU';
  const setStatus=v=>{inviteStatus.textContent=v};
  const loadPeer=()=>new Promise((resolve,reject)=>{
    if(window.Peer)return resolve();
    const s=document.createElement('script');s.src='https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js';s.onload=resolve;s.onerror=reject;document.head.appendChild(s);
  });
  let peer=null,conn=null,confirmed=false,outgoing=false;
  const stopPrematureRecognition=()=>{
    if(!outgoing)return;
    const r=record();
    if(r?.classList.contains('recording'))r.click();
  };
  const waitForMedia=()=>{
    let tries=0;
    const timer=setInterval(()=>{
      tries++;
      const a=remoteAudio(),r=record();
      if(a?.srcObject){
        clearInterval(timer);outgoing=false;
        if(r&&!r.classList.contains('recording'))r.click();
        return;
      }
      stopPrematureRecognition();
      if(tries>300){clearInterval(timer);outgoing=false;setStatus(isDe?'Keine Antwort auf den Anruf.':'Hovor zatiaľ nebol prijatý.');}
    },100);
  };
  const confirmInvite=async()=>{
    if(confirmed)return;
    confirmed=true;inviteAccept.disabled=true;setStatus(isDe?'Verbinde mit dem FOX-Server…':'Pripájam sa na FOX server…');
    try{
      await loadPeer();
      peer=new Peer(undefined,{config:{iceServers:[{urls:'stun:stun.l.google.com:19302'}]}});
      await new Promise((resolve,reject)=>{const tm=setTimeout(()=>reject(Error('PeerJS timeout')),20000);peer.once('open',()=>{clearTimeout(tm);resolve()});peer.once('error',reject)});
      conn=peer.connect(targetId,{reliable:true,label:'fox-invite'});
      await new Promise((resolve,reject)=>{const tm=setTimeout(()=>reject(Error('connection timeout')),15000);conn.once('open',()=>{clearTimeout(tm);resolve()});conn.once('error',reject)});
      conn.send({type:'invite-accepted',at:Date.now()});
      root.hidden=true;
      setStatus(isDe?'Direkt mit dem FOX-Kommunikator verbunden.':'Priamo pripojené k FOX komunikátoru.');
      const btn=callBtn();
      if(btn){btn.disabled=false;btn.dataset.foxInviteReady='1';}
    }catch(e){confirmed=false;inviteAccept.disabled=false;setStatus('❌ '+(e?.message||'Spojenie sa nepodarilo.'))}
  };
  inviteAccept.addEventListener('click',confirmInvite);
  document.addEventListener('click',e=>{
    const btn=e.target?.closest?.('[data-call]');
    if(!btn||btn.disabled)return;
    const label=(callLabel()?.textContent||'').toLowerCase();
    if(/accept|anruf annehmen|prijat/.test(label))return;
    outgoing=true;
    setTimeout(stopPrematureRecognition,50);
    waitForMedia();
  },true);
  if(targetId){
    root.hidden=false;
    setStatus(isDe?'Noch nicht verbunden – bestätigen Sie die Einladung.':'Zatiaľ nie ste pripojený – potvrďte pozvánku.');
  }
})();
</script>
