---
interface Props { locale: string }
const { locale } = Astro.props;
const copy = {
  sk:{title:'DOSTUPNOSŤ PRE HOVORY',pc:'KANCELÁRIA PC',mobile:'MOBIL',online:'ONLINE',offline:'OFFLINE',owner:'REŽIM VLASTNÍKA',prompt:'Zadajte FOX owner key',toggle:'PREPNÚŤ'},
  de:{title:'ERREICHBARKEIT FÜR ANRUFE',pc:'BÜRO-PC',mobile:'MOBIL',online:'ONLINE',offline:'OFFLINE',owner:'INHABER-MODUS',prompt:'FOX Owner Key eingeben',toggle:'UMSCHALTEN'},
  en:{title:'CALL AVAILABILITY',pc:'OFFICE PC',mobile:'MOBILE',online:'ONLINE',offline:'OFFLINE',owner:'OWNER MODE',prompt:'Enter FOX owner key',toggle:'TOGGLE'},
  fr:{title:'DISPONIBILITÉ DES APPELS',pc:'PC BUREAU',mobile:'MOBILE',online:'EN LIGNE',offline:'HORS LIGNE',owner:'MODE PROPRIÉTAIRE',prompt:'Entrez la clé FOX owner',toggle:'BASCULER'},
  it:{title:'DISPONIBILITÀ CHIAMATE',pc:'PC UFFICIO',mobile:'CELLULARE',online:'ONLINE',offline:'OFFLINE',owner:'MODALITÀ PROPRIETARIO',prompt:'Inserisci FOX owner key',toggle:'CAMBIA'},
  pl:{title:'DOSTĘPNOŚĆ POŁĄCZEŃ',pc:'PC BIURO',mobile:'TELEFON',online:'ONLINE',offline:'OFFLINE',owner:'TRYB WŁAŚCICIELA',prompt:'Wpisz FOX owner key',toggle:'PRZEŁĄCZ'},
  es:{title:'DISPONIBILIDAD DE LLAMADAS',pc:'PC OFICINA',mobile:'MÓVIL',online:'ONLINE',offline:'OFFLINE',owner:'MODO PROPIETARIO',prompt:'Introduce FOX owner key',toggle:'CAMBIAR'},
  sv:{title:'SAMTALSTILLGÄNGLIGHET',pc:'KONTORS-PC',mobile:'MOBIL',online:'ONLINE',offline:'OFFLINE',owner:'ÄGARLÄGE',prompt:'Ange FOX owner key',toggle:'VÄXLA'},
  hr:{title:'DOSTUPNOST ZA POZIVE',pc:'URED PC',mobile:'MOBITEL',online:'ONLINE',offline:'OFFLINE',owner:'VLASNIČKI NAČIN',prompt:'Unesite FOX owner key',toggle:'PREBACI'}
} as const;
const t = copy[locale as keyof typeof copy] || copy.en;
---
<section class="fox-availability" data-availability data-copy={JSON.stringify(t)}>
  <div class="availability-head">
    <span>{t.title}</span>
    <small data-owner-badge hidden>🔒 {t.owner}</small>
  </div>

  <div class="availability-grid" data-public-grid>
    <div class="availability-card" data-public-device="pc">
      <span class="device">🖥️ {t.pc}</span>
      <span class="state"><i></i><b>{t.offline}</b></span>
    </div>
    <div class="availability-card" data-public-device="mobile">
      <span class="device">📱 {t.mobile}</span>
      <span class="state"><i></i><b>{t.offline}</b></span>
    </div>
  </div>

  <div class="availability-grid" data-owner-grid hidden>
    <button type="button" class="availability-btn" data-device="pc" aria-pressed="false">
      <span class="device">🖥️ {t.pc}</span>
      <span class="state"><i></i><b>{t.offline}</b></span>
      <span class="toggle-label">{t.toggle}</span>
    </button>
    <button type="button" class="availability-btn" data-device="mobile" aria-pressed="false">
      <span class="device">📱 {t.mobile}</span>
      <span class="state"><i></i><b>{t.offline}</b></span>
      <span class="toggle-label">{t.toggle}</span>
    </button>
  </div>
</section>
<style>
.fox-availability{margin:16px auto 4px;max-width:1180px;padding:0 24px}.availability-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:9px;color:#697386;font-size:10px;font-weight:900;letter-spacing:.09em}.availability-head small{color:#f36a0a;font-size:10px}.availability-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.availability-card,.availability-btn{border:1px solid #e8e8e8;border-radius:16px;background:#fff;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;gap:10px;color:#172033;box-shadow:0 7px 24px rgba(20,24,35,.05)}.availability-btn{appearance:none;width:100%;font:inherit;cursor:pointer;transition:border-color .18s ease,transform .18s ease,background .18s ease}.availability-btn:hover{border-color:#f36a0a;transform:translateY(-1px)}.availability-btn:focus-visible{outline:3px solid rgba(243,106,10,.25);outline-offset:2px}.device{font-size:12px;font-weight:900}.state{display:inline-flex;align-items:center;gap:7px;font-size:11px;margin-left:auto}.state i{width:9px;height:9px;border-radius:999px;background:#c8cdd5;box-shadow:0 0 0 4px rgba(200,205,213,.18)}.availability-card.is-online,.availability-btn.is-online{border-color:#bee8cf;background:#f7fff9}.availability-card.is-online .state i,.availability-btn.is-online .state i{background:#18a957;box-shadow:0 0 0 4px rgba(24,169,87,.14)}.availability-card.is-online .state b,.availability-btn.is-online .state b{color:#118347}.toggle-label{margin-left:8px;border-left:1px solid #ececec;padding-left:10px;color:#f36a0a;font-size:10px;font-weight:900;letter-spacing:.04em}.availability-btn.is-loading{opacity:.55;pointer-events:none}@media(max-width:650px){.fox-availability{padding:0 18px}.availability-grid{grid-template-columns:1fr}.availability-card,.availability-btn{padding:14px}.toggle-label{margin-left:4px}}
</style>
<script>
(() => {
  const root = document.querySelector('[data-availability]');
  if (!root || root.__foxAvailability) return;
  root.__foxAvailability = true;

  const API = 'https://wdfox.vercel.app/api/availability';
  const copy = JSON.parse(root.dataset.copy || '{}');
  const publicGrid = root.querySelector('[data-public-grid]');
  const ownerGrid = root.querySelector('[data-owner-grid]');
  const publicCards = [...root.querySelectorAll('[data-public-device]')];
  const buttons = [...root.querySelectorAll('[data-device]')];
  const ownerBadge = root.querySelector('[data-owner-badge]');
  let ownerKey = localStorage.getItem('foxOwnerKey') || '';
  let ownerAuthenticated = false;
  let state = {pc:false,mobile:false};

  const setOwnerUi = (authenticated) => {
    ownerAuthenticated = Boolean(authenticated);
    if (ownerBadge) ownerBadge.hidden = !ownerAuthenticated;
    if (publicGrid) publicGrid.hidden = ownerAuthenticated;
    if (ownerGrid) ownerGrid.hidden = !ownerAuthenticated;
  };

  const updateNode = (node, online) => {
    node.classList.toggle('is-online', online);
    const label = node.querySelector('b');
    if (label) label.textContent = online ? copy.online : copy.offline;
    if ('setAttribute' in node) node.setAttribute('aria-pressed', String(online));
  };

  const render = (next) => {
    state = {...state,...next};
    for (const card of publicCards) {
      const device = card.dataset.publicDevice;
      updateNode(card, Boolean(state[device]));
    }
    for (const btn of buttons) {
      const device = btn.dataset.device;
      updateNode(btn, Boolean(state[device]));
    }
  };

  const load = async () => {
    try {
      const r = await fetch(API,{cache:'no-store'});
      if (!r.ok) throw new Error('HTTP '+r.status);
      const d = await r.json();
      render({pc:d.pc,mobile:d.mobile});
    } catch (e) {
      console.warn('availability read failed', e);
    }
  };

  const authenticate = async ({promptIfMissing=true}={}) => {
    if (ownerAuthenticated && ownerKey) return true;
    if (!ownerKey && promptIfMissing) ownerKey = String(prompt(copy.prompt || 'FOX owner key') || '').trim();
    if (!ownerKey) return false;

    try {
      const r = await fetch(API,{
        method:'POST',
        headers:{'Content-Type':'application/json','Authorization':'Bearer '+ownerKey},
        body:JSON.stringify({action:'auth'}),
        cache:'no-store'
      });
      if (!r.ok) {
        ownerKey='';
        setOwnerUi(false);
        localStorage.removeItem('foxOwnerKey');
        if (promptIfMissing) alert('FOX owner key: ACCESS DENIED');
        return false;
      }
      localStorage.setItem('foxOwnerKey', ownerKey);
      setOwnerUi(true);
      return true;
    } catch (e) {
      console.error('availability auth failed', e);
      return false;
    }
  };

  const toggle = async (btn) => {
    if (!(await authenticate({promptIfMissing:true}))) return;
    const device = btn.dataset.device;
    btn.classList.add('is-loading');
    try {
      const r = await fetch(API,{
        method:'POST',
        headers:{'Content-Type':'application/json','Authorization':'Bearer '+ownerKey},
        body:JSON.stringify({device}),
        cache:'no-store'
      });
      const d = await r.json().catch(()=>({}));
      if (!r.ok) {
        if (r.status === 401) {
          ownerKey='';
          setOwnerUi(false);
          localStorage.removeItem('foxOwnerKey');
        }
        throw new Error(d.error || 'HTTP '+r.status);
      }
      render({pc:d.pc,mobile:d.mobile});
      window.dispatchEvent(new CustomEvent('fox:availability',{detail:d}));
    } catch (e) {
      console.error('availability update failed', e);
    } finally {
      btn.classList.remove('is-loading');
    }
  };

  buttons.forEach(btn => btn.addEventListener('click', () => toggle(btn)));
  setOwnerUi(false);

  const ownerUnlockRequested = location.hash === '#foxOwner';
  if (ownerUnlockRequested) {
    history.replaceState({}, '', location.pathname + location.search);
    void authenticate({promptIfMissing:true});
  } else if (ownerKey) {
    void authenticate({promptIfMissing:false});
  }

  load();
  setInterval(load, 10000);
})();
</script>
