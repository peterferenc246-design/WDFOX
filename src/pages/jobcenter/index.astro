---
import fs from 'node:fs';
import path from 'node:path';

const sourcePath = path.join(process.cwd(), 'public', 'jobcenter-source.html');
let html = fs.readFileSync(sourcePath, 'utf8');

html = html.replace(
  '<head>',
  '<head><meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate"><meta http-equiv="Pragma" content="no-cache"><meta http-equiv="Expires" content="0"><meta name="wdfox-jobcenter-version" content="2026-10-02-2110">'
);

html = html.replace(
  '</style>',
  `.outlook-card{display:block;padding:14px 16px;margin:12px 0;border:1px solid #d0d0d0;border-radius:10px;color:#111;background:#fafafa}.outlook-card-title{font-weight:700;margin-bottom:6px}.outlook-card-note{margin-bottom:12px}.outlook-actions{display:flex;gap:12px;flex-wrap:wrap}.outlook-action{display:inline-flex;align-items:center;justify-content:center;padding:10px 16px;border-radius:8px;border:1px solid #cfcfcf;background:#fff;color:#111;text-decoration:none;font-weight:700;box-shadow:0 1px 3px rgba(0,0,0,.06);cursor:pointer}.outlook-action:hover{background:#f0f0f0}.outlook-view{display:none;margin-top:14px;background:#fff;border:1px solid #d9d9d9;border-radius:10px;overflow:hidden}.outlook-view.is-open{display:block}.outlook-view-head{padding:16px;border-bottom:1px solid #e4e4e4;background:#f5f7fa}.outlook-view-subject{font-weight:700;font-size:1.08rem;margin-bottom:8px}.outlook-view-meta{font-size:.92rem;color:#555;line-height:1.5}.outlook-view-body{padding:18px;line-height:1.6;white-space:pre-wrap}.outlook-attachments{padding:0 18px 18px}.outlook-attachment{display:flex;gap:8px;align-items:center;margin-top:8px}.outlook-attachment a{font-weight:700}.outlook-error{padding:16px;color:#8a1c1c}</style>`
);

const portalOutageBlock = `
<section class="attachment evidence-section" id="portal-ausfall-2026-10-02">
  <hr class="evidence-divider">
  <p class="update-date">Aktualisiert am: 02.10.2026</p>
  <h2>Nachweis der Nichtverfügbarkeit des „ONLINE“-Portals</h2>
  <p>Am 02.10.2026 war das Online-Portal der Bundesagentur für Arbeit beziehungsweise des Jobcenters erneut nicht erreichbar. Dadurch war es mir nicht möglich, die vorgesehenen Online-Dienste zuverlässig zu nutzen.</p>
  <p>Besonders problematisch ist, dass damit zugleich auch der Zugang zu der vorgesehenen Online-Unterstützung beziehungsweise zur Kontaktaufnahme mit dem Portal-Support beeinträchtigt war. Ein funktionsfähiger alternativer Kommunikationsweg wurde mir trotz der bestehenden technischen Störung nicht zur Verfügung gestellt.</p>
  <p class="emph">Damit war aus meiner Sicht eine rechtzeitige elektronische Kommunikation mit dem Jobcenter erneut erheblich erschwert. Dies ist besonders kritisch, weil das Jobcenter diesen Kommunikationsweg selbst als „ONLINE“-Service bezeichnet und gleichzeitig Fristen sowie Mitwirkungspflichten an die Nutzung dieses Systems knüpft.</p>
  <img src="https://raw.githubusercontent.com/peterferenc246-design/WDFOX/main/privat/Diese%20Website%20ist%20nicht%20erreichbar.png" alt="Nachweis der Nichtverfügbarkeit des Online-Portals der Bundesagentur für Arbeit / des Jobcenters am 2. Oktober 2026">
  <p class="caption">Dokumentierter Nachweis vom 02.10.2026: Das Anmelde- beziehungsweise Online-Portal war nicht erreichbar; eine Verbindung über den vorgesehenen Online-Weg war nicht möglich.</p>
</section>`;

const outlookMsgUrl = 'https://raw.githubusercontent.com/peterferenc246-design/WDFOX/main/privat/JC-10.00%20Tr.%20Ihre%20Mahnung%20vom%2025.09.2026.msg';

const originalOutlookCard = `<div class="outlook-card">
  <div class="outlook-card-title">✉️ Original-Outlook-Nachricht (.msg) – JC-10.00 Tr. Ihre Mahnung vom 25.09.2026</div>
  <div class="outlook-card-note">Die Originalnachricht wird direkt im Browser aus der .msg-Datei gelesen.</div>
  <div class="outlook-actions">
    <button class="outlook-action" type="button" id="wdfox-msg-open">✉️ Nachricht im Browser anzeigen</button>
  </div>
  <div class="outlook-view" id="wdfox-msg-view" aria-live="polite">
    <div class="outlook-view-head">
      <div class="outlook-view-subject" id="wdfox-msg-subject">Nachricht wird geladen …</div>
      <div class="outlook-view-meta" id="wdfox-msg-meta"></div>
    </div>
    <div class="outlook-view-body" id="wdfox-msg-body"></div>
    <div class="outlook-attachments" id="wdfox-msg-attachments"></div>
  </div>
</div>`;

const msgViewerScript = `<script type="module">
const openButton = document.getElementById('wdfox-msg-open');
const view = document.getElementById('wdfox-msg-view');
const subjectEl = document.getElementById('wdfox-msg-subject');
const metaEl = document.getElementById('wdfox-msg-meta');
const bodyEl = document.getElementById('wdfox-msg-body');
const attachmentsEl = document.getElementById('wdfox-msg-attachments');
const msgUrl = ${JSON.stringify(outlookMsgUrl)};
let loaded = false;

const hiddenNames = ['andrej ferenc','tomáš zdechovsky','tomas zdechovsky','freund daniel','daniel freund'];
const hiddenEmails = ['ferencandrej97@gmail.com','tomas.zdechovsky@europarl.europa.eu','daniel.freund@europarl.europa.eu'];

function esc(value='') {
  return String(value).replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));
}
function norm(value='') { return String(value).trim().toLowerCase(); }
function isHidden(name='', email='') {
  return hiddenNames.includes(norm(name)) || hiddenEmails.includes(norm(email));
}
function formatPerson(name, email) {
  if (name && email) return name + ' <' + email + '>';
  return name || email || '';
}
function splitHeaderAddresses(value='') {
  return String(value).split(/,(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)/).map(v => v.trim()).filter(Boolean);
}
function parseHeaderPerson(value='') {
  const m = String(value).match(/^\s*\"?([^\"<]*)\"?\s*<([^>]+)>\s*$/);
  if (m) return { name: m[1].trim(), email: m[2].trim() };
  const plain = String(value).trim();
  return plain.includes('@') ? { name: '', email: plain } : { name: plain, email: '' };
}
function getHeaderValues(headers='', key='') {
  const unfolded = String(headers).replace(/\r?\n[\t ]+/g, ' ');
  const re = new RegExp('^' + key + ':\\s*(.+)$', 'gmi');
  const out = [];
  let m;
  while ((m = re.exec(unfolded))) out.push(m[1]);
  return out;
}

openButton?.addEventListener('click', async () => {
  view?.classList.toggle('is-open');
  if (loaded || !view?.classList.contains('is-open')) return;
  try {
    openButton.disabled = true;
    openButton.textContent = '⏳ Nachricht wird geladen …';
    const [{ default: MsgReader }, response] = await Promise.all([
      import('https://esm.sh/@kenjiuno/msgreader@1.28.0'),
      fetch(msgUrl, { cache: 'no-store' })
    ]);
    if (!response.ok) throw new Error('MSG-Datei konnte nicht geladen werden (' + response.status + ')');
    const buffer = await response.arrayBuffer();
    const reader = new MsgReader(buffer);
    const data = reader.getFileData();
    subjectEl.textContent = data.subject || 'Ohne Betreff';

    const sender = formatPerson(data.senderName || 'Peter Ferenc', data.senderEmail);
    const buckets = { to: [], cc: [], bcc: [], other: [] };
    const seen = new Set();
    const addRecipient = (type, name, email) => {
      if (isHidden(name, email)) return;
      const text = formatPerson(name, email);
      if (!text) return;
      const key = norm(text);
      if (seen.has(key)) return;
      seen.add(key);
      const t = norm(type);
      if (t === 'to') buckets.to.push(text);
      else if (t === 'cc') buckets.cc.push(text);
      else if (t === 'bcc') buckets.bcc.push(text);
      else buckets.other.push(text);
    };

    (data.recipients || []).forEach(r => addRecipient(r.recipType || r.recipientType || r.type, r.name || r.displayName || '', r.email || r.emailAddress || ''));

    const headers = data.headers || data.transportMessageHeaders || '';
    [['To','to'],['Cc','cc'],['Bcc','bcc']].forEach(([headerName,type]) => {
      getHeaderValues(headers, headerName).forEach(value => {
        splitHeaderAddresses(value).forEach(raw => {
          const p = parseHeaderPerson(raw);
          addRecipient(type, p.name, p.email);
        });
      });
    });

    let meta = '<strong>Von:</strong> ' + esc(sender || '—');
    if (buckets.to.length) meta += '<br><strong>An:</strong> ' + esc(buckets.to.join(', '));
    if (buckets.cc.length) meta += '<br><strong>CC:</strong> ' + esc(buckets.cc.join(', '));
    if (buckets.bcc.length) meta += '<br><strong>BCC:</strong> ' + esc(buckets.bcc.join(', '));
    if (buckets.other.length) meta += '<br><strong>Empfänger:</strong> ' + esc(buckets.other.join(', '));
    if (data.clientSubmitTime) meta += '<br><strong>Gesendet:</strong> ' + esc(new Date(data.clientSubmitTime).toLocaleString('de-DE'));
    metaEl.innerHTML = meta;

    bodyEl.textContent = data.body || data.bodyHtml || 'Kein Nachrichtentext vorhanden.';
    attachmentsEl.innerHTML = '';
    const attachments = data.attachments || [];
    if (attachments.length) {
      const title = document.createElement('strong');
      title.textContent = 'Anhänge';
      attachmentsEl.appendChild(title);
      attachments.forEach((att, index) => {
        const row = document.createElement('div');
        row.className = 'outlook-attachment';
        const link = document.createElement('a');
        link.href = '#';
        link.textContent = '📎 ' + (att.fileName || ('Anlage ' + (index + 1)));
        link.addEventListener('click', e => {
          e.preventDefault();
          const extracted = reader.getAttachment(att);
          const bytes = extracted.content instanceof Uint8Array ? extracted.content : new Uint8Array(extracted.content);
          const blob = new Blob([bytes], { type: 'application/octet-stream' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = att.fileName || ('Anlage-' + (index + 1));
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 1000);
        });
        row.appendChild(link);
        attachmentsEl.appendChild(row);
      });
    }
    loaded = true;
    openButton.textContent = '✉️ Nachricht im Browser anzeigen / schließen';
  } catch (error) {
    subjectEl.textContent = 'Nachricht konnte nicht angezeigt werden';
    bodyEl.innerHTML = '<div class="outlook-error">' + esc(error?.message || error) + '</div>';
    openButton.textContent = '✉️ Erneut versuchen';
  } finally {
    openButton.disabled = false;
  }
});
</script>`;

const evidenceHeading = '<h2>Dokumente des Jobcenters / Nachweise</h2>';
const existingCard = /<div class="outlook-card">[\s\S]*?<\/div>\s*<\/div>/;
const plainLink = /<a class="pdf-link" href="https:\/\/raw\.githubusercontent\.com\/peterferenc246-design\/WDFOX\/main\/privat\/JC-10\.00%20Tr\.%20Ihre%20Mahnung%20vom%2025\.09\.2026\.msg"[\s\S]*?<\/a>/;

if (existingCard.test(html)) {
  html = html.replace(existingCard, originalOutlookCard);
} else if (plainLink.test(html)) {
  html = html.replace(plainLink, originalOutlookCard);
} else if (!html.includes('wdfox-msg-open')) {
  html = html.replace(evidenceHeading, `${evidenceHeading}${originalOutlookCard}`);
}

if (!html.includes('id="portal-ausfall-2026-10-02"')) {
  html = html.replace('</body>', `${portalOutageBlock}\n</body>`);
}

html = html.replace('</body>', `${msgViewerScript}\n<!-- WDFOX JOBCENTER FORCE-ROUTE 2026-10-02-2110 --></body>`);
---
<Fragment set:html={html} />
