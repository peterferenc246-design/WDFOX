---
import fs from 'node:fs';
import path from 'node:path';

const sourcePath = path.join(process.cwd(), 'public', 'jobcenter', 'index.html');
let html = fs.readFileSync(sourcePath, 'utf8');

html = html.replace(
  '<head>',
  '<head><meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate"><meta http-equiv="Pragma" content="no-cache"><meta http-equiv="Expires" content="0"><meta name="wdfox-jobcenter-version" content="2026-10-02-1125">'
);

html = html.replace(
  '</body>',
  '<!-- WDFOX JOBCENTER FORCE-ROUTE 2026-10-02-1125 --></body>'
);
---
<Fragment set:html={html} />
