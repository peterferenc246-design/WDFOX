<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FOX Web Analyzer | WebDizainFOX</title>
    <meta name="description" content="FOX Web Analyzer – rýchly audit webstránky, SEO, obsahu, CTA, dôveryhodnosti a UX." />
    <style>
      :root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#171717;background:#f7f7f5}
      *{box-sizing:border-box}body{margin:0}.page{min-height:100vh;padding:40px 20px}.wrap{max-width:1180px;margin:0 auto}.back{display:inline-block;margin:0 0 22px;color:#171717;text-decoration:none;font-weight:800}.analyzer{display:grid;grid-template-columns:1fr 1.08fr;gap:44px;align-items:center;background:#171717;color:#fff;border-radius:34px;padding:54px;overflow:hidden;position:relative}.analyzer:before{content:"";position:absolute;width:420px;height:420px;right:-180px;top:-220px;border-radius:50%;background:rgba(243,106,10,.16);filter:blur(4px)}.copy,.card{position:relative;z-index:1}.eyebrow{display:flex;align-items:center;gap:8px;color:#ff7a22;font-size:13px;font-weight:900;letter-spacing:.08em}.copy h1{font-size:clamp(32px,4vw,54px);line-height:1.03;margin:14px 0}.copy h1 em{color:#f36a0a;font-style:normal}.copy>p{color:#cfcfcf;max-width:560px;font-size:17px;line-height:1.65}.points{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:26px}.points span{color:#eee;font-size:14px}.points b{color:#f36a0a;margin-right:7px}.card{background:#fff;color:#171717;border-radius:24px;padding:28px;box-shadow:0 24px 70px rgba(0,0,0,.25)}label{display:block;font-weight:800;margin-bottom:9px}.row{display:flex;gap:10px}.input{display:flex;align-items:center;gap:9px;flex:1;border:1px solid #ddd;border-radius:14px;padding:0 14px;background:#fafafa}.input span{color:#f36a0a}.input input{width:100%;border:0;outline:0;background:transparent;padding:16px 0;font-size:15px;min-width:0}.button{border:0;border-radius:12px;padding:0 18px;font-weight:800;cursor:pointer;white-space:nowrap}.button-primary{background:#f36a0a;color:#fff}.button:disabled{opacity:.6;cursor:wait}small.help{display:block;color:#777;margin-top:10px;font-size:12px}.error{margin-top:18px;background:#fff1eb;color:#b33b08;border-radius:12px;padding:12px 14px;font-size:14px}.result{margin-top:24px;border-top:1px solid #eee;padding-top:22px}.score{display:flex;align-items:center;justify-content:space-between;background:#fff7f2;border-radius:16px;padding:14px 18px;margin-bottom:14px}.score-label{font-size:11px;font-weight:900;letter-spacing:.12em;color:#777}.score-value{display:block;font-size:34px;color:#f36a0a;line-height:1;margin-top:5px}.score-value small{font-size:13px;color:#777}.categories{display:grid;grid-template-columns:repeat(5,1fr);gap:7px;margin-bottom:14px}.category{border:1px solid #eee;border-radius:12px;padding:10px;text-align:center;background:#fff}.category strong{display:block;font-size:19px;color:#f36a0a}.category span{display:block;font-size:10px;font-weight:800;margin-top:3px}.category small{display:block;font-size:9px;color:#888;margin-top:3px;line-height:1.2}.grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.item{border:1px solid #eee;border-radius:12px;padding:11px}.item strong{display:block;font-size:13px}.item span{display:block;font-size:11px;color:#777;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ok{color:#16803a}.bad{color:#b33b08}.recommendations{margin-top:14px;border-radius:14px;background:#f7f7f7;padding:14px;font-size:13px}.recommendations ul{margin:8px 0 0;padding-left:18px;color:#555;line-height:1.6}.foot{display:flex;gap:8px;align-items:center;margin-top:12px;color:#777;font-size:11px}.spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.45);border-top-color:#fff;border-radius:50%;vertical-align:-2px;margin-right:7px;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:850px){.analyzer{grid-template-columns:1fr;padding:34px 24px;gap:28px}.row{flex-direction:column}.button{height:48px}.points{grid-template-columns:1fr}.categories{grid-template-columns:repeat(3,1fr)}}@media(max-width:520px){.page{padding:24px 12px}.card{padding:20px}.analyzer{border-radius:24px}.grid{grid-template-columns:1fr}.categories{grid-template-columns:repeat(2,1fr)}}
    </style>
  </head>
  <body>
    <main class="page">
      <div class="wrap">
        <a class="back" href="/">← WebDizainFOX</a>
        <section class="analyzer" aria-labelledby="fox-title">
          <div class="copy">
            <div class="eyebrow">✦ FOX LANDING PAGE AUDIT</div>
            <h1 id="fox-title">Je tvoja stránka pripravená<br><em>meniť návštevy na klientov?</em></h1>
            <p>Zadaj URL a získaj rýchly audit SEO, konverzie, obsahu, dôvery a UX. Vlastné FOX hodnotenie bez registrácie.</p>
            <div class="points"><span><b>✓</b>SEO a štruktúra</span><span><b>✓</b>Konverzia a CTA</span><span><b>✓</b>Obsah a benefity</span><span><b>✓</b>Dôvera a UX</span></div>
          </div>
          <div class="card">
            <form id="fox-form">
              <label for="fox-url">URL webstránky</label>
              <div class="row">
                <div class="input"><span>🌐</span><input id="fox-url" type="url" required placeholder="https://tvoja-stranka.sk" /></div>
                <button id="fox-submit" class="button button-primary" type="submit">Spustiť audit →</button>
              </div>
              <small class="help">Analyzujeme verejne dostupný obsah zadanej stránky.</small>
            </form>
            <div id="fox-error" class="error" hidden></div>
            <div id="fox-result" class="result" hidden></div>
            <div class="foot">🔒 Analýza používa iba verejne dostupný obsah.</div>
          </div>
        </section>
      </div>
    </main>
    <script is:inline>
      const form=document.getElementById("fox-form"), input=document.getElementById("fox-url"), button=document.getElementById("fox-submit"), errorBox=document.getElementById("fox-error"), resultBox=document.getElementById("fox-result");
      const esc=(v)=>String(v??"").replace(/[&<>"']/g,(c)=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
      const metric=(label,score,note)=>`<div class="category"><strong>${score}</strong><span>${label}</span><small>${note}</small></div>`;
      const item=(label,ok,detail="")=>`<div class="item"><strong class="${ok?"ok":"bad"}">${ok?"✓":"!"} ${label}</strong><span>${esc(detail)}</span></div>`;
      form.addEventListener("submit",async(e)=>{
        e.preventDefault(); errorBox.hidden=true; resultBox.hidden=true; button.disabled=true; button.innerHTML='<span class="spinner"></span>Analyzujem…';
        try{
          const target=/^https?:\/\//i.test(input.value.trim())?input.value.trim():`https://${input.value.trim()}`; const parsed=new URL(target); if(!/^https?:$/.test(parsed.protocol)) throw new Error("Zadaj platnú HTTP alebo HTTPS adresu.");
          const response=await fetch(`https://r.jina.ai/${target}`,{headers:{Accept:"application/json"}}); if(!response.ok) throw new Error("Stránku sa nepodarilo načítať na analýzu.");
          const raw=await response.text(); let content=raw,title=""; try{const json=JSON.parse(raw),data=json?.data||json; content=data?.content||""; title=data?.title||"";}catch{} if(!content)content=raw;
          const headings=content.match(/^#{1,3}\s+.+$/gm)||[],links=content.match(/\[[^\]]+\]\([^\)]+\)/g)||[],images=content.match(/!\[[^\]]*\]\([^\)]+\)/g)||[];
          const clean=content.replace(/[#*_`>\[\]()]/g," ").replace(/\s+/g," ").trim(),len=clean.length,lower=clean.toLowerCase();
          const ctaWords=["kontakt","contact","objedna","chcem","kúpi","kup","rezerv","book","call","get started","začať","nezáväz","ponuka","cena"],trustWords=["referenc","recenzi","testimonial","klient","case study","certifik","garanci","skúsen","skusen"],benefitWords=["výhod","benefit","riešen","result","výsled","šetri","získ","rast","pomôž","pomoz","prečo","preco"];
          const hasCta=ctaWords.some(w=>lower.includes(w)),hasTrust=trustWords.some(w=>lower.includes(w)),hasBenefits=benefitWords.some(w=>lower.includes(w));
          const seo=Math.round((title.length>=10&&title.length<=70?40:title?20:0)+(headings.length>=2?30:headings.length===1?15:0)+(len>=500?30:len>=250?18:8));
          const conversion=Math.round((hasCta?40:5)+(links.length>=3?25:links.length?12:0)+(hasBenefits?20:0)+(hasTrust?15:0));
          const contentScore=Math.min(100,Math.round((len>=1200?45:len>=700?35:len>=400?25:12)+(headings.length>=3?25:headings.length>=2?18:8)+(hasBenefits?20:5)+(images.length?10:0)));
          const trust=Math.min(100,Math.round((parsed.protocol==="https:"?35:0)+(hasTrust?35:5)+(hasCta?15:0)+(links.length>=2?15:5)));
          const ux=Math.min(100,Math.round((headings.length>=2?30:headings.length===1?18:8)+(images.length?20:5)+(links.length>=3?25:links.length?12:0)+(hasCta?25:5)));
          const score=Math.round((seo+conversion+contentScore+trust+ux)/5);
          const rec=[]; if(!title)rec.push("Doplň jasný SEO titulok stránky s hlavnou hodnotou ponuky."); else if(title.length<10||title.length>70)rec.push("Uprav titulok približne na 10–70 znakov a zameraj ho na zákazníka."); if(headings.length<2)rec.push("Vytvor jasnú hierarchiu nadpisov H1/H2 a rozdeľ obsah do sekcií."); if(!hasCta||links.length<2)rec.push("Pridaj výrazné CTA, ktoré návštevníka vedie k jednému konkrétnemu ďalšiemu kroku."); if(!hasBenefits)rec.push("Komunikuj konkrétne benefity a výsledok, ktorý zákazník získa."); if(!hasTrust)rec.push("Pridaj referencie, recenzie, ukážky práce alebo iný dôkaz dôveryhodnosti."); if(len<500)rec.push("Rozšír obsah o služby, benefity, dôkazy a odpovede na najčastejšie otázky."); if(!images.length)rec.push("Zváž relevantné obrázky alebo ukážky práce, ktoré podporia ponuku.");
          resultBox.innerHTML=`<div class="score"><div><span class="score-label">FOX SCORE</span><strong class="score-value">${score}<small>/100</small></strong></div><span style="font-size:30px">✓</span></div><div class="categories">${metric("SEO",seo,seo>=75?"Silný základ":"Je priestor na zlepšenie")}${metric("Konverzia",conversion,conversion>=75?"CTA funguje":"Posilni ďalší krok")}${metric("Obsah",contentScore,contentScore>=75?"Dostatočná hĺbka":"Pridaj hodnotný obsah")}${metric("Dôvera",trust,trust>=75?"Dobrá dôveryhodnosť":"Pridaj dôkazy")}${metric("UX",ux,ux>=75?"Jasná štruktúra":"Zjednoduš cestu")}</div><div class="grid">${item("HTTPS",parsed.protocol==="https:",parsed.protocol==="https:"?"Bezpečné pripojenie":"Použi HTTPS")}${item("SEO titulok",!!title,title||"Chýba")}${item("Nadpisy",headings.length>=2,`${headings.length} nájdené`)}${item("CTA / odkazy",hasCta&&links.length>=2,`${links.length} nájdené`)}${item("Obrázky",images.length>0,`${images.length} nájdených`)}${item("Obsah",len>=500,`${len} znakov`)}</div>${rec.length?`<div class="recommendations"><strong>FOX odporúčania</strong><ul>${rec.map(r=>`<li>${esc(r)}</li>`).join("")}</ul></div>`:""}`;
          resultBox.hidden=false;
        }catch(err){errorBox.textContent=err instanceof Error?err.message:"Analýzu sa nepodarilo dokončiť.";errorBox.hidden=false;}finally{button.disabled=false;button.textContent="Spustiť audit →";}
      });
    </script>
  </body>
</html>
