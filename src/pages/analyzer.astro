---
const embed = false;
const lang = "de";
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>FOX Web Analyzer 3.0 | FOX Technology Lab</title>
<meta name="description" content="FOX Technology Lab – Website Audit für SEO, Google, Performance, UX, Accessibility, Security, Meta/Facebook, X/Twitter und Conversion." />
<style>
:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#171717;background:#f6f6f4;--fox:#f36a0a;--line:#30343c;--good:#31b46e;--bad:#ff6b3d;--muted:#8f959e}*{box-sizing:border-box}body{margin:0;background:#f6f6f4}.page{min-height:100vh;padding:38px 20px}.wrap{max-width:1280px;margin:auto}.back{display:inline-block;margin:0 0 20px;color:#171717;text-decoration:none;font-weight:800}.analyzer{background:#111318;color:#fff;border-radius:32px;padding:46px;position:relative;overflow:hidden;border:1px solid #292d35}.analyzer:after{content:"";position:absolute;width:520px;height:520px;right:-250px;top:-300px;border-radius:50%;background:rgba(243,106,10,.18)}.hero,.tool{position:relative;z-index:1}.eyebrow{color:#ff7a22;font-size:13px;font-weight:900;letter-spacing:.1em}.hero h1{font-size:clamp(34px,5vw,62px);line-height:1.02;margin:14px 0}.hero h1 em{color:var(--fox);font-style:normal}.hero p{color:#bfc3ca;max-width:980px;font-size:16px;line-height:1.6}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}.chips span{border:1px solid #30343c;border-radius:999px;padding:7px 10px;font-size:12px;color:#eee;background:#181b21}.tool{margin-top:30px;background:#15181e;color:#f5f5f5;border:1px solid #30343c;border-radius:24px;padding:26px}.selection{margin:0 0 26px;padding:18px;border:1px solid #30343c;border-radius:18px;background:#0f1115}.selection h2{font-size:13px;margin:0 0 12px}.selection-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.select{border:1px solid #30343c;background:#12151a;color:#fff;border-radius:14px;padding:13px 10px;text-align:left;min-height:72px;cursor:pointer}.select.active{border-color:#f36a0a;background:#25170e;box-shadow:inset 0 0 0 1px #f36a0a}.select b{display:block;font-size:12px}.select small{display:block;color:#818792;font-size:10px;margin-top:6px}.select.active small{color:#ffad7b}.selection-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px}.selection-note{font-size:11px;color:#8f959e}.selection-run{height:42px}.selection-run:disabled{opacity:.35;cursor:not-allowed}.row{display:flex;gap:10px}.input{display:flex;align-items:center;gap:8px;flex:1;border:1px solid #383d47;border-radius:13px;padding:0 13px;background:#0e1014}.input input{width:100%;border:0;outline:0;background:transparent;color:#fff;padding:16px 0;font-size:15px;min-width:0}.button{border:0;border-radius:12px;padding:0 20px;font-weight:850;cursor:pointer}.primary{background:var(--fox);color:#fff}.button:disabled{opacity:.6}.help,.foot{display:block;color:#7f858f;font-size:11px;margin-top:9px}.error,.loading{margin-top:16px;padding:13px;border-radius:12px;background:#0f1115;border:1px solid #30343c}.error{color:var(--bad)}.result{margin-top:22px;border-top:1px solid #30343c;padding-top:22px}.top{display:grid;grid-template-columns:1fr 2fr;gap:12px}.score{background:linear-gradient(135deg,#24170e,#181b21);border:1px solid #4a3425;border-radius:17px;padding:18px}.score small{color:#8f959e}.score strong{display:block;color:#ff7a22;font-size:52px;line-height:1;margin-top:6px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.card{border:1px solid #30343c;border-radius:13px;padding:12px;background:#0f1115;min-height:76px}.card strong{display:block;font-size:13px}.card p{margin:6px 0 0;color:#8f959e;font-size:11px;line-height:1.4}.ok{color:var(--good)}.warn{color:#ffb05f}.bad{color:var(--bad)}.section{margin-top:18px}.section h2{font-size:16px;margin:0 0 9px}.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.metric{border:1px solid #30343c;border-radius:13px;padding:12px;background:#0f1115}.metric b{font-size:24px;color:#ff7a22;display:block}.metric span{font-size:11px;font-weight:850}.metric small{display:block;color:#8f959e;font-size:10px;margin-top:3px}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}.action{padding:10px 12px;border:1px solid #383d47;border-radius:10px;text-decoration:none;color:#e9ebef;font-size:12px;font-weight:850;background:#181b21;cursor:pointer}.action:hover{border-color:var(--fox);color:#ff7a22}.embed .page{padding:0}.embed .wrap{max-width:none}.embed .back{display:none}.embed .analyzer{border-radius:0}@media(max-width:900px){.top{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,1fr)}.metrics{grid-template-columns:repeat(3,1fr)}.selection-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.page{padding:22px 12px}.analyzer{padding:28px 17px;border-radius:22px}.row{flex-direction:column}.button{height:48px}.grid,.metrics,.selection-grid{grid-template-columns:1fr 1fr}.hero h1{font-size:36px}}
@media print{.back,.hero,.tool>form,.help,.foot,.actions,.selection{display:none!important}.analyzer,.tool{box-shadow:none;border:0}.page{padding:0}}
</style>
</head>
<body>
<main class="page"><div class="wrap">
<a class="back" href="/">← FOX Technology Lab</a>
<section class="analyzer">
<div class="hero"><div class="eyebrow">✦ FOX TECHNOLOGY LAB · WEB AUDIT 3.0</div><h1 id="headline"></h1><p id="intro"></p><div class="chips" id="chips"></div></div>
<div class="tool">
<div class="selection" id="selection" hidden><h2 id="selectionTitle"></h2><div class="selection-grid" id="selectionGrid"></div><div class="selection-footer"><span class="selection-note" id="selectionNote"></span><button class="button primary selection-run" id="selectionRun" type="button" disabled>Spustiť vybrané testy →</button></div></div>
<form id="form"><label id="urlLabel" for="url"></label><div class="row"><div class="input"><span>🌐</span><input id="url" type="url" required /></div><button class="button primary" id="submit" type="submit"></button></div><small class="help" id="help"></small></form><div class="error" id="error" hidden></div><div class="loading" id="loading" hidden></div><div class="result" id="result" hidden></div><span class="foot" id="foot"></span></div>
</section></div></main>
<script is:inline>
const params=new URLSearchParams(window.location.search);const supported=["de","en","sk","fr","hr","pl","it","es","sv"];const activeLang=supported.includes(params.get("lang"))?params.get("lang"):"de";const selectedKeys=new Set((params.get("selected")||"").split(",").map(x=>x.trim()).filter(Boolean));document.documentElement.lang=activeLang;document.body.classList.toggle("embed",params.get("embed")==="1");
const C={
 de:{h:"Ist deine Website bereit<br><em>für Google und Kunden?</em>",intro:"FOX-Audit für technische SEO, Google, Meta/Facebook, X/Twitter, Performance, UX, Security und Conversion.",chips:["SEO","Google","Meta / Facebook","X / Twitter","Performance","UX","Security","Conversion"],url:"Website-URL",ph:"https://deine-website.de",go:"Audit starten →",load:"FOX analysiert die ausgewählten Tests…",invalid:"Bitte eine gültige HTTP- oder HTTPS-Adresse eingeben.",fail:"Die Website konnte für den Audit nicht geladen werden.",help:"Nur öffentlich erreichbare Daten. Ausgewählte Kategorien werden gezielt geprüft.",foot:"🔒 Keine Anmeldung · Keine Passwörter · Nur öffentliche Website-Daten",tests:"Testergebnisse",indic:"Indikativ – Search Console bleibt maßgeblich",seo:"SEO",google:"Google / Lighthouse",meta:"Meta / Facebook · Open Graph",twitter:"X / Twitter · Twitter Cards",performance:"Performance & Core Web Vitals",ux:"UX & Accessibility",security:"Security & Trust",conversion:"Conversion & Ads",openpsi:"PageSpeed Insights öffnen",robots:"robots.txt öffnen",sitemap:"Sitemap öffnen",pdf:"PDF / Drucken",score:"FOX SCORE 3.0"},
 en:{h:"Is your website ready<br><em>for Google and customers?</em>",intro:"FOX audit for technical SEO, Google, Meta/Facebook, X/Twitter, performance, UX, security and conversion.",chips:["SEO","Google","Meta / Facebook","X / Twitter","Performance","UX","Security","Conversion"],url:"Website URL",ph:"https://your-website.com",go:"Start audit →",load:"FOX is analyzing the selected tests…",invalid:"Enter a valid HTTP or HTTPS URL.",fail:"The website could not be loaded for the audit.",help:"Public data only. Selected categories are tested selectively.",foot:"🔒 No login · No passwords · Public website data only",tests:"Test results",indic:"Indicative – Search Console remains authoritative",seo:"SEO",google:"Google / Lighthouse",meta:"Meta / Facebook · Open Graph",twitter:"X / Twitter · Twitter Cards",performance:"Performance & Core Web Vitals",ux:"UX & Accessibility",security:"Security & Trust",conversion:"Conversion & Ads",openpsi:"Open PageSpeed Insights",robots:"Open robots.txt",sitemap:"Open sitemap",pdf:"PDF / Print",score:"FOX SCORE 3.0"},
 sk:{h:"Je tvoja stránka pripravená<br><em>na Google a zákazníkov?</em>",intro:"FOX audit technického SEO, Google, Meta/Facebook, X/Twitter, výkonu, UX, bezpečnosti a konverzie.",chips:["SEO","Google","Meta / Facebook","X / Twitter","Výkon","UX","Bezpečnosť","Konverzia"],url:"URL webstránky",ph:"https://tvoja-stranka.sk",go:"Spustiť audit →",load:"FOX analyzuje vybrané testy…",invalid:"Zadaj platnú HTTP alebo HTTPS adresu.",fail:"Webstránku sa nepodarilo načítať na audit.",help:"Iba verejné dáta. Vybrané kategórie sa testujú samostatne.",foot:"🔒 Bez registrácie · Bez hesiel · Iba verejné dáta",tests:"Výsledky testov",indic:"Indikatívne – rozhodujúce sú údaje Search Console",seo:"SEO",google:"Google / Lighthouse",meta:"Meta / Facebook · Open Graph",twitter:"X / Twitter · Twitter Cards",performance:"Výkon a Core Web Vitals",ux:"UX a prístupnosť",security:"Bezpečnosť a dôvera",conversion:"Konverzia a Ads",openpsi:"Otvoriť PageSpeed Insights",robots:"Otvoriť robots.txt",sitemap:"Otvoriť sitemap",pdf:"PDF / tlač",score:"FOX SCORE 3.0"},
 fr:{h:"Votre site est-il prêt<br><em>pour Google et vos clients ?</em>",intro:"Audit FOX : SEO technique, Google, Meta/Facebook, X/Twitter, performance, UX, sécurité et conversion.",chips:["SEO","Google","Meta / Facebook","X / Twitter","Performance","UX","Sécurité","Conversion"],url:"URL du site",ph:"https://votre-site.fr",go:"Lancer l’audit →",load:"FOX analyse les tests sélectionnés…",invalid:"Saisissez une URL HTTP ou HTTPS valide.",fail:"Le site n’a pas pu être chargé.",help:"Données publiques uniquement. Les catégories sélectionnées sont testées séparément.",foot:"🔒 Sans inscription · Sans mots de passe · Données publiques",tests:"Résultats",indic:"Indicatif – Search Console reste la référence",seo:"SEO",google:"Google / Lighthouse",meta:"Meta / Facebook · Open Graph",twitter:"X / Twitter · Twitter Cards",performance:"Performance & Core Web Vitals",ux:"UX & accessibilité",security:"Sécurité & confiance",conversion:"Conversion & Ads",openpsi:"Ouvrir PageSpeed Insights",robots:"Ouvrir robots.txt",sitemap:"Ouvrir sitemap",pdf:"PDF / Imprimer",score:"FOX SCORE 3.0"}
};
const Cx=C[activeLang]||C.de;
const $=id=>document.getElementById(id);const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
$('headline').innerHTML=Cx.h;$('intro').textContent=Cx.intro;$('chips').innerHTML=Cx.chips.map(x=>`<span>✓ ${esc(x)}</span>`).join('');$('urlLabel').textContent=Cx.url;$('url').placeholder=Cx.ph;$('submit').textContent=Cx.go;$('help').textContent=Cx.help;$('foot').textContent=Cx.foot;
const catalog={seo:["⌕",Cx.seo,"Technical SEO"],google:["G",Cx.google,"Search & Lighthouse"],meta:["◎",Cx.meta,"Facebook / Open Graph"],twitter:["𝕏",Cx.twitter,"X / Twitter Cards"],performance:["↯",Cx.performance,"Core Web Vitals"],ux:["◈",Cx.ux,"Mobile & accessibility"],security:["◇",Cx.security,"HTTPS & trust"],conversion:["↗",Cx.conversion,"CTA & Ads"]};
if(!selectedKeys.size){$('selection').hidden=false;$('selectionTitle').textContent=activeLang==='sk'?'Vyber až 2 kategórie':'Choose up to 2 categories';$('selectionGrid').innerHTML=Object.entries(catalog).map(([k,c])=>`<button class="select" data-key="${k}" type="button"><b>${c[0]} ${esc(c[1])}</b><small>${esc(c[2])}</small></button>`).join('');$('selectionNote').textContent=activeLang==='sk'?'Vybrať môžeš maximálne 2 kategórie.':'Select a maximum of 2 categories.';const picked=new Set();const runSelected=$('selectionRun');$('selectionGrid').querySelectorAll('.select').forEach(b=>b.addEventListener('click',()=>{const k=b.dataset.key;if(picked.has(k)){picked.delete(k);b.classList.remove('active')}else{if(picked.size>=2)return;picked.add(k);b.classList.add('active')}selectedKeys.clear();picked.forEach(x=>selectedKeys.add(x));$('selectionNote').textContent=`${picked.size} / 2`;runSelected.disabled=!picked.size;}));runSelected.addEventListener('click',()=>{if(!picked.size)return;const next=new URL(window.location.href);next.searchParams.set('selected',[...picked].join(','));window.history.replaceState({},'',next.href);selectedKeys.clear();picked.forEach(x=>selectedKeys.add(x));$('selection').hidden=true;$('form').requestSubmit();});}
const pass=x=>x===true?'ok':x===false?'bad':'warn';const badge=x=>x===true?'✓':x===false?'!':'•';const card=(name,x,detail)=>`<div class="card"><strong class="${pass(x)}">${badge(x)} ${esc(name)}</strong><p>${x===true?'Passed':x===false?'Missing / problem':'Not available'}${detail?' · '+esc(detail):''}</p></div>`;const metric=(name,value,note)=>`<div class="metric"><b>${esc(value==null?'—':value)}</b><span>${esc(name)}</span><small>${esc(note||'')}</small></div>`;
async function reader(url,head=false){const headers={Accept:'application/json'};if(head){headers['X-Return-Format']='html';headers['X-Target-Selector']='head';headers['X-Engine']='direct';}const r=await fetch('https://r.jina.ai/'+url,{headers});if(!r.ok)throw Error('reader');const raw=await r.text();try{const j=JSON.parse(raw);return j?.data||j}catch{return {content:raw,url}}}
async function psi(url,categories){if(!categories.some(x=>['google','performance','ux','seo'].includes(x)))return null;const qs=['url='+encodeURIComponent(url),'strategy=mobile'];if(categories.includes('google')||categories.includes('seo'))qs.push('category=seo');if(categories.includes('performance'))qs.push('category=performance');if(categories.includes('ux')){qs.push('category=accessibility');qs.push('category=best-practices')}const r=await fetch('https://www.googleapis.com/pagespeedonline/v5/runPagespeed?'+qs.join('&'));if(!r.ok)throw Error('psi');return r.json()}
function metaValue(html,key){const k=key.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');const patterns=[new RegExp(`<meta[^>]+(?:property|name)=["']${k}["'][^>]*content=["']([^"']*)["'][^>]*>`,`i`),new RegExp(`<meta[^>]+content=["']([^"']*)["'][^>]+(?:property|name)=["']${k}["'][^>]*>`,`i`)];for(const p of patterns){const m=html.match(p);if(m)return m[1]}return ''}
$('form').addEventListener('submit',async e=>{e.preventDefault();$('error').hidden=true;$('result').hidden=true;$('loading').hidden=false;$('loading').textContent=Cx.load;$('submit').disabled=true;try{let target=$('url').value.trim();if(!/^https?:\/\//i.test(target))target='https://'+target;const u=new URL(target);const cats=selectedKeys.size?[...selectedKeys]:Object.keys(catalog);const needPage=cats.some(x=>['seo','meta','twitter','performance','ux','security','conversion'].includes(x));const needHead=cats.some(x=>['seo','meta','twitter'].includes(x));const needRobots=cats.includes('seo');const needPsi=cats.some(x=>['google','seo','performance','ux'].includes(x));const [page,head,robots,p]=await Promise.all([needPage?reader(target):null,needHead?reader(target,true):null,needRobots?reader(new URL('/robots.txt',u).href).catch(()=>null):null,needPsi?psi(target,cats).catch(()=>null):null]);const html=String(head?.content||'');const content=String(page?.content||'');const lower=(html+'\n'+content).toLowerCase();const title=(html.match(/<title[^>]*>([\s\S]*?)<\/title>/i)?.[1]||String(page?.title||'')).trim();const desc=metaValue(html,'description')||String(page?.description||'');const ogKeys=['og:title','og:description','og:image','og:url'];const twKeys=['twitter:card','twitter:title','twitter:description','twitter:image'];const og=ogKeys.map(k=>[k,metaValue(html,k)]);const tw=twKeys.map(k=>[k,metaValue(html,k)]);const ogOk=og.filter(x=>x[1]).length>=2;const twOk=tw.filter(x=>x[1]).length>=2;const robotsText=String(robots?.content||'');const robotsOk=/user-agent\s*:/i.test(robotsText);const audits=p?.lighthouseResult?.audits||{};const cats=p?.lighthouseResult?.categories||{};const score=id=>typeof cats?.[id]?.score==='number'?Math.round(cats[id].score*100):null;const crawl=typeof audits?.['is-crawlable']?.score==='number'?audits['is-crawlable'].score===1:null;const canonical=typeof audits?.canonical?.score==='number'?audits.canonical.score===1:null;const schema=typeof audits?.['structured-data']?.score==='number'?audits['structured-data'].score===1:null;const viewport=typeof audits?.viewport?.score==='number'?audits.viewport.score===1:null;const seoScore=score('seo'),perfScore=score('performance'),accScore=score('accessibility'),bestScore=score('best-practices');const https=u.protocol==='https:';const hasCta=/contact|kontakt|contact|book|reserv|angebot|anfrage|demo|get started|start|buy|kaufen|objed|ponuka|cena|call to action/i.test(content);const headings=(content.match(/^#{1,6}\s+/gm)||[]).length;const links=(content.match(/\[[^\]]+\]\([^\)]+\)/g)||[]).length;const images=(content.match(/!\[[^\]]*\]\([^\)]+\)/g)||[]).length;const chosen=cats;let sections='';if(chosen.includes('meta'))sections+=`<div class="section"><h2>${Cx.meta}</h2><div class="grid">${og.map(([k,v])=>card(k,!!v,v||'not detected')).join('')}</div></div>`;if(chosen.includes('twitter'))sections+=`<div class="section"><h2>${Cx.twitter}</h2><div class="grid">${tw.map(([k,v])=>card(k,!!v,v||'not detected')).join('')}</div></div>`;if(chosen.includes('seo'))sections+=`<div class="section"><h2>${Cx.seo}</h2><div class="grid">${card('Google crawlability',crawl,crawl===true?'crawlable':Cx.indic)}${card('robots.txt',robotsOk,robotsOk?'found':'not detected')}${card('Canonical',canonical,canonical===true?'confirmed':'not confirmed')}${card('Schema.org / JSON-LD',schema,schema===true?'structured data':'not confirmed')}${card('Meta title',!!title,title||'missing')}${card('Meta description',!!desc,desc||'missing')}${card('Hreflang',/hreflang/i.test(html),/hreflang/i.test(html)?'detected':'not detected')}${card('Favicon',/rel=["'][^"']*icon/i.test(html),/rel=["'][^"']*icon/i.test(html)?'detected':'not detected')}</div><div class="metrics">${metric('SEO Lighthouse',seoScore,'/100')}${metric('Headings',headings,'detected')}${metric('Links',links,'detected')}${metric('Images',images,'detected')}${metric('HTTPS',https,https?'secure':'HTTP')}</div></div>`;if(chosen.includes('google'))sections+=`<div class="section"><h2>${Cx.google}</h2><div class="grid">${card('SEO Lighthouse',seoScore!=null,seoScore==null?'unavailable':seoScore+'/100')}${card('Crawlability',crawl,crawl===true?'crawlable':'not confirmed')}${card('Final URL',true,p?.lighthouseResult?.finalUrl||target)}</div></div>`;if(chosen.includes('performance'))sections+=`<div class="section"><h2>${Cx.performance}</h2><div class="metrics">${metric('Performance',perfScore,'/100')}${metric('LCP',audits?.['largest-contentful-paint']?.displayValue||'—','Lighthouse')}${metric('FCP',audits?.['first-contentful-paint']?.displayValue||'—','Lighthouse')}${metric('CLS',audits?.['cumulative-layout-shift']?.displayValue||'—','Lighthouse')}${metric('TTFB',audits?.['server-response-time']?.displayValue||'—','Lighthouse')}</div></div>`;if(chosen.includes('ux'))sections+=`<div class="section"><h2>${Cx.ux}</h2><div class="grid">${card('Accessibility',accScore!=null,accScore==null?'unavailable':accScore+'/100')}${card('Viewport',viewport,viewport===true?'mobile-ready':'not confirmed')}${card('Best Practices',bestScore!=null,bestScore==null?'unavailable':bestScore+'/100')}</div></div>`;if(chosen.includes('security'))sections+=`<div class="section"><h2>${Cx.security}</h2><div class="grid">${card('HTTPS',https,https?'TLS active':'HTTP detected')}${card('Secure final URL',p?.lighthouseResult?.finalUrl?.startsWith('https://')??https,p?.lighthouseResult?.finalUrl||target)}${card('Noindex',!/noindex/i.test(html),/noindex/i.test(html)?'NOINDEX FOUND':'no noindex signal')}${card('Privacy / legal signals',/privacy|datenschutz|impressum|legal/i.test(content),'public content signal')}</div></div>`;if(chosen.includes('conversion'))sections+=`<div class="section"><h2>${Cx.conversion}</h2><div class="grid">${card('CTA',hasCta,hasCta?'CTA language detected':'CTA missing')}${card('Message / benefits',/benefit|vorteil|výhod|solution|lösung|riešen|result|výsled|save|šetri|growth/i.test(content),'value proposition signal')}${card('Trust',/privacy|datenschutz|impressum|review|recenzi|testimonial|client|klient|certif|guarantee|garanc/i.test(content),'trust signal')}${card('Mobile readiness',viewport,viewport===true?'viewport detected':'not confirmed')}</div></div>`;const top=`<div class="section"><h2>${esc(Cx.tests)} · ${esc(target)}</h2></div>`;const actions=`<div class="actions"><a class="action" href="https://pagespeed.web.dev/analysis?url=${encodeURIComponent(target)}" target="_blank" rel="noopener">↗ ${Cx.openpsi}</a>${chosen.includes('seo')?`<a class="action" href="${esc(new URL('/robots.txt',u).href)}" target="_blank" rel="noopener">↗ ${Cx.robots}</a>`:''}<button class="action" onclick="window.print()">▣ ${Cx.pdf}</button></div>`;$('result').innerHTML=top+sections+actions;$('result').hidden=false;}catch(err){$('error').textContent=err?.message==='invalid'?Cx.invalid:Cx.fail;$('error').hidden=false}finally{$('loading').hidden=true;$('submit').disabled=false;$('submit').textContent=Cx.go}});
</script></body></html>
