---
const embed = Astro.url.searchParams.get("embed") === "1";
const requestedLang = Astro.url.searchParams.get("lang") ?? "de";
const lang = ["de", "en", "sk"].includes(requestedLang) ? requestedLang : "de";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FOX Web Analyzer | WebDizainFOX</title>
    <meta name="description" content="FOX Web Analyzer – technischer SEO-, Google-, Performance-, UX-, Accessibility- und Conversion-Audit." />
    <style>
      :root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#171717;background:#f7f7f5;--fox:#f36a0a;--dark:#171717;--muted:#747474;--line:#e8e8e8;--good:#16803a;--warn:#a15c00;--bad:#b33b08}
      *{box-sizing:border-box}body{margin:0;background:#f7f7f5}.page{min-height:100vh;padding:40px 20px}.wrap{max-width:1240px;margin:0 auto}.back{display:inline-block;margin:0 0 22px;color:#171717;text-decoration:none;font-weight:800}.analyzer{background:var(--dark);color:#fff;border-radius:34px;padding:48px;overflow:hidden;position:relative}.analyzer:before{content:"";position:absolute;width:520px;height:520px;right:-220px;top:-300px;border-radius:50%;background:rgba(243,106,10,.17);filter:blur(4px)}.hero-copy,.tool-card{position:relative;z-index:1}.hero-copy{max-width:900px}.eyebrow{display:flex;align-items:center;gap:8px;color:#ff7a22;font-size:13px;font-weight:900;letter-spacing:.1em}.hero-copy h1{font-size:clamp(34px,5vw,64px);line-height:1.02;margin:14px 0}.hero-copy h1 em{color:var(--fox);font-style:normal}.hero-copy>p{color:#cfcfcf;max-width:850px;font-size:17px;line-height:1.65;margin:0}.points{display:flex;flex-wrap:wrap;gap:9px;margin-top:24px}.points span{color:#eee;font-size:13px;border:1px solid #383838;border-radius:999px;padding:8px 11px}.points b{color:var(--fox);margin-right:6px}.tool-card{margin-top:34px;background:#fff;color:var(--dark);border-radius:24px;padding:28px;box-shadow:0 24px 70px rgba(0,0,0,.25)}label{display:block;font-weight:850;margin-bottom:9px}.row{display:flex;gap:10px}.input{display:flex;align-items:center;gap:9px;flex:1;border:1px solid #ddd;border-radius:14px;padding:0 14px;background:#fafafa}.input span{color:var(--fox)}.input input{width:100%;border:0;outline:0;background:transparent;padding:16px 0;font-size:15px;min-width:0}.button{border:0;border-radius:12px;padding:0 20px;font-weight:850;cursor:pointer;white-space:nowrap}.button-primary{background:var(--fox);color:#fff}.button:disabled{opacity:.6;cursor:wait}small.help{display:block;color:#777;margin-top:10px;font-size:12px}.error{margin-top:18px;background:#fff1eb;color:var(--bad);border-radius:12px;padding:12px 14px;font-size:14px}.loading{margin-top:18px;background:#f7f7f7;border-radius:14px;padding:16px;color:#555;font-size:13px}.result{margin-top:24px;border-top:1px solid var(--line);padding-top:24px}.score-head{display:grid;grid-template-columns:1.15fr 2fr;gap:14px;margin-bottom:16px}.score{background:#fff7f2;border-radius:18px;padding:18px}.score-label{font-size:11px;font-weight:900;letter-spacing:.12em;color:#777}.score-value{display:block;font-size:50px;color:var(--fox);line-height:1;margin-top:7px}.score-value small{font-size:16px;color:#777}.score-note{margin-top:8px;font-size:12px;color:#666}.status-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.status{border:1px solid var(--line);border-radius:14px;padding:12px;background:#fff}.status strong{display:block;font-size:14px}.status span{display:block;font-size:11px;color:#777;margin-top:5px}.ok{color:var(--good)}.warn{color:var(--warn)}.bad{color:var(--bad)}.section{margin-top:18px}.section-title{display:flex;align-items:end;justify-content:space-between;gap:10px;margin:0 0 10px}.section-title h2{font-size:16px;margin:0}.section-title span{font-size:11px;color:#888}.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.metric{border:1px solid var(--line);border-radius:14px;padding:13px;background:#fff}.metric strong{display:block;font-size:24px;color:var(--fox)}.metric span{display:block;font-size:11px;font-weight:850;margin-top:3px}.metric small{display:block;font-size:10px;color:#888;margin-top:4px;line-height:1.3}.tests{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.test{border:1px solid var(--line);border-radius:14px;padding:13px;background:#fff;min-height:88px}.test-top{display:flex;justify-content:space-between;gap:8px;align-items:flex-start}.test strong{font-size:13px}.badge{font-size:9px;font-weight:900;border-radius:999px;padding:4px 7px;background:#f3f3f3;color:#666;white-space:nowrap}.test p{margin:6px 0 0;color:#777;font-size:11px;line-height:1.4}.test a{color:var(--fox);font-weight:800;text-decoration:none}.cwv{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.cwv-card{border:1px solid var(--line);border-radius:14px;padding:13px}.cwv-card strong{display:block;font-size:21px}.cwv-card span{display:block;font-size:11px;font-weight:800;margin-top:3px}.cwv-card small{display:block;color:#888;font-size:10px;margin-top:3px}.recommendations{margin-top:18px;border-radius:16px;background:#f7f7f7;padding:16px;font-size:13px}.recommendations ul{margin:8px 0 0;padding-left:19px;color:#555;line-height:1.65}.actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:14px}.action{display:inline-flex;align-items:center;gap:7px;padding:10px 13px;border:1px solid #ddd;border-radius:10px;text-decoration:none;color:#222;font-size:12px;font-weight:850;background:#fff}.action:hover{border-color:var(--fox);color:var(--fox)}.foot{display:flex;gap:8px;align-items:center;margin-top:14px;color:#777;font-size:11px}.spinner{display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.45);border-top-color:#fff;border-radius:50%;vertical-align:-2px;margin-right:7px;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
      .embed .page{padding:0}.embed .wrap{max-width:none}.embed .back{display:none}.embed .analyzer{border-radius:0}.embed .tool-card{margin-top:30px}
      @media(max-width:950px){.score-head{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(3,1fr)}.status-grid{grid-template-columns:repeat(2,1fr)}.tests{grid-template-columns:repeat(2,1fr)}.cwv{grid-template-columns:repeat(3,1fr)}}
      @media(max-width:650px){.page{padding:24px 12px}.analyzer{border-radius:24px;padding:28px 18px}.tool-card{padding:18px}.row{flex-direction:column}.button{height:48px}.metrics{grid-template-columns:repeat(2,1fr)}.tests{grid-template-columns:1fr}.cwv{grid-template-columns:repeat(2,1fr)}.hero-copy h1{font-size:36px}}
    </style>
  </head>
  <body class={embed ? "embed" : ""}>
    <main class="page">
      <div class="wrap">
        <a class="back" href="/">← WebDizainFOX</a>
        <section class="analyzer" aria-labelledby="fox-title">
          <div class="hero-copy">
            <div class="eyebrow">✦ FOX TECHNOLOGY LAB · WEB AUDIT 3.0</div>
            <h1 id="fox-title">Ist deine Website bereit<br><em>für Google und Kunden?</em></h1>
            <p>Ein interaktiver FOX-Audit für technische SEO, Google-Indexierbarkeit, robots.txt, Sitemap, Canonical, Schema.org, Open Graph, Google Ads, PageSpeed, Core Web Vitals, UX, Barrierefreiheit, Sicherheit, Redirects und Conversion.</p>
            <div class="points"><span><b>✓</b>Google & Indexierung</span><span><b>✓</b>PageSpeed & Core Web Vitals</span><span><b>✓</b>SEO & Schema.org</span><span><b>✓</b>Ads & Conversion</span><span><b>✓</b>UX & Accessibility</span><span><b>✓</b>Security & Trust</span></div>
          </div>
          <div class="tool-card">
            <form id="fox-form">
              <label for="fox-url" id="url-label">Website-URL</label>
              <div class="row">
                <div class="input"><span>🌐</span><input id="fox-url" type="url" required placeholder="https://deine-website.de" /></div>
                <button id="fox-submit" class="button button-primary" type="submit">Kompletten Audit starten →</button>
              </div>
              <small class="help" id="help">Wir prüfen öffentlich erreichbare Daten. Für Google-Lighthouse-Daten wird der PageSpeed-Insights-Dienst verwendet.</small>
            </form>
            <div id="fox-error" class="error" hidden></div>
            <div id="fox-loading" class="loading" hidden></div>
            <div id="fox-result" class="result" hidden></div>
            <div class="foot">🔒 Keine Anmeldung. Keine Passwörter. Nur öffentlich erreichbare Website-Daten.</div>
          </div>
        </section>
      </div>
    </main>
    <script is:inline>
      const form=document.getElementById("fox-form");
      const input=document.getElementById("fox-url");
      const button=document.getElementById("fox-submit");
      const errorBox=document.getElementById("fox-error");
      const loadingBox=document.getElementById("fox-loading");
      const resultBox=document.getElementById("fox-result");
      const currentLang=document.documentElement.lang||"de";
      const copy={
        de:{loading:"FOX prüft jetzt technische SEO, Google, Performance, UX und Conversion…",invalid:"Bitte eine gültige HTTP- oder HTTPS-Adresse eingeben.",fail:"Die Website konnte für den Audit nicht geladen werden.",network:"Ein Teil der Google-Daten war nicht verfügbar. Die lokalen FOX-Tests werden trotzdem angezeigt.",strong:"Starker Bereich",improve:"Verbesserungspotenzial",good:"Bestanden",missing:"Fehlt / nicht erkannt",unknown:"Nicht verfügbar",indicative:"Indikativ – kein Google-Search-Console-Nachweis",recommend:"FOX Empfehlungen",tests:"Technische Tests",google:"Google / Lighthouse",cwv:"Core Web Vitals & Performance",ads:"Google Ads & Conversion",actions:"Weiterführende Tests",openpsi:"PageSpeed Insights öffnen",openrobots:"robots.txt öffnen",opensitemap:"Sitemap öffnen",scoreNote:"Gesamtscore aus den verfügbaren FOX- und Lighthouse-Prüfungen."},
        en:{loading:"FOX is checking technical SEO, Google, performance, UX and conversion…",invalid:"Enter a valid HTTP or HTTPS address.",fail:"The website could not be loaded for the audit.",network:"Some Google data was unavailable. Local FOX tests are still shown.",strong:"Strong area",improve:"Room for improvement",good:"Passed",missing:"Missing / not detected",unknown:"Not available",indicative:"Indicative – not proof from Google Search Console",recommend:"FOX recommendations",tests:"Technical tests",google:"Google / Lighthouse",cwv:"Core Web Vitals & performance",ads:"Google Ads & conversion",actions:"Further tests",openpsi:"Open PageSpeed Insights",openrobots:"Open robots.txt",opensitemap:"Open sitemap",scoreNote:"Overall score from available FOX and Lighthouse checks."},
        sk:{loading:"FOX teraz kontroluje technické SEO, Google, výkon, UX a konverziu…",invalid:"Zadaj platnú HTTP alebo HTTPS adresu.",fail:"Webstránku sa nepodarilo načítať na audit.",network:"Časť Google dát nebola dostupná. Lokálne FOX testy sa aj tak zobrazia.",strong:"Silná oblasť",improve:"Priestor na zlepšenie",good:"Splnené",missing:"Chýba / nerozpoznané",unknown:"Nedostupné",indicative:"Indikatívne – nie je to dôkaz z Google Search Console",recommend:"FOX odporúčania",tests:"Technické testy",google:"Google / Lighthouse",cwv:"Core Web Vitals a výkon",ads:"Google Ads a konverzia",actions:"Ďalšie testy",openpsi:"Otvoriť PageSpeed Insights",openrobots:"Otvoriť robots.txt",opensitemap:"Otvoriť sitemap",scoreNote:"Celkové skóre z dostupných FOX a Lighthouse kontrol."}
      }[currentLang]||null;
      const t=copy||{loading:"FOX is checking…",invalid:"Enter a valid URL.",fail:"Audit failed.",network:"Some Google data was unavailable.",strong:"Strong",improve:"Needs improvement",good:"Passed",missing:"Missing",unknown:"Unavailable",indicative:"Indicative",recommend:"FOX recommendations",tests:"Technical tests",google:"Google / Lighthouse",cwv:"Core Web Vitals & performance",ads:"Google Ads & conversion",actions:"Further tests",openpsi:"Open PageSpeed Insights",openrobots:"Open robots.txt",opensitemap:"Open sitemap",scoreNote:"Overall score."};
      const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
      const clamp=(n,min=0,max=100)=>Math.max(min,Math.min(max,Math.round(n)));
      const status=(label,ok,detail="")=>`<div class="test"><div class="test-top"><strong class="${ok===true?"ok":ok===false?"bad":"warn"}">${ok===true?"✓":ok===false?"!":"•"} ${esc(label)}</strong><span class="badge">${ok===true?t.good:ok===false?t.missing:t.unknown}</span></div><p>${esc(detail)}</p></div>`;
      const metric=(label,score,note)=>`<div class="metric"><strong>${score===null?"—":score}</strong><span>${esc(label)}</span><small>${esc(note)}</small></div>`;
      const cwv=(label,value,note,kind)=>`<div class="cwv-card"><strong class="${kind||""}">${esc(value)}</strong><span>${esc(label)}</span><small>${esc(note)}</small></div>`;
      const audit=(audits,id)=>audits?.[id]||null;
      const auditScore=(audits,id)=>{const a=audit(audits,id);return a&&typeof a.score==="number"?Math.round(a.score*100):null};
      const auditPassed=(audits,id)=>{const a=audit(audits,id);return a? a.score===1 : null};
      const auditText=(audits,id)=>{const a=audit(audits,id);return a?.displayValue||a?.title||""};
      const psiUrl=target=>`https://pagespeed.web.dev/analysis?url=${encodeURIComponent(target)}`;
      const safeUrl=(base,path)=>{try{return new URL(path,base).href}catch{return path}};
      const reader=async target=>{const r=await fetch(`https://r.jina.ai/${target}`,{headers:{Accept:"application/json"}});if(!r.ok)throw new Error("reader");const raw=await r.text();let data={};try{const j=JSON.parse(raw);data=j?.data||j}catch{}return {raw,content:data.content||raw,title:data.title||"",description:data.description||"",url:data.url||target}};
      const readerOptional=async target=>{try{return await reader(target)}catch{return null}};
      const fetchPsi=async target=>{const endpoint=`https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=${encodeURIComponent(target)}&strategy=mobile&category=performance&category=accessibility&category=best-practices&category=seo`;const r=await fetch(endpoint);if(!r.ok)throw new Error("psi");return await r.json()};
      const getFieldMetric=(psi,names)=>{const metrics=psi?.loadingExperience?.metrics||{};for(const name of names){if(metrics[name])return metrics[name].percentile}return null};
      const scoreOf=(psi,key)=>typeof psi?.lighthouseResult?.categories?.[key]?.score==="number"?Math.round(psi.lighthouseResult.categories[key].score*100):null;
      const classify=(value,good,needs)=>value===null?"":value<=good?"ok":value<=needs?"warn":"bad";
      const ms=value=>value===null?"—":`${Math.round(value)} ms`;
      const cls=(score)=>score===null?"":score>=90?"ok":score>=50?"warn":"bad";
      const makeRecommendations=(data)=>{const r=[];if(data.seo!==null&&data.seo<90)r.push("Technické SEO: oprav Lighthouse-SEO problémy a chýbajúce metadáta.");if(data.performance!==null&&data.performance<75)r.push("Performance: optimalizuj obrázky, JavaScript, CSS a serverovú odozvu.");if(data.accessibility!==null&&data.accessibility<90)r.push("Accessibility: oprav kontrast, formuláre, alt texty a navigáciu klávesnicou podľa nálezov Lighthouse.");if(data.best!==null&&data.best<90)r.push("Best Practices: odstráň bezpečnostné a moderné webové anti-patterny označené Lighthouse.");if(!data.robots)r.push("Vytvor alebo oprav robots.txt a skontroluj, že neblokuje dôležité stránky.");if(!data.sitemap)r.push("Vytvor sitemap.xml a uisti sa, že obsahuje kanonické indexovateľné URL.");if(!data.canonical)r.push("Pridaj jednoznačný canonical odkaz na každú indexovateľnú stránku.");if(!data.schema)r.push("Pridaj relevantné Schema.org JSON-LD dáta, napr. Organization, LocalBusiness, Service alebo WebSite.");if(!data.og)r.push("Doplň Open Graph title, description, image a URL pre zdieľanie na sociálnych sieťach.");if(!data.cta)r.push("Google Ads landing page: zjednoť reklamný zámer, headline, benefit a CTA na jednu jasnú konverznú cestu.");if(!data.trust)r.push("Dôvera: pridaj kontaktné údaje, referencie, právne informácie a konkrétne dôkazy kvality.");if(data.https!==true)r.push("Security: používaj HTTPS na celej stránke a presmeruj HTTP na HTTPS.");return r.slice(0,10)};
      form.addEventListener("submit",async e=>{
        e.preventDefault();errorBox.hidden=true;resultBox.hidden=true;loadingBox.hidden=false;button.disabled=true;button.innerHTML='<span class="spinner"></span>Audit läuft…';loadingBox.textContent=t.loading;
        try{
          const rawInput=input.value.trim();const target=/^https?:\/\//i.test(rawInput)?rawInput:`https://${rawInput}`;const parsed=new URL(target);if(!/^https?:$/.test(parsed.protocol))throw new Error("invalid");
          const robotsUrl=safeUrl(target,"/robots.txt"),sitemapUrl=safeUrl(target,"/sitemap.xml");
          const [page,robots,sitemap,psi]=await Promise.all([reader(target),readerOptional(robotsUrl),readerOptional(sitemapUrl),fetchPsi(target).catch(()=>null)]);
          const content=page.content||"",clean=content.replace(/[#*_`>\[\]()]/g," ").replace(/\s+/g," ").trim(),lower=clean.toLowerCase();
          const headings=content.match(/^#{1,3}\s+.+$/gm)||[],links=content.match(/\[[^\]]+\]\([^\)]+\)/g)||[],images=content.match(/!\[[^\]]*\]\([^\)]+\)/g)||[];
          const ctaWords=["kontakt","contact","objedna","chcem","kúpi","kup","rezerv","book","call","get started","začať","nezáväz","ponuka","cena","demo","anfragen","angebot","termin"];const trustWords=["referenc","recenzi","testimonial","klient","case study","certifik","garanci","skúsen","skusen","impressum","datenschutz","privacy"];const benefitWords=["výhod","benefit","riešen","result","výsled","šetri","získ","rast","pomôž","pomoz","prečo","preco","warum","vorteil","lösung"];
          const hasCta=ctaWords.some(w=>lower.includes(w)),hasTrust=trustWords.some(w=>lower.includes(w)),hasBenefits=benefitWords.some(w=>lower.includes(w));
          const title=page.title||"";const description=page.description||"";const protocol=parsed.protocol;const robotsText=robots?.content||"";const sitemapText=sitemap?.content||"";
          const robots=!!robotsText&&/user-agent\s*:/i.test(robotsText);const sitemap=!!sitemapText&&(/<urlset|<sitemapindex|https?:\/\//i.test(sitemapText));
          const audits=psi?.lighthouseResult?.audits||{};const finalUrl=psi?.lighthouseResult?.finalUrl||page.url||target;
          const canonical=auditPassed(audits,"canonical");const schema=auditPassed(audits,"structured-data")||auditPassed(audits,"valid-source-maps");const og=/open graph|og:title|og:description/i.test(content);const crawlable=auditPassed(audits,"is-crawlable");const metaDescription=auditPassed(audits,"meta-description");const mobile=auditPassed(audits,"viewport");
          const seo=scoreOf(psi,"seo");const performance=scoreOf(psi,"performance");const accessibility=scoreOf(psi,"accessibility");const best=scoreOf(psi,"best-practices");
          const lcp=getFieldMetric(psi,["LARGEST_CONTENTFUL_PAINT_MS"]);const inp=getFieldMetric(psi,["INTERACTION_TO_NEXT_PAINT","EXPERIMENTAL_INTERACTION_TO_NEXT_PAINT"]);const clsValue=getFieldMetric(psi,["CUMULATIVE_LAYOUT_SHIFT_SCORE"]);const fcp=getFieldMetric(psi,["FIRST_CONTENTFUL_PAINT_MS"]);const ttfb=getFieldMetric(psi,["EXPERIMENTAL_TIME_TO_FIRST_BYTE","SERVER_RESPONSE_TIME"]);
          const localSeo=clamp((title?30:0)+(description?20:0)+(headings.length>=2?20:10)+(robots?10:0)+(sitemap?10:0)+(canonical?10:0));const conversion=clamp((hasCta?35:0)+(hasBenefits?25:0)+(hasTrust?15:0)+(links.length>=3?15:5)+(images.length?10:0));const trust=clamp((protocol==="https:"?35:0)+(hasTrust?35:0)+(links.length>=2?15:0)+(description?15:0));const ux=clamp((headings.length>=2?25:10)+(images.length?15:0)+(links.length>=3?25:10)+(hasCta?25:5)+(mobile===true?10:0));
          const available=[seo,performance,accessibility,best].filter(v=>v!==null);const lighthouseAvg=available.length?available.reduce((a,b)=>a+b,0)/available.length:null;const overall=clamp((localSeo+conversion+trust+ux+(lighthouseAvg??75))/5);const adsScore=clamp((hasCta?30:0)+(hasBenefits?20:0)+(title?15:0)+(description?10:0)+(mobile===true?10:0)+(performance!==null&&performance>=75?10:0)+(trust>=60?5:0));
          const redirects=finalUrl.replace(/\/$/,"")!==target.replace(/\/$/,"");const googleIndicative=crawlable===true&&robots!==false;
          const rec=makeRecommendations({seo,performance,accessibility,best,robots,sitemap,canonical,schema,og,cta:hasCta,trust:trust>=60,https:protocol==="https:"});
          const scoreLabel=overall>=90?t.strong:overall>=70?t.improve:"Priorität: technische und konzeptionelle Optimierung";
          resultBox.innerHTML=`
            <div class="score-head"><div class="score"><span class="score-label">FOX SCORE 3.0</span><strong class="score-value">${overall}<small>/100</small></strong><div class="score-note">${esc(scoreLabel)} · ${esc(t.scoreNote)}</div></div><div class="status-grid">
              ${status("HTTPS",protocol==="https:",protocol==="https:"?"Sichere Verbindung":"HTTP erkannt")}${status("Google crawlbar",crawlable===true,crawlable===true?t.good:(crawlable===false?t.missing:t.unknown))}${status("robots.txt",robots,robots?"Datei gefunden":"Nicht erkannt")}${status("Sitemap",sitemap,sitemap?"XML/Sitemap erkannt":"Nicht erkannt")}
            </div></div>
            <div class="section"><div class="section-title"><h2>FOX Kategorien</h2><span>${esc(t.scoreNote)}</span></div><div class="metrics">${metric("SEO",seo??localSeo,seo===null?"FOX technical score":seo>=90?t.strong:t.improve)}${metric("Performance",performance??75,performance===null?"Google nicht verfügbar":performance>=90?t.strong:t.improve)}${metric("Accessibility",accessibility??75,accessibility===null?"Google nicht verfügbar":accessibility>=90?t.strong:t.improve)}${metric("Best Practices",best??75,best===null?"Google nicht verfügbar":best>=90?t.strong:t.improve)}${metric("Google Ads",adsScore,adsScore>=80?t.strong:t.improve)}</div></div>
            <div class="section"><div class="section-title"><h2>${esc(t.tests)}</h2><span>${esc(t.indicative)}</span></div><div class="tests">
              ${status("Google Indexierbarkeit",googleIndicative,"Indikativer Crawlability-Check – Search Console bleibt maßgeblich.")}${status("robots.txt",robots,robots?robotsUrl:"Datei nicht erkannt")}${status("sitemap.xml",sitemap,sitemap?sitemapUrl:"Nicht erkannt")}${status("Canonical",canonical,canonical===true?"Lighthouse bestätigt Canonical":canonical===false?"Canonical-Problem erkannt":"Google-Daten nicht verfügbar")}${status("Schema.org / Structured Data",schema,schema===true?"Strukturierte Daten erkannt":schema===false?"Nicht bestätigt":"Google-Daten nicht verfügbar")}${status("Open Graph",og,og?"Open-Graph-Hinweise erkannt":"Nicht zuverlässig aus dem Reader erkennbar")}${status("Meta Description",metaDescription??!!description,description||"Nicht erkannt")}${status("Mobile / Viewport",mobile,mobile===true?"Viewport-Test bestanden":"Nicht bestätigt")}${status("Redirect",redirects,redirects?`Final: ${finalUrl}`:"Kein zusätzlicher Redirect erkannt")}${status("HTTPS / Transport",protocol==="https:",protocol==="https:"?"HTTPS aktiv":"HTTPS fehlt")}${status("Trust / Legal",hasTrust,hasTrust?"Kontakt / Recht / Trust-Signale erkannt":"Mehr Vertrauenssignale ergänzen")}${status("CTA / Conversion",hasCta,hasCta?"Konversionsorientierte Begriffe/CTA erkannt":"Klares CTA ergänzen")}
            </div></div>
            <div class="section"><div class="section-title"><h2>${esc(t.google)}</h2><span>${psi?"Google PageSpeed Insights / Lighthouse":"nicht verfügbar"}</span></div><div class="tests">${status("SEO Lighthouse",seo!==null,seo===null?"Nicht verfügbar":`${seo}/100`)}${status("Performance Lighthouse",performance!==null,performance===null?"Nicht verfügbar":`${performance}/100`)}${status("Accessibility Lighthouse",accessibility!==null,accessibility===null?"Nicht verfügbar":`${accessibility}/100`)}${status("Best Practices",best!==null,best===null?"Nicht verfügbar":`${best}/100`)}${status("Crawlability",crawlable,crawlable===true?"Lighthouse: crawlable":crawlable===false?"Lighthouse: nicht crawlbar":"Nicht verfügbar")}${status("Final URL",true,finalUrl)}</div></div>
            <div class="section"><div class="section-title"><h2>${esc(t.cwv)}</h2><span>Field data wenn von Google verfügbar</span></div><div class="cwv">${cwv("LCP",ms(lcp),"Ziel: ≤ 2.5 s",classify(lcp,2500,4000))}${cwv("INP",ms(inp),"Ziel: ≤ 200 ms",classify(inp,200,500))}${cwv("CLS",clsValue===null?"—":(clsValue/100).toFixed(2),"Ziel: ≤ 0.10",classify(clsValue===null?null:clsValue/100,.1,.25))}${cwv("FCP",ms(fcp),"Orientierung: ≤ 1.8 s",classify(fcp,1800,3000))}${cwv("TTFB",ms(ttfb),"Orientierung: ≤ 800 ms",classify(ttfb,800,1800))}</div></div>
            <div class="section"><div class="section-title"><h2>${esc(t.ads)}</h2><span>${adsScore}/100</span></div><div class="tests">${status("Landing-Page Message Match",hasBenefits,hasBenefits?"Benefit-/Lösungsbotschaft erkannt":"Benefit klarer formulieren")}${status("CTA",hasCta,hasCta?"Konversions-CTA erkannt":"Eindeutiges CTA fehlt")}${status("Mobile Readiness",mobile,mobile===true?"Viewport erkannt":"Nicht bestätigt")}${status("Trust",trust>=60,trust>=60?"Vertrauenssignale vorhanden":"Trust-Signale ausbauen")}${status("Speed",performance===null?null:performance>=75,performance===null?"Google-Daten nicht verfügbar":`${performance}/100 Performance`)}${status("Ad destination",true,"FOX readiness score – kein Google Ads Policy Review")}</div></div>
            ${rec.length?`<div class="recommendations"><strong>${esc(t.recommend)}</strong><ul>${rec.map(x=>`<li>${esc(x)}</li>`).join("")}</ul></div>`:""}
            <div class="actions"><a class="action" href="${esc(psiUrl(target))}" target="_blank" rel="noopener">↗ ${esc(t.openpsi)}</a><a class="action" href="${esc(robotsUrl)}" target="_blank" rel="noopener">↗ ${esc(t.openrobots)}</a><a class="action" href="${esc(sitemapUrl)}" target="_blank" rel="noopener">↗ ${esc(t.opensitemap)}</a></div>`;
          resultBox.hidden=false;
        }catch(err){errorBox.textContent=err?.message==="invalid"?t.invalid:t.fail;errorBox.hidden=false;}finally{loadingBox.hidden=true;button.disabled=false;button.textContent="Kompletten Audit starten →";}
      });
    </script>
  </body>
</html>
