---
const embed = Astro.url.searchParams.get("embed") === "1";
const requested = Astro.url.searchParams.get("lang") ?? "de";
const lang = ["de","en","sk","fr","hr","pl","it","es","sv"].includes(requested) ? requested : "de";
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>FOX Web Analyzer 3.0 | WebDizainFOX</title>
<meta name="description" content="FOX Technology Lab – Website Audit für SEO, Google, Performance, UX, Accessibility, Security und Conversion." />
<style>
:root{font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#171717;background:#f6f6f4;--fox:#f36a0a;--dark:#171717;--line:#e6e6e6;--good:#16803a;--warn:#a15c00;--bad:#b33b08}*{box-sizing:border-box}body{margin:0;background:#f6f6f4}.page{min-height:100vh;padding:38px 20px}.wrap{max-width:1280px;margin:auto}.back{display:inline-block;margin:0 0 20px;color:#171717;text-decoration:none;font-weight:800}.analyzer{background:#171717;color:#fff;border-radius:32px;padding:46px;position:relative;overflow:hidden}.analyzer:after{content:"";position:absolute;width:520px;height:520px;right:-250px;top:-300px;border-radius:50%;background:rgba(243,106,10,.18)}.hero,.tool{position:relative;z-index:1}.eyebrow{color:#ff7a22;font-size:13px;font-weight:900;letter-spacing:.1em}.hero h1{font-size:clamp(34px,5vw,62px);line-height:1.02;margin:14px 0}.hero h1 em{color:var(--fox);font-style:normal}.hero p{color:#d0d0d0;max-width:980px;font-size:16px;line-height:1.6}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}.chips span{border:1px solid #383838;border-radius:999px;padding:7px 10px;font-size:12px;color:#eee}.tool{margin-top:30px;background:#fff;color:#171717;border-radius:24px;padding:26px;box-shadow:0 24px 70px rgba(0,0,0,.28)}label{display:block;font-weight:850;margin-bottom:8px}.row{display:flex;gap:10px}.input{display:flex;align-items:center;gap:8px;flex:1;border:1px solid #ddd;border-radius:13px;padding:0 13px;background:#fafafa}.input input{width:100%;border:0;outline:0;background:transparent;padding:16px 0;font-size:15px;min-width:0}.button{border:0;border-radius:12px;padding:0 20px;font-weight:850;cursor:pointer}.primary{background:var(--fox);color:#fff}.button:disabled{opacity:.6}.help,.foot{display:block;color:#777;font-size:11px;margin-top:9px}.error,.loading{margin-top:16px;padding:13px;border-radius:12px;background:#f7f7f7}.error{color:var(--bad);background:#fff0ea}.result{margin-top:22px;border-top:1px solid var(--line);padding-top:22px}.top{display:grid;grid-template-columns:1fr 2fr;gap:12px}.score{background:#fff7f2;border-radius:17px;padding:18px}.score small{color:#777}.score strong{display:block;color:var(--fox);font-size:52px;line-height:1;margin-top:6px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.card{border:1px solid var(--line);border-radius:13px;padding:12px;background:#fff;min-height:76px}.card strong{display:block;font-size:13px}.card p{margin:6px 0 0;color:#777;font-size:11px;line-height:1.4}.ok{color:var(--good)}.warn{color:var(--warn)}.bad{color:var(--bad)}.section{margin-top:18px}.section h2{font-size:16px;margin:0 0 9px}.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.metric{border:1px solid var(--line);border-radius:13px;padding:12px}.metric b{font-size:24px;color:var(--fox);display:block}.metric span{font-size:11px;font-weight:850}.metric small{display:block;color:#888;font-size:10px;margin-top:3px}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}.action{padding:10px 12px;border:1px solid #ddd;border-radius:10px;text-decoration:none;color:#222;font-size:12px;font-weight:850;background:#fff;cursor:pointer}.action:hover{border-color:var(--fox);color:var(--fox)}.embed .page{padding:0}.embed .wrap{max-width:none}.embed .back{display:none}.embed .analyzer{border-radius:0}.embed .tool{margin-top:28px}@media(max-width:900px){.top{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,1fr)}.metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:620px){.page{padding:22px 12px}.analyzer{padding:28px 17px;border-radius:22px}.row{flex-direction:column}.button{height:48px}.grid,.metrics{grid-template-columns:1fr 1fr}.hero h1{font-size:36px}}
@media print{.back,.hero,.tool>form,.help,.foot,.actions{display:none!important}.analyzer,.tool{box-shadow:none;border:0}.page{padding:0}}
</style>
</head>
