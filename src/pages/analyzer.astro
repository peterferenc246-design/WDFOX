---
const locale = Astro.props.locale ?? "de";
---
<!doctype html>
<html lang={locale}><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>FOX Web Analyzer 3.0 | FOX Technology Lab</title>
<meta name="description" content="FOX Technology Lab – SEO, Google, Meta/Facebook, X/Twitter, Performance, UX, Security und Conversion Audit.">
<style>
:root{font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;color:#171717;background:#f6f6f4;--fox:#f36a0a;--line:#30343c;--good:#16803a;--bad:#b33b08}*{box-sizing:border-box}body{margin:0;background:#f6f6f4}.page{min-height:100vh;padding:38px 20px}.wrap{max-width:1280px;margin:auto}.back{display:inline-block;margin:0 0 20px;color:#171717;text-decoration:none;font-weight:800}.analyzer{background:#111318;color:#fff;border:1px solid #292d35;border-radius:32px;padding:46px;position:relative;overflow:hidden}.analyzer:after{content:"";position:absolute;width:520px;height:520px;right:-250px;top:-300px;border-radius:50%;background:rgba(243,106,10,.18)}.hero,.tool{position:relative;z-index:1}.eyebrow{color:#ff7a22;font-size:13px;font-weight:900;letter-spacing:.1em}.hero h1{font-size:clamp(34px,5vw,62px);line-height:1.02;margin:14px 0}.hero h1 em{color:var(--fox);font-style:normal}.hero p{color:#bfc3ca;max-width:980px;font-size:16px;line-height:1.6}.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}.chips span{border:1px solid #30343c;border-radius:999px;padding:7px 10px;font-size:12px;color:#eee;background:#181b21}.tool{margin-top:30px;background:#15181e;color:#f5f5f5;border:1px solid #30343c;border-radius:24px;padding:26px}.row{display:flex;gap:10px}.input{display:flex;align-items:center;gap:8px;flex:1;border:1px solid #383d47;border-radius:13px;padding:0 13px;background:#0e1014}.input input{width:100%;border:0;outline:0;background:transparent;color:#fff;padding:16px 0;font-size:15px;min-width:0}.button{border:0;border-radius:12px;padding:0 20px;font-weight:850;cursor:pointer}.primary{background:var(--fox);color:#fff}.button:disabled{opacity:.6}.help,.foot{display:block;color:#7f858f;font-size:11px;margin-top:9px}.error,.loading{margin-top:16px;padding:13px;border-radius:12px;background:#0f1115;border:1px solid #30343c}.error{color:#ff6b3d}.result{margin-top:22px;border-top:1px solid #30343c;padding-top:22px}.top{display:grid;grid-template-columns:1fr 2fr;gap:12px}.score{background:linear-gradient(135deg,#24170e,#181b21);border:1px solid #4a3425;border-radius:17px;padding:18px}.score small{color:#8f959e}.score strong{display:block;color:#ff7a22;font-size:52px;line-height:1;margin-top:6px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.card{border:1px solid #30343c;border-radius:13px;padding:12px;background:#0f1115;min-height:76px}.card strong{display:block;font-size:13px}.card p{margin:6px 0 0;color:#8f959e;font-size:11px;line-height:1.4}.ok{color:var(--good)}.bad{color:var(--bad)}.warn{color:#ffb05f}.section{margin-top:18px}.section h2{font-size:16px;margin:0 0 9px}.metrics{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.metric{border:1px solid #30343c;border-radius:13px;padding:12px;background:#0f1115}.metric b{font-size:24px;color:#ff7a22;display:block}.metric span{font-size:11px;font-weight:850}.metric small{display:block;color:#8f959e;font-size:10px;margin-top:3px}.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:15px}.action{padding:10px 12px;border:1px solid #383d47;border-radius:10px;text-decoration:none;color:#e9ebef;font-size:12px;font-weight:850;background:#181b21;cursor:pointer}.embed .page{padding:0}.embed .wrap{max-width:none}.embed .back{display:none}.embed .analyzer{border-radius:0}@media(max-width:900px){.top{grid-template-columns:1fr}.grid{grid-template-columns:repeat(2,1fr)}.metrics{grid-template-columns:repeat(3,1fr)}}@media(max-width:620px){.page{padding:22px 12px}.analyzer{padding:28px 17px;border-radius:22px}.row{flex-direction:column}.button{height:48px}.grid,.metrics{grid-template-columns:1fr 1fr}.hero h1{font-size:36px}}
</style></head><body>
<main class="page"><div class="wrap"><a class="back" href="/">← FOX Technology Lab</a><section class="analyzer"><div class="hero"><div class="eyebrow">✦ FOX TECHNOLOGY LAB · WEB AUDIT 3.0</div><h1 id="headline"></h1><p id="intro"></p><div class="chips" id="chips"></div></div><div class="tool"><form id="form"><label id="urlLabel" for="url"></label><div class="row"><div class="input"><span>🌐</span><input id="url" type="url" required></div><button class="button primary" id="submit" type="submit"></button></div><small class="help" id="help"></small></form><div class="error" id="error" hidden></div><div class="loading" id="loading" hidden></div><div class="result" id="result" hidden></div><span class="foot" id="foot"></span></div></section></div></main>
<script is:inline>
const qs=new URLSearchParams(location.search),langs=['de','en','sk','fr','hr','pl','it','es','sv'],L=langs.includes(qs.get('lang'))?qs.get('lang'):'de';document.documentElement.lang=L;document.body.classList.toggle('embed',qs.get('embed')==='1');
const T={de:['Ist deine Website bereit<br><em>für Google und Kunden?</em>','FOX-Audit für technische SEO, Google, Meta/Facebook, X/Twitter, Meta Pixel, Performance, UX, Security und Conversion.','Website-URL','https://deine-website.de','Kompletten Audit starten →'],en:['Is your website ready<br><em>for Google and customers?</em>','FOX audit for technical SEO, Google, Meta/Facebook, X/Twitter, Meta Pixel, performance, UX, security and conversion.','Website URL','https://your-website.com','Start complete audit →'],sk:['Je tvoja stránka pripravená<br><em>na Google a zákazníkov?</em>','FOX audit technického SEO, Google, Meta/Facebook, X/Twitter, Meta Pixel, výkonu, UX, bezpečnosti a konverzie.','URL webstránky','https://tvoja-stranka.sk','Spustiť kompletný audit →'],fr:['Votre site est-il prêt<br><em>pour Google et vos clients ?</em>','Audit FOX : SEO technique, Google, Meta/Facebook, X/Twitter, Meta Pixel, performance, UX, sécurité et conversion.','URL du site','https://votre-site.fr','Lancer l’audit complet →'],hr:['Je li vaša web stranica spremna<br><em>za Google i klijente?</em>','Potpuni FOX audit SEO-a, Googlea, Meta/Facebooka, X/Twittera, Meta Pixela, performansi, UX-a, sigurnosti i konverzije.','URL web stranice','https://vasa-stranica.hr','Pokreni potpuni audit →'],pl:['Czy Twoja strona jest gotowa<br><em>na Google i klientów?</em>','Kompletny audyt FOX: SEO, Google, Meta/Facebook, X/Twitter, Meta Pixel, wydajność, UX, bezpieczeństwo i konwersja.','URL strony','https://twoja-strona.pl','Uruchom pełny audyt →'],it:['Il tuo sito è pronto<br><em>per Google e i clienti?</em>','Audit FOX completo per SEO, Google, Meta/Facebook, X/Twitter, Meta Pixel, performance, UX, sicurezza e conversione.','URL del sito','https://tuo-sito.it','Avvia audit completo →'],es:['¿Tu web está preparada<br><em>para Google y tus clientes?</em>','Auditor FOX completo de SEO, Google, Meta/Facebook, X/Twitter, Meta Pixel, rendimiento, UX, seguridad y conversión.','URL del sitio','https://tu-sitio.es','Iniciar auditoría completa →'],sv:['Är din webbplats redo<br><em>för Google och kunder?</em>','Komplett FOX-granskning av SEO, Google, Meta/Facebook, X/Twitter, Meta Pixel, prestanda, UX, säkerhet och konvertering.','Webbplatsens URL','https://din-webbplats.se','Starta komplett analys →']};
const t=T[L]||T.de,$=id=>document.getElementById(id),esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));$('headline').innerHTML=t[0];$('intro').textContent=t[1];$('urlLabel').textContent=t[2];$('url').placeholder=t[3];$('submit').textContent=t[4];$('help').textContent='Iba verejné dáta. Vybrané kategórie sa po dokončení filtrujú v FOX launcheri.';$('foot').textContent='🔒 Bez registrácie · Bez hesiel · Iba verejné dáta';$('chips').innerHTML=['SEO','Google','Meta / Facebook','Meta Pixel','X / Twitter','Performance','UX','Security','Conversion'].map(x=>`<span>✓ ${x}</span>`).join('');
const card=(n,v,d)=>`<div class="card"><strong class="${v===true?'ok':v===false?'bad':'warn'}">${v===true?'✓':v===false?'!':'•'} ${esc(n)}</strong><p>${v===true?'Splnené':v===false?'Chýba / problém':'Nedostupné'}${d?' · '+esc(d):''}</p></div>`,metric=(n,v,d)=>`<div class="metric"><b>${esc(v==null?'—':v)}</b><span>${esc(n)}</span><small>${esc(d||'')}</small></div>`;
async function jina(url,head=false){const target=new URL(url,location.href),same=target.origin===location.origin||['foxprof.club','www.foxprof.club'].includes(target.hostname.toLowerCase());if(same){const local=new URL(target.pathname+target.search,location.origin),r=await fetch(local.href,{cache:'no-store',redirect:'follow'});if(!r.ok)throw Error('local');return{content:await r.text(),url:local.href}}const h={Accept:'application/json','X-No-Cache':'true'};if(head){h['X-Respond-With']='html';h['X-Engine']='curl';h['X-Respond-Timing']='html'}const r=await fetch('https://r.jina.ai/'+url,{headers:h});if(!r.ok)throw Error('jina');const raw=await r.text();try{const j=JSON.parse(raw),d=j?.data||j;return{...d,content:String(d?.content||'')}}catch{return{content:raw}}}
async function pagespeed(url){const u='https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url='+encodeURIComponent(url)+'&strategy=mobile&category=performance&category=accessibility&category=best-practices&category=seo',r=await fetch(u);if(!r.ok)throw Error('psi');return r.json()}
function meta(html,name){const n=name.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),a=new RegExp(`<meta\\b[^>]*(?:name|property)=["']${n}["'][^>]*\\bcontent=["']([^"']*)["'][^>]*>`,`i`),b=new RegExp(`<meta\\b[^>]*\\bcontent=["']([^"']*)["'][^>]*(?:name|property)=["']${n}["'][^>]*>`,`i`);return html.match(a)?.[1]||html.match(b)?.[1]||''}
function pixelAudit(html){const src=/https?:\/\/[^"']*connect\.facebook\.net[^"']*\/fbevents\.js/i.test(html)||/fbevents\.js/i.test(html),fbq=/\bfbq\s*\(/i.test(html),init=/fbq\s*\(\s*['"]init['"]/i.test(html),pageview=/fbq\s*\(\s*['"]track['"]\s*,\s*['"]PageView['"]/i.test(html),ids=[...html.matchAll(/fbq\s*\(\s*['"]init['"]\s*,\s*['"](\d{5,})['"]/gi)].map(m=>m[1]),consent=/(consent|cookie|gdpr|privacy|cmp|cookiebot|onetrust|usercentrics|klaro|didomi)/i.test(html);return{src,fbq,init,pageview,ids:[...new Set(ids)],consent,ok:src&&fbq&&init&&pageview}}
$('form').addEventListener('submit',async e=>{e.preventDefault();$('error').hidden=true;$('result').hidden=true;$('loading').hidden=false;$('loading').textContent='FOX analyzuje webstránku…';$('submit').disabled=true;try{let target=$('url').value.trim();if(!/^https?:\/\//i.test(target))target='https://'+target;const u=new URL(target),robotsUrl=new URL('/robots.txt',u).href,sitemapUrl=new URL('/sitemap.xml',u).href;const [page,head,robots,sitemap,ps]=await Promise.all([jina(target),jina(target,true).catch(()=>({content:''})),jina(robotsUrl).catch(()=>({content:''})),jina(sitemapUrl).catch(()=>({content:''})),pagespeed(target).catch(()=>null)]);const html=String(head.content||''),content=String(page.content||''),px=pixelAudit(html);const aud=ps?.lighthouseResult?.audits||{},cats=ps?.lighthouseResult?.categories||{},score=k=>typeof cats[k]?.score==='number'?Math.round(cats[k].score*100):null,pass=k=>typeof aud[k]?.score==='number'?aud[k].score===1:null;const title=(html.match(/<title[^>]*>([\s\S]*?)<\/title>/i)?.[1]||page.title||'').trim(),desc=meta(html,'description')||page.description||'',og=['og:title','og:description','og:image','og:url'].map(k=>[k,meta(html,k)]),tw=['twitter:card','twitter:title','twitter:description','twitter:image'].map(k=>[k,meta(html,k)]),ogOk=og.filter(x=>x[1]).length>=2,twOk=tw.filter(x=>x[1]).length>=2,https=u.protocol==='https:',robotsOk=/user-agent\s*:/i.test(String(robots.content||'')),sitemapOk=/<(urlset|sitemapindex)\b/i.test(String(sitemap.content||''))||/https?:\/\//i.test(String(sitemap.content||'')),crawl=pass('is-crawlable'),canon=pass('canonical'),schema=pass('structured-data'),viewport=pass('viewport'),metaDesc=pass('meta-description'),seo=score('seo'),perf=score('performance'),access=score('accessibility'),best=score('best-practices'),cta=/contact|kontakt|demo|book|reserv|angebot|anfrage|get started|buy|kaufen|objed|ponuka|cena/i.test(content),trust=/privacy|datenschutz|impressum|review|recenzi|testimonial|client|klient|certif|guarantee|garanc/i.test(content),benefit=/benefit|vorteil|výhod|solution|lösung|riešen|result|výsled|save|šetri|growth|rast/i.test(content),headings=(content.match(/^#{1,6}\s+/gm)||[]).length,links=(content.match(/\[[^\]]+\]\([^\)]+\)/g)||[]).length,images=(content.match(/!\[[^\]]*\]\([^\)]+\)/g)||[]).length,vals=[seo,perf,access,best].filter(x=>x!=null),overall=vals.length?Math.round(vals.reduce((a,b)=>a+b,0)/vals.length):75;let out=`<div class="top"><div class="score"><small>FOX SCORE 3.0</small><strong>${overall}/100</strong><p>${esc(target)}</p></div><div class="grid">${card('HTTPS',https,'TLS active')}${card('Google crawlability',crawl,'Lighthouse')}${card('robots.txt',robotsOk,robotsOk?'found':'missing')}${card('sitemap.xml',sitemapOk,sitemapOk?'detected':'missing')}</div></div>`;out+=`<div class="section"><h2>Technické testy</h2><div class="grid">${card('Canonical',canon)}${card('Schema.org / JSON-LD',schema)}${card('Meta title',!!title,title||'missing')}${card('Meta description',metaDesc??!!desc,desc||'missing')}${card('Open Graph / Meta',ogOk,og.filter(x=>x[1]).map(x=>x[0]).join(', ')||'not detected')}${card('X / Twitter Cards',twOk,tw.filter(x=>x[1]).map(x=>x[0]).join(', ')||'not detected')}${card('Meta Pixel',px.ok,px.ok?`ID ${px.ids.join(', ')||'detected'} · fbevents.js · init · PageView${px.consent?' · consent signal':''}`:`${px.src?'fbevents.js':'no fbevents.js'} · ${px.fbq?'fbq':'no fbq'} · ${px.init?'init':'no init'} · ${px.pageview?'PageView':'no PageView'}`)}${card('Hreflang',/hreflang/i.test(html))}${card('Favicon',/rel=["'][^"']*icon/i.test(html))}${card('Mobile / viewport',viewport)}${card('Noindex',!/noindex/i.test(html),/noindex/i.test(html)?'NOINDEX FOUND':'not detected')}${card('Headings',headings>=2,headings+' detected')}${card('Links',links>=3,links+' detected')}${card('Images',images>0,images+' detected')}</div></div>`;out+=`<div class="section"><h2>Meta Pixel / Tracking</h2><div class="grid">${card('fbevents.js',px.src)}${card('fbq()',px.fbq)}${card('Pixel init',px.init,px.ids.length?`ID ${px.ids.join(', ')}`:'ID not detected')}${card('PageView',px.pageview)}${card('Consent / GDPR signal',px.consent,null)}</div></div>`;out+=`<div class="section"><h2>Google / Lighthouse</h2><div class="metrics">${metric('SEO',seo,'/100')}${metric('Performance',perf,'/100')}${metric('Accessibility',access,'/100')}${metric('Best Practices',best,'/100')}${metric('Crawlability',crawl?'OK':'—','Lighthouse')}</div></div>`;out+=`<div class="section"><h2>Core Web Vitals & Performance</h2><div class="metrics">${metric('LCP',aud['largest-contentful-paint']?.displayValue,'Lighthouse')}${metric('INP',aud['interaction-to-next-paint']?.displayValue,'Lighthouse')}${metric('CLS',aud['cumulative-layout-shift']?.displayValue,'Lighthouse')}${metric('FCP',aud['first-contentful-paint']?.displayValue,'Lighthouse')}${metric('TTFB',aud['server-response-time']?.displayValue,'Lighthouse')}</div></div>`;out+=`<div class="section"><h2>Google Ads & Conversion</h2><div class="grid">${card('Message match / benefits',benefit)}${card('CTA',cta)}${card('Mobile readiness',viewport)}${card('Trust',trust)}${card('Speed',perf==null?null:perf>=75,perf==null?'unavailable':perf+'/100')}${card('Ad destination',true,'FOX readiness check')}</div></div>`;out+=`<div class="section"><h2>FOX Recommendations</h2><div class="card"><p>${[!https&&'HTTPS aktivovať.',!robotsOk&&'Skontrolovať robots.txt.',!sitemapOk&&'Skontrolovať sitemap.xml.',canon!==true&&'Nastaviť canonical.',schema!==true&&'Doplniť Schema.org.',!ogOk&&'Doplniť Open Graph pre Facebook/Meta.',!twOk&&'Doplniť Twitter Cards pre X.',!px.ok&&'Nainštalovať alebo opraviť Meta Pixel.',!cta&&'Pridať jasné CTA.',!trust&&'Posilniť trust signály.'].filter(Boolean).map(x=>'• '+esc(x)).join('<br>')||'✓ Žiadne kritické odporúčania.'}</p></div></div>`;out+=`<div class="actions"><a class="action" href="https://pagespeed.web.dev/analysis?url=${encodeURIComponent(target)}" target="_blank" rel="noopener">↗ PageSpeed Insights</a><a class="action" href="${esc(robotsUrl)}" target="_blank" rel="noopener">↗ robots.txt</a><a class="action" href="${esc(sitemapUrl)}" target="_blank" rel="noopener">↗ sitemap.xml</a><button class="action" type="button" onclick="window.print()">▣ PDF / tlač</button></div>`;$('result').innerHTML=out;$('result').hidden=false}catch(err){$('error').textContent='Audit sa nepodarilo dokončiť. Skontroluj URL a verejnú dostupnosť webu.';$('error').hidden=false}finally{$('loading').hidden=true;$('submit').disabled=false;$('submit').textContent=t[4]}});
</script></body></html>