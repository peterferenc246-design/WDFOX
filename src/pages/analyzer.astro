const pass=(x)=>x===true?'ok':x===false?'bad':'warn';const badge=(x)=>x===true?C.good:x===false?C.bad:C.unknown;const card=(name,x,detail)=>`<div class="card"><strong class="${pass(x)}">${x===true?'✓':x===false?'!':'•'} ${esc(name)}</strong><p>${esc(badge(x))}${detail?' · '+esc(detail):''}</p></div>`;const scoreCard=(name,x,note)=>`<div class="metric"><b>${x==null?'—':x}</b><span>${esc(name)}</span><small>${esc(note||'')}</small></div>`;
const read=async url=>{const r=await fetch('https://r.jina.ai/'+url,{headers:{Accept:'application/json'}});if(!r.ok)throw Error('read');const raw=await r.text();try{const j=JSON.parse(raw);return j?.data||j}catch{return {content:raw,url}}};
const psi=async url=>{const u='https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url='+encodeURIComponent(url)+'&strategy=mobile&category=performance&category=accessibility&category=best-practices&category=seo';const r=await fetch(u);if(!r.ok)throw Error('psi');return r.json()};
const aScore=(audits,id)=>{const a=audits?.[id];return typeof a?.score==='number'?Math.round(a.score*100):null};const aPass=(audits,id)=>{const a=audits?.[id];return a? a.score===1:null};const field=(p,names)=>{const m=p?.loadingExperience?.metrics||{};for(const n of names)if(m[n]?.percentile!=null)return m[n].percentile;return null};
$('form').addEventListener('submit',async e=>{e.preventDefault();$('error').hidden=true;$('result').hidden=true;$('loading').hidden=false;$('loading').textContent=C.load;$('submit').disabled=true;try{let target=$('url').value.trim();if(!/^https?:\/\//i.test(target))target='https://'+target;const u=new URL(target);if(!/^https?:$/.test(u.protocol))throw Error('invalid');const robotsUrl=new URL('/robots.txt',u).href,sitemapUrl=new URL('/sitemap.xml',u).href;const [page,robots,sitemap,p]=await Promise.all([read(target),read(robotsUrl).catch(()=>null),read(sitemapUrl).catch(()=>null),psi(target).catch(()=>null)]);const content=String(page?.content||'');const lower=content.toLowerCase();const audits=p?.lighthouseResult?.audits||{};const cats=p?.lighthouseResult?.categories||{};const title=String(page?.title||'');const desc=String(page?.description||'');const robotsText=String(robots?.content||'');const sitemapText=String(sitemap?.content||'');const has=(...w)=>w.some(x=>lower.includes(x));const headings=(content.match(/^#{1,6}\s+/gm)||[]).length;const links=(content.match(/\[[^\]]+\]\([^\)]+\)/g)||[]).length;const images=(content.match(/!\[[^\]]*\]\([^\)]+\)/g)||[]).length;const https=u.protocol==='https:';const robotsOk=/user-agent\s*:/i.test(robotsText);const sitemapOk=/<(urlset|sitemapindex)\b/i.test(sitemapText)||/https?:\/\//i.test(sitemapText);const canonical=aPass(audits,'canonical');const schema=aPass(audits,'structured-data');const crawl=aPass(audits,'is-crawlable');const viewport=aPass(audits,'viewport');const meta=aPass(audits,'meta-description');const seo=aScore(cats,'seo'),perf=aScore(cats,'performance'),access=aScore(cats,'accessibility'),best=aScore(cats,'best-practices');const og=has('og:title','og:description','open graph');const twitter=has('twitter:card','twitter:title');const hreflang=has('hreflang');const favicon=has('favicon','shortcut icon');const noindex=/noindex/i.test(lower);const htmlLang=document.documentElement.lang;const cta=has('contact','kontakt','contact','book','reserv','angebot','anfrage','demo','get started','start','buy','kaufen','objed','ponuka','cena');const benefit=has('benefit','vorteil','výhod','solution','lösung','riešen','result','výsled','save','šetri','rast','growth');const trust=has('impressum','datenschutz','privacy','referenc','review','recenzi','testimonial','client','klient','certif','guarantee','garanc');const lcp=field(p,['LARGEST_CONTENTFUL_PAINT_MS']),inp=field(p,['INTERACTION_TO_NEXT_PAINT','EXPERIMENTAL_INTERACTION_TO_NEXT_PAINT']),cls=field(p,['CUMULATIVE_LAYOUT_SHIFT_SCORE']),fcp=field(p,['FIRST_CONTENTFUL_PAINT_MS']),ttfb=field(p,['EXPERIMENTAL_TIME_TO_FIRST_BYTE','SERVER_RESPONSE_TIME']);const localSeo=Math.round((title?20:0)+(desc?15:0)+(headings>=2?15:5)+(robotsOk?10:0)+(sitemapOk?10:0)+(canonical?10:0)+(schema?10:0)+(og?5:0)+(viewport?5:0));const conv=Math.round((cta?30:0)+(benefit?25:0)+(trust?15:0)+(links>=3?15:5)+(images?10:0)+(viewport?5:0));const ads=Math.round((cta?25:0)+(benefit?20:0)+(title?15:0)+(desc?10:0)+(viewport?10:0)+(perf==null?5:perf>=75?10:0)+(trust?10:0));const vals=[seo,perf,access,best].filter(x=>x!=null);const avg=vals.length?vals.reduce((a,b)=>a+b,0)/vals.length:75;const overall=Math.max(0,Math.min(100,Math.round((localSeo+conv+ads+avg+ (https?10:0))/5)));const metric=(v,g,n)=>v==null?'—':v>=g?'OK':'Improve';const rec=[];if(!https)rec.push('HTTPS aktivieren und HTTP auf HTTPS umleiten.');if(!robotsOk)rec.push('robots.txt erstellen oder korrigieren.');if(!sitemapOk)rec.push('sitemap.xml erstellen und in robots.txt referenzieren.');if(canonical!==true)rec.push('Eindeutigen Canonical-Link setzen.');if(schema!==true)rec.push('Schema.org JSON-LD für relevante Entitäten ergänzen.');if(!og)rec.push('Open Graph für Social Sharing ergänzen.');if(!cta)rec.push('Ein klares, sichtbares Conversion-CTA ergänzen.');if(!trust)rec.push('Trust-Signale, Referenzen und rechtliche Informationen stärken.');if(perf!=null&&perf<75)rec.push('Performance und Core Web Vitals optimieren.');if(access!=null&&access<90)rec.push('Accessibility-Probleme aus Lighthouse beheben.');if(noindex)rec.push('ACHTUNG: noindex erkannt – Indexierung wird verhindert.');
$('result').innerHTML=`<div class="top"><div class="score"><small>${C.score}</small><strong>${overall}/100</strong><p>${esc(target)}</p></div><div class="grid">${card('HTTPS',https,https?'secure':'HTTP')}${card('Google crawlability',crawl,crawl===true?'Lighthouse':C.indic)}${card('robots.txt',robotsOk,robotsOk?robotsUrl:'not detected')}${card('sitemap.xml',sitemapOk,sitemapOk?sitemapUrl:'not detected')}</div></div><div class="section"><h2>${C.cat}</h2><div class="metrics">${scoreCard('SEO',seo??localSeo,seo==null?'FOX technical score':metric(seo,90))}${scoreCard('Performance',perf,'Lighthouse')}${scoreCard('Accessibility',access,'Lighthouse')}${scoreCard('Best Practices',best,'Lighthouse')}${scoreCard('Google Ads',ads,'FOX readiness')}</div></div><div class="section"><h2>${C.tests}</h2><div class="grid">${card('Google indexability',crawl,crawl===true?'crawlable':C.indic)}${card('robots.txt',robotsOk,robotsOk?'found':'missing')}${card('sitemap.xml',sitemapOk,sitemapOk?'XML detected':'missing')}${card('Canonical',canonical,canonical===true?'confirmed by Lighthouse':'not confirmed')}${card('Schema.org / JSON-LD',schema,schema===true?'structured data':'not confirmed')}${card('Meta title',!!title,title||'missing')}${card('Meta description',meta??!!desc,desc||'missing')}${card('Open Graph',og,og?'OG signals detected':'not detected')}${card('Twitter Cards',twitter,twitter?'Twitter metadata detected':'not detected')}${card('Hreflang',hreflang,hreflang?'language alternates detected':'not detected')}${card('Favicon',favicon,favicon?'icon signal detected':'not detected')}${card('Mobile / viewport',viewport,viewport===true?'viewport passed':'not confirmed')}${card('HTML language',!!htmlLang,htmlLang||'not set')}${card('Noindex',!noindex,noindex?'NOINDEX FOUND':'indexable signal')}${card('Redirect / final URL',true,p?.lighthouseResult?.finalUrl||target)}${card('HTTPS / transport',https,https?'TLS active':'HTTP detected')}${card('CTA / conversion',cta,cta?'CTA language detected':'CTA missing')}${card('Benefits / message',benefit,benefit?'benefit signal detected':'make value proposition clearer')}${card('Trust / legal',trust,trust?'trust/legal signals detected':'add trust signals')}${card('Images / content',images>0,images+' images detected')}${card('Headings / structure',headings>=2,headings+' headings detected')}${card('Links / navigation',links>=3,links+' links detected')}</div></div><div class="section"><h2>${C.google}</h2><div class="grid">${card('SEO Lighthouse',seo!=null,seo==null?'unavailable':seo+'/100')}${card('Performance Lighthouse',perf!=null,perf==null?'unavailable':perf+'/100')}${card('Accessibility Lighthouse',access!=null,access==null?'unavailable':access+'/100')}${card('Best Practices',best!=null,best==null?'unavailable':best+'/100')}${card('Crawlability',crawl,crawl===true?'crawlable':'not confirmed')}${card('Final URL',true,p?.lighthouseResult?.finalUrl||target)}</div></div><div class="section"><h2>${C.cwv}</h2><div class="metrics">${scoreCard('LCP',lcp==null?null:Math.round(lcp)+' ms','good ≤ 2500 ms')}${scoreCard('INP',inp==null?null:Math.round(inp)+' ms','good ≤ 200 ms')}${scoreCard('CLS',cls==null?null:(cls/100).toFixed(2),'good ≤ 0.10')}${scoreCard('FCP',fcp==null?null:Math.round(fcp)+' ms','guide ≤ 1800 ms')}${scoreCard('TTFB',ttfb==null?null:Math.round(ttfb)+' ms','guide ≤ 800 ms')}</div></div><div class="section"><h2>${C.ads} · ${ads}/100</h2><div class="grid">${card('Message match',benefit,benefit?'benefit/solution detected':'improve message match')}${card('CTA',cta,cta?'conversion CTA detected':'CTA missing')}${card('Mobile readiness',viewport,viewport===true?'viewport detected':'not confirmed')}${card('Trust',trust,trust?'trust signals detected':'strengthen trust')}${card('Speed',perf==null?null:perf>=75,perf==null?'Google unavailable':perf+'/100')}${card('Ad destination',true,'FOX readiness only – not a Google Ads policy review')}</div></div>${rec.length?`<div class="section"><h2>${C.rec}</h2><div class="card"><p>${rec.map(x=>'• '+esc(x)).join('<br>')}</p></div></div>`:''}<div class="actions"><a class="action" href="https://pagespeed.web.dev/analysis?url=${encodeURIComponent(target)}" target="_blank" rel="noopener">↗ ${C.openpsi}</a><a class="action" href="${esc(robotsUrl)}" target="_blank" rel="noopener">↗ ${C.robots}</a><a class="action" href="${esc(sitemapUrl)}" target="_blank" rel="noopener">↗ ${C.sitemap}</a><button class="action" onclick="window.print()">▣ ${C.pdf}</button></div>`;$('result').hidden=false;}catch(err){$('error').textContent=err?.message==='invalid'?C.invalid:C.fail;$('error').hidden=false}finally{$('loading').hidden=true;$('submit').disabled=false;$('submit').textContent=C.go}});
