---
<!doctype html><html lang="sk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WDFOX System Design</title><style>:root{color-scheme:dark;--bg:#05070a;--panel:#0d1218;--line:#59616d;--text:#f4f7fb;--muted:#9da8b5;--accent:#31e7a5;--cyan:#39d9ff}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% 0,#12202a 0,#05070a 38%);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif}.wrap{max-width:1180px;margin:auto;padding:42px 18px 80px}header{text-align:center;margin-bottom:22px}h1{font-size:clamp(2rem,5vw,4.2rem);margin:0;background:linear-gradient(90deg,var(--cyan),var(--accent));-webkit-background-clip:text;color:transparent}header p{color:var(--muted);font-size:1.05rem}.nav{text-align:center;margin:0 0 25px}.nav a{display:inline-block;color:#dff8ff;text-decoration:none;border:1px solid #315063;background:#0b1720;padding:10px 15px;border-radius:999px}.nav a:hover{border-color:var(--cyan)}.root{width:max-content;max-width:100%;margin:0 auto 32px;padding:15px 25px;border:1px solid #39d9ff;border-radius:14px;background:#0b1720;box-shadow:0 0 28px #39d9ff22;font-weight:800}.tree{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.tree:before{content:'';position:absolute;left:50%;top:-32px;height:32px;border-left:2px solid var(--line)}.branch{position:relative;border:1px solid #29323c;border-radius:16px;background:linear-gradient(180deg,#10161d,#090d12);padding:18px;box-shadow:0 12px 35px #0008}.branch:before{content:'';position:absolute;left:50%;top:-20px;height:20px;border-left:1px solid var(--line)}.branch h2{font-size:1.05rem;margin:0 0 13px;color:var(--accent);display:flex;gap:9px;align-items:center}.branch ul{list-style:none;margin:0;padding:0}.branch li{position:relative;margin:8px 0;padding:9px 11px 9px 25px;border-left:1px solid #36414c;background:#0c1117;border-radius:0 8px 8px 0;color:#dfe6ee;font-size:.9rem}.branch li:before{content:'├';position:absolute;left:7px;color:#687684}.branch li:last-child:before{content:'└'}footer{text-align:center;color:#6f7c89;margin-top:34px;font-size:.85rem}.legend{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:18px 0 32px}.pill{border:1px solid #26323c;border-radius:999px;padding:7px 11px;color:#aab5c0;background:#0a0f14;font-size:.8rem}@media(max-width:850px){.tree{grid-template-columns:1fr 1fr}}@media(max-width:580px){.wrap{padding-top:28px}.tree{grid-template-columns:1fr}.branch:before,.tree:before{display:none}}</style></head><body><main class="wrap"><header><h1>WDFOX SYSTEM DESIGN</h1><p>Živý strom architektúry WebDesignFOX — od klienta cez orchestrátor až po agentov, dáta a produkciu.</p></header><div class="nav"><a href="/system-design/communication">🔗 Otvoriť Communication Map</a> <a href="/system-design/dns">🌐 Otvoriť DNS Flow</a> <a href="/system-design/image-generation">🎨 Image Generation Agent</a> <a href="/system-design/ai-tools">🧰 Tool Vault</a> <a href="/system-design/prompt-router">🧭 Prompt & Model Router</a> <a href="/system-design/translate">🌍 WDFOX Translate</a> <a href="/system-design/local-seo">📍 Local SEO Agent</a></div><div class="legend"><span class="pill">PREVIEW</span><span class="pill">architektúra v1</span><span class="pill">postupne rozširovateľná</span></div><div class="root">🦊 WebDesignFOX / WDFOX</div><section class="tree">{groups.map(group => <article class="branch"><h2><span>{group.icon}</span>{group.title}</h2><ul>{group.items.map(item => <li>{item}</li>)}</ul></article>)}</section><footer>WDFOX Architecture Map • pracovná verzia na vetve preview</footer></main></body></html>