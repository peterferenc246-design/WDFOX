anch h2{font-size:1.05rem;margin:0 0 13px;color:var(--accent);display:flex;gap:9px;align-items:center}.branch ul{list-style:none;margin:0;padding:0}.branch li{position:relative;margin:8px 0;padding:9px 11px 9px 25px;border-left:1px solid #36414c;background:#0c1117;border-radius:0 8px 8px 0;color:#dfe6ee;font-size:.9rem}.branch li:before{content:'├';position:absolute;left:7px;color:#687684}.branch li:last-child:before{content:'└'}footer{text-align:center;color:#6f7c89;margin-top:34px;font-size:.85rem}.legend{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin:18px 0 32px}.pill{border:1px solid #26323c;border-radius:999px;padding:7px 11px;color:#aab5c0;background:#0a0f14;font-size:.8rem}@media(max-width:850px){.tree{grid-template-columns:1fr 1fr}}@media(max-width:580px){.wrap{padding-top:28px}.tree{grid-template-columns:1fr}.branch:before,.tree:before{display:none}}.featured-doc-agent{border:2px solid #ff6f9c;background:#131b28;padding:18px;margin:22px 0 32px;border-radius:18px;text-align:center}.featured-doc-agent h2{font-size:1.2rem;color:#ffbad0}.featured-doc-agent img{display:block;width:min(100%,650px);height:auto;max-height:none;object-fit:contain;margin:14px auto;border:1px solid #44647a;border-radius:12px}.featured-doc-agent a{color:#9de6ff}.heart-score{margin:8px 0;color:#ffb6c9;font-size:.82rem;overflow-wrap:anywhere}.heart-score strong{color:#fff;white-space:nowrap}.heart-why{font-size:.8rem;color:#b8c7d4;margin:4px 0 12px}.image-gallery{margin-top:38px}.image-gallery h2{color:#9fe4ff}.image-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}.image-card{border:1px solid #364b60;background:#101b27;border-radius:14px;padding:14px}.image-card img{width:100%;height:210px;object-fit:contain;background:#050a10;border-radius:8px}.image-card h3{font-size:1rem;margin:10px 0 6px}.image-card p{font-size:.85rem}.image-card a{color:#8cdcff}</style></head><body><main class="wrap"><header><h1>WDFOX SYSTEM DESIGN</h1><p>Živý 