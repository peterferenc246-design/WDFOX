const providers = [
{ name:'ChatGPT / OpenAI',role:'Supervisor, plánovanie, formulovanie výstupov',format:'Rola → cieľ → kontext → kroky → formát → kontrola',status:'Návrh routingu'},
{ name:'Claude / Anthropic',role:'Kód, revízia, analytické a redakčné úlohy',format:'Presné zadanie → vstupy → obmedzenia → akceptačné kritériá',status:'Návrh routingu'},
{ name:'Perplexity',role:'Výskum a zdrojovanie',format:'Konkrétna otázka → dátum a oblasť → zdroje → overenie',status:'Návrh routingu'},
{ name:'Gemini / Google',role:'Multimodálne vstupy, plánovanie a súhrny',format:'Typ vstupu → cieľová skupina → kroky → formát výsledku',status:'Návrh routingu'}
];
---
<!doctype html><html lang="sk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WDFOX Prompt Engineering & Model Router</title><style>:root{color-scheme:dark}*{box-sizing:border-box}body{background:radial-gradient(circle at top,#162b39,#060a10 60%);color:#edf8ff;font-family:system-ui,sans-serif;margin:0}.wrap{max-width:1100px;margin:auto;padding:28px 18px 80px}nav{display:flex;flex-wrap:wrap;gap:10px}a{color:#8ee9e0}nav a{border:1px solid #3a6470;border-radius:30px;padding:9px 13px;text-decoration:none}h1{font-size:clamp(2rem,5vw,3.5rem);color:#a4f3cf}p,li{color:#b5c9d7;line-height:1.65}.flow{display:flex;flex-direction:column;align-items:center;gap:8px;margin:30px auto}.node{width:min(740px,100%);border:1px solid #3c6672;background:#101c26;border-radius:15px;padding:18px;text-align:center}.node strong{display:block;font-size:1.13rem}.node small{color:#a5c3ce}.arrow{font-size:25px;color:#7ca6b4}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:24px 0}.card{border:1px solid #375060;border-radius:14px;background:#0d1720;padding:18px}.card h2{font-size:1.15rem;margin:0 0 10px}.pill{display:inline-block;border:1px solid #4a756a;border-radius:30px;color:#a9f4da;padding:4px 9px;font-size:.78rem}.example{border:1px solid #446575;background:#0b1b23;border-radius:15px;padding:20px;margin-top:26px}.example code{white-space:pre-wrap;overflow-wrap:anywhere;display:block;line-height:1.8;color:#d7ecf6}.notice{border-left:3px solid #a0e8c8;padding:12px 17px;background:#0c1b22}@media(max-width:650px){.grid{grid-template-columns:1fr}}</style></head><body><main class="wrap"><nav><a href="/system-design">🌳 Hlavná mapa</a><a href="/system-design/context-engine">🧠 Context Engine</a><a href="/system-design/ai-tools">🧰 Tool Vault</a></nav><h1>🧭 WDFOX Prompt Engineering & Model Router</h1><p>Architektonický návrh: jednotná príprava promptu a výber vhodného AI providera podľa typu úlohy, schopností, dostupnosti, ceny, súkromia a schválených oprávnení. Inšpirované referenčným „Prompting Cheat Sheet“ pre ChatGPT, Claude, Perplexity a Gemini.</p><div class="flow"><div class="node"><strong>👤 Používateľ / klient</strong><small>Zadanie, cieľ a požadovaný výstup</small></div><div class="arrow">↓</div><div class="node"><strong>🧠 Supervisor + Context Engine</strong><small>Instructions • Skills • RAG • Memory • API • pravidlá</small></div><div class="arrow">↓</div><div class="node"><strong>🧭 Prompt Router + Provider Selection</strong><small>Klasifikácia úlohy • model capabilities • budget • latency • GDPR • fallback</small></div><div class="arrow">↓</div><div class="node"><strong>✨ Model / agent z WDFOX Tool Vault</strong><small>OpenAI • Claude • Perplexity • Gemini • iné schválené nástroje</small></div><div class="arrow">↓</div><div class="node"><strong>🔍 QA → 👤 schválenie → ⚙️ n8n / MCP akcie</strong><small>Kontrola zdrojov a výstupu; nákladné alebo externé akcie iba po schválení</small></div></div><h2>Šablóny podľa providera</h2><section class="grid">{providers.map(p=><article class="card"><h2>{p.name}</h2><p>{p.role}</p><p><strong>Prompt:</strong> {p.format}</p><span class="pill">{p.status}</span></article>)}</section><section class="example"><h2>📦 Jednotný Prompt Contract</h2><code>role: rola agenta
goal: merateľný výsledok
context: minimálne relevantné podklady
constraints: bezpečnosť, čas, cena, rozsah
tools: povolené MCP/API a oprávnenia
output: formát a akceptačné kritériá
quality: overenie, zdroje, QA
approval: vyžadované pri platbách, publikovaní a rizikových zmenách
fallback: alternatívny provider alebo ľudské rozhodnutie</code></section><div class="notice"><strong>Stav: iba architektúra.</strong> Táto stránka ešte neroutuje skutočné API požiadavky, nemeria cenu ani nespúšťa modely. Dostupnosť, licencie, ceny a ochranu údajov každého providera treba overiť pred integráciou. Žiadne tajné API kľúče nesmú byť vo frontend kóde.</div></main></body></html>