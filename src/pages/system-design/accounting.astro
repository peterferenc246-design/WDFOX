<!doctype html><html lang="sk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WDFOX Accounting Workspace</title><style>
:root{color-scheme:dark;--bg:#05070a;--text:#eef6ff;--muted:#93a2b2;--green:#9cff72;--cyan:#35dcff;--warn:#ffd166;--red:#ff7d7d}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% 0,#14251c,#05070a 42%);font-family:Inter,system-ui,sans-serif;color:var(--text)}.wrap{max-width:1320px;margin:auto;padding:18px 18px 70px}.topnav{position:sticky;top:0;z-index:20;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:#07100ceF;border:1px solid #26372d;border-radius:16px;padding:10px 12px;backdrop-filter:blur(12px)}.brand{font-weight:800;color:var(--green)}.links{display:flex;gap:7px;flex-wrap:wrap}.links a,.actions button{border:1px solid #33424c;background:#0b1418;color:#e7f4ed;padding:8px 11px;border-radius:999px;text-decoration:none;cursor:pointer}.links a:hover,.actions button:hover,.actions button.active{border-color:var(--green);box-shadow:0 0 16px #9cff7222}header{text-align:center;padding-top:22px}h1{font-size:clamp(2rem,5vw,4rem);margin:6px 0;background:linear-gradient(90deg,var(--green),var(--cyan));-webkit-background-clip:text;color:transparent}header p{color:var(--muted)}.actions{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:18px 0}.tree{display:grid;grid-template-columns:1fr 58px 1fr 58px 1fr;gap:14px;align-items:center;margin-top:28px}.node{padding:16px;border:1px solid #33453a;border-radius:16px;background:linear-gradient(180deg,#111a16,#09100d);min-height:116px;cursor:pointer;transition:.2s}.node:hover,.node.on{border-color:var(--green);transform:translateY(-2px);box-shadow:0 0 22px #9cff7224}.node.dim{opacity:.2;filter:grayscale(.6)}.node .icon{font-size:26px}.node b{display:block;margin:8px 0 4px}.node small{color:var(--muted)}.arrow{text-align:center;color:#758379;font-size:27px}.section{grid-column:1/-1;color:#8da399;font-size:.76rem;letter-spacing:.12em;text-transform:uppercase;border-bottom:1px solid #24332b;padding:10px 0 6px}.decision{border-color:#77683c}.qa{border-color:#426277}.approval{border-color:#735353}.details{margin-top:28px;border:1px solid #2d3c34;background:#09110d;border-radius:16px;padding:20px;min-height:150px}.details h2{margin:0 0 8px;color:var(--green)}.details p{color:#c8d4cc}.badge{display:inline-block;border:1px solid #3c4d43;border-radius:999px;padding:3px 8px;font-size:.72rem;color:#aebeb5}.flow{grid-column:1/-1;display:grid;grid-template-columns:1fr 58px 1fr 58px 1fr;gap:14px;align-items:center}.legend{text-align:center;color:var(--muted);font-size:.84rem;margin-top:14px}@media(max-width:850px){.tree,.flow{grid-template-columns:1fr}.arrow{transform:rotate(90deg)}.section,.flow{grid-column:1}.node{min-height:auto}.topnav{position:relative}}</style></head><body><main class="wrap"><nav class="topnav"><div class="brand">🦊 WDFOX</div><div class="links"><a href="/system-design">🌳 Architektúra</a><a href="/system-design/communication">🏢 Control Center</a><a href="/system-design/accounting">🧾 Účtovníctvo</a><a href="/system-design/accounting#document">📥 Doklad</a><a href="/system-design/accounting#booking">🧾 Účtovanie</a><a href="/system-design/accounting#payment">💶 Platba</a><a href="/system-design/accounting#qa">🔍 QA</a></div></nav><header><span class="badge">PREVIEW • ACCOUNTING WORKSPACE v2</span><h1>🧾 WDFOX ÚČTOVNÍCTVO</h1><p>Prepínateľné zobrazenia jednotlivých účtovných workflowov.</p></header><div class="actions"><button class="scenario active" data-s="all">🗺️ Celý strom</button><button class="scenario" data-s="document">📥 Workflow: Doklad</button><button class="scenario" data-s="booking">🧾 Workflow: Účtovanie</button><button class="scenario" data-s="payment">💶 Workflow: Platba</button><button class="scenario" data-s="qa">🔍 Workflow: QA</button></div><section class="tree">
<div class="section">1 • Riadenie účtovnej úlohy</div><div class="node decision" id="supervisor" data-info="Accounting Supervisor pochopí požiadavku a pripraví štruktúrované zadanie pre n8n."><span class="icon">🧠</span><b>Accounting Supervisor</b><small>intent • routing • rozhodnutie</small></div><div class="arrow">→</div><div class="node" id="n8n" data-info="n8n vykonáva IF/ELSE pravidlá, poradie krokov, retry, chyby a approval gate."><span class="icon">⚙️</span><b>n8n Accounting Workflow</b><small>IF/ELSE • workflow • stav</small></div><div class="arrow">→</div><div class="node" id="agent" data-info="Accounting Agent vykonáva konkrétnu účtovnú úlohu a pripravuje povolenú operáciu."><span class="icon">🧮</span><b>Accounting Agent</b><small>spracovanie • návrh • párovanie</small></div>
<div class="section">2 • Doklady, znalosti a účtovný systém</div><div class="node" id="capture" data-info="PDF, fotografia, sken alebo e-mailová príloha vstupujú do spracovania."><span class="icon">📷</span><b>Doklad / Scan</b><small>PDF • foto • príloha</small></div><div class="arrow">→</div><div class="node" id="rag" data-info="RAG poskytuje relevantné znalosti, históriu a firemný kontext."><span class="icon">📚</span><b>RAG / Kontext</b><small>znalosti • história • pravidlá</small></div><div class="arrow">↔</div><div class="node" id="gateway" data-info="Lexware MCP/API Gateway vystavuje agentovi iba povolené nástroje; credentials zostávajú mimo agenta."><span class="icon">🔐</span><b>Lexware MCP / API</b><small>tools • permissions • secrets</small></div>
<div class="flow"><div class="node" id="lexware" data-info="Lexware Office je účtovný systém záznamu; použijeme podporované API operácie."><span class="icon">🧾</span><b>Lexware Office</b><small>doklady • faktúry • účtovanie</small></div><div class="arrow">↔</div><div class="node" id="bank" data-info="Banková vetva slúži na transakcie, párovanie a povolený platobný tok."><span class="icon">🏦</span><b>Banka / Payments</b><small>transakcie • párovanie • platba</small></div><div class="arrow">↔</div><div class="node" id="audit" data-info="Audit uchováva stav workflowu, referencie a výsledky kontrol."><span class="icon">🗃️</span><b>Audit / Metadata</b><small>stav • výsledok • audit trail</small></div></div>
<div class="section">3 • Nezávislá kontrola a oprava</div><div class="node qa" id="qa" data-info="Accounting QA Agent nezávisle kontroluje výsledok Workera. Chyba sa vracia na prepracovanie."><span class="icon">🔍</span><b>Accounting QA Agent</b><small>nezávislá kontrola • PASS/FAIL</small></div><div class="arrow">→</div><div class="node decision" id="decision" data-info="FAIL = späť Accounting Agentovi s chybami. PASS = pokračovať."><span class="icon">🔀</span><b>QA Gate</b><small>FAIL → oprava • PASS → ďalej</small></div><div class="arrow">→</div><div class="node approval" id="approval" data-info="Peter Approval je autorizačná hranica pre kritické finančné operácie."><span class="icon">👤</span><b>Peter / Approval</b><small>schváliť • zamietnuť • STOP</small></div>
</section><section class="details" id="details"><h2>🧾 Celý účtovný strom</h2><p>Pomocou hornej navigácie sa vieš kedykoľvek prepnúť na architektúru, Control Center alebo priamo na konkrétny účtovný workflow.</p></section><div class="legend">Vybraný workflow zostáva zvýraznený • ostatné bloky sa stlmia • URL hash umožňuje otvoriť konkrétne zobrazenie priamo</div></main><script>
const nodes=[...document.querySelectorAll('.node')],details=document.querySelector('#details');const sets={all:nodes.map(n=>n.id),document:['supervisor','n8n','agent','capture','rag','gateway','lexware','qa','decision','audit'],booking:['supervisor','n8n','agent','rag','gateway','lexware','qa','decision','audit'],payment:['supervisor','n8n','agent','gateway','lexware','bank','qa','decision','approval','audit'],qa:['agent','qa','decision','approval']};const texts={all:'Celý účtovný strom: všetky komponenty a ich vzťahy.',document:'Doklad: príjem → Accounting Supervisor → n8n → Accounting Agent → kontext → Lexware nástroje → QA → audit.',booking:'Účtovanie: Supervisor → n8n → Accounting Agent → RAG → Lexware MCP/API → Lexware Office → QA → audit.',payment:'Platba: Supervisor → n8n → Accounting Agent → Lexware/Banka → QA → Peter Approval → povolený krok → audit.',qa:'QA slučka: Accounting Agent → Accounting QA → FAIL = späť na opravu; PASS = pokračovanie.'};function show(s){if(!sets[s])s='all';document.querySelectorAll('.scenario').forEach(b=>b.classList.toggle('active',b.dataset.s===s));nodes.forEach(n=>{n.classList.toggle('on',s!=='all'&&sets[s].includes(n.id));n.classList.toggle('dim',s!=='all'&&!sets[s].includes(n.id))});details.innerHTML=`<h2>${document.querySelector(`[data-s="${s}"]`)?.textContent||'Celý strom'}</h2><p>${texts[s]}</p>`;if(s==='all')history.replaceState(null,'',location.pathname);else history.replaceState(null,'',`#${s}`)}document.querySelectorAll('.scenario').forEach(b=>b.onclick=()=>show(b.dataset.s));nodes.forEach(n=>n.onclick=()=>{nodes.forEach(x=>x.classList.remove('on'));n.classList.remove('dim');n.classList.add('on');details.innerHTML=`<h2>${n.querySelector('b').textContent}</h2><p>${n.dataset.info}</p>`});window.addEventListener('hashchange',()=>show(location.hash.slice(1)||'all'));show(location.hash.slice(1)||'all');
</script></body></html>