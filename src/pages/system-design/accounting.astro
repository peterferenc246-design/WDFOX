<!doctype html><html lang="sk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WDFOX Accounting Workspace</title><style>
:root{color-scheme:dark;--bg:#05070a;--panel:#0d141b;--line:#42505d;--text:#eef6ff;--muted:#93a2b2;--green:#9cff72;--cyan:#35dcff;--warn:#ffd166;--red:#ff7d7d}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% 0,#14251c,#05070a 42%);font-family:Inter,system-ui,sans-serif;color:var(--text)}.wrap{max-width:1280px;margin:auto;padding:28px 18px 70px}header{text-align:center}h1{font-size:clamp(2rem,5vw,4rem);margin:6px 0;background:linear-gradient(90deg,var(--green),var(--cyan));-webkit-background-clip:text;color:transparent}header p{color:var(--muted)}nav,.actions{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:18px 0}button,a.btn{border:1px solid #33424c;background:#0b1418;color:#e7f4ed;padding:9px 12px;border-radius:999px;text-decoration:none;cursor:pointer}button:hover,button.active,a.btn:hover{border-color:var(--green);box-shadow:0 0 16px #9cff7222}.tree{display:grid;grid-template-columns:1fr 58px 1fr 58px 1fr;gap:14px;align-items:center;margin-top:28px}.node{padding:16px;border:1px solid #33453a;border-radius:16px;background:linear-gradient(180deg,#111a16,#09100d);min-height:116px;cursor:pointer;transition:.2s}.node:hover,.node.on{border-color:var(--green);transform:translateY(-2px);box-shadow:0 0 22px #9cff7224}.node .icon{font-size:26px}.node b{display:block;margin:8px 0 4px}.node small{color:var(--muted)}.arrow{text-align:center;color:#758379;font-size:27px}.section{grid-column:1/-1;color:#8da399;font-size:.76rem;letter-spacing:.12em;text-transform:uppercase;border-bottom:1px solid #24332b;padding:10px 0 6px}.decision{border-color:#77683c}.qa{border-color:#426277}.approval{border-color:#735353}.details{margin-top:28px;border:1px solid #2d3c34;background:#09110d;border-radius:16px;padding:20px;min-height:150px}.details h2{margin:0 0 8px;color:var(--green)}.details p{color:#c8d4cc}.badge{display:inline-block;border:1px solid #3c4d43;border-radius:999px;padding:3px 8px;font-size:.72rem;color:#aebeb5}.flow{grid-column:1/-1;display:grid;grid-template-columns:1fr 58px 1fr 58px 1fr;gap:14px;align-items:center}.legend{text-align:center;color:var(--muted);font-size:.84rem;margin-top:14px}@media(max-width:850px){.tree,.flow{grid-template-columns:1fr}.arrow{transform:rotate(90deg)}.section,.flow{grid-column:1}.node{min-height:auto}}</style></head><body><main class="wrap"><header><span class="badge">PREVIEW • ACCOUNTING WORKSPACE v1</span><h1>🧾 WDFOX ÚČTOVNÍCTVO</h1><p>Samostatný pracovný strom pre doklady, účtovanie, Lexware, kontrolu a schvaľovanie.</p></header><nav><a class="btn" href="/system-design">← Control Center</a><a class="btn" href="/system-design/communication">🔗 Celá Communication Map</a></nav><div class="actions"><button class="scenario active" data-s="all">🗺️ Celé účtovníctvo</button><button class="scenario" data-s="document">📥 Doklad</button><button class="scenario" data-s="booking">🧾 Účtovanie</button><button class="scenario" data-s="payment">💶 Platba</button><button class="scenario" data-s="qa">🔍 QA kontrola</button></div><section class="tree">
<div class="section">1 • Riadenie účtovnej úlohy</div><div class="node decision" id="supervisor" data-info="Accounting Supervisor pochopí účtovnú požiadavku, určí typ úlohy a pripraví štruktúrované zadanie pre n8n. Nevykonáva platbu ani neobchádza pravidlá."><span class="icon">🧠</span><b>Accounting Supervisor</b><small>intent • routing • rozhodnutie</small></div><div class="arrow">→</div><div class="node" id="n8n" data-info="n8n vykonáva pevný workflow: IF/ELSE pravidlá, poradie krokov, retry, chyby, approval gate a odovzdanie výsledkov medzi agentmi."><span class="icon">⚙️</span><b>n8n Accounting Workflow</b><small>IF/ELSE • workflow • stav</small></div><div class="arrow">→</div><div class="node" id="agent" data-info="Accounting Agent spracuje konkrétnu účtovnú úlohu: kontrola údajov, návrh kategorizácie, párovanie a príprava povolenej operácie."><span class="icon">🧮</span><b>Accounting Agent</b><small>spracovanie • návrh • párovanie</small></div>
<div class="section">2 • Doklady, znalosti a účtovný systém</div><div class="node" id="capture" data-info="Doklad vstupuje ako PDF, fotografia, sken alebo e-mailová príloha. Extrakcia pripraví údaje, ale originál zostáva v určenom systéme záznamu."><span class="icon">📷</span><b>Doklad / Scan</b><small>PDF • foto • príloha</small></div><div class="arrow">→</div><div class="node" id="rag" data-info="RAG poskytuje relevantné firemné znalosti a kontext. Nie je náhradou účtovného systému ani právneho archívu."><span class="icon">📚</span><b>RAG / Kontext</b><small>znalosti • história • pravidlá</small></div><div class="arrow">↔</div><div class="node" id="gateway" data-info="Lexware MCP/API Gateway je kontrolovaná integračná hranica. Agent nedostáva API kľúč priamo; dostáva iba povolené nástroje a operácie."><span class="icon">🔐</span><b>Lexware MCP / API</b><small>tools • permissions • secrets</small></div>
<div class="flow"><div class="node" id="lexware" data-info="Lexware Office je účtovný systém záznamu. Budeme používať iba operácie, ktoré podporuje oficiálne API a zvolený balík."><span class="icon">🧾</span><b>Lexware Office</b><small>doklady • faktúry • účtovanie</small></div><div class="arrow">↔</div><div class="node" id="bank" data-info="Banková/platobná vetva slúži na párovanie a prípravu platobného toku. Vykonanie citlivej finančnej akcie smeruje cez approval gate."><span class="icon">🏦</span><b>Banka / Payments</b><small>transakcie • párovanie • platba</small></div><div class="arrow">↔</div><div class="node" id="audit" data-info="Audit uchová stav workflowu, referencie, výsledky kontrol a stopu rozhodnutí bez nekontrolovaného duplikovania citlivých údajov."><span class="icon">🗃️</span><b>Audit / Metadata</b><small>stav • výsledok • audit trail</small></div></div>
<div class="section">3 • Nezávislá kontrola a oprava</div><div class="node qa" id="qa" data-info="Accounting QA Agent nezávisle kontroluje výsledok Workera podľa vlastných kritérií. Ak nájde chybu, výsledok sa neodošle ďalej, ale vráti Accounting Agentovi na prepracovanie."><span class="icon">🔍</span><b>Accounting QA Agent</b><small>nezávislá kontrola • PASS/FAIL</small></div><div class="arrow">→</div><div class="node decision" id="decision" data-info="QA Gate: PASS znamená pokračovať. FAIL znamená vrátiť úlohu Accounting Agentovi s konkrétnym zoznamom chýb a opakovať kontrolu."><span class="icon">🔀</span><b>QA Gate</b><small>FAIL → oprava • PASS → ďalej</small></div><div class="arrow">→</div><div class="node approval" id="approval" data-info="Peter Approval je povinná autorizačná hranica pre kritické finančné operácie podľa nastavenej politiky. Zamietnutie znamená STOP."><span class="icon">👤</span><b>Peter / Approval</b><small>schváliť • zamietnuť • STOP</small></div>
</section><section class="details" id="details"><h2>🧾 Účtovný pracovný priestor</h2><p>Klikni na blok alebo vyber scenár hore. Toto je izolovaný strom iba pre účtovníctvo; ostatné oddelenia WDFOX sú skryté.</p><p><strong>Princíp:</strong> Supervisor → n8n → Accounting Agent → nástroje/znalosti → Accounting QA → oprava alebo PASS → Approval pri kritickej akcii.</p></section><div class="legend">Kliknutie = detail • zelená = účtovná cesta • modrá = QA • červená = human approval</div></main><script>
const nodes=[...document.querySelectorAll('.node')],details=document.querySelector('#details');nodes.forEach(n=>n.onclick=()=>{nodes.forEach(x=>x.classList.remove('on'));n.classList.add('on');details.innerHTML=`<h2>${n.querySelector('b').textContent}</h2><p>${n.dataset.info}</p>`});const sets={all:nodes.map(n=>n.id),document:['supervisor','n8n','agent','capture','rag','gateway','lexware','qa','decision','audit'],booking:['supervisor','n8n','agent','rag','gateway','lexware','qa','decision','audit'],payment:['supervisor','n8n','agent','gateway','lexware','bank','qa','decision','approval','audit'],qa:['agent','qa','decision','approval']};const texts={document:'Doklad: príjem → extrakcia → Accounting Agent → kontext → povolené Lexware nástroje → QA → audit.',booking:'Účtovanie: Supervisor určí úlohu → n8n riadi kroky → Agent pripraví operáciu → Lexware API → nezávislá QA kontrola.',payment:'Platba: príprava a kontrola → QA → Peter Approval → až potom povolený platobný krok → audit.',qa:'QA slučka: Accounting Agent → Accounting QA → FAIL = späť na opravu; PASS = pokračovanie podľa policy.'};document.querySelectorAll('.scenario').forEach(b=>b.onclick=()=>{document.querySelectorAll('.scenario').forEach(x=>x.classList.remove('active'));b.classList.add('active');nodes.forEach(n=>n.classList.toggle('on',sets[b.dataset.s].includes(n.id)));details.innerHTML=`<h2>${b.textContent}</h2><p>${texts[b.dataset.s]||'Zobrazený je celý účtovný pracovný strom.'}</p>`});
</script></body></html>