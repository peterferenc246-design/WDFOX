const blocks = [
 {name:'1. Core Concepts',priority:'P1 – základ',source:['Variables & Data Types','Operators','Input & Output','Conditional Statements','Loops','Functions','Scope & Lifetime','Modules & Packages'],comment:'Bezpečné spracovanie vstupov, konfigurácie a modulárna logika WDFOX agentov. Začať funkciami, typmi a modulmi.'},
 {name:'2. Data Structures',priority:'P1 – základ',source:['Lists','Tuples','Sets','Dictionaries','Strings','Arrays (NumPy)','Collections Module'],comment:'Dictionaries a zoznamy sú kľúčové pri JSON dátach z MCP, REST API a n8n. NumPy až podľa analytických potrieb.'},
 {name:'3. Object-Oriented Programming',priority:'P2 – podľa potreby',source:['Classes & Objects','Inheritance','Polymorphism','Encapsulation','Abstraction','Magic Methods','Decorators & Properties'],comment:'Využiť na rozšíriteľné konektory a služby, nie nasilu v jednoduchých skriptoch.'},
 {name:'4. File Handling',priority:'P1 – pre dokumenty',source:['Read / Write Files','Append Files','File Methods','CSV & JSON','Pickle','OS Module'],comment:'JSON, CSV a práca so súbormi sú dôležité pre import/export dokumentov. Pickle nepoužívať na nedôveryhodné vstupy.'},
 {name:'5. Exception Handling',priority:'P1 – spoľahlivosť',source:['Try / Except','Else / Finally','Raise Exceptions','Custom Exceptions','Assertion','Logging'],comment:'Každý agent a API konektor potrebuje zrozumiteľné chyby, retry politiku, logovanie bez tajomstiev a bezpečné zastavenie.'},
 {name:'6. Modules & Libraries',priority:'P1 – základ',source:['Math','Random','Datetime','OS / Sys','Re','NumPy / Pandas'],comment:'Datetime a os/pathlib pri automatizáciách, re pri validácii textu. NumPy/Pandas nie sú nutné pre každú službu.'},
 {name:'7. Advanced Topics',priority:'P2 – pri raste',source:['List Comprehensions','Lambda Functions','Map / Filter / Reduce','Generators','Iterators','Context Managers'],comment:'Generátory a context managers sú užitočné pre väčšie súbory a bezpečné spracovanie zdrojov.'},
 {name:'8. Web Development',priority:'P1 – API',source:['Flask / Django','RESTful APIs','Templates','Forms','Authentication','Database (ORM)'],comment:'Pre WDFOX navyše preveriť FastAPI + Pydantic pre typované API. Autentifikácia, autorizácia a rate limiting sú nutné pri verejnej službe.'},
 {name:'9. GUI Development',priority:'P3 – nízka priorita',source:['Tkinter','PyQt / PySide','Kivy','wxPython','Event Handling','Layouts'],comment:'Desktopové Python GUI teraz nepotrebujeme: WDFOX má webové rozhranie Astro/React.'},
 {name:'10. Data Science',priority:'P2 – analytika',source:['NumPy','Pandas','Matplotlib','Seaborn','SciPy','Jupyter Notebook'],comment:'Zmysluplné pre reporty, kvalitu prekladov, analýzu prevádzky a nákladov. Nepridávať bez konkrétnej dátovej úlohy.'},
 {name:'11. Machine Learning',priority:'P3 – voliteľné',source:['Scikit-learn','Data Preprocessing','Model Training','Evaluation','Classification','Regression'],comment:'Vlastný tréning modelov nie je podmienkou AI Meeting Terminalu. Najprv API modely a RAG; tréning iba pri merateľnom prínose.'},
 {name:'12. Automation & Scripting',priority:'P1 – vysoká priorita',source:['Automate Tasks','Web Scraping','Regular Expressions','Schedule Jobs','Send Emails','Working with APIs'],comment:'Python pracovníci môžu vykonávať n8n úlohy, normalizovať dáta, volať MCP/API a spracovať dokumenty. Scraping iba v súlade s pravidlami webov.'},
 {name:'13. Testing & Debugging',priority:'P1 – povinné',source:['Debugging (pdb)','Unit Testing','PyTest','Assertions','Logging','Error Tracking'],comment:'Pytest, mock API odpovedí, integračné testy a logovanie; pred každým nasadením testovať vo vetve preview.'},
 {name:'14. Best Practices',priority:'P1 – povinné',source:['PEP 8 Style Guide','Code Readability','Docstrings','Virtual Environments','Type Hints','Clean Code'],comment:'Virtuálne prostredia, type hints, bezpečné uloženie kľúčov, kontrola závislostí a dokumentácia OneNote/GitHub.'},
 {name:'15. Projects',priority:'P1 – praktické overenie',source:['Mini Projects','Web Apps','Data Analysis','Automation Bots','APIs','Portfolio Projects'],comment:'Prvý pilot: Python FastAPI test endpoint → n8n workflow → WDFOX Supervisor → odpoveď; následne testovací dokumentový agent.'}
];
const stack = [
 {label:'Tools & Frameworks (podľa obrázka)',values:'Python, PyCharm, Jupyter, VS Code, Flask, Django, NumPy, Pandas, GitHub'},
 {label:'Popular Python Libraries (podľa obrázka)',values:'Requests, BeautifulSoup, Scrapy, Selenium, Matplotlib, Seaborn, TensorFlow, PyTorch, Keras, OpenCV'}
];
