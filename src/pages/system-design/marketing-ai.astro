<!doctype html><html lang="sk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WDFOX Marketing AI – architektúra agentúry</title><style>:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% 0,#173343,#070b12 55%);color:#f1f9ff;font:16px system-ui,sans-serif}a{color:#a3f3d5}.wrap{max-width:1160px;margin:auto;padding:28px 18px 80px}nav{display:flex;flex-wrap:wrap;gap:8px}nav a{padding:9px 13px;border:1px solid #47737c;border-radius:24px;text-decoration:none}h1{font-size:clamp(2.1rem,5vw,3.7rem);color:#9ef0d2;margin-bottom:10px}h2{color:#a6f0d6}p,li{color:#bfd0db;line-height:1.65}.lead{font-size:1.15rem;max-width:820px}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.card,.stage,.panel{background:#0f1e29;border:1px solid #385e6a;border-radius:16px;padding:19px}.card h3{color:#a7efd7;margin:10px 0 5px}.card p{margin:0}.emoji{font-size:2rem}.flow{max-width:780px;margin:30px auto;text-align:center}.flow div{border:1px solid #4a817a;border-radius:12px;padding:15px;background:#132730}.flow span{display:block;color:#91b9c4;padding:7px}.stages{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.stage strong{color:#a7efd7}.notice{border-left:3px solid #a7efd7;background:#0e2229;padding:16px;margin:22px 0}.pill{display:inline-block;border:1px solid #4b8178;border-radius:20px;padding:5px 11px;color:#b4f3db}@media(max-width:800px){.cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:580px){.cards,.stages{grid-template-columns:1fr}}</style></head><body><main class="wrap"><nav><a href="/system-design">🌳 Hlavná mapa</a><a href="/system-design/ai-tools">🧰 Tool Vault</a><a href="/system-design/jarvis-crm">🦊 Jarvis CRM</a><a href="/system-design/local-seo">📍 Local SEO Agent</a></nav><h1>🦊 WDFOX Marketing AI</h1><span class="pill">Návrh produktu / digitálnej reklamnej agentúry</span><p class="lead">Jedno miesto pre zadanie, tvorbu, sc