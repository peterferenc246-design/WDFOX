const metrics = [
  ['ROAS','Atribuované tržby / spend','Rovnaká mena, obdobie a atribučný model.'],
  ['CAC','Náklady na akvizíciu / noví zákazníci','Výdavky a deduplikovaní noví zákazníci z CRM; rozsah nákladov explicitný.'],
  ['CPA','Spend / počet cieľových akcií','Definovať konverznú akciu a atribúciu.'],
  ['MER','Celkové tržby / celkové marketingové náklady','Započítať všetky relevantné kanály a náklady.'],
  ['CVR','Počet konverzií / oprávnené návštevy alebo kliky × 100 %','Menovateľ musí byť uvedený.'],
  ['LTV','Hodnota zákazníka počas zvoleného horizontu','Označiť historický výpočet alebo modelový odhad a horizont.']
];
const stages = [
  ['01 · Import','Autorizovaný zber nákladov, metrík, návštev, konverzií a výnosov z Google Ads, Meta Ads, GA4, CRM a voliteľne Stripe; n8n plánuje a monitoruje import.'],
  ['02 · Normalizácia','PostgreSQL: tenant_id, zdroj, čas, mena, ID kampane; deduplikácia, verzovanie, kontrola úplnosti a audit zdrojov.'],
  ['03 · Metrics Engine','Deterministické pravidlá a SQL/Python výpočty; chýbajúci menovateľ alebo nulové náklady znamenajú N/A, nie vymyslené číslo.'],
  ['04 · Campaign Intelligence','Porovnanie období, detekcia anomálií a odporúčania SCALE / OPTIMIZE / INVESTIGATE podľa dát, vzorky, atribúcie a limitov.'],
  ['05 · AI Ads Engine','Existujúca Google Ads AI Automation: landing page, marketingové uhly a persony, masové varianty, Composer, kontrola duplicít, pravdivosti a formátov.'],
  ['06 · Approval & Evaluation','Manuálne schválenie konkrétneho návrhu a oprávnení; neskôr autorizovaný upload v PAUSED stave, samostatné schválenie aktivácie a rozpočtu, meranie výsledkov.']
];
