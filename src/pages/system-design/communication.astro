---
const nodes = [
  ['client','👤','Zákazník','hlas • chat • e-mail • web'],
  ['frontend','🌐','WDFOX Frontend','web • komunikátor • LANG'],
  ['orchestrator','🧠','n8n Orchestrátor','analýza • routing • workflow'],
  ['agents','🤖','AI Agenti','support • voice • email • web'],
  ['models','✨','AI Modely','OpenAI • Gemini • ďalšie'],
  ['rag','📚','RAG / Qdrant','znalosti • história • kontext'],
  ['mcp','🔌','MCP Access Layer','gateway • tools • externé služby'],
  ['data','🗄️','PostgreSQL / Dáta','klienti • zákazky • metadata'],
  ['human','🧑‍💼','Peter / Human Approval','kontrola • schválenie • zásah'],
  ['external','☁️','Externé systémy','GitHub • Outlook • Tawk • Cloudflare']
];
---
<!doctype html><html lang="sk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WDFOX Communication Map</title>
<style>
:root{color-scheme:dark;--bg:#05070a;--card:#0d141b;--line:#536272;--cyan:#35dcff;--green:#35e6a1;--text:#eef6ff;--muted:#93a2b2;--hot:#ffd166}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% 0,#112532,#05070a 42%);font-family:Inter,system-ui,sans-serif;color:var(--text)}.wrap{max-width:1280px;margin:auto;padding:30px 18px 70px}header{text-align:center}h1{margin:5px 0;font-size:clamp(2rem,5vw,4rem);background:linear-gradient(90deg,var(--cyan),var(--green));-webkit-background-clip:text;color:transparent}header p{color:var(--muted)}nav{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:18px 0 28px}button,a.btn{border:1px solid #304150;background:#0c151d;color:#dcecff;padding:9px 12px;border-radius:999px;text-decoration:none;cursor:pointer}button:hover,a.btn:hover,button.active{border-color:var(--cyan);box-shadow:0 0 15px #35dcff22}.map{position:relative;display:grid;grid-template-columns:repeat(5,1fr);gap:44px 28px;align-items:center}.node{position:relative;z-index:2;min-height:116px;padding:16px;border:1px solid #2b3b49;border-radius:16px;background:linear-gradient(180deg,#101a22,#091016);box-shadow:0 12px 30px #0009;cursor:pointer;transition:.2s}.node:hover,.node.on{transform:translateY(-3px);border-color:var(--green);box-shadow:0 0 24px #35e6a126}.node .icon{font-size:26px}.node b{display:block;margin:8px 0 4px}.node small{color:var(--muted)}.arrow{text-align:center;color:#728293;font-size:28px}.arrow.on{color:var(--hot);text-shadow:0 0 12px #ffd16666}.flow{grid-column:1/-1;display:grid;grid-template-columns:repeat(5,1fr);gap:12px;align-items:center}.details{margin-top:28px;border:1px solid #263744;border-radius:16px;background:#091118;padding:20px;min-height:130px}.details h2{margin:0 0 8px;color:var(--green)}.details p{margin:5px 0;color:#c5d0da}.legend{color:var(--muted);font-size:.85rem;text-align:center;margin-top:14px}.status{display:inline-block;padding:3px 7px;border:1px solid #3b4d5b;border-radius:99px;font-size:.72rem;color:#a8bac8}.topline{display:flex;justify-content:center;gap:8px;flex-wrap:wrap}.scenario{font-size:.82rem}@media(max-width:900px){.map,.flow{grid-template-columns:1fr}.arrow{transform:rotate(90deg)}.flow{grid-column:auto}.node{min-height:auto}}
</style></head><body><main class="wrap"><header><div class="topline"><span class="status">PREVIEW</span><span class="status">COMMUNICATION MAP v1</span></div><h1>WDFOX COMMUNICATION MAP</h1><p>Kto s kým komunikuje, kadiaľ tečú dáta a kto rozhoduje.</p></header>
<nav><a class="btn" href="/system-design">🌳 Architektúra</a><button class="scenario active" data-s="all">🗺️ Celý systém</button><button class="scenario" data-s="call">📞 Telefonát</button><button class="scenario" data-s="chat">💬 Chat</button><button class="scenario" data-s="rag">📚 RAG</button><button class="scenario" data-s="mcp">🔌 MCP</button></nav>
<section class="map">
<div class="node" id="client" data-info="Vstup klienta: hlas, chat, e-mail alebo požiadavka z webu."><span class="icon">👤</span><b>Zákazník</b><small>hlas • chat • e-mail • web</small></div><div class="arrow">→</div><div class="node" id="frontend" data-info="Frontend prijme požiadavku, jazyk a kontext používateľa a odošle ich do backendu."><span class="icon">🌐</span><b>WDFOX Frontend</b><small>web • komunikátor • LANG</small></div><div class="arrow">→</div><div class="node" id="orchestrator" data-info="Centrálny n8n Orchestrátor analyzuje požiadavku a rozhoduje, ktorý workflow, agent alebo nástroj ju spracuje."><span class="icon">🧠</span><b>n8n Orchestrátor</b><small>analýza • routing • workflow</small></div>
<div class="flow"><div class="node" id="human" data-info="Human-in-the-loop: citlivé alebo dôležité akcie môže pred vykonaním schváliť Peter."><span class="icon">🧑‍💼</span><b>Peter / Approval</b><small>kontrola • schválenie</small></div><div class="arrow">↔</div><div class="node" id="agents" data-info="Špecializovaní agenti vykonávajú konkrétne úlohy a vracajú výsledok orchestrátoru."><span class="icon">🤖</span><b>AI Agenti</b><small>support • voice • email • web</small></div><div class="arrow">↔</div><div class="node" id="models" data-info="Modelová vrstva poskytuje agentom reasoning, generovanie, hlas a ďalšie AI schopnosti."><span class="icon">✨</span><b>AI Modely</b><small>OpenAI • Gemini • ďalšie</small></div></div>
<div class="node" id="rag" data-info="RAG vyhľadáva relevantné firemné znalosti, dokumenty a históriu. Qdrant slúži ako vektorová pamäť."><span class="icon">📚</span><b>RAG / Qdrant</b><small>znalosti • história • kontext</small></div><div class="arrow">↔</div><div class="node" id="data" data-info="Štruktúrované dáta: zákazníci, zákazky, stav procesov, metadata a história."><span class="icon">🗄️</span><b>PostgreSQL / Dáta</b><small>klienti • zákazky • metadata</small></div><div class="arrow">↔</div><div class="node" id="mcp" data-info="MCP Access Layer sprostredkuje kontrolovaný prístup agentov k nástrojom a externým systémom."><span class="icon">🔌</span><b>MCP Access Layer</b><small>gateway • tools • policies</small></div>
<div></div><div></div><div class="arrow">↕</div><div class="arrow">→</div><div class="node" id="external" data-info="Externé služby a účty, ku ktorým WDFOX pristupuje cez MCP alebo API."><span class="icon">☁️</span><b>Externé systémy</b><small>GitHub • Outlook • Tawk • Cloudflare</small></div>
</section><section class="details" id="details"><h2>🗺️ Ako mapu používať</h2><p>Klikni na komponent a zobrazí sa jeho úloha. Tlačidlami hore zvýrazníš komunikačný scenár.</p><p><b>Hlavný princíp:</b> klient → WDFOX → orchestrátor → agent/nástroj/znalosti → výsledok → klient.</p></section><div class="legend">↔ obojsmerná komunikácia • → tok požiadavky • kliknutie = detail komponentu</div></main>
<script>
const nodes=[...document.querySelectorAll('.node')], arrows=[...document.querySelectorAll('.arrow')], details=document.querySelector('#details');
nodes.forEach(n=>n.onclick=()=>{nodes.forEach(x=>x.classList.remove('on'));n.classList.add('on');details.innerHTML=`<h2>${n.querySelector('b').textContent}</h2><p>${n.dataset.info}</p>`});
const sets={all:['client','frontend','orchestrator','human','agents','models','rag','data','mcp','external'],call:['client','frontend','orchestrator','agents','models','rag','data','human'],chat:['client','frontend','orchestrator','agents','models','rag','data'],rag:['orchestrator','agents','rag','data'],mcp:['orchestrator','agents','mcp','external','human']};
document.querySelectorAll('.scenario').forEach(b=>b.onclick=()=>{document.querySelectorAll('.scenario').forEach(x=>x.classList.remove('active'));b.classList.add('active');nodes.forEach(n=>n.classList.toggle('on',sets[b.dataset.s].includes(n.id)));arrows.forEach(a=>a.classList.toggle('on',b.dataset.s!=='all'));details.innerHTML=`<h2>${b.textContent}</h2><p>Zvýraznené sú komponenty, ktoré sa zúčastňujú tohto scenára. Toto je pracovný model; budeme ho spresňovať podľa reálneho zapojenia WDFOX.</p>`});
</script></body></html>