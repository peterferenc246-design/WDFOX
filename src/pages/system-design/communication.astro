<!doctype html><html lang="sk"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WDFOX Communication Map</title><style>
:root{color-scheme:dark;--bg:#05070a;--cyan:#35dcff;--green:#35e6a1;--text:#eef6ff;--muted:#93a2b2;--hot:#ffd166;--money:#a7ff83}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% 0,#112532,#05070a 42%);font-family:Inter,system-ui,sans-serif;color:var(--text)}.wrap{max-width:1320px;margin:auto;padding:30px 18px 70px}header{text-align:center}h1{margin:5px 0;font-size:clamp(2rem,5vw,4rem);background:linear-gradient(90deg,var(--cyan),var(--green));-webkit-background-clip:text;color:transparent}header p,.legend{color:var(--muted)}nav{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:18px 0 28px}button,a.btn{border:1px solid #304150;background:#0c151d;color:#dcecff;padding:9px 12px;border-radius:999px;text-decoration:none;cursor:pointer}button:hover,a.btn:hover,button.active{border-color:var(--cyan);box-shadow:0 0 15px #35dcff22}.map{display:grid;grid-template-columns:repeat(5,1fr);gap:24px;align-items:center}.node{min-height:112px;padding:15px;border:1px solid #2b3b49;border-radius:16px;background:linear-gradient(180deg,#101a22,#091016);box-shadow:0 12px 30px #0009;cursor:pointer;transition:.2s}.node:hover,.node.on{transform:translateY(-3px);border-color:var(--green);box-shadow:0 0 24px #35e6a126}.node.account{border-color:#547346}.node.account.on{border-color:var(--money);box-shadow:0 0 25px #a7ff8333}.node .icon{font-size:25px}.node b{display:block;margin:7px 0 4px}.node small{color:var(--muted)}.arrow{text-align:center;color:#728293;font-size:27px}.arrow.on{color:var(--hot)}.details{margin-top:28px;border:1px solid #263744;border-radius:16px;background:#091118;padding:20px;min-height:145px}.details h2{margin:0 0 9px;color:var(--green)}.details p{margin:6px 0;color:#c5d0da}.details strong{color:white}.status{display:inline-block;padding:3px 7px;border:1px solid #3b4d5b;border-radius:99px;font-size:.72rem;color:#a8bac8}.topline{display:flex;justify-content:center;gap:8px;flex-wrap:wrap}.section{grid-column:1/-1;margin:8px 0 -8px;color:#91a4b5;font-size:.78rem;text-transform:uppercase;letter-spacing:.12em;border-bottom:1px solid #1d2b36;padding-bottom:7px}.legend{text-align:center;margin-top:15px;font-size:.84rem}@media(max-width:900px){.map{grid-template-columns:1fr}.arrow{transform:rotate(90deg)}.section{grid-column:1}}</style></head><body><main class="wrap"><header><div class="topline"><span class="status">PREVIEW</span><span class="status">COMMUNICATION MAP v2</span></div><h1>WDFOX COMMUNICATION MAP</h1><p>Komunikácia, AI, firemné procesy a účtovníctvo v jednej architektúre.</p></header><nav><a class="btn" href="/system-design">🌳 Architektúra</a><button class="scenario active" data-s="all">🗺️ Celý systém</button><button class="scenario" data-s="call">📞 Telefonát</button><button class="scenario" data-s="chat">💬 Chat</button><button class="scenario" data-s="accounting">🧾 Účtovníctvo</button><button class="scenario" data-s="payment">💶 Platba</button><button class="scenario" data-s="scan">📷 Sken dokladu</button><button class="scenario" data-s="mcp">🔌 MCP</button></nav><section class="map">
<div class="section">Klient a komunikačná vrstva</div><div class="node" id="client" data-info="Klient vstupuje hlasom, chatom, e-mailom alebo cez web."><span class="icon">👤</span><b>Zákazník</b><small>hlas • chat • e-mail • web</small></div><div class="arrow">→</div><div class="node" id="frontend" data-info="WDFOX prijíma požiadavku, jazyk a kontext klienta."><span class="icon">🌐</span><b>WDFOX Frontend</b><small>web • komunikátor • LANG</small></div><div class="arrow">→</div><div class="node" id="orchestrator" data-info="n8n je centrálny procesný mozog: rozhodne, ktorý agent, workflow alebo firemná služba má úlohu spracovať."><span class="icon">🧠</span><b>n8n Orchestrátor</b><small>routing • workflow • pravidlá</small></div>
<div class="section">AI, znalosti a kontrola</div><div class="node" id="human" data-info="Human approval pre citlivé kroky. Finančné operácie nemajú byť vykonávané iba rozhodnutím AI bez nastavenej autorizačnej politiky."><span class="icon">🧑‍💼</span><b>Peter / Approval</b><small>schválenie • kontrola</small></div><div class="arrow">↔</div><div class="node" id="agents" data-info="Špecializovaní agenti: komunikácia, web, administratíva a účtovný asistent."><span class="icon">🤖</span><b>AI Agenti</b><small>support • web • accounting</small></div><div class="arrow">↔</div><div class="node" id="rag" data-info="RAG poskytuje interné znalosti a históriu. Účtovné originály a právne záznamy však musia zostať v určenom systéme záznamu, nie iba vo vektorovej databáze."><span class="icon">📚</span><b>RAG / Qdrant</b><small>znalosti • kontext • história</small></div>
<div class="section">Účtovníctvo / Lexware Office</div><div class="node account" id="capture" data-info="Vstup dokladov: sken alebo fotografia, PDF faktúra, e-mailová príloha a ďalšie podporované zdroje. Workflow pripraví dokument na spracovanie."><span class="icon">📷</span><b>Doklady / Scan</b><small>foto • PDF • príloha</small></div><div class="arrow">→</div><div class="node account" id="accountAgent" data-info="Účtovný agent/workflow kontroluje údaje, navrhuje kategorizáciu, páruje kontext a pripravuje operáciu. Kritické zápisy a platby smerujú na schválenie."><span class="icon">🧮</span><b>Accounting Agent</b><small>kontrola • návrh • párovanie</small></div><div class="arrow">→</div><div class="node account" id="lexMcp" data-info="Bezpečnostná integračná vrstva. MCP nástroje vystavujú agentovi iba povolené účtovné operácie; samotné volania do Lexware používajú podporované API a bezpečne uložené credentials/tokeny."><span class="icon">🔐</span><b>Lexware MCP / API Gateway</b><small>permissions • API • secrets</small></div>
<div class="node account" id="bank" data-info="Bankové transakcie a platobný tok. Presný spôsob integrácie závisí od podporovaných možností banky a Lexware; platba musí mať samostatnú autorizačnú hranicu."><span class="icon">🏦</span><b>Banka / Payments</b><small>transakcie • párovanie • platba</small></div><div class="arrow">↔</div><div class="node account" id="lexware" data-info="Lexware Office je účtovný systém záznamu pre doklady, fakturáciu a účtovné procesy podľa možností zvoleného balíka a API. Integrácia bude používať iba oficiálne podporované API operácie."><span class="icon">🧾</span><b>Lexware Office</b><small>doklady • faktúry • účtovanie</small></div><div class="arrow">↔</div><div class="node account" id="accountData" data-info="Prevádzkové metadata workflowu: ID spracovania, stav, audit log, väzba na klienta/zákazku. Citlivé účtovné údaje sa nebudú nekontrolovane duplikovať."><span class="icon">🗃️</span><b>Audit / Metadata</b><small>stav • ID • audit trail</small></div>
<div class="section">Prístup k externým službám</div><div class="node" id="mcp" data-info="Centrálna MCP vrstva poskytuje agentom riadený prístup k firemným nástrojom podľa oprávnení."><span class="icon">🔌</span><b>MCP Access Layer</b><small>tools • permissions • policies</small></div><div class="arrow">↔</div><div class="node" id="external" data-info="Externé služby: Outlook, GitHub, Tawk.to, Vercel, Cloudflare a ďalšie systémy."><span class="icon">☁️</span><b>Externé systémy</b><small>Outlook • GitHub • Tawk • Vercel</small></div><div class="arrow">↔</div><div class="node" id="data" data-info="Firemná dátová vrstva pre klientov, zákazky, workflow stav a bezpečné referencie."><span class="icon">🗄️</span><b>WDFOX Data</b><small>klienti • zákazky • workflow</small></div>
</section><section class="details" id="details"><h2>🗺️ WDFOX ako firemný systém</h2><p>Komunikátor je iba jedna vetva. Nová účtovná vetva vedie: <strong>doklad → Accounting Agent → Lexware MCP/API Gateway → Lexware Office → kontrola/párovanie → audit</strong>.</p><p>Pri finančnej akcii pridávame samostatnú hranicu <strong>Peter / Approval</strong>.</p></section><div class="legend">→ tok procesu • ↔ obojsmerná výmena • zelené účtovné bloky = finančná vetva • klikni na blok pre vysvetlenie</div></main><script>
const nodes=[...document.querySelectorAll('.node')],arrows=[...document.querySelectorAll('.arrow')],details=document.querySelector('#details');nodes.forEach(n=>n.onclick=()=>{nodes.forEach(x=>x.classList.remove('on'));n.classList.add('on');details.innerHTML=`<h2>${n.querySelector('b').textContent}</h2><p>${n.dataset.info}</p>`});const sets={all:nodes.map(n=>n.id),call:['client','frontend','orchestrator','agents','rag','human'],chat:['client','frontend','orchestrator','agents','rag'],accounting:['orchestrator','human','accountAgent','lexMcp','lexware','accountData','mcp'],payment:['orchestrator','human','accountAgent','lexMcp','lexware','bank','accountData'],scan:['capture','accountAgent','lexMcp','lexware','accountData','orchestrator'],mcp:['orchestrator','agents','mcp','external','lexMcp','lexware','human']};document.querySelectorAll('.scenario').forEach(b=>b.onclick=()=>{document.querySelectorAll('.scenario').forEach(x=>x.classList.remove('active'));b.classList.add('active');nodes.forEach(n=>n.classList.toggle('on',sets[b.dataset.s].includes(n.id)));arrows.forEach(a=>a.classList.toggle('on',b.dataset.s!=='all'));const descriptions={accounting:'Účtovný proces: n8n spustí účtovný workflow, agent pripraví operáciu, integračná vrstva použije povolené API nástroje a výsledok sa zapíše/audituje.',payment:'Platobný proces: účtovný kontext → návrh platby/párovania → autorizačný bod Peter → podporovaný bankový/Lexware tok → audit výsledku.',scan:'Skenovanie: foto/PDF → workflow → extrakcia a kontrola údajov → účtovný agent → povolené API → Lexware Office → audit.',mcp:'MCP neurčuje účtovnú pravdu. Je to kontrolovaná nástrojová vrstva medzi agentmi a službami; credentials zostávajú v secrets a agent dostáva iba povolené nástroje.'};details.innerHTML=`<h2>${b.textContent}</h2><p>${descriptions[b.dataset.s]||'Zvýraznené komponenty ukazujú tok vybraného scenára.'}</p>`});
</script></body></html>