---
const layers=[
{title:'01 · KLIENTI A KOMUNIKÁCIA',nodes:[['web','🌐 WebDesignFOX / Astro','Web UI · / · /[lang]/'],['chat','💬 Tawk.to – 9 jazykov','Chat widget · jazykový loader'],['meeting','🎙️ AI Meeting Terminal','Text · audio · súbory · miestnosti'],['mobile','📱 Mobile / PWA','Navrhovaný klient']]},
{title:'02 · VSTUPY A API',nodes:[['api','🔗 REST API Gateway','HTTP request/response'],['hooks','🪝 Webhook receiver','Event → callback'],['auth','🔐 Auth & Permissions','Role · tenant · súhlas'],['realtime','📡 Realtime transport','WebRTC / WebSocket']]},
{title:'03 · RIADENIE A ORCHESTRÁCIA',nodes:[['supervisor','🦊 WDFOX AI Supervisor','Plánovanie · delegovanie'],['n8n','⚙️ n8n Orchestrator','Workflowy · retry · stav'],['router','🧭 Prompt / Model Router','Výber modelu a nástrojov'],['guard','🛡️ Guardrails & Approval','Validácia · schvaľovanie']]},
{title:'04 · AGENTI A VÝPOČTY',nodes:[['coding','👩‍💻 Coding Agent','GitHub · testy · preview'],['support','🤝 Support Agent','Zákaznícky chat'],['translate','🌍 Translation Agent','STT → preklad → TTS'],['python','🐍 Python API Worker','Spracovanie · skripty'],['llm','🧠 LLM Provider','Externý / lokálny model']]},
{title:'05 · DÁTA A PAMÄŤ',nodes:[['qdrant','🗄️ Qdrant / Vector RAG','Embeddingy · retrieval'],['db','🐘 SQL / App DB','Účty · miestnosti · metadata'],['memory','🧾 Session / Long-term State','Kontext · história'],['files','📁 Object / File Storage','Prílohy · súbory']]},
{title:'06 · INFRAŠTRUKTÚRA A PREVÁDZKA',nodes:[['docker','🐳 Docker / Compose','Kontajnery · siete · volumes'],['github','🐙 GitHub Preview / Main','Repo · PR · Actions'],['vercel','▲ Vercel / Cloudflare','Web · API · edge'],['monitor','📊 Monitoring & Audit','Logy · evals · náklady'],['backup','💾 Backup & Recovery','Zálohy · obnova']]}
];
const routes=[
['web','api','HTTPS / REST'],['web','chat','Tawk widget'],['web','meeting','UI route'],['mobile','api','HTTPS'],['chat','hooks','Event webhook'],['meeting','realtime','WebRTC / WS'],['meeting','auth','Session / ACL'],['realtime','translate','Audio stream'],['api','auth','Token / role'],['api','supervisor','Task request'],['hooks','n8n','POST event'],['auth','guard','Permission'],['supervisor','router','Model selection'],['supervisor','n8n','Task / webhook'],['supervisor','guard','Approval'],['n8n','coding','Agent job'],['n8n','support','Agent job'],['n8n','translate','Translation job'],['n8n','python','HTTP / tool'],['router','llm','LLM API'],['coding','github','GitHub API'],['support','qdrant','RAG query'],['translate','llm','Model API'],['python','qdrant','Vector API'],['python','db','SQL'],['supervisor','memory','State read/write'],['meeting','files','File upload'],['n8n','monitor','Events / logs'],['docker','n8n','Container runtime'],['docker','qdrant','Container runtime'],['docker','python','Container runtime'],['github','vercel','Deploy / preview'],['db','backup','Backup'],['qdrant','backup','Backup'],['files','backup','Backup'],['guard','monitor','Audit event']
];
const status={web:'Repo',chat:'Repo',meeting:'Návrh',mobile:'Návrh',api:'Repo / návrh',hooks:'Návrh',auth:'Návrh',realtime:'Návrh',supervisor:'Návrh',n8n:'História projektu',router:'Návrh',guard:'Návrh',coding:'Návrh',support:'Návrh',translate:'Repo / návrh',python:'Návrh',llm:'API v repo',qdrant:'História projektu',db:'Návrh',memory:'Návrh',files:'Návrh',docker:'História projektu',github:'Repo',vercel:'Repo / projekt',monitor:'Návrh',backup:'Návrh'};
const flat=layers.flatMap((layer,li)=>layer.nodes.map(([id,name,detail],ni)=>({id,name,detail,layer:li,x:32+ni*272,y:92+li*195,status:status[id]})));
const byId=Object.fromEntries(flat.map(n=>[n.id,n]));
const links=routes.map(([from,to,type],i)=>({from,to,type,i,fromNode:byId[from],toNode:byId[to]}));
---
<!doctype html><html lang="sk"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WDFOX – Kompletná animovaná architektúra a routes</title><style>:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:#07111d;color:#edf6ff;font:15px/1.5 system-ui}main{max-width:1460px;margin:auto;padding:20px 14px 70px}a{color:#87e0ff}h1{color:#80ddff}h2{color:#a1e7cb}.warning{border:2px solid #ff9e71;background:#2b1e26;border-radius:12px;padding:13px 16px}.toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:16px 0}.toolbar button,.toolbar select{border:1px solid #5e91b1;border-radius:8px;background:#163147;color:#fff;padding:10px 13px;cursor:pointer}.canvas{border:1px solid #3b5f77;border-radius:14px;overflow:auto;background:radial-gradient(ellipse at 40% 40%,#102c42,#06101c 80%);max-height:77vh}.canvas svg{display:block;width:1200px;height:auto}.lane{fill:#102337;stroke:#2e526e;stroke-width:1}.lane-title{fill:#a9d9f4;font-size:17px;font-weight:700}.edge{fill:none;stroke:#5c94bd;stroke-width:1.8;opacity:.55}.pulse{fill:none;stroke:#72efff;stroke-width:2.6;stroke-dasharray:7 18;animation:travel 2s linear infinite}.edge-group:hover .edge{stroke:#fff;stroke-width:3;opacity:1}.edge-group:hover .pulse{stroke:#ffdd7e}.node rect{fill:#15354a;stroke:#66c6ed;stroke-width:1.6}.node text{fill:#fff;font-size:15px;font-weight:700}.node .detail{fill:#c0d7e6;font-size:12px;font-weight:400}.node .state{fill:#ffdc9a;font-size:11px}.node{cursor:pointer}.node.selected rect{stroke:#ffdc70;stroke-width:3;filter:drop-shadow(0 0 7px #ffc94e)}.edge-group.dim{opacity:.07}.node.dim{opacity:.2}.route-label{font-size:11px;fill:#d2e6f4}.route-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:8px}.route{border:1px solid #34516a;background:#102333;border-radius:9px;padding:10px}.route strong{color:#9cdeff}.legend{display:flex;gap:15px;flex-wrap:wrap;margin:12px 0;color:#bfd2e1}.details{border-left:4px solid #ffda79;padding:12px 16px;background:#152a39;margin:16px 0}@keyframes travel{to{stroke-dashoffset:-50}}.paused .pulse{animation-play-state:paused}@media(prefers-reduced-motion:reduce){.pulse{animation:none;stroke-dasharray:none;opacity:.4}}@media(max-width:650px){.canvas svg{width:1000px}.toolbar button,.toolbar select{font-size:13px}} </style></head><body><main><p><a href="/system-design">← Hlavná architektonická mapa WDFOX</a></p><h1>🦊❤️ Kompletná animovaná mapa – komponenty a routes</h1><p class="warning"><strong>‼️ ARCHITEKTONICKÁ SIMULÁCIA – NIE ŽIVÝ DOCKER.</strong> Mapa zobrazuje všetky komponenty tohto návrhu a ich navrhované spojenia. „Repo“ znamená, že v GitHube existuje súvisiaci kód, nie že služba beží. „História projektu“ nie je overenie aktuálneho stavu. Route sú logické integračné trasy, nie skutočné IP adresy ani overené sieťové spojenia. Docker zostáva nepripojený.</p><div class="toolbar"><button id="toggle" type="button">⏸ Pozastaviť</button><button id="clear" type="button">↺ Zobraziť všetky spojenia</button><label for="filter">Vrstva:</label><select id="filter"><option value="all">Všetky vrstvy</option>{layers.map((l,i)=><option value={String(i)}>{l.title}</option>)}</select></div><div class="legend"><span>🔵 Komponenty a služby</span><span>🟡 Kliknutím na blok zvýrazníš jeho routes</span><span>💠 Prerušované animované čiary = smer toku</span></div><div class="canvas" id="canvas"><svg viewBox="0 0 1200 1300" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Šesť vrstiev, 26 komponentov a 36 integračných routes v architektúre WDFOX"><defs><marker id="arr" markerWidth="8" markerHeight="8" refX="7" refY="3" orient="auto"><path d="M0 0 L7 3 L0 6 Z" fill="#5c94bd"/></marker></defs>{layers.map((l,i)=><g><rect class="lane" x="15" y={40+i*195} width="1170" height="175" rx="14"/><text class="lane-title" x="32" y={68+i*195}>{l.title}</text></g>)}{links.map(l=>{const a=l.fromNode,b=l.toNode;const x1=a.x+126,y1=a.y+68,x2=b.x+126,y2=b.y;const delta=Math.abs(x2-x1);const d=`M ${x1} ${y1} C ${x1+(x2-x1)*.1} ${y1+42+delta*.025}, ${x2-(x2-x1)*.1} ${y2-42-delta*.025}, ${x2} ${y2}`;return <g class="edge-group" data-from={l.from} data-to={l.to}><title>{a.name} → {b.name}: {l.type}</title><path class="edge" d={d} marker-end="url(#arr)"/><path class="pulse" d={d} style={`animation-delay:-${(l.i%9)*.21}s`}/></g>})}{flat.map(n=><g class="node" tabindex="0" role="button" aria-label={`${n.name}, ${n.status}. Zobraziť spojenia`} data-id={n.id}><rect x={n.x} y={n.y} width="252" height="85" rx="12"/><text x={n.x+12} y={n.y+25}>{n.name}</text><text class="detail" x={n.x+12} y={n.y+46}>{n.detail}</text><text class="state" x={n.x+12} y={n.y+68}>{n.status}</text></g>)}</svg></div><div class="details" id="details" aria-live="polite">Klikni na ľubovoľný komponent. Zvýraznia sa jeho vstupné a výstupné routes.</div><h2>Všetky integračné routes – {routes.length} spojení</h2><div class="route-list">{links.map((l,i)=><div class="route" data-route={i}><strong>{i+1}. {l.fromNode.name} → {l.toNode.name}</strong><div>{l.type}</div></div>)}</div><h2>Čo bude znamenať druhá fáza</h2><p>Až po tvojom schválení porovnáme tento návrh so skutočnými Docker Compose službami, sieťami, healthcheckmi a kontajnermi. Vtedy pridáme read-only monitorovací zdroj. Žiadne verejné vystavenie Docker socketu, interných IP adries, tokenov ani hesiel.</p><p><a href="/system-design/docker-kubernetes">🐳 Docker a Kubernetes</a> · <a href="/system-design/ai-agent-architecture">❤️ 7 komponentov AI agenta</a> · <a href="/system-design/api-webhooks">🔗 API a webhooky</a></p></main><script>const canvas=document.getElementById('canvas'),detail=document.getElementById('details'),nodes=[...document.querySelectorAll('.node')],edges=[...document.querySelectorAll('.edge-group')],routeRows=[...document.querySelectorAll('.route')],filter=document.getElementById('filter');function select(id){nodes.forEach(n=>{n.classList.toggle('selected',n.dataset.id===id);n.classList.toggle('dim',!!id&&n.dataset.id!==id)});edges.forEach(e=>e.classList.toggle('dim',!!id&&e.dataset.from!==id&&e.dataset.to!==id));routeRows.forEach((r,i)=>{const e=edges[i];r.style.display=!id||e.dataset.from===id||e.dataset.to===id?'':'none'});const node=nodes.find(n=>n.dataset.id===id);detail.textContent=id&&node?('Vybraný komponent: '+node.getAttribute('aria-label')+'. Zvýraznené sú všetky jeho vstupné a výstupné spojenia.'): 'Zobrazené všetky komponenty a routes.'}nodes.forEach(n=>{n.addEventListener('click',()=>select(n.dataset.id));n.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();select(n.dataset.id)}})});document.getElementById('clear').addEventListener('click',()=>{filter.value='all';nodes.forEach(n=>n.style.display='');select(null)});document.getElementById('toggle').addEventListener('click',e=>{const p=canvas.classList.toggle('paused');e.currentTarget.textContent=p?'▶ Pokračovať':'⏸ Pozastaviť'});filter.addEventListener('change',()=>{const v=filter.value;nodes.forEach(n=>{n.style.display=v==='all'||Math.floor((Number(n.querySelector('rect').getAttribute('y'))-92)/195)===Number(v)?'':'none'});select(null)})</script></body></html>