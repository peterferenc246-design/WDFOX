---
const nodes=[
{id:'user',label:'Používateľ / klient',sub:'Text • hlas • súbory',x:20,y:35,w:210,h:76,c:'#43d6ff'},
{id:'terminal',label:'WDFOX Meeting Terminal',sub:'Web / PWA / chat',x:305,y:35,w:240,h:76,c:'#43d6ff'},
{id:'supervisor',label:'WDFOX AI Supervisor',sub:'Plánovanie • pravidlá',x:625,y:35,w:255,h:76,c:'#f3a6ff'},
{id:'n8n',label:'n8n orchestrátor',sub:'Workflowy • webhooky',x:625,y:218,w:255,h:76,c:'#ffb65d'},
{id:'python',label:'Python API / agenti',sub:'Nástroje • spracovanie',x:315,y:410,w:250,h:76,c:'#78e6a3'},
{id:'qdrant',label:'Qdrant / RAG',sub:'Vektorový kontext',x:20,y:410,w:225,h:76,c:'#78e6a3'},
{id:'llm',label:'LLM model',sub:'Generovanie • rozhodovanie',x:625,y:410,w:255,h:76,c:'#78e6a3'},
{id:'safety',label:'Audit • monitoring • schválenie',sub:'Prierezová ochranná vrstva',x:230,y:575,w:450,h:76,c:'#ffdc86'}
];
const edges=[['user','terminal'],['terminal','supervisor'],['supervisor','n8n'],['n8n','python'],['n8n','llm'],['python','qdrant'],['python','safety'],['llm','safety']];
const lookup=Object.fromEntries(nodes.map(n=>[n.id,n]));
const paths=edges.map(([a,b])=>{const s=lookup[a],t=lookup[b];const sx=s.x+s.w/2,sy=s.y+s.h/2,tx=t.x+t.w/2,ty=t.y+t.h/2;const vertical=Math.abs(ty-sy)>Math.abs(tx-sx);const x1=vertical?sx:(tx>sx?s.x+s.w:s.x),y1=vertical?(ty>sy?s.y+s.h:s.y):sy,x2=vertical?tx:(tx>sx?t.x:t.x+t.w),y2=vertical?(ty>sy?t.y:t.y+t.h):ty;return {a,b,d:vertical?`M ${x1} ${y1} C ${x1} ${(y1+y2)/2}, ${x2} ${(y1+y2)/2}, ${x2} ${y2}`:`M ${x1} ${y1} C ${(x1+x2)/2} ${y1}, ${(x1+x2)/2} ${y2}, ${x2} ${y2}`}});
---
<!doctype html><html lang="sk"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>WDFOX – Animovaná architektúra AI a Docker</title><style>:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:#06101d;color:#edf7ff;font:16px/1.6 system-ui}main{max-width:1120px;margin:auto;padding:25px 16px 80px}a{color:#83e3ff}h1{color:#85e4ff}h2{color:#9fe6c4}.notice{background:#162839;border:1px solid #46718c;border-radius:14px;padding:14px 18px}.stage{background:radial-gradient(ellipse at 50% 35%,#183752,#07121e 75%);border:1px solid #315471;border-radius:18px;overflow:auto}.stage svg{display:block;min-width:600px;width:100%;height:auto}.edge{fill:none;stroke:#4aa9dc;stroke-width:2;opacity:.52}.moving{fill:none;stroke:#7df2ff;stroke-width:3;stroke-dasharray:8 22;animation:move 1.7s linear infinite;filter:drop-shadow(0 0 5px #7df2ff)}@keyframes move{to{stroke-dashoffset:-60}}.node rect{fill:#122b3d;stroke-width:2}.node text{font-family:system-ui;fill:#f3fbff}.node .small{fill:#b8d0df;font-size:14px}.node .name{font-size:17px;font-weight:700}.node{transition:opacity .25s}.stage.paused .moving{animation-play-state:paused}.buttons{display:flex;gap:10px;flex-wrap:wrap;margin:15px 0}.buttons button{background:#173a51;color:#fff;border:1px solid #63a6c5;padding:10px 16px;border-radius:9px;cursor:pointer}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px}.card{background:#112333;border:1px solid #34546b;padding:16px;border-radius:13px}@media(prefers-reduced-motion:reduce){.moving{animation:none;stroke-dasharray:none;opacity:.5}}</style></head><body><main><p><a href="/system-design">← Hlavná architektonická mapa WDFOX</a></p><h1>🦊❤️ Animovaná architektúra WDFOX AI & Docker</h1><p class="notice"><strong>‼️ DEMO / NÁVRH – bez napojenia na Docker.</strong> Všetky bloky a prúdiace spojenia sú vizualizácia plánovanej architektúry, nie živý stav kontajnerov. Pripojenie na skutočný Docker vykonáme až po výslovnom odsúhlasení.</p><div class="buttons"><button type="button" id="toggle" aria-pressed="false">⏸ Pozastaviť animáciu</button><button type="button" id="reset">↻ Spustiť animáciu</button></div><div class="stage" id="stage" role="img" aria-label="Animovaná schéma toku: používateľ, WDFOX Meeting Terminal, Supervisor, n8n, Python agenti, Qdrant, LLM a audit. Ide o návrh, nie živé dáta."><svg viewBox="0 0 910 680" xmlns="http://www.w3.org/2000/svg"><defs><marker id="arrow" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto"><path d="M0 0 L7 3 L0 6 Z" fill="#69cdeb"/></marker></defs>{paths.map(p=><g><path class="edge" d={p.d} marker-end="url(#arrow)"/><path class="moving" d={p.d}/></g>)}{nodes.map(n=><g class="node"><rect x={n.x} y={n.y} width={n.w} height={n.h} rx="13" stroke={n.c}/><text class="name" x={n.x+n.w/2} y={n.y+31} text-anchor="middle">{n.label}</text><text class="small" x={n.x+n.w/2} y={n.y+54} text-anchor="middle">{n.sub}</text></g>)}</svg></div><p><small>Animované čiarkované čiary znázorňujú možný tok dát. Pre jednoduchšie zobrazenie sú niektoré reálne spätné odpovede a väzby vynechané.</small></p><h2>3 typy AI – miesto v našej architektúre</h2><div class="grid"><div class="card"><h3>🔵 Predictive AI</h3><p>Predikcie a analytika na základe dát. Pre WDFOX voliteľná budúca vrstva, nie potvrdený komponent.</p></div><div class="card"><h3>🟣 Generative AI</h3><p>LLM generuje text, odpovede, kód alebo preklady. V schéme reprezentované modelom LLM.</p></div><div class="card"><h3>🟢 Agentic AI</h3><p>Supervisor koordinuje úlohy a nástroje cez n8n, Python API a dátový kontext.</p></div></div><h2>Pred schválením pripojenia na Docker</h2><ol><li>Odsúhlasiť názvy blokov a smerovanie spojení.</li><li>Overiť skutočný zoznam kontajnerov a ich závislosti bez zverejnenia hesiel alebo interných adries.</li><li>Navrhnúť read-only konektor na stav kontajnerov a healthchecky, bez prístupu k Docker socketu z verejného webu.</li><li>Po schválení pridať autentifikované živé údaje; žiadne automatické nasadenie do produkcie.</li></ol><p><a href="/system-design/docker-kubernetes">🐳 Docker vs Kubernetes</a> · <a href="/system-design/ai-agent-architecture">❤️ AI Agent Architecture</a> · <a href="/system-design/api-webhooks">🔗 API & Webhooks</a></p></main><script>const stage=document.getElementById('stage'),toggle=document.getElementById('toggle');toggle.addEventListener('click',()=>{const paused=stage.classList.toggle('paused');toggle.textContent=paused?'▶ Pokračovať v animácii':'⏸ Pozastaviť animáciu';toggle.setAttribute('aria-pressed',String(paused))});document.getElementById('reset').addEventListener('click',()=>{stage.classList.remove('paused');toggle.textContent='⏸ Pozastaviť animáciu';toggle.setAttribute('aria-pressed','false');stage.querySelectorAll('.moving').forEach(e=>{e.style.animation='none';e.getBoundingClientRect();e.style.animation=''})});</script></body></html>