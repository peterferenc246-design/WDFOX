---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Landing from "../../components/Landing.astro";
import FoxAnalyzerLauncher from "../../components/FoxAnalyzerLauncher.astro";
import FoxLiveTranslator from "../../components/FoxLiveTranslator.astro";
import FoxGeminiAudioBridge from "../../components/FoxGeminiAudioBridge.astro";
import FoxHangupButton from "../../components/FoxHangupButton.astro";
import { getLandingContent } from "../../lib/sanity";
import { locales, type Locale } from "../../data/content";

export function getStaticPaths() { return locales.map((lang) => ({ params: { lang }, props: { lang } })); }
const lang = Astro.props.lang as Locale;
const content = await getLandingContent(lang);
---
<BaseLayout locale={lang} title={content.title} description={content.heroDescription}>
  <Fragment slot="navigation">
    <a class="nav-link active" href={`/${lang}/#domov`}>{content.nav.home}</a>
    <a class="nav-link" href={`/${lang}/#portfolio`}>{content.nav.portfolio}</a>
    <a class="nav-link" href={`/${lang}/#o-mne`}>{content.nav.about}</a>
    <a class="nav-link" href={`/${lang}/#proces`}>{content.nav.process}</a>
    <a class="nav-link" href={`/${lang}/#kontakt`}>{content.nav.contact}</a>
  </Fragment>
  <Landing content={content} />
  <FoxHangupButton />
  <FoxLiveTranslator locale={lang} />
  <FoxGeminiAudioBridge />
  <FoxAnalyzerLauncher locale={lang} />
  <Fragment slot="footer-links">
    <a href={`/${lang}/#domov`}>{content.nav.home}</a>
    <a href={`/${lang}/#portfolio`}>{content.nav.portfolio}</a>
    <a href={`/${lang}/#kontakt`}>{content.nav.contact}</a>
  </Fragment>
</BaseLayout>

<script is:inline>
(() => {
  const LIVE='https://wdfox-live-translator.vercel.app', GEMINI='https://wdfox-gemini-api.vercel.app', nativeFetch=window.fetch.bind(window);
  window.fetch=(input,init)=>{const url=typeof input==='string'?input:input?.url||'';if(url.startsWith('/api/')){const base=url.startsWith('/api/gemini-chat')?GEMINI:LIVE;const target=base+url;return typeof input==='string'?nativeFetch(target,init):nativeFetch(new Request(target,input),init)}return nativeFetch(input)};
})();
</script>

<style is:global>
/* WDFOX — FINAL MORNING CONTACT BLOCK RESTORATION */
.register-media-row{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;gap:16px!important;align-items:start!important;}
.register-photo{width:100%!important;height:170px!important;object-fit:cover!important;border-radius:0!important;}
.register-map-wrap{width:100%!important;max-width:none!important;flex:initial!important;}
.register-map{display:block!important;width:100%!important;height:170px!important;border:0!important;border-radius:12px!important;background:#e7edf0!important;}
.register-map-link{display:block!important;margin-top:6px!important;font-size:.72rem!important;font-weight:700!important;text-decoration:underline!important;}
.contact-socials{display:flex!important;align-items:center!important;gap:12px!important;margin-top:14px!important;}
.contact-socials a{display:grid!important;place-items:center!important;width:38px!important;height:38px!important;border:1px solid rgba(255,255,255,.48)!important;border-radius:50%!important;background:transparent!important;color:#fff!important;text-decoration:none!important;}
.contact-socials a svg{display:block!important;width:21px!important;height:21px!important;visibility:visible!important;opacity:1!important;color:currentColor!important;}
@media(max-width:900px){.register-media-row{grid-template-columns:1fr!important}.register-photo{width:min(100%,270px)!important}.register-map-wrap{width:min(100%,270px)!important}.register-map{width:100%!important;height:220px!important;}}
</style>
