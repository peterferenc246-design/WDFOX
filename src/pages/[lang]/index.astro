---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Landing from "../../components/Landing.astro";
import FoxAnalyzerLauncher from "../../components/FoxAnalyzerLauncher.astro";
import FoxLiveTranslator from "../../components/FoxLiveTranslator.astro";
import FoxAvailability from "../../components/FoxAvailability.astro";
import FoxGeminiAudioBridge from "../../components/FoxGeminiAudioBridge.astro";
import FoxHangupButton from "../../components/FoxHangupButton.astro";
import FoxAiNotificationsPrototype from "../../components/FoxAiNotificationsPrototype.astro";
import { getLandingContent } from "../../lib/sanity";
import { locales, type Locale } from "../../data/content";

export function getStaticPaths() { return locales.map((lang) => ({ params: { lang }, props: { lang } })); }
const lang = Astro.props.lang as Locale;
const content = await getLandingContent(lang);
---
<BaseLayout locale={lang} title={content.title} description={content.heroDescription}>
  <Fragment slot="navigation">
    <a class="nav-link active" href={`/${lang}/#domov`}>{content.nav.home}</a>
    <a class="nav-link" href={`/${lang}/#portfolio`}>{content.nav.portfolio}</a>
    <a class="nav-link" href={`/${lang}/#o-mne`}>{content.nav.about}</a>
    <a class="nav-link" href={`/${lang}/#proces`}>{content.nav.process}</a>
    <a class="nav-link" href={`/${lang}/#kontakt`}>{content.nav.contact}</a>
  </Fragment>
  <Landing content={content} />
  <FoxAiNotificationsPrototype />
  <FoxHangupButton />
  <script is:inline src="/fox-webrtc-hardening.js?v=20260920a"></script>
  <FoxLiveTranslator locale={lang} />
  <FoxAvailability locale={lang} />
  <FoxGeminiAudioBridge />
  <FoxAnalyzerLauncher locale={lang} />
  <Fragment slot="footer-links">
    <a href={`/${lang}/#domov`}>{content.nav.home}</a>
    <a href={`/${lang}/#portfolio`}>{content.nav.portfolio}</a>
    <a href={`/${lang}/#kontakt`}>{content.nav.contact}</a>
  </Fragment>
</BaseLayout>

<script is:inline>
(() => {
  const LIVE='https://wdfox-live-translator.vercel.app';
  const TRANSLATOR='https://wdfox.vercel.app';
  const nativeFetch=window.fetch.bind(window);
  const isCommunicator=()=>document.querySelector('[data-fox-live]')?.classList.contains('is-call-mode')===true;

  // Gemini Live already provides the translated audio in communicator mode.
  // Suppress the legacy browser TTS so it cannot echo/duplicate the Live audio.
  try{
    if(window.speechSynthesis && !window.__foxNativeSpeechSpeak){
      window.__foxNativeSpeechSpeak=window.speechSynthesis.speak.bind(window.speechSynthesis);
      window.speechSynthesis.speak=(utterance)=>{
        if(isCommunicator() && window.__foxGeminiAudioBridge) return;
        return window.__foxNativeSpeechSpeak(utterance);
      };
    }
  }catch{}

  window.fetch=async(input,init)=>{
    const url=typeof input==='string'?input:input?.url||'';

    if(url.startsWith('/api/gemini-chat')){
      // COMMUNICATOR = Gemini Live only. Never call the legacy REST translator.
      if(isCommunicator() && window.__foxGeminiAudioBridge){
        const current=String(document.querySelector('[data-translation]')?.textContent||'').trim();
        const liveText=current || '\u200B';
        return new Response(JSON.stringify({
          text:liveText,
          translation:liveText,
          interactionId:null,
          liveOnly:true
        }),{
          status:200,
          headers:{'Content-Type':'application/json','Cache-Control':'no-store'}
        });
      }

      // Stand-alone TRANSLATOR mode keeps the existing REST text translation.
      try{
        const original=JSON.parse(String(init?.body||'{}'));
        const prompt=String(original?.message||'');
        const match=prompt.match(/Translate only this spoken sentence from (.+?) to (.+?)\.[\s\S]*?Sentence:\s*([\s\S]*)$/);
        const sourceLanguage=match?.[1]?.trim()||'English';
        const targetLanguage=match?.[2]?.trim()||'Slovak';
        const text=match?.[3]?.trim()||prompt;

        const r=await nativeFetch(TRANSLATOR+'/api/translate-text',{
          method:'POST',
          headers:{'Content-Type':'application/json','Accept':'application/json'},
          body:JSON.stringify({text,sourceLanguage,targetLanguage}),
          cache:'no-store'
        });
        const d=await r.json().catch(()=>({}));
        const translated=String(d?.translatedText||d?.translation||d?.text||'').trim();
        return new Response(JSON.stringify({
          text:translated,
          translation:translated,
          interactionId:null,
          error:d?.error
        }),{
          status:r.status,
          statusText:r.statusText,
          headers:{'Content-Type':'application/json'}
        });
      }catch(e){
        return new Response(JSON.stringify({error:e?.message||'Translation bridge failed'}),{
          status:502,
          headers:{'Content-Type':'application/json'}
        });
      }
    }

    if(url.startsWith('/api/')){
      const target=LIVE+url;
      return typeof input==='string'
        ? nativeFetch(target,init)
        : nativeFetch(new Request(target,input),init);
    }

    return nativeFetch(input,init);
  };
})();
</script>
