---
import "../styles/site.css";
import { locales, localeLabels, type Locale } from "../data/content";
interface Props { locale: Locale; title: string; description: string; }
const { locale, title, description } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://webdizain-bbyygbqm.manus.space";
const pathFor = (code: Locale) => code === "de" ? "/de/" : `/${code}/`;
const footerCopy: Record<Locale, { contact: string; note: string; online: string }> = {
  de: { contact: "Kontakt", note: "Moderne Websites, die verkaufen. Und Technik, die Sie nicht aufhält.", online: "Deutschland · online" },
  en: { contact: "Contact", note: "Modern websites that convert. Technology that never slows you down.", online: "Germany · online" },
  sk: { contact: "Kontakt", note: "Moderné weby, ktoré predávajú. A technika, ktorá vás nezdržiava.", online: "Nemecko · online" },
  fr: { contact: "Contact", note: "Des sites modernes qui convertissent. Une technique qui ne vous ralentit pas.", online: "Allemagne · en ligne" },
  hr: { contact: "Kontakt", note: "Moderne web stranice koje donose rezultate. Tehnologija koja vas ne usporava.", online: "Njemačka · online" },
  pl: { contact: "Kontakt", note: "Nowoczesne strony, które zdobywają klientów. Technologia, która Cię nie spowalnia.", online: "Niemcy · online" },
  it: { contact: "Contatti", note: "Siti moderni che fanno crescere. Tecnologia che non rallenta.", online: "Germania · online" },
  es: { contact: "Contacto", note: "Sitios modernos que hacen crecer. Tecnología que nunca te frena.", online: "Alemania · online" },
  sv: { contact: "Kontakt", note: "Moderna webbplatser som skapar resultat. Teknik som aldrig bromsar dig.", online: "Tyskland · online" },
};
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#f36a0a" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" /><link rel="canonical" href={`${siteUrl}${pathFor(locale)}`} />{locales.map((code) => <link rel="alternate" hreflang={code} href={`${siteUrl}${pathFor(code)}`} />)}<title>{title}</title></head><body><div class="site-shell" id="domov"><div class="topline" aria-hidden="true"></div><header class="site-header"><div class="header-inner"><a class="brand" href={pathFor(locale)} aria-label="WebDesignFOX – domov"><span class="brand-mark" aria-hidden="true"><span class="fox-symbol"><i></i><b></b></span></span><span class="brand-copy"><span class="brand-name">WebDesign<span>FOX</span></span><span class="brand-tagline">{localeLabels[locale]} · WebDesign & Technik</span></span></a><nav class="main-nav" aria-label="Hauptnavigation"><slot name="navigation" /></nav><div class="header-actions"><div class="language-switcher" aria-label="Language selector">{locales.map((code) => <a class:list={{ "language-flag": true, active: code === locale }} href={`${siteUrl}${pathFor(code)}`} title={localeLabels[code]} aria-label={localeLabels[code]}><img src={`https://flagcdn.com/${code === "en" ? "gb" : code === "sv" ? "se" : code}.svg`} alt={code.toUpperCase()} /></a>)}</div><a class="nav-cta" href="#kontakt">✦ Beratung</a></div><button class="menu-toggle" type="button">☰</button></div></header><main><slot /></main><footer class="site-footer section-wrap"><div class="footer-main"><div><a class="brand" href={pathFor(locale)}><span class="brand-name">WebDesign<span>FOX</span></span></a><p class="footer-note">{footerCopy[locale].note}</p></div><div class="footer-links"><strong>{footerCopy[locale].contact}</strong><a href="mailto:info@foxprof.club">info@foxprof.club</a><a href="tel:+4915731733332">+49 157 31733332</a><span>{footerCopy[locale].online}</span></div></div><div class="footer-bottom"><span>© 2026 WebDesignFOX</span></div></footer></div>
<script is:inline>
  window.Tawk_API = window.Tawk_API || {};
  window.Tawk_LoadStart = new Date();
  (function () {
    var s1 = document.createElement("script");
    var s0 = document.getElementsByTagName("script")[0];
    s1.async = true;
    s1.src = "https://embed.tawk.to/6a951d52c3c46c344587662a/1k1b9121q";
    s1.charset = "UTF-8";
    s1.setAttribute("crossorigin", "*");
    s0.parentNode.insertBefore(s1, s0);
  })();
  document.addEventListener("click", function (event) {
    var trigger = event.target.closest(".live-chat-bubble");
    if (!trigger) return;
    event.preventDefault();
    if (window.Tawk_API && typeof window.Tawk_API.maximize === "function") {
      window.Tawk_API.maximize();
    }
  });
</script></body></html>
