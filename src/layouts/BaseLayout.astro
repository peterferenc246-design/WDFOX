---
import "../styles/site.css";
import { locales, localeLabels, type Locale } from "../data/content";
interface Props { locale: Locale; title: string; description: string; }
const { locale, title, description } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://webdizain-bbyygbqm.manus.space";
const pathFor = (code: Locale) => code === "de" ? "/de/" : `/${code}/`;
const footerCopy: Record<Locale, { contact: string; note: string; online: string }> = {
  de: { contact: "Kontakt", note: "Moderne Websites, die verkaufen. Und Technik, die Sie nicht aufhält.", online: "Deutschland · online" },
  en: { contact: "Contact", note: "Modern websites that convert. Technology that never slows you down.", online: "Germany · online" },
  sk: { contact: "Kontakt", note: "Moderné weby, ktoré predávajú. A technika, ktorá vás nezdržiava.", online: "Nemecko · online" },
  fr: { contact: "Contact", note: "Des sites modernes qui convertissent. Une technique qui ne vous ralentit pas.", online: "Allemagne · en ligne" },
  hr: { contact: "Kontakt", note: "Moderne web stranice koje donose rezultate. Tehnologija koja vas ne usporava.", online: "Njemačka · online" },
  pl: { contact: "Kontakt", note: "Nowoczesne strony, które zdobywają klientów. Technologia, która Cię nie spowalnia.", online: "Niemcy · online" },
  it: { contact: "Contatti", note: "Siti moderni che fanno crescere. Tecnologia che non rallenta.", online: "Germania · online" },
  es: { contact: "Contacto", note: "Sitios modernos que hacen crecer. Tecnología que nunca te frena.", online: "Alemania · online" },
  sv: { contact: "Kontakt", note: "Moderna webbplatser som skapar resultat. Teknik som aldrig bromsar dig.", online: "Tyskland · online" },
};
const consultationCta: Record<Locale, string> = { de:"Beratung", en:"Consultation", sk:"Konzultácia", fr:"Consultation", hr:"Savjetovanje", pl:"Konsultacja", it:"Consulenza", es:"Consulta", sv:"Konsultation" };
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#f36a0a" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" /><link rel="canonical" href={`${siteUrl}${pathFor(locale)}`} />{locales.map((code) => <link rel="alternate" hreflang={code} href={`${siteUrl}${pathFor(code)}`} />)}<title>{title}</title><style is:inline>
#fixed-lang-layer{position:fixed!important;top:6px!important;right:190px!important;left:auto!important;bottom:auto!important;z-index:2147483646!important;margin:0!important;padding:5px 7px!important;display:flex!important;align-items:center!important;gap:6px!important;flex-wrap:wrap!important;max-width:290px!important;border-radius:8px!important;background:rgba(255,255,255,.96)!important;box-shadow:0 6px 18px rgba(20,28,42,.14)!important;backdrop-filter:blur(10px)!important;-webkit-backdrop-filter:blur(10px)!important;transform:none!important;translate:none!important;visibility:visible!important;opacity:1!important;pointer-events:auto!important;overflow:visible!important}
#fixed-lang-layer .language-flag{display:inline-flex!important;flex:0 0 24px!important;width:24px!important;height:18px!important}.header-actions{padding-top:22px!important}
@media(max-width:900px){#fixed-lang-layer{top:6px!important;right:76px!important;max-width:210px!important;gap:4px!important;padding:4px 5px!important}.header-actions{padding-top:18px!important}}@media(max-width:560px){#fixed-lang-layer{top:5px!important;right:64px!important;max-width:170px!important}#fixed-lang-layer .language-flag{flex-basis:22px!important;width:22px!important;height:16px!important}.header-actions{padding-top:16px!important}}
#kontakt .contact-copy,#kontakt .register-identity-grid,#kontakt .register-identity-left,#kontakt .register-identity-right,#kontakt .register-person-name,#kontakt .register-address,#kontakt .register-right-details,#kontakt .register-identity-right>img{visibility:visible!important;opacity:1!important}#kontakt .register-identity-grid{display:grid!important;grid-template-columns:minmax(0,1fr) 270px!important;gap:1.5rem!important;align-items:start!important;margin-top:1.5rem!important}#kontakt .register-identity-left,#kontakt .register-identity-right{display:grid!important;position:relative!important;transform:none!important}#kontakt .register-identity-left{gap:1.5rem!important}#kontakt .register-identity-right{gap:1.25rem!important;width:270px!important;justify-items:start!important}#kontakt .register-person-name,#kontakt .register-address,#kontakt .register-right-details{display:block!important;position:relative!important;transform:none!important}#kontakt .register-address{display:flex!important;gap:.65rem!important}#kontakt .register-identity-right>img{display:block!important;width:270px!important;height:180px!important;object-fit:cover!important;position:relative!important;transform:none!important}#kontakt .register-right-details{width:270px!important;white-space:nowrap!important}@media(max-width:760px){#kontakt .register-identity-grid{grid-template-columns:1fr!important}#kontakt .register-identity-right,#kontakt .register-right-details{width:100%!important}#kontakt .register-identity-right>img{width:100%!important;max-width:270px!important;height:auto!important}#kontakt .register-right-details{white-space:normal!important}}
</style></head><body>
<div id="fixed-lang-layer" class="language-switcher" aria-label="Language selector" style="position:fixed;top:6px;right:190px;z-index:2147483646;transform:none;visibility:visible;opacity:1;">{locales.map((code) => <a class:list={{ "language-flag": true, active: code === locale }} href={`${siteUrl}${pathFor(code)}`} title={localeLabels[code]} aria-label={localeLabels[code]}><img src={`https://flagcdn.com/${code === "en" ? "gb" : code === "sv" ? "se" : code}.svg`} alt={code.toUpperCase()} /></a>)}</div>
<div class="site-shell" id="domov"><div class="topline" aria-hidden="true"></div><header class="site-header"><div class="header-inner"><a class="brand" href={pathFor(locale)} aria-label="WebDesignFOX – domov"><span class="brand-mark" aria-hidden="true"><span class="fox-symbol"><i></i><b></b></span></span><span class="brand-copy"><span class="brand-name">WebDesign<span>FOX</span></span><span class="brand-tagline">{localeLabels[locale]} · WebDesign & Technik</span></span></a><nav class="main-nav" aria-label="Hauptnavigation"><slot name="navigation" /></nav><div class="header-actions"><a class="nav-cta" href="#kontakt">✦ {consultationCta[locale]}</a></div><button class="menu-toggle" type="button">☰</button></div></header><main><slot /></main><footer class="site-footer section-wrap"><div class="footer-main"><div><a class="brand" href={pathFor(locale)}><span class="brand-name">WebDesign<span>FOX</span></span></a><p class="footer-note">{footerCopy[locale].note}</p></div><div class="footer-links"><strong>{footerCopy[locale].contact}</strong><a href="mailto:info@foxprof.club">info@foxprof.club</a><a href="tel:+4915731733332">+49 157 31733332</a><span>{footerCopy[locale].online}</span></div></div><div class="footer-bottom"><span>© 2026 WebDesignFOX</span></div></footer></div>
<script is:inline>(function(){const lang=document.getElementById('fixed-lang-layer');if(!lang)return;const enforce=()=>{const mobile=window.innerWidth<=900;const tiny=window.innerWidth<=560;lang.style.setProperty('position','fixed','important');lang.style.setProperty('top',tiny?'5px':mobile?'6px':'6px','important');lang.style.setProperty('right',tiny?'64px':mobile?'76px':'190px','important');lang.style.setProperty('left','auto','important');lang.style.setProperty('bottom','auto','important');lang.style.setProperty('z-index','2147483646','important');lang.style.setProperty('transform','none','important');lang.style.setProperty('visibility','visible','important');lang.style.setProperty('opacity','1','important');};enforce();window.addEventListener('scroll',enforce,{passive:true});window.addEventListener('resize',enforce,{passive:true});new MutationObserver(enforce).observe(lang,{attributes:true,attributeFilter:['style','class']});})();</script>
<script is:inline src="/tawk-language-loader.js?v=ee97e723"></script>
<script is:inline src="/cunderlik-gallery-runtime.js?v=6"></script></body></html>