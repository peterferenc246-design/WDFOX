---
import "../styles/site.css";
import { locales, localeLabels, type Locale } from "../data/content";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://webdizain-bbyygbqm.manus.space";
const pathFor = (code: Locale) => code === "de" ? "/de/" : `/${code}/`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f36a0a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="canonical" href={`${siteUrl}${pathFor(locale)}`} />
    {locales.map((code) => <link rel="alternate" hreflang={code} href={`${siteUrl}${pathFor(code)}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/de/`} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell" id="domov">
      <div class="topline" aria-hidden="true"></div>
      <header class="site-header">
        <div class="header-inner">
          <a class="brand" href={pathFor(locale)} aria-label="WebDizainFOX – domov">
            <span class="brand-mark" aria-hidden="true"><span class="fox-symbol"><i></i><b></b></span></span>
            <span class="brand-copy"><span class="brand-name">WebDizain<span>FOX</span></span><span class="brand-tagline">{localeLabels[locale]} · WebDesign & Technik</span></span>
          </a>
          <nav class="main-nav" aria-label="Hauptnavigation">
            <slot name="navigation" />
          </nav>
          <div class="header-actions">
            <details class="language-switcher">
              <summary aria-label="Sprache wechseln">{locale.toUpperCase()} <span aria-hidden="true">⌄</span></summary>
              <div class="language-menu">
                {locales.map((code) => <a href={pathFor(code)} class:list={{ active: code === locale }}>{code.toUpperCase()} · {localeLabels[code]}</a>)}
              </div>
            </details>
            <a class="nav-cta" href={`#kontakt`}>✦ {locale === "de" ? "Beratung" : locale === "en" ? "Consultation" : locale === "sk" ? "Konzultácia" : locale === "fr" ? "Consultation" : locale === "hr" ? "Konzultacije" : locale === "pl" ? "Konsultacja" : locale === "it" ? "Consulenza" : locale === "es" ? "Consulta" : "Konsultation"}</a>
          </div>
          <button class="menu-toggle" type="button" aria-label="Menu öffnen" aria-expanded="false">☰</button>
        </div>
      </header>
      <main><slot /></main>
      <footer class="site-footer section-wrap">
        <div class="footer-main">
          <div><a class="brand" href={pathFor(locale)}><span class="brand-mark" aria-hidden="true"><span class="fox-symbol"><i></i><b></b></span></span><span class="brand-copy"><span class="brand-name">WebDizain<span>FOX</span></span><span class="brand-tagline">{localeLabels[locale]}</span></span></a><p class="footer-note">{locale === "de" ? "Moderne Websites, die verkaufen. Und Technik, die Sie nicht aufhält." : locale === "en" ? "Modern websites that convert. Technology that never slows you down." : locale === "sk" ? "Moderné weby, ktoré predávajú. A technika, ktorá vás nezdržiava." : locale === "fr" ? "Des sites modernes qui convertissent. Une technique qui ne vous ralentit pas." : locale === "hr" ? "Moderne web stranice koje rade. Tehnika koja vas ne usporava." : locale === "pl" ? "Nowoczesne strony, które sprzedają. Technologia, która nie spowalnia." : locale === "it" ? "Siti moderni che fanno crescere. Tecnologia che non rallenta." : locale === "es" ? "Webs modernas que hacen crecer. Tecnología que nunca te frena." : "Moderna webbplatser som skapar resultat. Teknik som aldrig bromsar dig."}</p></div>
          <div class="footer-links"><strong>{locale === "de" ? "Direkt zu" : locale === "en" ? "Jump to" : locale === "sk" ? "Preskočiť na" : locale === "fr" ? "Aller à" : locale === "hr" ? "Idi na" : locale === "pl" ? "Przejdź do" : locale === "it" ? "Vai a" : locale === "es" ? "Ir a" : "Gå till"}</strong><slot name="footer-links" /></div>
          <div class="footer-links"><strong>Kontakt</strong><a href="mailto:info@foxprof.club">info@foxprof.club</a><a href="tel:+4915731733332">+49 157 31733332</a><span>Slovensko · online</span></div>
        </div>
        <div class="footer-bottom"><span>© 2026 WebDizainFOX</span><span>Made with fox energy.</span><a href="#domov">↑</a></div>
      </footer>
    </div>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.main-nav');
      toggle?.addEventListener('click', () => { const open = nav?.classList.toggle('is-open') ?? false; toggle.setAttribute('aria-expanded', String(open)); });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { nav.classList.remove('is-open'); toggle?.setAttribute('aria-expanded', 'false'); }));
    </script>
  </body>
</html>
