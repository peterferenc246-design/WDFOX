---
import "../styles/site.css";
import { locales, localeLabels, type Locale } from "../data/content";
interface Props { locale: Locale; title: string; description: string; }
const { locale, title, description } = Astro.props;
const siteUrl = Astro.site?.toString().replace(/\/$/, "") || "https://webdizain-bbyygbqm.manus.space";
const pathFor = (code: Locale) => code === "de" ? "/de/" : `/${code}/`;
---
<!doctype html><html lang={locale}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#f36a0a" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" /><link rel="canonical" href={`${siteUrl}${pathFor(locale)}`} />{locales.map((code) => <link rel="alternate" hreflang={code} href={`${siteUrl}${pathFor(code)}`} />)}<title>{title}</title></head><body><div class="site-shell" id="domov"><div class="topline" aria-hidden="true"></div><header class="site-header"><div class="header-inner"><a class="brand" href={pathFor(locale)} aria-label="WebDesignFOX – domov"><span class="brand-mark" aria-hidden="true"><span class="fox-symbol"><i></i><b></b></span></span><span class="brand-copy"><span class="brand-name">WebDesign<span>FOX</span></span><span class="brand-tagline">{localeLabels[locale]} · WebDesign & Technik</span></span></a><nav class="main-nav" aria-label="Hauptnavigation"><slot name="navigation" /></nav><div class="header-actions"><div class="language-switcher" aria-label="Language selector">{locales.map((code) => <a class:list={{ "language-flag": true, active: code === locale }} href={`${siteUrl}${pathFor(code)}`} title={localeLabels[code]} aria-label={localeLabels[code]}><img src={`https://flagcdn.com/${code === "en" ? "gb" : code === "sv" ? "se" : code}.svg`} alt={code.toUpperCase()} /></a>)}</div><a class="nav-cta" href="#kontakt">✦ Beratung</a></div><button class="menu-toggle" type="button">☰</button></div></header><main><slot /></main><footer class="site-footer section-wrap"><div class="footer-main"><div><a class="brand" href={pathFor(locale)}><span class="brand-name">WebDesign<span>FOX</span></span></a><p class="footer-note">Moderne Websites, die verkaufen. Und Technik, die Sie nicht aufhält.</p></div><div class="footer-links"><strong>Kontakt</strong><a href="mailto:info@foxprof.club">info@foxprof.club</a><a href="tel:+4915731733332">+49 157 31733332</a><span>Deutschland · online</span></div></div><div class="footer-bottom"><span>© 2026 WebDesignFOX</span></div></footer></div></body></html>
